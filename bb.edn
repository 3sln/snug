;; snug's kin wiring. kin is on the PATH (as in emon and nome) so that nothing
;; in the generation path needs a JVM; `deps.edn` carries the Clojure-consumer
;; form of the same thing.
{:paths ["kin/src" "../kin/src"]
 :tasks
 {gen        {:doc "Print what one source generates.   bb gen kin/hello.kin"
              :task (apply shell "kin/scripts/gen" *command-line-args*)}
  emit       {:doc "Write every source's modules into gen/ (all or nothing)."
              :task (shell "kin/scripts/emit")}
  drift      {:doc "Is committed gen/ what the sources produce? (hand edits, stale, orphans, missing)"
              :task (shell "kin/scripts/drift")}
  check      {:doc "Generate, run JS (node) and Rust (cargo); require identical output."
              :task (shell "kin/scripts/check")}
  scan-test  {:doc "Every CBOR vector + seeded mutations through generated JS and Rust; codes must equal cbor.mjs's."
              :task (apply shell "kin/scripts/scan-test" *command-line-args*)}
  rscan-test {:doc "P6.1: the resumable scanner == the recursive one under window splits and yields, JS and Rust."
              :task (apply shell "kin/scripts/rscan-test" *command-line-args*)}
  compile-test {:doc "P3.2/P3.3: every corpus schema through the compiler on JS and Rust; refusals, identity, program.md §15, vm-verify."
                :task (apply shell "kin/scripts/compile-test" *command-line-args*)}
  vm-test    {:doc "P3.4: the VM on JS and Rust -- §15, profile identity vs the scanner, the corpus through the compiler, assembled programs, JS == Rust."
              :task (apply shell "kin/scripts/vm-test" *command-line-args*)}
  compile-fuzz {:doc "P3.2/P3.3: seeded random/mutated CDDL; only SchemaError, no panic, budget kept, JS == Rust, vm-verify accepts."
                :task (apply shell "kin/scripts/compile-fuzz" *command-line-args*)}
  crate-diff {:doc "P4.1: seeded differential vs the native cddl crate 0.10.7."
              :task (apply shell "node" "corpus/tools/crate-diff.mjs" *command-line-args*)}
  nav-test   {:doc "P5: kin navigation primitives on JS and Rust -- trace identity, truth vs the builder, unchecked-input robustness, Rust View paths."
              :task (apply shell "kin/scripts/nav-test" *command-line-args*)}
  write-test {:doc "P5.4: kin writer primitives on JS and Rust -- heads, float widths, integers, key order, close-map, Writer streams; truth vs cbor.mjs and the scanner; robustness."
              :task (apply shell "kin/scripts/write-test" *command-line-args*)}
  bench-scan {:doc "P1.4: generated JS vs hand-written JS vs wasm vs cbor.mjs (bench/SCAN.md)."
              :task (apply shell "kin/scripts/bench-scan" *command-line-args*)}}}
