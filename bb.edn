;; snug's kin wiring. kin is on the PATH (as in emon and nome) so that nothing
;; in the generation path needs a JVM; `deps.edn` carries the Clojure-consumer
;; form of the same thing.
{:paths ["kin/src" "../kin/src"]
 :tasks
 {size       {:doc "Public entry min/gzip/brotli regression budgets (offline esbuild)." :task (apply shell "node" "tools/size/size.mjs" *command-line-args*)}
  gen        {:doc "Print what one source generates.   bb gen kin/hello.kin"
              :task (apply shell "kin/scripts/gen" *command-line-args*)}
  emit       {:doc "Write every source's modules into gen/ (all or nothing)."
              :task (shell "kin/scripts/emit")}
  drift      {:doc "Is committed gen/ what the sources produce? (hand edits, stale, orphans, missing)"
              :task (shell "kin/scripts/drift")}
  check      {:doc "Generate, run JS (node) and Rust (cargo); require identical output."
              :task (shell "kin/scripts/check")}
  scan-test  {:doc "Every CBOR vector + seeded mutations through generated JS and Rust; codes must equal cbor.mjs's."
              :task (apply shell "kin/scripts/scan-test" *command-line-args*)}
  rscan-test {:doc "P6.1: the resumable scanner == the recursive one under window splits and yields, JS and Rust."
              :task (apply shell "kin/scripts/rscan-test" *command-line-args*)}
  compile-test {:doc "The compiler's gates: compile2-test (format 2.0, P8.5) then the regexp gate; format 1's compile-test.mjs is retired."
                :task (apply shell "kin/scripts/compile-test" *command-line-args*)}
  compile2-test {:doc "P8.5 phase 1: the format 2.0 compiler and verifier (PEG groups, D270) on JS and Rust -- corpus compiles, withdrawn refusals, JS == Rust (Programs and warnings), vm-verify, corruptions, SOURCE_KEY, tier census."
                 :task (apply shell "kin/scripts/compile2-test" *command-line-args*)}
  abnf-test {:doc "P9.14 (D334): .abnf/.abnfb -- the ABNF engine (kin/abnf.kin) vs the independent oracle (corpus/tools/abnf-oracle.mjs) on hand, RFC 9165 and seeded random/mutated grammars; budget at every room, the memory cap, scratch growth; JS == Rust.   bb abnf-test [grammars] [seed]"
             :task (apply shell "kin/scripts/abnf-test" *command-line-args*)}
  unicode-test {:doc "P7.3: offline Unicode tables, JS/Rust Program identity, category samples through the VM."
                :task (shell "kin/scripts/unicode-test")}
  rust-api-test {:doc "P7.11: public Rust API, JS codec/schema/Program parity, doctests and offline clippy; P9.6's async differential on a seeded slice (`full`: at full scale)."
                 :task (apply shell "sh" "host/rust/tests/run" *command-line-args*)}
  vm-test    {:doc "P3.4: the VM on JS and Rust -- §15, profile identity vs the scanner, the corpus through the compiler, assembled programs, JS == Rust."
              :task (apply shell "kin/scripts/vm-test" *command-line-args*)}
  vmsession-test {:doc "P6.2: the resumable session VM == the buffer driver (whole out array) under window splits, yields and budgets; JS and Rust."
                  :task (apply shell "kin/scripts/vmsession-test" *command-line-args*)}
  sequence-test {:doc "P7.13: CBOR sequences (RFC 8742) -- the session's sequence mode and the JS/Rust hosts == D211's oracle under every chunking; JS == Rust."
                 :task (apply shell "kin/scripts/sequence-test" *command-line-args*)}
  valid-test {:doc "P8.4: valid CBOR -- RFC 8949 Appendix A/F, additional and RFC 8742 vectors per preset, canonical equivalence, refusal replay (D280, F2) at every budget through buffer and session, and the cbor2 differential." :task (apply shell "node" "kin/scripts/valid-test.mjs" *command-line-args*)}
  compile-fuzz {:doc "P3.2/P3.3: seeded random/mutated CDDL; only SchemaError, no panic, budget kept, JS == Rust, vm-verify accepts."
                :task (apply shell "kin/scripts/compile-fuzz" *command-line-args*)}
  crate-diff {:doc "P4.1: seeded differential vs the native cddl crate 0.10.7."
              :task (apply shell "node" "corpus/tools/crate-diff.mjs" *command-line-args*)}
  regexp-diff {:doc "P9.8 follow-up: .regexp (XSD, D242) on xsd-regexp.json and seeded patterns vs the Ruby cddl gem and the cddl crate.   bb regexp-diff [--patterns=120] [--seed=..]"
               :task (apply shell "node" "corpus/tools/regexp-diff.mjs" *command-line-args*)}
  nav-test   {:doc "P5: kin navigation primitives on JS and Rust -- trace identity, truth vs the builder, unchecked-input robustness, Rust View paths."
              :task (apply shell "kin/scripts/nav-test" *command-line-args*)}
  write-test {:doc "P5.4: kin writer primitives on JS and Rust -- heads, float widths, integers, key order, close-map, Writer streams; truth vs cbor.mjs and the scanner; robustness."
              :task (apply shell "kin/scripts/write-test" *command-line-args*)}
  proptest   {:doc "P4.2: the property-based campaign (schema x value vs the oracle, codec, views, serialised Programs, robustness, Rust-parity gates); findings in tools/proptest/findings/."
              :task (apply shell "node" "tools/proptest/campaign.mjs" *command-line-args*)}
  wasm-size  {:doc "D341: the wasm SDK modules (kin/scripts/wasm-build sdk | cc) under their bytes and gzip caps (tools/size/budget.json \"wasm\"); SKIP without the nightly or wasm-opt." :task (apply shell "node" "tools/size/wasm-size.mjs" *command-line-args*)}
  wasm-sdk-test {:doc "P7.9 follow-up: build the wasm SDK modules (SKIP without the nightly toolchain); the SDK == native JS on vm-test's case set (validate, decode, encode, views, sessions, compile) + instance loss." :task (apply shell "sh" "host/wasm-sdk/test/run" *command-line-args*)}
  wasm-release {:doc "P9.17 (D345): build the wasm SDK modules with the pinned nightly and wasm-opt and stage the release artefacts (snug.wasm, snug-compiler.wasm, SHA256SUMS, MANIFEST.json) in .cache/release/wasm or DEST; SKIP (exit 3) without the toolchain.   bb wasm-release [DEST]" :task (apply shell "node" "kin/scripts/wasm-release.mjs" *command-line-args*)}
  wasm-package-test {:doc "P9.17 (D345): @3sln/snug-wasm -- wasm-release, the staged package (allowlist, links, metadata, wasm bytes, types, every entry), then npm pack and a consumer install: every loader in Node, the Workers recipe in workerd (and wrangler's bundle), Chrome; SKIP without the nightly." :task (apply shell "sh" "host/wasm-sdk/test/package-run" *command-line-args*)}
  watchdog-test {:doc "P9.1: the gate watchdog (kin/scripts/watchdog.mjs) -- CPU and wall caps trip, name the gate, its arguments and the cap, kill the gate's whole process group; pass-through otherwise; a real sh gate (scan-test 300 1) and a node gate (size) trip."
                 :task (shell "node" "kin/scripts/watchdog-test.mjs")}
  node-oldest {:doc "P9.18 (D344): host/js's npm test, then the @3sln/snug-wasm package gate (D345), on the oldest supported Node (engines.node), via nvm; SKIP without it."
               :task (shell "kin/scripts/node-oldest")}
  msrv       {:doc "P9.18 (D344): the assembled crate's build, tests and doctests on its rust-version, via rustup; SKIP without it."
              :task (shell "kin/scripts/msrv")}
  dist       {:doc "P9.19 (D346): build the dist branch commit and tags from a stamped release build's artefacts, in the given repository; never pushes.   bb dist --repo <checkout> --release <dir> --source <commit> [--overlay <dir>] [--dry-run]"
              :task (apply shell "node" "kin/scripts/dist.mjs" *command-line-args*)}
  dist-test  {:doc "P9.19 (D346): offline validation of bb dist in .cache/dist-test: reproducible commits, npm git+file and #semver, the wasm-sdk tree, cargo git tag, a probe Go module via go/ tags.   bb dist-test --release <dir> --source <commit>"
              :task (apply shell "node" "kin/scripts/dist-test.mjs" *command-line-args*)}
  gates      {:doc "P9.15: run gate sets or gates from ci/gate-map.edn in order, each under the watchdog; SKIP or blocked = not ok.   bb gates release | land | identity | <gate>... | --list | --check"
              :task (apply shell "kin/scripts/gates" *command-line-args*)}
  identity   {:doc "SPEC §7: the cross-host identity gates (bb gates identity): Programs, verdicts, reasons, paths and budget points, JS == Rust."
              :task (shell "kin/scripts/gates" "identity")}
  versions   {:doc "D343: every version site (manifests, version.mjs, kin's literal, gen/) holds version.edn's :placeholder; stamped versions are never checked in.   bb versions [--list]"
              :task (apply shell "node" "kin/scripts/version-sites.mjs" *command-line-args*)}
  stamp      {:doc "D343: write a release version onto every version site and re-emit gen/. Only in a detached release worktree or an exported copy.   bb stamp [version]  (default version.edn :version)"
              :task (apply shell "node" "kin/scripts/stamp.mjs" *command-line-args*)}
  stamp-test {:doc "D343: stamp scratch copies of this tree (0.1.0, a 32-byte prerelease): every site coherent, npm test passes stamped, stamping is idempotent, and two stamps give byte-identical trees, npm tarballs and .crate files."
              :task (apply shell "node" "kin/scripts/stamp-test.mjs" *command-line-args*)}
  bench-scan {:doc "P1.4: generated JS vs hand-written JS vs wasm vs cbor.mjs (bench/SCAN.md)."
              :task (apply shell "kin/scripts/bench-scan" *command-line-args*)}}}
