(defconst ^:pub ^I32 SS_CSTART 35)
(defconst ^:pub ^I32 SS_CPT 36)
;; the profile flags of the session's run (S[O_PROFILE] at vms-init), for the prescan
(defconst ^:pub ^I32 SS_PROF 37)
;; D085: 0 a declared length; 1 an unknown length (SS_TOTAL is the provisional end, the
;; effective input limit); 2 an unknown length whose end vms-eof has given
(defconst ^:pub ^I32 SS_UNK 38)
;; D085: pending end checks -- how many, and where (PW words each: claim, offset, budget
;; used, items, all absolute)
(defconst ^:pub ^I32 SS_NPEND 39)
(defconst ^:pub ^I32 SS_PEND 40)
(defconst ^:pub ^I32 PW 4)
;; D212: 1 a message of a CBOR sequence (vms-init-seq): the root's end is a boundary,
;; not a trailing check; its offset (the message length) once the root completed, else -1
(defconst ^:pub ^I32 SS_SEQ 41)
(defconst ^:pub ^I32 SS_MLEN 42)
;; P8.4 (D266): what a VMS_GROW suspension asks the host for -- the valid scratch's
;; words, the canonical buffer's bytes, the VM scratch's words, the key arena's bytes
;; (each 0: enough) -- and the window length a whole item asks for
(defconst ^:pub ^I32 SS_GW 44)
(defconst ^:pub ^I32 SS_GB 45)
(defconst ^:pub ^I32 SS_GS 46)
(defconst ^:pub ^I32 SS_GA 47)
(defconst ^:pub ^I32 SS_VNEED 48)
;; 1 when the step was given the valid machinery's buffers (vms-step-v)
(defconst ^:pub ^I32 SS_VOK 49)
(defconst ^:pub ^I32 SS_HDR 52)
;; an indefinite level's entries owed (the prescans, D266): far more than any count
(defconst ^:pub ^I32 IND 1073741824)

(defconst ^:pub ^I32 PH_START 0)
(defconst ^:pub ^I32 PH_ITEM 1)
(defconst ^:pub ^I32 PH_RET 2)
(defconst ^:pub ^I32 PH_FRAME 3)
(defconst ^:pub ^I32 PH_DONE 4)
;; D085: the verdict is in `out` but waits for the end (an unknown-length session)
(defconst ^:pub ^I32 PH_HELD 5)

;; item modes (IT_MODE)
(defconst ^:pub ^I32 MODE_ITEM 0)
(defconst ^:pub ^I32 MODE_VSEQ 1)
(defconst ^:pub ^I32 MODE_DSEQ 2)
(defconst ^:pub ^I32 MODE_FRAME 3)

