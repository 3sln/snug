;; The resumable validator session's machinery (P6.2; D027, architecture §17
;; rev 3, D029/D030; this item's design D090-D095): the session array's layout,
;; the frame stack and its control words, suspension (NEED / YIELD), the work
;; quantum, the window-relative rebasing of the scratch's position words, the
;; byte KEY ARENA (each active map's previous key and a key being copied across
;; windows), the structural PRESCAN that tells whether the buffer walk may take
;; an item whole from the current window (D091), and the tag-4/40 notes taken
;; from element heads (D029's summaries).
;;
;; Conventions: `ss` is the session array (Ints), `s` the VM scratch (Ints, as
;; for vm-validate, exclusive to the session), `ka` the key arena (BytesW), `b`
;; the current window and `base` its first byte's message offset. Positions in
;; `ss` are ABSOLUTE; positions handed to the buffer walk's functions are
;; window-relative (absolute - base) and may be negative or past the window
;; when they only label a charge or a witness.
(ns snug.vm.sbase
  (:require [kin.lang :refer [defn let local return set if while for do comment forever break continue defconst]]
            [snug.lang :refer [I32 Bool Bytes BytesW Ints IntsR + - * neg quot rem shl sar ushr bit-and bit-or
                               bit-xor < > <= >= == != and or not u8 blen ia iset ilen bset bcopy]]
            [snug.cbor.codes :refer [CODE_DUPLICATE_KEY CODE_KEY_ORDER CODE_DECIMAL CODE_NDARRAY O_ERR_POS
                                     O_ITEMS O_MAX_DEPTH PF_VREL]]
            [snug.cbor.stdtags :refer [std-allowed any-tags rule-tag]]
            [snug.cbor.head :refer [fail head-size small-arg be16 be32 enter-container]]
            [snug.cbor.tags :refer [typed-size exponent-ok mantissa-ok]]
            [snug.vm.layout :refer [H_LIM_DEPTH H_LIM_INPUT H_S_LEAVES H_S_LITREFS H_FLAGS FL_EMBED
                                    K_LIT K_LITSET K_BYTES K_EMBED VM_BUDGET VM_POS VM_W_OFFSET
                                    VM_BIGNUM_MAX R_BUDGET INF VM_BUDGET_START FL_ARENA H_R_ITEM_MAX
                                    H_ACT_SUM H_RECLEAF_MAX H_S_ARRAY_INDEX H_S_MAP_INDEX]]
            [snug.vm.arena :refer [arena-room arena-want]]
            [snug.vm.array :refer [forced]]
            [snug.vm.map :refer [t-recw]]
            [snug.vm.base :refer [charge c64min]]
            [snug.vm.api :refer [lim]]))

;; ------------------------------------------------------------ results

(defconst ^:pub ^I32 VMS_NEED -64)
(defconst ^:pub ^I32 VMS_YIELD -65)
;; D085: an unknown-length session's verdict is held until the end is known (vms-eof)
(defconst ^:pub ^I32 VMS_HELD -67)
;; D085: vms-eof took the end; step again (windows below it)
(defconst ^:pub ^I32 VMS_RESUME -68)
;; P8.4 (D266): a buffer is too small -- grow the arrays vms-grow-* name, step again
;; over the same window
(defconst ^:pub ^I32 VMS_GROW -69)
(defconst ^:pub ^I32 GO 0)

;; ------------------------------------------------------------ the session array header

(defconst ^:pub ^I32 SS_PH 0)
(defconst ^:pub ^I32 SS_TOTAL 1)
