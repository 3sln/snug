(ns snug.targets
  "snug's two targets (D006): JavaScript (this project's own, D005) and Rust
  (kin's, with a place to write).

  Generated layout: `snug.cbor.head` is `gen/js/snug/cbor/head.mjs` and
  `gen/rust/snug/cbor/head.rs`."
  (:require [clojure.string :as str]
            [kin]
            [kin.lang :as kl]
            [kin.target :as kt]
            [kin.vfs :as vfs]
            [snug.js :as js]))

(defn- segments [ns-name] (str/split (str ns-name) #"\."))

(defn- js-path [ns-name] (str (str/join "/" (segments ns-name)) ".mjs"))

(def js-reserved
  #{"arguments" "await" "break" "case" "catch" "class" "const" "continue"
    "debugger" "default" "delete" "do" "else" "enum" "eval" "export" "extends"
    "false" "finally" "for" "function" "if" "implements" "import" "in"
    "instanceof" "interface" "let" "new" "null" "package" "private"
    "protected" "public" "return" "static" "super" "switch" "this" "throw"
    "true" "try" "typeof" "undefined" "var" "void" "while" "with" "yield"
    "NaN" "Infinity" "Math" "Object" "Array" "Number" "String" "Error"})

(defn- relative
  "The ES import specifier for file `to` from a module at file `from`, both
  paths relative to the generated root: `./head.mjs`, `../x/y.mjs`."
  [from to]
  (let [fd (vec (butlast (str/split from #"/")))
        tp (str/split to #"/")
        td (vec (butlast tp))
        common (count (take-while true? (map = fd td)))
        ups (- (count fd) common)]
    (str (if (zero? ups) "./" (str/join (repeat ups "../")))
         (str/join "/" (concat (drop common td) [(last tp)])))))

(defn- js-cross-unit
  "A reference to `nm` in another unit: written bare, imported BY NAME. The
  import is recorded as data (`:import`/`:name`) beside the unit kin.lang
  already registered; the header keeps only the named ones."
  [c home nm]
  (when (seq nm)
    (kl/need! c {:qualified (str (kt/unit-import home) "#" nm)
                 :import home :import-name nm}))
  nm)

(defn- js-emit
  "An ES module: banner, named imports (sorted, deterministic), then every
  form with a blank line between top-level forms."
  [ctx forms]
  (let [ns-name (second (kt/ns-form-of forms))
        here (js-path ns-name)]
    (kin/emit! ctx "// Generated by kin. Do not edit.\n")
    (kin/emit! ctx "// source: " (str ns-name) "\n\n")
    (kt/with-unit
      ctx (kt/unit-of ctx ns-name)
      (fn [needs]
        (let [named (filter :import-name needs)
              by (group-by (comp kt/unit-import :import) named)]
          (str/join
           (for [[path entries] (sort-by key by)]
             (str "import { " (str/join ", " (sort (distinct (map :import-name entries))))
                  " } from '" (relative here path) "';\n")))))
      (fn [inner]
        (let [body (vec (kt/body-of forms))
              ;; forms that belong to (or emit nothing before) the next one
              glue? (fn [f] (and (seq? f) (symbol? (first f))
                                 (contains? #{"doc" "declarefn" "declaretag" "declarename"}
                                            (name (first f)))))]
          (doseq [[i f] (map-indexed vector body)]
            ;; A blank line between top-level forms, except after a `doc`
            ;; block (it belongs to the form it precedes) or a forward
            ;; declaration (it emits nothing in JS).
            (when (and (pos? i) (not (glue? (nth body (dec i)))))
              (kin/emit! inner "\n"))
            (kin/statement! inner f)))))))

(def targets
  {:js {:key :js :ext "mjs" :line-comment "//" :doc-comment "///"
        :reserved js-reserved
        :local-name (kt/namer kt/camel #(str % "_") js-reserved)
        :fn-name (kt/namer kt/camel #(str % "_") js-reserved)
        :unit (fn [ns-name] {:ns ns-name :name (last (segments ns-name))
                             :qualified (js-path ns-name)})
        :cross-unit js-cross-unit
        :data-emitters {'snug.lang/table js/table}
        :emit js-emit
        :vfs (vfs/disk-vfs "gen/js")
        :path js-path}

   :rust (assoc kt/rust
                :data-emitters {'snug.lang/table kl/flat-array}
                :vfs (vfs/disk-vfs "gen/rust")
                :path (fn [ns-name] (str (str/join "/" (segments ns-name)) ".rs")))})
