;; Scalar leaf evaluation (program.md §4.2-§4.5, §8.2, §9.1): integers as
;; sign + magnitude against interval lists (no host numbers, D009), floats as
;; ordered binary64 keys widened by integer operations, literals and literal
;; sets by encoded bytes, text size and I-Regexp (a bitset Glushkov
;; simulation over code points), byte-string size and `.bits`, `uint .bits`,
;; simple values. Every loop is charged per program.md §14.
;;
;; A leaf evaluator answers 0 (matched), a failure reason (32..41), or a
;; negated code (budget / inconsistent).
(ns snug.vm.leaf
  (:require [kin.lang :refer [defn let return set if while for do comment case]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR + - * neg shl sar ushr bit-and bit-or bit-xor
                               sub32 < > <= >= == != and or not ult u8 ia iset hex]]
            [snug.cbor.codes :refer [O_HI O_LO]]
            [snug.cbor.head :refer [be16 be32]]
            [snug.vm.layout :refer [H_S_LEAVES H_S_INTERVALS H_S_FINTERVALS H_S_LITREFS H_S_REGEX_INDEX
                                    VM_REGEX VM_REGCAP K_ANY K_MAJOR K_INT K_FLOAT K_SIMPLE K_LIT
                                    K_LITSET K_TEXT K_BYTES K_UINTX F_ADMITTED F_MATCHED
                                    R_TYPE R_VALUE R_SIZE R_RANGE R_PATTERN R_BITS R_BUDGET
                                    R_INCONSISTENT INF]]
            [snug.vm.base :refer [charge c12 c64min popcount low-bit high-bit]]))

;; ------------------------------------------------------------ comparisons

(defn ^:pub ^I32 cmp-u64 [^I32 ahi ^I32 alo ^I32 bhi ^I32 blo]
  (comment "Unsigned 64-bit hi:lo comparison: -1, 0, 1.")
  (if (!= ahi bhi) (if (ult ahi bhi) (return (neg 1)) (return 1)))
  (if (!= alo blo) (if (ult alo blo) (return (neg 1)) (return 1)))
  (return 0))

(defn ^:pub ^I32 cmp-mag [^Bytes x ^I32 xs ^I32 xl ^Bytes y ^I32 ys ^I32 yl]
  (comment "Minimal big-endian magnitudes: by length, then bytes.")
  (if (!= xl yl) (if (< xl yl) (return (neg 1)) (return 1)))
  (for [^I32 i 0 xl]
    (let [c (u8 x (+ xs i))
          d (u8 y (+ ys i))]
      (if (!= c d) (return (- c d)))))
  (return 0))

(defn ^:pub ^I32 cmp-bytes [^Bytes x ^I32 xs ^I32 xl ^Bytes y ^I32 ys ^I32 yl]
  (comment "Bytewise lexicographic order, shorter first on a common prefix (RFC 8949"
           "§4.2.1): the order of KEYS, LITSET members and rule names.")
  (let [^:mut m xl]
    (if (< yl m) (set m yl))
    (for [^I32 i 0 m]
      (let [c (u8 x (+ xs i))
            d (u8 y (+ ys i))]
        (if (!= c d) (return (- c d)))))
    (return (- xl yl))))

(defn ^:pub ^I32 cmp-point [^IntsR p ^Bytes pool ^Bytes b ^I32 rg ^I32 a ^I32 c ^I32 bo]
  (comment "The data point (region rg; a, c = hi, lo for NEG/POS, content start and"
           "length in b for NEG_BIG/POS_BIG) against the bound at word bo: -1, 0, 1.")
  (let [br (ia p bo)
        ba (ia p (+ bo 1))
        bb (ia p (+ bo 2))]
    (if (!= rg br) (if (< rg br) (return (neg 1)) (return 1)))
    (if (== rg 3) (return (cmp-u64 a c ba bb)))
    (if (== rg 2) (return (cmp-u64 ba bb a c)))
    (if (== rg 4) (return (cmp-mag b a c pool ba bb)))
    (return (cmp-mag pool ba bb b a c))))

(defn ^:pub ^I32 in-intervals [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 first ^I32 count
                               ^I32 rg ^I32 a ^I32 c ^I32 at]
  (comment "1 if the point lies in the interval run [first, first+count), else 0:"
           "binary search for the last interval whose lower bound is <= the point"
           "(1 unit per probe), then its upper bound. Or a negated code.")
  (let [base (ia p H_S_INTERVALS)
        ^:mut lo 0
        ^:mut hi count]
    (while (< lo hi)
      (if (not (charge s 1 at)) (return (neg R_BUDGET)))
      (let [mid (sar (+ lo hi) 1)
            bo (+ base (* 6 (+ first mid)))]
        (if (>= (cmp-point p pool b rg a c bo) 0) (set lo (+ mid 1)) (set hi mid))))
    (if (== lo 0) (return 0))
    (let [hb (+ (+ base (* 6 (+ first (- lo 1)))) 3)]
      (if (<= (cmp-point p pool b rg a c hb) 0) (return 1))
      (return 0))))

;; ------------------------------------------------------------ floats

(defn ^:pub float-key [^Bytes b ^Ints s ^I32 pos ^I32 ai]
  (comment "The ordered binary64 key of the profile-valid float at pos into s[O_HI],"
           "s[O_LO]: float16/32 are widened by integer operations, then key(x) = x >= 0"
           "? x | 2^63 : ~x (§4.4). A zero, an infinity or a NaN can only be a float16"
           "(the RFC float rules, D122) and is widened as such.")
  (let [^:mut hi 0
        ^:mut lo 0
        ^:mut sg 0]
    (if (== ai 27)
      (do (set hi (be32 b (+ pos 1)))
          (set lo (be32 b (+ pos 5)))
          (set sg (bit-and hi (shl 1 31)))))
    (if (== ai 26)
      (do (let [w (be32 b (+ pos 1))
                e (bit-and (sar w 23) 255)
                m (bit-and w (hex 8388607))]
            (set sg (bit-and w (shl 1 31)))
            (if (!= e 0)
              (do (set hi (bit-or sg (bit-or (shl (+ e 896) 20) (ushr m 3))))
                  (set lo (shl m 29)))
              (do (comment "Subnormal: m * 2^-149 = 2^(k-149) (1 + r / 2^k).")
                  (let [k (high-bit m)
                        r (bit-xor m (shl 1 k))]
                    (set hi (bit-or sg (shl (+ k 874) 20)))
                    (if (<= k 20)
                      (set hi (bit-or hi (shl r (- 20 k))))
                      (do (set hi (bit-or hi (ushr r (- k 20))))
                          (set lo (shl r (- 52 k)))))))))))
    (if (== ai 25)
      (do (let [h (be16 b (+ pos 1))
                e5 (bit-and (sar h 10) 31)
                f (bit-and h 1023)]
            (set sg (shl (bit-and h (hex 32768)) 16))
            (if (== e5 31)
              (set hi (bit-or sg (bit-or (hex 2146435072) (shl f 10))))
              (if (!= e5 0)
                (set hi (bit-or sg (bit-or (shl (+ e5 1008) 20) (shl f 10))))
                (if (== f 0)
                  (set hi sg)
                  (do (comment "Subnormal: f * 2^-24.")
                      (let [k5 (high-bit f)
                            r5 (bit-xor f (shl 1 k5))]
                        (set hi (bit-or sg (bit-or (shl (+ k5 999) 20) (shl r5 (- 20 k5)))))))))))))
    (if (== sg 0)
      (do (iset s O_HI (bit-or hi (shl 1 31)))
          (iset s O_LO lo))
      (do (iset s O_HI (bit-xor hi (neg 1)))
          (iset s O_LO (bit-xor lo (neg 1)))))))

(defn ^:pub ^I32 in-fintervals [^IntsR p ^Ints s ^I32 first ^I32 count ^I32 khi ^I32 klo ^I32 at]
  (comment "1 if the ordered key lies in the float interval run, else 0; 1 unit per"
           "probe; or a negated code.")
  (let [base (ia p H_S_FINTERVALS)
        ^:mut lo 0
        ^:mut hi count]
    (while (< lo hi)
      (if (not (charge s 1 at)) (return (neg R_BUDGET)))
      (let [mid (sar (+ lo hi) 1)
            bo (+ base (* 4 (+ first mid)))]
        (if (>= (cmp-u64 khi klo (ia p bo) (ia p (+ bo 1))) 0) (set lo (+ mid 1)) (set hi mid))))
    (if (== lo 0) (return 0))
    (let [hb (+ base (* 4 (+ first (- lo 1))))]
      (if (<= (cmp-u64 khi klo (ia p (+ hb 2)) (ia p (+ hb 3))) 0) (return 1))
      (return 0))))

;; ------------------------------------------------------------ regexps

(defn ^:pub ^I32 utf8-len [^I32 c0]
  (comment "The length of the (valid) UTF-8 sequence whose lead byte is c0.")
  (if (>= c0 240) (return 4))
  (if (>= c0 224) (return 3))
  (if (>= c0 192) (return 2))
  (return 1))

(defn ^:pub ^I32 rx-cp [^IntsR p ^Ints s ^Bytes b ^I32 rx ^I32 i ^I32 step ^I32 act ^I32 at]
  (comment "One code point of an I-Regexp run (§8.2): the whole UTF-8 sequence at"
           "b[i], W (|active| + 1) units, the atom (1 unit per probe), then the next"
           "active set N = (step 0 ? first : OR of the follow rows of the active"
           "set) AND the atom's mask, kept in the regex area. act is |active|."
           "Answers the new |active| (0: the run is dead) or a negated code. The"
           "buffer walk (rx-match) and the resumable session share it.")
  (let [ro (ia p (+ (ia p H_S_REGEX_INDEX) rx))
        npos (ia p ro)
        w (ia p (+ ro 1))
        natoms (ia p (+ ro 2))
        first (+ ro 4)
        accept (+ first w)
        follow (+ accept w)
        astart (+ follow (* npos w))
        amask (+ astart natoms)
        cur (ia s VM_REGEX)
        nxt (+ cur w)
        c0 (u8 b i)
        ^:mut cp c0
        ^:mut na 0]
    (if (>= c0 240)
      (set cp (bit-or (bit-or (shl (bit-and c0 7) 18) (shl (bit-and (u8 b (+ i 1)) 63) 12))
                      (bit-or (shl (bit-and (u8 b (+ i 2)) 63) 6) (bit-and (u8 b (+ i 3)) 63))))
      (if (>= c0 224)
        (set cp (bit-or (bit-or (shl (bit-and c0 15) 12) (shl (bit-and (u8 b (+ i 1)) 63) 6))
                        (bit-and (u8 b (+ i 2)) 63)))
        (if (>= c0 192)
          (set cp (bit-or (shl (bit-and c0 31) 6) (bit-and (u8 b (+ i 1)) 63))))))
    (if (not (charge s (* w (+ act 1)) at)) (return (neg R_BUDGET)))
    (comment "The atom: the last atom_start <= cp.")
    (let [^:mut lo 0
          ^:mut hi natoms]
      (while (< lo hi)
        (if (not (charge s 1 at)) (return (neg R_BUDGET)))
        (let [mid (sar (+ lo hi) 1)]
          (if (<= (ia p (+ astart mid)) cp) (set lo (+ mid 1)) (set hi mid))))
      (let [atom (- lo 1)
            mrow (+ amask (* atom w))]
        (if (== step 0)
          (for [^I32 j 0 w]
            (iset s (+ nxt j) (bit-and (ia p (+ first j)) (ia p (+ mrow j)))))
          (do (for [^I32 j2 0 w]
                (iset s (+ nxt j2) 0))
              (for [^I32 wi 0 w]
                (let [^:mut x (ia s (+ cur wi))]
                  (while (!= x 0)
                    (let [pp (+ (* wi 32) (low-bit x))
                          row (+ follow (* pp w))]
                      (set x (bit-and x (sub32 x 1)))
                      (for [^I32 j3 0 w]
                        (let [v (ia s (+ nxt j3))]
                          (iset s (+ nxt j3) (bit-or v (ia p (+ row j3))))))))))
              (for [^I32 j4 0 w]
                (let [v4 (ia s (+ nxt j4))]
                  (iset s (+ nxt j4) (bit-and v4 (ia p (+ mrow j4))))))))
        (for [^I32 j5 0 w]
          (let [v5 (ia s (+ nxt j5))]
            (iset s (+ cur j5) v5)
            (set na (+ na (popcount v5)))))))
    (return na)))

(defn ^:pub ^I32 rx-accepts [^IntsR p ^IntsR s ^I32 rx]
  (comment "After the last code point: 1 if the active set meets `accept`, else 0.")
  (let [ro (ia p (+ (ia p H_S_REGEX_INDEX) rx))
        w (ia p (+ ro 1))
        accept (+ (+ ro 4) w)
        cur (ia s VM_REGEX)]
    (for [^I32 j 0 w]
      (if (!= (bit-and (ia s (+ cur j)) (ia p (+ accept j))) 0) (return 1)))
    (return 0)))

(defn ^:pub ^I32 rx-match [^IntsR p ^Ints s ^Bytes b ^I32 rx ^I32 cs ^I32 ce ^I32 at]
  (comment "Run I-Regexp automaton rx over the code points of the (UTF-8-valid) text"
           "b[cs, ce), one rx-cp per code point; stops when the active set"
           "empties. 1 matched, 0 not, or a negated code.")
  (let [ro (ia p (+ (ia p H_S_REGEX_INDEX) rx))
        w (ia p (+ ro 1))
        nullable (ia p (+ ro 3))
        ^:mut i cs
        ^:mut act 0
        ^:mut step 0]
    (if (> (* 2 w) (ia s VM_REGCAP)) (return (neg R_INCONSISTENT)))
    (if (== cs ce) (return nullable))
    (while (< i ce)
      (set act (rx-cp p s b rx i step act at))
      (if (< act 0) (return act))
      (if (== act 0) (return 0))
      (set i (+ i (utf8-len (u8 b i))))
      (set step 1))
    (return (rx-accepts p s rx))))

;; ------------------------------------------------------------ one leaf

(defn ^:pub ^Bool scalar-kind [^I32 kind]
  (comment "Kinds a scalar evaluation decides (TAG/TAGSET/EMBED/ARRAY/MAP/AND/NOT are"
           "decided by their item's walk).")
  (return (and (>= kind K_ANY) (<= kind K_UINTX))))

(defn ^:pub ^I32 leaf-int [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 lb ^I32 pos ^I32 cs ^I32 ce
                           ^I32 cls ^I32 hi ^I32 lo]
  (comment "INT: major 0 is the point POS(v), major 1 NEG(n), a bignum (only with"
           "BIGOK) POS_BIG / NEG_BIG over its content bytes, read in place (§4.3).")
  (let [bigok (!= (bit-and (ia p lb) 256) 0)
        ^:mut rg 0
        ^:mut a hi
        ^:mut c lo]
    (if (== cls 1) (set rg 3))
    (if (== cls 2) (set rg 2))
    (if (and (== cls 2048) bigok)
      (do (set a cs)
          (set c (- ce cs))
          (comment "The tag head is the single byte c2 (tag 2) or c3 (tag 3).")
          (if (== (bit-and (u8 b pos) 31) 2) (set rg 4) (set rg 1))
          (comment "P8.4 (D265): valid CBOR admits leading zeros and small bignums;"
                   "compare the magnitude without them, as an integer when it fits 64 bits")
          (while (and (> c 0) (== (u8 b a) 0))
            (set a (+ a 1))
            (set c (- c 1)))
          (if (<= c 8)
            (do (let [^:mut vh 0
                      ^:mut vl 0]
                  (for [^I32 j 0 c]
                    (set vh (bit-or (shl vh 8) (ushr vl 24)))
                    (set vl (bit-or (shl vl 8) (u8 b (+ a j)))))
                  (set a vh)
                  (set c vl)
                  (if (== rg 4) (set rg 3) (set rg 2)))))))
    (if (== rg 0) (return R_TYPE))
    (let [r (in-intervals p pool b s (ia p (+ lb 2)) (ia p (+ lb 3)) rg a c pos)]
      (if (< r 0) (return r))
      (if (== r 1) (return 0))
      (return R_RANGE))))

(defn ^I32 float-nan [^IntsR p ^Ints s ^I32 lb ^I32 count ^I32 pos]
  (comment "Every NaN (any width, sign or payload) is one number for CDDL: it is in the"
           "run when the NaN key fff80000:00000000 is (D250).")
  (let [r (in-fintervals p s (ia p (+ lb 2)) count (neg 524288) 0 pos)]
    (if (< r 0) (return r))
    (if (== r 1) (return 0))
    (return R_RANGE)))

(defn ^:pub ^I32 leaf-float [^IntsR p ^Bytes b ^Ints s ^I32 lb ^I32 pos]
  (comment "FLOAT: the width is exact by mask; then the interval list, if any. Under"
           "the RFC float rules (D122) a NaN is looked up as the one NaN key"
           "fff80000:00000000 (the key of f97e00, above +inf: D250), and a zero compares"
           "as IEEE does (-0 = +0): it is in the list when the key of +0 or of -0 is"
           "(the two keys are adjacent), a second search for -0.")
  (let [count (ia p (+ lb 3))
        ai (bit-and (u8 b pos) 31)]
    (if (== count 0) (return 0))
    (if (== ai 25)
      (do (let [h (be16 b (+ pos 1))]
            (if (and (== (bit-and h (hex 31744)) (hex 31744)) (!= (bit-and h (hex 1023)) 0))
              (return (float-nan p s lb count pos)))
            (if (== (bit-and h (hex 32767)) 0)
              (do (let [rz (in-fintervals p s (ia p (+ lb 2)) count (shl 1 31) 0 pos)]
                    (if (< rz 0) (return rz))
                    (if (== rz 1) (return 0)))
                  (let [rn (in-fintervals p s (ia p (+ lb 2)) count (hex 2147483647) (neg 1) pos)]
                    (if (< rn 0) (return rn))
                    (if (== rn 1) (return 0))
                    (return R_RANGE)))))))
    (if (== ai 26)
      (do (let [w (be32 b (+ pos 1))]
            (if (and (== (bit-and w (hex 2139095040)) (hex 2139095040)) (!= (bit-and w (hex 8388607)) 0))
              (return (float-nan p s lb count pos))))))
    (if (== ai 27)
      (do (let [wh (be32 b (+ pos 1))]
            (if (and (== (bit-and wh (hex 2146435072)) (hex 2146435072))
                     (or (!= (bit-and wh (hex 1048575)) 0) (!= (be32 b (+ pos 5)) 0)))
              (return (float-nan p s lb count pos))))))
    (float-key b s pos ai)
    (let [khi (ia s O_HI)
          klo (ia s O_LO)
          r (in-fintervals p s (ia p (+ lb 2)) count khi klo pos)]
      (if (< r 0) (return r))
      (if (== r 1) (return 0))
      (return R_RANGE))))

(defn ^:pub ^I32 leaf-lit [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 lb ^I32 pos ^I32 ce]
  (comment "LIT: the item's whole encoded span against the pool literal; the"
           "comparison is charged ceil(min(len)/64), at least 1.")
  (let [off (ia p (+ lb 2))
        len (ia p (+ lb 3))
        il (- ce pos)]
    (if (not (charge s (c64min il len) pos)) (return (neg R_BUDGET)))
    (if (!= il len) (return R_VALUE))
    (if (== (cmp-bytes b pos il pool off len) 0) (return 0))
    (return R_VALUE)))

(defn ^:pub ^I32 leaf-litset [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 lb ^I32 pos ^I32 ce]
  (comment "LITSET: binary search of the sorted members by encoded bytes; a probe is"
           "charged with its comparison, ceil(min(len)/64), at least 1.")
  (let [first (ia p (+ lb 2))
        count (ia p (+ lb 3))
        base (ia p H_S_LITREFS)
        il (- ce pos)
        ^:mut lo 0
        ^:mut hi count]
    (while (< lo hi)
      (let [mid (sar (+ lo hi) 1)
            mo (+ base (* 2 (+ first mid)))
            off (ia p mo)
            len (ia p (+ mo 1))]
        (if (not (charge s (c64min il len) pos)) (return (neg R_BUDGET)))
        (let [c (cmp-bytes b pos il pool off len)]
          (if (== c 0) (return 0))
          (if (< c 0) (set hi mid) (set lo (+ mid 1))))))
    (return R_VALUE)))

(defn ^:pub ^I32 leaf-text [^IntsR p ^Bytes b ^Ints s ^I32 lb ^I32 pos ^I32 cs ^I32 ce]
  (comment "TEXT: size in bytes, then the anchored regexp.")
  (let [len (- ce cs)
        rx (ia p (+ lb 4))]
    (if (or (< len (ia p (+ lb 2))) (> len (ia p (+ lb 3)))) (return R_SIZE))
    (if (< rx 0) (return 0))
    (let [r (rx-match p s b rx cs ce pos)]
      (if (< r 0) (return r))
      (if (== r 1) (return 0))
      (return R_PATTERN))))

(defn ^:pub ^Bool bits-ok [^Bytes pool ^Bytes b ^I32 moff ^I32 mlen ^I32 cs ^I32 i0 ^I32 stop]
  (comment "`.bits` over b[i0, stop) of content starting at cs: data[k] & ~mask[k] = 0"
           "with k = i - cs and mask 0 past its length (shared by the buffer walk"
           "and the resumable session, which checks a window at a time).")
  (let [^:mut i i0]
    (while (< i stop)
      (let [k (- i cs)
            ^:mut m 0]
        (if (< k mlen) (set m (u8 pool (+ moff k))))
        (if (!= (bit-and (u8 b i) (bit-xor m 255)) 0) (return false)))
      (set i (+ i 1))))
  (return true))

(defn ^:pub ^I32 leaf-bytes [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 lb ^I32 pos ^I32 cs ^I32 ce]
  (comment "BYTES: size, then `.bits` (data[i] & ~mask[i] = 0, mask 0 past its"
           "length; charged ceil(len/12), D253).")
  (let [len (- ce cs)
        moff (ia p (+ lb 4))
        mlen (ia p (+ lb 5))]
    (if (or (< len (ia p (+ lb 2))) (> len (ia p (+ lb 3)))) (return R_SIZE))
    (if (== mlen 0) (return 0))
    (if (not (charge s (c12 len) pos)) (return (neg R_BUDGET)))
    (if (bits-ok pool b moff mlen cs cs ce) (return 0))
    (return R_BITS)))

(defn ^:pub ^I32 leaf-simple [^IntsR p ^Bytes b ^I32 lb ^I32 pos]
  (comment "#7.v: v 0..23 is the head's ai; v 32..255 (D284) the f8 head's argument.")
  (let [v (ia p (+ lb 2))
        ib (u8 b pos)]
    (if (< v 24)
      (if (== (bit-and ib 31) v) (return 0))
      (if (and (== ib 248) (== (u8 b (+ pos 1)) v)) (return 0)))
    (return R_VALUE)))

(defn ^:pub ^I32 leaf-uintx [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 lb ^I32 pos ^I32 cls ^I32 hi ^I32 lo]
  (comment "UINTX (`uint .bits`): intervals (if any) first, then v & ~allowed = 0.")
  (let [count (ia p (+ lb 5))]
    (if (!= cls 1) (return R_TYPE))
    (if (> count 0)
      (do (let [r (in-intervals p pool b s (ia p (+ lb 4)) count 3 hi lo pos)]
            (if (< r 0) (return r))
            (if (== r 0) (return R_RANGE)))))
    (if (!= (bit-or (bit-and hi (bit-xor (ia p (+ lb 2)) (neg 1)))
                    (bit-and lo (bit-xor (ia p (+ lb 3)) (neg 1))))
            0)
      (return R_BITS))
    (return 0)))

(defn ^:pub ^I32 eval-leaf [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 lb ^I32 kind ^I32 pos
                            ^I32 cs ^I32 ce ^I32 cls ^I32 hi ^I32 lo]
  (comment "One admitted scalar leaf on the item at pos (content [cs, ce), which is"
           "also where the item ends): 0 matched, a reason, or a negated code.")
  (case kind
    [K_ANY K_MAJOR] 0
    [K_INT] (leaf-int p pool b s lb pos cs ce cls hi lo)
    [K_FLOAT] (leaf-float p b s lb pos)
    [K_SIMPLE] (leaf-simple p b lb pos)
    [K_LIT] (leaf-lit p pool b s lb pos ce)
    [K_LITSET] (leaf-litset p pool b s lb pos ce)
    [K_TEXT] (leaf-text p b s lb pos cs ce)
    [K_BYTES] (leaf-bytes p pool b s lb pos cs ce)
    [K_UINTX] (leaf-uintx p pool b s lb pos cls hi lo)
    :else R_TYPE))

(defn ^:pub ^I32 eval-scalars [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 fb ^I32 w ^I32 nq
                               ^I32 pos ^I32 cs ^I32 ce ^I32 cls ^I32 hi ^I32 lo ^I32 unit]
  (comment "Every admitted scalar leaf of the query list, in query order, on the item"
           "at pos: 1 unit each, then its own work; sets MATCHED or the failure"
           "reason (bits 8-15) in the entry's flags. 0 or a negated code.")
  (let [lv (ia p H_S_LEAVES)
        fl0 (+ fb w)]
    (for [^I32 i 0 nq]
      (let [f (ia s (+ fl0 i))]
        (if (!= (bit-and f F_ADMITTED) 0)
          (do (let [l (ia s (+ fb i))
                    lb (+ lv (* 8 l))
                    kind (bit-and (ia p lb) 255)]
                (if (scalar-kind kind)
                  (do (comment "unit 0: schedule 2's one-leaf child (D045), no leaf unit")
                      (if (not (charge s unit pos)) (return (neg R_BUDGET)))
                      (let [r (eval-leaf p pool b s lb kind pos cs ce cls hi lo)]
                        (if (< r 0) (return r))
                        (if (== r 0)
                          (iset s (+ fl0 i) (bit-or f F_MATCHED))
                          (iset s (+ fl0 i) (bit-or f (shl r 8))))))))))))
    (return 0)))
