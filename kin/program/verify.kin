;; The structural verifier, program.md §11 with the format 2.0 delta of
;; docs/program-2.md §3.1, §7: `vm-verify` runs once per Program at load,
;; before any validation. It checks that every offset and id is in range,
;; every index section matches its data walk, every [V] invariant and every
;; [D] derived field (recomputed and compared: PEG lengths, B, tiers, depth,
;; the relaxed automata, map classes, slots, records, the arena words), the
;; absence of left recursion and the closure chains' superset property, under
;; a verify budget of 64 * (PROGRAM_WORDS + POOL_BYTES / 4 + 1) units raised by
;; each fixed point's bound (D297). Format 1.x Programs are refused (D084: the
;; major version must be 2), check id C_VERSION. It does not check [S]
;; properties or SOURCE_KEY.
;;
;; Every read of P is CHECKED here (`pw`): an index outside P records a
;; refusal and reads 0, so a corrupt Program is refused and never read out of
;; bounds. The first failure is kept: S[VM_DETAIL] = the word offset (or byte
;; offset in B, see the check id), S[VM_DETAIL + 1] = the check id (below).
;;
;; Scratch use: S[16] (VM_EPOCH) and the marks S[48 .. 48 + M) and
;; S[48 + M .. 48 + 2M) with M = S[17] (VM_MARK_CAP), as program.md §12.1; the
;; host must pass a scratch with M >= N_LEAVES and len(S) >= 48 + 2M plus the
;; PEG working area after the marks: `vm-verify-words` gives the total (format
;; 2.0), else the answer is -2.
(ns snug.program.verify
  (:require [kin.lang :refer [defn let return set if while for do comment defconst forever break declarefn]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR + - * neg quot shl sar ushr bit-and bit-or bit-not add32 sub32
                               < > <= >= == != and or not ult u8 blen ia iset ilen]]))

;; scratch words
(defconst ^:pub ^I32 VM_EPOCH 16)
(defconst ^:pub ^I32 VM_MARK_CAP 17)
(defconst ^:pub ^I32 VM_DETAIL 35)
(defconst ^I32 V_FAILED 37)
(defconst ^I32 V_BUDGET 38)
(defconst ^I32 MARKS 48)

(defconst ^I32 INF 2147483647)

;; check ids (S[VM_DETAIL + 1])
(defconst ^:pub ^I32 C_SCRATCH 1)
(defconst ^:pub ^I32 C_HEADER 2)
(defconst ^:pub ^I32 C_SECTIONS 3)
(defconst ^:pub ^I32 C_INDEX 4)
(defconst ^:pub ^I32 C_RULE 5)
(defconst ^:pub ^I32 C_LEAF 6)
(defconst ^:pub ^I32 C_MASK 7)
(defconst ^:pub ^I32 C_TYPESET 8)
(defconst ^:pub ^I32 C_KEY 9)
(defconst ^:pub ^I32 C_PEG 10)
(defconst ^:pub ^I32 C_MAP 11)
(defconst ^:pub ^I32 C_ARRAY 12)
(defconst ^:pub ^I32 C_REGEXP 13)
(defconst ^:pub ^I32 C_INTERVAL 14)
(defconst ^:pub ^I32 C_FINTERVAL 15)
(defconst ^:pub ^I32 C_LITREF 16)
(defconst ^:pub ^I32 C_CSET 17)
(defconst ^:pub ^I32 C_CHAIN 18)
(defconst ^:pub ^I32 C_DERIVED 19)
(defconst ^:pub ^I32 C_POOL 20)
(defconst ^:pub ^I32 C_BUDGET 21)
(defconst ^:pub ^I32 C_TOTAL 22)
(defconst ^:pub ^I32 C_UTF8 23)
;; format 1.1 (D141): the extension-control table
(defconst ^:pub ^I32 C_EXT 24)
;; format 2.0: a Program of another major version (1.x is refused, D084)
(defconst ^:pub ^I32 C_VERSION 25)
;; format 2.0: a CALL cycle through nullable prefixes (left recursion, program-2 §5.3)
(defconst ^:pub ^I32 C_RECURSION 26)

;; header words
(defconst ^I32 W_N_RULES 15)
(defconst ^I32 W_N_LEAVES 16)
(defconst ^I32 W_N_TYPESETS 17)
(defconst ^I32 W_N_KEYS 18)
(defconst ^I32 W_N_PEGS 19)
(defconst ^I32 W_N_MAPS 20)
(defconst ^I32 W_N_ARRAYS 21)
(defconst ^I32 W_N_REGEXPS 22)
(defconst ^I32 W_N_INTERVALS 23)
(defconst ^I32 W_N_FINTERVALS 24)
(defconst ^I32 W_N_LITREFS 25)
(defconst ^I32 W_N_CSETS 26)
(defconst ^I32 W_N_CHAINS 27)
(defconst ^I32 W_TS_ANY 28)
(defconst ^I32 W_R_ITEM_MAX 29)
(defconst ^I32 W_LIM_GROUP 41)
(defconst ^I32 W_RECLEAF_MAX 62)
(defconst ^I32 W_ACT_SUM 63)
(defconst ^I32 W_SEC 42)
;; format 1.1 (D141): extension controls -- count, names' pool offset and byte length
(defconst ^I32 W_N_EXTS 30)
(defconst ^I32 W_EXT_NAMES 31)
(defconst ^I32 W_EXT_NAMES_LEN 39)
(defconst ^:pub ^I32 FORMAT_V2 2)
(defconst ^I32 PEG_HDR 9)
(defconst ^I32 COUNT_SAT 16777216)
(defconst ^I32 RING_WORDS 4096)
(defconst ^I32 P_EMPTY 0)
(defconst ^I32 P_FAIL 1)
(defconst ^I32 P_ENTRY 2)
(defconst ^I32 P_MEMBER 3)
(defconst ^I32 P_SEQ 4)
(defconst ^I32 P_CHOICE 5)
(defconst ^I32 P_REP 6)
(defconst ^I32 P_CALL 7)
(defconst ^I32 TIER_A0 0)
(defconst ^I32 TIER_A1 1)
(defconst ^I32 TIER_A2 2)
(defconst ^I32 TIER_F 0)
(defconst ^I32 TIER_S 1)
(defconst ^I32 TIER_T 2)


(declarefn ^I32 vm-verify-temp)

;; ------------------------------------------------------------ failure, budget

(defn ^I32 bad [^Ints s ^I32 at ^I32 check]
  (comment "Record the first refusal (word or byte offset, check id); answers 0.")
  (if (== (ia s V_FAILED) 0)
    (do (iset s V_FAILED 1)
        (iset s VM_DETAIL at)
        (iset s (+ VM_DETAIL 1) check)))
  (return 0))

(defn ^Bool failed [^IntsR s] (return (!= (ia s V_FAILED) 0)))

(defn ^Bool spend [^Ints s ^I32 n]
  (comment "Spend n verify-budget units; refuse when exhausted.")
  (let [b (ia s V_BUDGET)]
    (if (or (< n 0) (> n b))
      (do (iset s V_BUDGET 0) (bad s 0 C_BUDGET) (return false)))
    (iset s V_BUDGET (- b n))
    (return true)))

(defn ^I32 pw [^IntsR p ^I32 i]
  (comment "P[i], checked: outside P it reads 0. The checks below establish every"
           "section boundary and record length before they read inside, so this is"
           "only the guarantee that a mistake can never read out of bounds.")
  (if (ult i (ilen p)) (return (ia p i)))
  (return 0))

(defn ^I32 sec [^IntsR p ^I32 k]
  (comment "Section k's first word; section 20 is the end (PROGRAM_WORDS, format 2.0).")
  (if (== k 20) (return (ilen p)))
  (return (pw p (+ W_SEC k))))

(defn ^Bool in-range [^I32 v ^I32 n] (return (and (>= v 0) (< v n))))

(defn ^Bool want [^Ints s ^Bool ok ^I32 at ^I32 check]
  (if (not ok) (bad s at check))
  (return ok))

;; ------------------------------------------------------------ marks

(defn ^I32 epoch [^Ints s]
  (comment "A fresh mark epoch (program.md §12.1's discipline).")
  (let [m (ia s VM_MARK_CAP)
        ^:mut e (+ (ia s VM_EPOCH) 1)]
    (if (>= e 2147483632)
      (do (for [^I32 i 0 (* 2 m)] (iset s (+ MARKS i) 0))
          (set e 1)))
    (iset s VM_EPOCH e)
    (return e)))

(defn ^I32 mark-get [^IntsR s ^I32 l] (return (ia s (+ MARKS l))))
(defn mark-set [^Ints s ^I32 l ^I32 e] (iset s (+ MARKS l) e))
(defn ^I32 aux-get [^IntsR s ^I32 l] (return (ia s (+ (+ MARKS (ia s VM_MARK_CAP)) l))))
(defn aux-set [^Ints s ^I32 l ^I32 v] (iset s (+ (+ MARKS (ia s VM_MARK_CAP)) l) v))

;; ------------------------------------------------------------ pool helpers

(defn ^Bool byte-range [^Bytes b ^I32 off ^I32 len]
  (return (and (and (>= off 0) (>= len 0)) (<= len (- (blen b) off)))))

(defn ^I32 bytes-cmp [^Bytes b ^I32 o1 ^I32 l1 ^I32 o2 ^I32 l2]
  (comment "Bytewise order, a proper prefix first (both ranges already checked).")
  (let [^:mut m l1]
    (if (< l2 m) (set m l2))
    (for [^I32 i 0 m]
      (let [x (u8 b (+ o1 i))
            y (u8 b (+ o2 i))]
        (if (!= x y) (return (- x y)))))
    (return (- l1 l2))))

(defn ^I32 enc-class [^Bytes b ^I32 off]
  (comment "The class bit (program.md §4.1) of an item whose first byte is at off.")
  (let [ib (u8 b off)
        m (ushr ib 5)]
    (if (<= m 5) (return (shl 1 m)))
    (if (== m 7)
      (do (let [ai (bit-and ib 31)]
            (if (== ai 25) (return 256))
            (if (== ai 26) (return 512))
            (if (== ai 27) (return 1024))
            (return 128))))
    (comment "major 6: a bignum tag only if the number is 2 or 3 (one-byte head)")
    (if (or (== ib 194) (== ib 195)) (return 2048))
    (return 64)))

(defn ^I32 head-end [^Bytes b ^I32 off ^I32 end]
  (comment "The offset after a shortest-form head at off (argument < 2^31 for"
           "lengths), or -1. Leaves the argument in the low 31 bits if it fits; -2"
           "marks an argument >= 2^31 (fine for integers, impossible as a length).")
  (if (>= off end) (return (neg 1)))
  (let [ai (bit-and (u8 b off) 31)]
    (if (< ai 24) (return (+ off 1)))
    (if (> ai 27) (return (neg 1)))
    (let [w (shl 1 (- ai 24))]
      (if (> w (- end (+ off 1))) (return (neg 1)))
      (comment "shortest form")
      (if (== ai 24) (if (< (u8 b (+ off 1)) 24) (return (neg 1))))
      (if (== ai 25) (if (== (u8 b (+ off 1)) 0) (return (neg 1))))
      (if (== ai 26) (if (== (bit-or (u8 b (+ off 1)) (u8 b (+ off 2))) 0) (return (neg 1))))
      (if (== ai 27)
        (if (== (bit-or (bit-or (u8 b (+ off 1)) (u8 b (+ off 2))) (bit-or (u8 b (+ off 3)) (u8 b (+ off 4)))) 0)
          (return (neg 1))))
      (return (+ (+ off 1) w)))))

(defn ^I32 head-len-arg [^Bytes b ^I32 off]
  (comment "The argument of a (checked) head as a length, or -1 if >= 2^31.")
  (let [ai (bit-and (u8 b off) 31)]
    (if (< ai 24) (return ai))
    (if (== ai 24) (return (u8 b (+ off 1))))
    (if (== ai 25) (return (bit-or (shl (u8 b (+ off 1)) 8) (u8 b (+ off 2)))))
    (if (== ai 26)
      (do (if (>= (u8 b (+ off 1)) 128) (return (neg 1)))
          (return (bit-or (bit-or (shl (u8 b (+ off 1)) 24) (shl (u8 b (+ off 2)) 16))
                          (bit-or (shl (u8 b (+ off 3)) 8) (u8 b (+ off 4)))))))
    (return (neg 1))))

(defn ^Bool utf8-ok [^Bytes b ^I32 s ^I32 e]
  (comment "Well-formed UTF-8 (WHATWG fatal rules).")
  (let [^:mut i s]
    (while (< i e)
      (let [c (u8 b i)]
        (if (< c 128)
          (set i (+ i 1))
          (do (if (< c 194) (return false))
              (let [^:mut n 1
                    ^:mut lo 128
                    ^:mut hi 191]
                (if (>= c 224) (set n 2))
                (if (>= c 240) (set n 3))
                (if (> c 244) (return false))
                (if (== c 224) (set lo 160))
                (if (== c 237) (set hi 159))
                (if (== c 240) (set lo 144))
                (if (== c 244) (set hi 143))
                (if (> n (- (- e i) 1)) (return false))
                (let [c1 (u8 b (+ i 1))]
                  (if (or (< c1 lo) (> c1 hi)) (return false)))
                (for [^I32 k 2 (+ n 1)]
                  (let [ck (u8 b (+ i k))]
                    (if (or (< ck 128) (> ck 191)) (return false))))
                (set i (+ i (+ n 1))))))))
    (return true)))

;; ------------------------------------------------------------ header

(defn ^Bool check-header [^IntsR p ^Bytes b ^Ints s]
  (if (or (< (ilen p) 64) (> (ilen p) 16777216)) (do (bad s 0 C_HEADER) (return false)))
  (if (> (blen b) 67108864) (do (bad s 4 C_HEADER) (return false)))
  (if (not (want s (== (ia p 0) 1735749235) 0 C_HEADER)) (return false))
  (comment "format 2.0 only: D084's major-version rule refuses 1.x (and anything else)")
  (if (not (want s (== (ia p 1) FORMAT_V2) 1 C_VERSION)) (return false))
  (if (not (want s (== (ia p 2) 64) 2 C_HEADER)) (return false))
  (if (not (want s (== (ia p 3) (ilen p)) 3 C_HEADER)) (return false))
  (if (not (want s (== (ia p 4) (blen b)) 4 C_HEADER)) (return false))
  (if (not (want s (and (>= (ia p 5) 0) (<= (ia p 5) 2)) 5 C_HEADER)) (return false))
  (for [^I32 w 15 28]
    (if (not (want s (and (>= (ia p w) 0) (<= (ia p w) (ilen p))) w C_HEADER)) (return false)))
  (if (not (want s (<= (ia p W_N_LEAVES) 1048576) W_N_LEAVES C_HEADER)) (return false))
  (if (not (want s (and (>= (ia p W_TS_ANY) (neg 1)) (< (ia p W_TS_ANY) (ia p W_N_TYPESETS))) W_TS_ANY C_HEADER))
    (return false))
  (comment "format 2.0: the arena cap (41) within its hard maximum; 29, 62 and 63 are"
           "derived (check-csets); 30, 31 and 39 are the extension table (check-exts)")
  (if (not (want s (and (>= (ia p W_LIM_GROUP) 0) (<= (ia p W_LIM_GROUP) COUNT_SAT)) W_LIM_GROUP C_HEADER))
    (return false))
  (if (not (want s (and (>= (ia p 30) 0) (<= (ia p 30) 65536)) 30 C_HEADER)) (return false))
  (comment "limits within their hard maxima")
  (if (not (want s (and (>= (ia p 32) 0) (<= (ia p 32) 256)) 32 C_HEADER)) (return false))
  (if (not (want s (>= (ia p 33) 0) 33 C_HEADER)) (return false))
  (if (not (want s (and (>= (ia p 34) 0) (<= (ia p 34) 16777216)) 34 C_HEADER)) (return false))
  (if (not (want s (and (>= (ia p 35) 0) (<= (ia p 35) 16777216)) 35 C_HEADER)) (return false))
  (if (not (want s (and (>= (ia p 36) 0) (<= (ia p 36) 4096)) 36 C_HEADER)) (return false))
  (if (not (want s (>= (ia p 37) 0) 37 C_HEADER)) (return false))
  (if (not (want s (and (>= (ia p 38) 0) (<= (ia p 38) 67108864)) 38 C_HEADER)) (return false))
  (if (not (want s (>= (ia p 40) 0) 40 C_HEADER)) (return false))
  (comment "sections: S_RULES = 64, monotone, ending at PROGRAM_WORDS (format 2.0 has"
           "no S_END word)")
  (if (not (want s (== (ia p W_SEC) 64) W_SEC C_SECTIONS)) (return false))
  (for [^I32 k 0 19]
    (if (not (want s (<= (ia p (+ W_SEC k)) (ia p (+ W_SEC (+ k 1)))) (+ W_SEC k) C_SECTIONS)) (return false)))
  (if (not (want s (<= (ia p (+ W_SEC 19)) (ilen p)) (+ W_SEC 19) C_SECTIONS)) (return false))
  (comment "fixed-width sections and index sections against the counts")
  (if (not (want s (== (- (ia p 43) (ia p 42)) (* 5 (ia p W_N_RULES))) 42 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 44) (ia p 43)) (* 8 (ia p W_N_LEAVES))) 43 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 45) (ia p 44)) (ia p W_N_TYPESETS)) 44 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 47) (ia p 46)) (* 2 (ia p W_N_KEYS))) 46 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 48) (ia p 47)) (ia p W_N_PEGS)) 47 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 50) (ia p 49)) (ia p W_N_MAPS)) 49 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 52) (ia p 51)) (ia p W_N_ARRAYS)) 51 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 54) (ia p 53)) (ia p W_N_REGEXPS)) 53 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 56) (ia p 55)) (* 6 (ia p W_N_INTERVALS))) 55 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 57) (ia p 56)) (* 4 (ia p W_N_FINTERVALS))) 56 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 58) (ia p 57)) (* 2 (ia p W_N_LITREFS))) 57 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 59) (ia p 58)) (ia p W_N_CSETS)) 58 C_SECTIONS)) (return false))
  (if (not (want s (== (- (ia p 61) (ia p 60)) (ia p W_N_CHAINS)) 60 C_SECTIONS)) (return false))
  (return true))

;; ------------------------------------------------------------ index sections

(defn ^I32 record-len [^IntsR p ^I32 kind ^I32 at ^I32 end]
  (comment "The length of the variable-length record at `at` (kind 0 typeset, 1"
           "PEG program, 2 map, 3 array, 4 regexp, 5 cset, 6 chain), or -1 if it does not"
           "fit before `end`. Every count is bounded by the room left before it is"
           "multiplied, so nothing overflows.")
  (let [room (- end at)]
    (if (< room 2) (return (neg 1)))
    (if (== kind 0)
      (do (let [tna (pw p at)
                tne (pw p (+ at 1))]
            (if (or (< tna 0) (> tna room)) (return (neg 1)))
            (if (or (< tne 0) (> tne room)) (return (neg 1)))
            (if (and (!= tne 0) (< tne (+ tna 1))) (return (neg 1)))
            (if (> (+ 2 (+ tna tne)) room) (return (neg 1)))
            (return (+ 2 (+ tna tne))))))
    (if (== kind 1)
      (do (comment "a PEG program: 9 + 5 n_nodes + n_kids (1 <= n_nodes <= 16384)")
          (if (< room PEG_HDR) (return (neg 1)))
          (let [pn (pw p (+ at 1))
                pk (pw p (+ at 2))]
            (if (or (< pn 1) (> pn 16384)) (return (neg 1)))
            (if (> pn (quot (- room PEG_HDR) 5)) (return (neg 1)))
            (if (or (< pk 0) (> pk (- (- room PEG_HDR) (* 5 pn)))) (return (neg 1)))
            (return (+ (+ PEG_HDR (* 5 pn)) pk)))))
    (if (== kind 2)
      (do (comment "a map table: 8 + 5 n_members + 3 n_named + namers (one per literal"
                   "member) + n_root")
          (if (< room 8) (return (neg 1)))
          (let [nm (pw p (+ at 1))
                nn (pw p (+ at 2))
                nr (pw p (+ at 6))
                q (quot room 5)]
            (if (or (or (< nm 0) (> nm q)) (or (< nn 0) (> nn q))) (return (neg 1)))
            (if (or (< nr 0) (> nr q)) (return (neg 1)))
            (if (> (+ 8 (* 5 nm)) room) (return (neg 1)))
            (let [^:mut nlit 0]
              (for [^I32 i 0 nm]
                (if (>= (pw p (+ (+ at 8) (* 5 i))) 0) (set nlit (+ nlit 1))))
              (let [mlen (+ (+ (+ 8 (* 5 nm)) (* 3 nn)) (+ nlit nr))]
                (if (or (< mlen 0) (> mlen room)) (return (neg 1)))
                (return mlen))))))
    (if (== kind 3)
      (do (comment "an array table: 4 + W + npos + npos W")
          (if (< room 4) (return (neg 1)))
          (let [anpos (pw p at) aw (pw p (+ at 1))]
            (if (or (< anpos 0) (> anpos 4096)) (return (neg 1)))
            (if (!= aw (sar (+ anpos 31) 5)) (return (neg 1)))
            (let [alen (+ (+ 4 aw) (+ anpos (* anpos aw)))]
              (if (> alen room) (return (neg 1)))
              (return alen)))))
    (if (== kind 4)
      (do (if (< room 4) (return (neg 1)))
          (let [rnpos (pw p at) rw (pw p (+ at 1)) natoms (pw p (+ at 2))]
            (if (or (< rnpos 0) (> rnpos 512)) (return (neg 1)))
            (if (!= rw (sar (+ rnpos 31) 5)) (return (neg 1)))
            (if (or (< natoms 1) (> natoms (quot room (+ 1 rw)))) (return (neg 1)))
            (let [rlen (+ (+ 4 (* 2 rw)) (+ (* rnpos rw) (* natoms (+ 1 rw))))]
              (if (> rlen room) (return (neg 1)))
              (return rlen)))))
    (if (== kind 5)
      (do (if (< room 3) (return (neg 1)))
          (let [cn (pw p at)]
            (if (or (< cn 0) (> cn (- room 3))) (return (neg 1)))
            (return (+ 3 cn)))))
    (let [hn (pw p at)]
      (if (or (< hn 1) (> hn (- room 2))) (return (neg 1)))
      (return (+ 2 hn)))))

(defn ^Bool check-index [^IntsR p ^Ints s ^I32 ki ^I32 kd ^I32 count ^I32 kind]
  (comment "Index section ki (count words) against the walk of data section kd.")
  (let [^:mut at (sec p kd)
        end (sec p (+ kd 1))]
    (for [^I32 i 0 count]
      (if (not (spend s 1)) (return false))
      (if (!= (pw p (+ (sec p ki) i)) at) (do (bad s (+ (sec p ki) i) C_INDEX) (return false)))
      (let [len (record-len p kind at end)]
        (if (< len 0) (do (bad s at C_INDEX) (return false)))
        (set at (+ at len))))
    (if (!= at end) (do (bad s at C_INDEX) (return false)))
    (return (not (failed s)))))

(defn ^I32 rec [^IntsR p ^I32 ki ^I32 id]
  (comment "The word offset of record id of the variable section whose index is ki.")
  (return (pw p (+ (sec p ki) id))))

;; ------------------------------------------------------------ typesets

(defn ^I32 leaf-at [^IntsR p ^I32 l] (return (+ (sec p 1) (* 8 l))))
(defn ^I32 leaf-kind [^IntsR p ^I32 l] (return (bit-and (pw p (leaf-at p l)) 255)))
(defn ^Bool combinator [^IntsR p ^I32 l]
  (let [k (leaf-kind p l)]
    (return (or (== k 16) (== k 17)))))

(defn ^Bool check-typesets [^IntsR p ^Ints s]
  (let [nt (pw p W_N_TYPESETS)
        nl (pw p W_N_LEAVES)]
    (for [^I32 t 0 nt]
      (let [o (rec p 2 t)
            na (pw p o)
            ne (pw p (+ o 1))]
        (if (not (spend s (+ 1 (+ na ne)))) (return false))
        (comment "answers valid and strictly ascending")
        (for [^I32 i 0 na]
          (let [a (pw p (+ o (+ 2 i)))]
            (if (not (in-range a nl)) (do (bad s (+ o (+ 2 i)) C_TYPESET) (return false)))
            (if (and (> i 0) (<= a (pw p (+ o (+ 1 i))))) (do (bad s (+ o (+ 2 i)) C_TYPESET) (return false)))
            (if (and (== ne 0) (combinator p a)) (do (bad s (+ o (+ 2 i)) C_TYPESET) (return false)))
            (comment "D141: an EXT leaf only ever answers through a combinator")
            (if (== (leaf-kind p a) 18) (do (bad s (+ o (+ 2 i)) C_TYPESET) (return false)))))
        (if (> ne 0)
          (do (comment "each answer once as itself, nothing twice, operands earlier")
              (let [e (epoch s)
                    eo (+ o (+ 2 na))]
                (for [^I32 j 0 na]
                  (aux-set s (pw p (+ o (+ 2 j))) e))
                (let [^:mut seen-ans 0]
                  (for [^I32 k 0 ne]
                    (let [x (pw p (+ eo k))
                          ^:mut l x
                          is-dep (< x 0)]
                      (if is-dep (set l (bit-not x)))
                      (if (not (in-range l nl)) (do (bad s (+ eo k) C_TYPESET) (return false)))
                      (if (== (mark-get s l) e) (do (bad s (+ eo k) C_TYPESET) (return false)))
                      (if (and is-dep (== (aux-get s l) e)) (do (bad s (+ eo k) C_TYPESET) (return false)))
                      (if (and (not is-dep) (!= (aux-get s l) e)) (do (bad s (+ eo k) C_TYPESET) (return false)))
                      (if (not is-dep) (set seen-ans (+ seen-ans 1)))
                      (if (combinator p l)
                        (do (let [la (leaf-at p l)
                                  a1 (pw p (+ la 2))
                                  a2 (pw p (+ la 3))]
                              (if (or (not (in-range a1 nl)) (not (in-range a2 nl)))
                                (do (bad s la C_TYPESET) (return false)))
                              (if (or (!= (mark-get s a1) e) (!= (mark-get s a2) e))
                                (do (bad s (+ eo k) C_TYPESET) (return false))))))
                      (mark-set s l e)))
                  (if (!= seen-ans na) (do (bad s eo C_TYPESET) (return false)))))))))
    (comment "TS_ANY is {ANY}")
    (let [ta (pw p W_TS_ANY)]
      (if (>= ta 0)
        (do (let [o2 (rec p 2 ta)]
              (if (or (!= (pw p o2) 1) (!= (pw p (+ o2 1)) 0)) (do (bad s o2 C_TYPESET) (return false)))
              (let [al (pw p (+ o2 2))]
                (if (or (not (in-range al nl)) (!= (leaf-kind p al) 1)) (do (bad s o2 C_TYPESET) (return false))))))))
    (return (not (failed s)))))

(defn ^I32 ts-eval-n [^IntsR p ^I32 t]
  (comment "Length of typeset t's evaluation list (the answers when n_eval = 0).")
  (let [o (rec p 2 t)
        ne (pw p (+ o 1))]
    (if (> ne 0) (return ne))
    (return (pw p o))))

(defn ^I32 ts-eval-at [^IntsR p ^I32 t ^I32 i]
  (comment "Leaf i of typeset t's evaluation list (dependencies as their leaf id).")
  (let [o (rec p 2 t)
        na (pw p o)
        ne (pw p (+ o 1))]
    (if (> ne 0)
      (do (let [x (pw p (+ o (+ 2 (+ na i))))]
            (if (< x 0) (return (bit-not x)))
            (return x))))
    (return (pw p (+ o (+ 2 i))))))

;; ------------------------------------------------------------ intervals

(defn ^Bool bound-ok [^IntsR p ^Bytes b ^I32 o]
  (comment "A bound (region, a, b) at word o: region 0..5; infinities are 0, 0; a"
           "big magnitude is a pool range of length >= 9 without a leading zero.")
  (let [r (pw p o)
        a (pw p (+ o 1))
        c (pw p (+ o 2))]
    (if (or (< r 0) (> r 5)) (return false))
    (if (or (== r 0) (== r 5)) (return (and (== a 0) (== c 0))))
    (if (or (== r 1) (== r 4))
      (return (and (and (byte-range b a c) (>= c 9)) (and (<= c 4096) (!= (u8 b a) 0)))))
    (return true)))

(defn ^I32 u64-cmp [^I32 ahi ^I32 alo ^I32 bhi ^I32 blo]
  (if (!= ahi bhi) (do (if (ult ahi bhi) (return (neg 1))) (return 1)))
  (if (!= alo blo) (do (if (ult alo blo) (return (neg 1))) (return 1)))
  (return 0))

(defn ^I32 mag-cmp [^Bytes b ^I32 o1 ^I32 l1 ^I32 o2 ^I32 l2]
  (if (!= l1 l2) (return (- l1 l2)))
  (return (bytes-cmp b o1 l1 o2 l2)))

(defn ^I32 bcmp [^IntsR p ^Bytes b ^I32 x ^I32 y]
  (comment "Compare the (valid) bounds at words x and y.")
  (let [rx (pw p x)
        ry (pw p y)]
    (if (!= rx ry) (do (if (< rx ry) (return (neg 1))) (return 1)))
    (if (== rx 3) (return (u64-cmp (pw p (+ x 1)) (pw p (+ x 2)) (pw p (+ y 1)) (pw p (+ y 2)))))
    (if (== rx 2) (return (u64-cmp (pw p (+ y 1)) (pw p (+ y 2)) (pw p (+ x 1)) (pw p (+ x 2)))))
    (if (== rx 4) (return (mag-cmp b (pw p (+ x 1)) (pw p (+ x 2)) (pw p (+ y 1)) (pw p (+ y 2)))))
    (if (== rx 1) (return (mag-cmp b (pw p (+ y 1)) (pw p (+ y 2)) (pw p (+ x 1)) (pw p (+ x 2)))))
    (return 0)))

(defn ^Bool mag-succ [^Bytes b ^I32 vo ^I32 vl ^I32 wo ^I32 wl]
  (comment "Is magnitude w = magnitude v + 1?")
  (if (== wl (+ vl 1))
    (do (if (!= (u8 b wo) 1) (return false))
        (for [^I32 k 0 vl]
          (if (or (!= (u8 b (+ vo k)) 255) (!= (u8 b (+ wo (+ k 1))) 0)) (return false)))
        (return true)))
  (if (!= wl vl) (return false))
  (let [^:mut i (- vl 1)]
    (while (and (>= i 0) (and (== (u8 b (+ vo i)) 255) (== (u8 b (+ wo i)) 0)))
      (set i (- i 1)))
    (if (< i 0) (return false))
    (if (!= (+ (u8 b (+ vo i)) 1) (u8 b (+ wo i))) (return false))
    (for [^I32 j 0 i]
      (if (!= (u8 b (+ vo j)) (u8 b (+ wo j))) (return false)))
    (return true)))

(defn ^Bool is-succ [^IntsR p ^Bytes b ^I32 x ^I32 y]
  (comment "Is the bound at y exactly one more than the (finite) bound at x?")
  (let [rx (pw p x)
        ax (pw p (+ x 1))
        cx (pw p (+ x 2))
        ry (pw p y)
        ay (pw p (+ y 1))
        cy (pw p (+ y 2))]
    (if (and (== rx 3) (== ry 3))
      (do (let [lo (add32 cx 1)
                ^:mut hi ax]
            (if (== cx (neg 1)) (set hi (add32 ax 1)))
            (if (== cx (neg 1)) (if (== ax (neg 1)) (return false)))
            (return (and (== ay hi) (== cy (bit-or lo 0)))))))
    (if (and (== rx 3) (== ry 4))
      (return (and (and (== ax (neg 1)) (== cx (neg 1))) (and (== cy 9) (and (== (u8 b ay) 1) (and (== (bit-or (u8 b (+ ay 1)) (u8 b (+ ay 2))) 0) (and (== (bit-or (u8 b (+ ay 3)) (u8 b (+ ay 4))) 0) (and (== (bit-or (u8 b (+ ay 5)) (u8 b (+ ay 6))) 0) (== (bit-or (u8 b (+ ay 7)) (u8 b (+ ay 8))) 0)))))))))
    (if (and (== rx 2) (== ry 3)) (return (and (and (== ax 0) (== cx 0)) (and (== ay 0) (== cy 0)))))
    (if (and (== rx 2) (== ry 2))
      (do (comment "value + 1 means n - 1")
          (if (and (== ax 0) (== cx 0)) (return false))
          (let [lo2 (sub32 cx 1)
                ^:mut hi2 ax]
            (if (== cx 0) (set hi2 (sub32 ax 1)))
            (return (and (== ay hi2) (== cy lo2))))))
    (if (and (== rx 1) (== ry 2))
      (return (and (and (== ay (neg 1)) (== cy (neg 1))) (and (== cx 9) (and (== (u8 b ax) 1) (and (== (bit-or (u8 b (+ ax 1)) (u8 b (+ ax 2))) 0) (and (== (bit-or (u8 b (+ ax 3)) (u8 b (+ ax 4))) 0) (and (== (bit-or (u8 b (+ ax 5)) (u8 b (+ ax 6))) 0) (== (bit-or (u8 b (+ ax 7)) (u8 b (+ ax 8))) 0)))))))))
    (if (and (== rx 1) (== ry 1)) (return (mag-succ b ay cy ax cx)))
    (if (and (== rx 4) (== ry 4)) (return (mag-succ b ax cx ay cy)))
    (return false)))

(defn ^Bool check-iv-records [^IntsR p ^Bytes b ^Ints s]
  (let [base (sec p 13)
        n (pw p W_N_INTERVALS)]
    (for [^I32 i 0 n]
      (let [o (+ base (* 6 i))]
        (if (not (spend s 4)) (return false))
        (if (or (not (bound-ok p b o)) (not (bound-ok p b (+ o 3)))) (do (bad s o C_INTERVAL) (return false)))
        (if (> (bcmp p b o (+ o 3)) 0) (do (bad s o C_INTERVAL) (return false)))))
    (let [fb (sec p 14)
          nf (pw p W_N_FINTERVALS)]
      (for [^I32 j 0 nf]
        (let [fo (+ fb (* 4 j))]
          (if (> (u64-cmp (pw p fo) (pw p (+ fo 1)) (pw p (+ fo 2)) (pw p (+ fo 3))) 0)
            (do (bad s fo C_FINTERVAL) (return false))))))
    (return (not (failed s)))))

(defn ^Bool iv-run-ok [^IntsR p ^Bytes b ^Ints s ^I32 first ^I32 n]
  (comment "A leaf's interval run: in range, ascending, disjoint, non-adjacent.")
  (if (or (< first 0) (or (< n 0) (> n (- (pw p W_N_INTERVALS) first)))) (return false))
  (let [base (sec p 13)]
    (for [^I32 i 1 n]
      (let [pv (+ base (* 6 (+ first (- i 1))))
            cu (+ base (* 6 (+ first i)))]
        (if (not (spend s 2)) (return false))
        (if (<= (bcmp p b cu (+ pv 3)) 0) (return false))
        (if (== (pw p (+ pv 3)) 5) (return false))
        (if (is-succ p b (+ pv 3) cu) (return false))))
    (return true)))

(defn ^Bool fiv-run-ok [^IntsR p ^I32 first ^I32 n]
  (if (or (< first 0) (or (< n 0) (> n (- (pw p W_N_FINTERVALS) first)))) (return false))
  (let [base (sec p 14)]
    (for [^I32 i 1 n]
      (let [pv (+ base (* 4 (+ first (- i 1))))
            cu (+ base (* 4 (+ first i)))
            ph (pw p (+ pv 2))
            pl (pw p (+ pv 3))
            nl (add32 pl 1)
            ^:mut nh ph]
        (if (== pl (neg 1)) (set nh (add32 ph 1)))
        (if (and (== ph (neg 1)) (== pl (neg 1))) (return false))
        (if (<= (u64-cmp (pw p cu) (pw p (+ cu 1)) ph pl) 0) (return false))
        (if (and (== (pw p cu) (bit-or nh 0)) (== (pw p (+ cu 1)) (bit-or nl 0))) (return false))))
    (return true)))

;; ------------------------------------------------------------ leaves

(defn ^I32 iv-mask [^IntsR p ^I32 first ^I32 n ^I32 bigok]
  (comment "The INT class mask of a (checked) interval run.")
  (let [base (sec p 13)
        ^:mut m 0]
    (for [^I32 i 0 n]
      (let [o (+ base (* 6 (+ first i)))
            lr (pw p o)
            hr (pw p (+ o 3))]
        (if (and (<= lr 3) (>= hr 3)) (set m (bit-or m 1)))
        (if (and (<= lr 2) (>= hr 2)) (set m (bit-or m 2)))
        (if (!= bigok 0)
          (if (or (and (<= lr 1) (>= hr 1)) (and (<= lr 4) (>= hr 4))) (set m (bit-or m 2048))))))
    (return m)))

(defn ^Bool zero-from [^IntsR p ^I32 o ^I32 k]
  (comment "Are leaf words d_k .. d5 (o + 2 + k .. o + 7) all zero?")
  (for [^I32 i (+ 2 k) 8]
    (if (!= (pw p (+ o i)) 0) (return false)))
  (return true))

(defn ^I32 leaf-mask-of [^IntsR p ^Bytes b ^I32 l]
  (comment "The derived mask of leaf l (fields already checked), -1 if invalid.")
  (let [o (leaf-at p l)
        k (bit-and (pw p o) 255)
        fl (bit-and (sar (pw p o) 8) 255)
        d0 (pw p (+ o 2))
        d1 (pw p (+ o 3))]
    (if (== k 1) (return 4095))
    (if (== k 2)
      (do (if (== d0 6) (return 2112))
          (if (== d0 7) (return 1920))
          (return (shl 1 d0))))
    (if (== k 3) (return (iv-mask p d0 d1 fl)))
    (if (== k 4) (return (shl fl 8)))
    (if (== k 5) (return 128))
    (if (== k 6) (return (enc-class b d0)))
    (if (== k 7)
      (do (let [lr (+ (sec p 15) (* 2 d0))]
            (return (enc-class b (pw p lr))))))
    (if (== k 8) (return 8))
    (if (or (== k 9) (== k 13)) (return 4))
    (if (== k 10) (return 1))
    (if (== k 11)
      (do (if (and (== d0 0) (or (== d1 2) (== d1 3))) (return 2048))
          (return 64)))
    (if (== k 12)
      (do (let [lohi d0 lolo d1 hihi (pw p (+ o 4)) hilo (pw p (+ o 5))
                ^:mut m 0]
            (if (or (or (!= lohi 0) (!= hihi 0)) (or (ult lolo 2) (ult 3 hilo))) (set m (bit-or m 64)))
            (if (and (and (== lohi 0) (ult lolo 4)) (or (!= hihi 0) (not (ult hilo 2)))) (set m (bit-or m 2048)))
            (return m))))
    (if (== k 14) (return 16))
    (if (== k 15) (return 32))
    (if (== k 18) (return 4095))
    (return 0)))

(defn ^Bool check-leaf [^IntsR p ^Bytes b ^Ints s ^I32 l]
  (let [o (leaf-at p l)
        w0 (pw p o)
        k (bit-and w0 255)
        fl (bit-and (sar w0 8) 255)
        d0 (pw p (+ o 2))
        d1 (pw p (+ o 3))
        d2 (pw p (+ o 4))
        d3 (pw p (+ o 5))
        d4 (pw p (+ o 6))
        nl (pw p W_N_LEAVES)
        nt (pw p W_N_TYPESETS)]
    (if (not (spend s 8)) (return false))
    (if (or (or (< k 1) (> k 18)) (!= (sar w0 16) 0)) (return (want s false o C_LEAF)))
    (if (!= (pw p (+ o 7)) 0) (return (want s false o C_LEAF)))
    (if (and (and (!= k 3) (!= k 4)) (and (!= k 13) (!= fl 0))) (return (want s false o C_LEAF)))
    (if (== k 1) (return (want s (zero-from p o 0) o C_LEAF)))
    (if (== k 2) (return (want s (and (and (>= d0 0) (<= d0 7)) (zero-from p o 1)) o C_LEAF)))
    (if (== k 3)
      (do (let [run-ok (iv-run-ok p b s d0 d1)]
            (return (want s (and (and (<= fl 1) (>= d1 1)) (and run-ok (zero-from p o 2))) o C_LEAF)))))
    (if (== k 4)
      (do (if (or (< fl 1) (> fl 7)) (return (want s false o C_LEAF)))
          (if (== d1 0) (return (want s (zero-from p o 0) o C_LEAF)))
          (return (want s (and (fiv-run-ok p d0 d1) (zero-from p o 2)) o C_LEAF))))
    (if (== k 5) (return (want s (and (or (and (>= d0 0) (<= d0 23)) (and (>= d0 32) (<= d0 255))) (zero-from p o 1)) o C_LEAF)))
    (if (== k 6) (return (want s (and (and (byte-range b d0 d1) (>= d1 1)) (zero-from p o 2)) o C_LEAF)))
    (if (== k 7)
      (do (if (or (or (< d0 0) (< d1 2)) (> d1 (- (pw p W_N_LITREFS) d0))) (return (want s false o C_LEAF)))
          (if (not (zero-from p o 2)) (return (want s false o C_LEAF)))
          (let [lb (sec p 15)
                ^:mut cls 0]
            (for [^I32 i 0 d1]
              (let [mo (pw p (+ lb (* 2 (+ d0 i))))
                    ml (pw p (+ lb (+ (* 2 (+ d0 i)) 1)))]
                (if (or (not (byte-range b mo ml)) (< ml 1)) (return (want s false o C_LITREF)))
                (if (== i 0) (set cls (enc-class b mo)))
                (if (!= (enc-class b mo) cls) (return (want s false o C_LITREF)))
                (if (> i 0)
                  (do (let [po (pw p (+ lb (* 2 (+ d0 (- i 1)))))
                            pl (pw p (+ lb (+ (* 2 (+ d0 (- i 1))) 1)))]
                        (if (>= (bytes-cmp b po pl mo ml) 0) (return (want s false o C_LITREF))))))))
            (return true))))
    (if (== k 8)
      (return (want s (and (and (and (>= d0 0) (>= d1 d0)) (and (>= d2 (neg 1)) (< d2 (pw p W_N_REGEXPS))))
                           (zero-from p o 3)) o C_LEAF)))
    (if (== k 9)
      (do (if (or (< d0 0) (< d1 d0)) (return (want s false o C_LEAF)))
          (if (== d3 0) (return (want s (zero-from p o 2) o C_LEAF)))
          (return (want s (and (byte-range b d2 d3) (zero-from p o 4)) o C_LEAF))))
    (if (== k 10)
      (do (if (== d3 0) (return (want s (and (== d2 0) (zero-from p o 4)) o C_LEAF)))
          (let [run-ok2 (iv-run-ok p b s d2 d3)]
            (return (want s (and run-ok2 (zero-from p o 4)) o C_LEAF)))))
    (if (== k 11) (return (want s (and (in-range d2 nt) (zero-from p o 3)) o C_LEAF)))
    (if (== k 12)
      (return (want s (and (<= (u64-cmp d0 d1 d2 d3) 0) (and (in-range d4 nt) (zero-from p o 5))) o C_LEAF)))
    (if (== k 13) (return (want s (and (<= fl 1) (and (in-range d0 nt) (zero-from p o 1))) o C_LEAF)))
    (if (== k 14) (return (want s (and (in-range d0 (pw p W_N_ARRAYS)) (zero-from p o 1)) o C_LEAF)))
    (if (== k 15) (return (want s (and (in-range d0 (pw p W_N_MAPS)) (zero-from p o 1)) o C_LEAF)))
    (if (== k 16) (return (want s (and (and (in-range d0 nl) (in-range d1 nl)) (zero-from p o 2)) o C_LEAF)))
    (if (== k 18)
      (do (comment "EXT (D140): control id, argument bytes (at least one), maximum item bytes")
          (return (want s (and (and (in-range d0 (pw p W_N_EXTS)) (and (byte-range b d1 d2) (>= d2 1)))
                               (and (>= d3 0) (zero-from p o 4))) o C_LEAF))))
    (if (and (in-range d0 nl) (in-range d1 nl))
      (return (want s (and (== (leaf-kind p d1) 6) (zero-from p o 2)) o C_LEAF)))
    (return (want s false o C_LEAF))))

(defn ^Bool check-leaves [^IntsR p ^Bytes b ^Ints s]
  (let [nl (pw p W_N_LEAVES)]
    (for [^I32 l 0 nl]
      (if (not (check-leaf p b s l)) (return false)))
    (comment "masks, derived (AND/NOT need their operands' masks: computed in a second pass)")
    (for [^I32 l2 0 nl]
      (let [o (leaf-at p l2)
            k (bit-and (pw p o) 255)]
        (if (and (!= k 16) (!= k 17))
          (if (!= (pw p (+ o 1)) (leaf-mask-of p b l2)) (return (want s false (+ o 1) C_MASK))))))
    (for [^I32 l3 0 nl]
      (let [o3 (leaf-at p l3)
            k3 (bit-and (pw p o3) 255)]
        (if (or (== k3 16) (== k3 17))
          (do (comment "AND: mask(a) & mask(b), NOT: mask(target), over the operands' stored"
                       "masks (each verified in turn, so the whole set is consistent).")
              (let [ma (pw p (+ (leaf-at p (pw p (+ o3 2))) 1))
                    mb (pw p (+ (leaf-at p (pw p (+ o3 3))) 1))
                    ^:mut m ma]
                (if (== k3 16) (set m (bit-and ma mb)))
                (if (!= (pw p (+ o3 1)) m) (return (want s false (+ o3 1) C_MASK))))))))
    (return (not (failed s)))))

;; ------------------------------------------------------------ keys, rules, groups

(defn ^Bool check-keys [^IntsR p ^Bytes b ^Ints s]
  (let [base (sec p 4)
        n (pw p W_N_KEYS)]
    (for [^I32 i 0 n]
      (let [o (+ base (* 2 i))
            off (pw p o)
            len (pw p (+ o 1))]
        (if (not (spend s (+ 2 (quot len 8)))) (return false))
        (if (or (not (byte-range b off len)) (< len 1)) (return (want s false o C_KEY)))
        (let [m (ushr (u8 b off) 5)
              he (head-end b off (+ off len))]
          (if (< he 0) (return (want s false o C_KEY)))
          (if (<= m 1)
            (if (!= he (+ off len)) (return (want s false o C_KEY)))
            (do (if (!= m 3) (return (want s false o C_KEY)))
                (let [cl (head-len-arg b off)]
                  (if (or (< cl 0) (!= (+ he cl) (+ off len))) (return (want s false o C_KEY)))
                  (if (not (utf8-ok b he (+ off len))) (return (want s false o C_UTF8)))))))
        (if (> i 0)
          (if (>= (bytes-cmp b (pw p (- o 2)) (pw p (- o 1)) off len) 0) (return (want s false o C_KEY))))))
    (return (not (failed s)))))

(defn ^Bool check-rules [^IntsR p ^Bytes b ^Ints s]
  (let [base (sec p 0)
        n (pw p W_N_RULES)]
    (for [^I32 i 0 n]
      (let [o (+ base (* 5 i))
            off (pw p o)
            len (pw p (+ o 1))]
        (if (not (spend s (+ 2 (quot len 8)))) (return false))
        (if (or (not (byte-range b off len)) (< len 1)) (return (want s false o C_RULE)))
        (if (not (utf8-ok b off (+ off len))) (return (want s false o C_UTF8)))
        (if (> i 0)
          (if (>= (bytes-cmp b (pw p (- o 5)) (pw p (- o 4)) off len) 0) (return (want s false o C_RULE))))
        (if (not (in-range (pw p (+ o 2)) (pw p W_N_TYPESETS))) (return (want s false o C_RULE)))
        (if (not (in-range (pw p (+ o 3)) (pw p W_N_CHAINS))) (return (want s false o C_RULE)))))
    (return (not (failed s)))))

;; ------------------------------------------------------------ PEG programs (format 2.0)
;; program-2 §3: kind n_nodes n_kids tier B memo depth flags n_calls, nodes x 5
;; (op a b c d), kids. Working arrays live in the scratch after the marks
;; (TEMP, sized by vm-verify-words): per node nullable, ml, FL, height,
;; reference count / DFS colour, DFS cursor, DFS stack; then 2W words of
;; first / last per node plus an accumulator, then npos x W follow rows.

(defn ^I32 tb [^IntsR s] (return (+ MARKS (* 2 (ia s VM_MARK_CAP)))))
(defn ^I32 tg [^IntsR s ^I32 i] (return (ia s (+ (tb s) i))))
(defn tset [^Ints s ^I32 i ^I32 v] (iset s (+ (tb s) i) v))

(defn ^I32 sadd [^I32 a ^I32 b]
  (if (or (== a INF) (== b INF)) (return INF))
  (if (> a (- INF b)) (return INF))
  (return (+ a b)))

(defn ^I32 smul [^I32 a ^I32 b]
  (if (or (== a 0) (== b 0)) (return 0))
  (if (or (== a INF) (== b INF)) (return INF))
  (if (> a (quot INF b)) (return INF))
  (return (* a b)))

(defn ^I32 imax [^I32 a ^I32 b]
  (if (> a b) (return a))
  (return b))

(defn ^Bool more-budget [^Ints s ^I32 units]
  (comment "Raise the verify budget by units (saturating) before a fixed point.")
  (iset s V_BUDGET (sadd (ia s V_BUDGET) units))
  (return true))

(defn ^I32 peg-at [^IntsR p ^I32 g] (return (rec p 5 g)))
(defn ^I32 pnw [^IntsR p ^I32 o ^I32 i ^I32 w] (return (pw p (+ (+ o PEG_HDR) (+ (* 5 i) w)))))
(defn ^I32 pkid [^IntsR p ^I32 o ^I32 i ^I32 j]
  (comment "Kid j of SEQ / CHOICE node i of the program at o.")
  (return (pw p (+ (+ (+ o PEG_HDR) (* 5 (pw p (+ o 1)))) (+ (pnw p o i 1) j)))))

(defn ^Bool counts-ok [^I32 lo ^I32 hi]
  (comment "program-2 §3 Counts: 0 <= min <= 2^24, 1 <= max, max INF or below 2^24,"
           "min <= max.")
  (if (or (< lo 0) (> lo COUNT_SAT)) (return false))
  (if (< hi 1) (return false))
  (if (and (!= hi INF) (>= hi COUNT_SAT)) (return false))
  (return (<= lo hi)))

(defn ^I32 peg-count [^IntsR p ^I32 o ^I32 op]
  (comment "Nodes of the program at o with this op.")
  (let [^:mut c 0]
    (for [^I32 i 0 (pw p (+ o 1))]
      (if (== (pnw p o i 0) op) (set c (+ c 1))))
    (return c)))

(defn ^Bool peg-nullable [^IntsR p ^Ints s ^I32 o ^I32 n ^I32 calls]
  (comment "nullable as a least fixed point (TEMP[0, n)): rounds in reverse id order"
           "until nothing changes; one round without CALLs.")
  (for [^I32 z 0 n] (tset s z 0))
  (forever
   (let [^:mut changed false]
     (if (not (spend s n)) (return false))
     (let [^:mut i (- n 1)]
       (while (>= i 0)
         (let [op (pnw p o i 0)
               ^:mut nu 0]
           (if (== op P_EMPTY) (set nu 1))
           (if (and (== op P_MEMBER) (== (pnw p o i 2) 0)) (set nu 1))
           (if (== op P_CALL) (set nu (tg s (pnw p o i 1))))
           (if (== op P_REP)
             (if (or (== (pnw p o i 2) 0) (!= (tg s (pnw p o i 1)) 0)) (set nu 1)))
           (if (== op P_CHOICE)
             (for [^I32 j 0 (pnw p o i 2)]
               (if (!= (tg s (pkid p o i j)) 0) (set nu 1))))
           (if (== op P_SEQ)
             (do (set nu 1)
                 (for [^I32 j2 0 (pnw p o i 2)]
                   (if (== (tg s (pkid p o i j2)) 0) (set nu 0)))))
           (if (and (!= nu 0) (== (tg s i) 0))
             (do (tset s i 1) (set changed true))))
         (set i (- i 1))))
     (if (or (not changed) (== calls 0)) (return true)))))

(defn ^I32 left-edge [^IntsR p ^IntsR s ^I32 o ^I32 u ^I32 j]
  (comment "Edge j of node u in the left graph (program-2 §5.3), or -1.")
  (let [op (pnw p o u 0)]
    (if (== op P_SEQ)
      (do (if (>= j (pnw p o u 2)) (return (neg 1)))
          (if (and (> j 0) (== (tg s (pkid p o u (- j 1))) 0)) (return (neg 1)))
          (return (pkid p o u j))))
    (if (== op P_CHOICE)
      (do (if (>= j (pnw p o u 2)) (return (neg 1)))
          (return (pkid p o u j))))
    (if (and (or (== op P_REP) (== op P_CALL)) (== j 0)) (return (pnw p o u 1)))
    (return (neg 1))))

(defn ^Bool no-left-recursion [^IntsR p ^Ints s ^I32 o ^I32 n]
  (comment "No cycle in the left graph (CALL cycles reachable through nullable"
           "prefixes): iterative DFS, colours TEMP[4n..), cursors TEMP[5n..), stack"
           "TEMP[6n..). Needs the nullable words.")
  (for [^I32 z 0 n] (tset s (+ (* 4 n) z) 0))
  (for [^I32 st 0 n]
    (if (== (tg s (+ (* 4 n) st)) 0)
      (do (let [^:mut sp 1]
            (tset s (* 6 n) st)
            (tset s (+ (* 4 n) st) 1)
            (tset s (+ (* 5 n) st) 0)
            (while (> sp 0)
              (if (not (spend s 1)) (return false))
              (let [u (tg s (+ (* 6 n) (- sp 1)))
                    j (tg s (+ (* 5 n) u))
                    v (left-edge p s o u j)]
                (if (< v 0)
                  (do (tset s (+ (* 4 n) u) 2)
                      (set sp (- sp 1)))
                  (do (tset s (+ (* 5 n) u) (+ j 1))
                      (if (== (tg s (+ (* 4 n) v)) 1) (return false))
                      (if (== (tg s (+ (* 4 n) v)) 0)
                        (do (if (>= sp n) (return false))
                            (tset s (+ (* 4 n) v) 1)
                            (tset s (+ (* 5 n) v) 0)
                            (tset s (+ (* 6 n) sp) v)
                            (set sp (+ sp 1))))))))))))
  (return true))

(defn ^Bool check-peg [^IntsR p ^Ints s ^I32 g]
  (comment "One program: node fields and counts, a tree through kids and REP children"
           "(each non-root node referenced once, by a smaller id), positions and"
           "members numbered in node order, the map normal form (no foldable REP of"
           "a MEMBER, §3.3), no left recursion, and the derived fields: n_calls,"
           "flags bit 0, depth, B and the array tier (map tiers: check-map).")
  (let [o (peg-at p g)
        kind (pw p o)
        n (pw p (+ o 1))
        nk (pw p (+ o 2))
        ^:mut npos 0
        ^:mut nmem 0
        ^:mut calls 0
        ^:mut sumk 0]
    (if (not (spend s (+ (* 5 n) nk))) (return false))
    (if (or (< kind 0) (> kind 1)) (return (want s false o C_PEG)))
    (if (!= (pw p (+ o 5)) 0) (return (want s false (+ o 5) C_PEG)))
    (for [^I32 z 0 n] (tset s (+ (* 4 n) z) 0))
    (for [^I32 i 0 n]
      (let [at (+ (+ o PEG_HDR) (* 5 i))
            op (pw p at)
            a (pw p (+ at 1))
            b (pw p (+ at 2))
            c (pw p (+ at 3))]
        (if (!= (pw p (+ at 4)) (neg 1)) (return (want s false at C_PEG)))
        (if (or (< op 0) (> op 7)) (return (want s false at C_PEG)))
        (if (== op P_EMPTY)
          (if (or (!= a 0) (or (!= b 0) (!= c 0))) (return (want s false at C_PEG))))
        (if (== op P_FAIL)
          (if (or (!= a 0) (or (< b (neg 1)) (!= c 0))) (return (want s false at C_PEG))))
        (if (== op P_ENTRY)
          (do (if (or (!= kind 0) (or (!= a npos) (or (!= b 0) (!= c 0)))) (return (want s false at C_PEG)))
              (set npos (+ npos 1))))
        (if (== op P_MEMBER)
          (do (if (or (!= kind 1) (or (!= a nmem) (not (counts-ok b c)))) (return (want s false at C_PEG)))
              (set nmem (+ nmem 1))))
        (if (or (== op P_SEQ) (== op P_CHOICE))
          (do (if (or (or (!= c 0) (< b 2)) (or (< a 0) (> a (- nk b)))) (return (want s false at C_PEG)))
              (set sumk (+ sumk b))
              (for [^I32 j 0 b]
                (let [k (pkid p o i j)]
                  (if (or (not (in-range k n)) (<= k i)) (return (want s false at C_PEG)))
                  (tset s (+ (* 4 n) k) (+ (tg s (+ (* 4 n) k)) 1))))))
        (if (== op P_REP)
          (do (if (or (not (counts-ok b c)) (or (not (in-range a n)) (<= a i))) (return (want s false at C_PEG)))
              (tset s (+ (* 4 n) a) (+ (tg s (+ (* 4 n) a)) 1))
              (if (and (== kind 1) (== (pnw p o a 0) P_MEMBER))
                (do (comment "the fold table leaves no REP of a MEMBER(1, 1) or MEMBER(k, INF)"
                             "it would rewrite")
                    (let [mk (pnw p o a 2)
                          mm (pnw p o a 3)]
                      (if (and (== mk 1) (== mm 1)) (return (want s false at C_PEG)))
                      (if (and (== mm INF) (or (== mk 0) (or (and (== mk 1) (<= b 1)) (and (>= mk 1) (>= b 2)))))
                        (return (want s false at C_PEG))))))))
        (if (== op P_CALL)
          (do (if (or (or (!= b 0) (!= c 0)) (not (in-range a n))) (return (want s false at C_PEG)))
              (set calls (+ calls 1))))))
    (if (!= sumk nk) (return (want s false (+ o 2) C_PEG)))
    (for [^I32 i2 1 n]
      (if (!= (tg s (+ (* 4 n) i2)) 1) (return (want s false (+ (+ o PEG_HDR) (* 5 i2)) C_PEG))))
    (comment "derived: n_calls, flags (arrays: bit 0 only; maps: bits 1-2 by check-map)")
    (if (!= (pw p (+ o 8)) calls) (return (want s false (+ o 8) C_DERIVED)))
    (let [fl (pw p (+ o 7))
          ^:mut rbit 0]
      (if (> calls 0) (set rbit 1))
      (if (!= (bit-and fl 1) rbit) (return (want s false (+ o 7) C_DERIVED)))
      (if (and (== kind 0) (!= fl rbit)) (return (want s false (+ o 7) C_DERIVED)))
      (if (and (== kind 1) (!= (bit-and fl (bit-not 7)) 0)) (return (want s false (+ o 7) C_DERIVED))))
    (comment "lengths (TEMP: ml at n.., FL at 2n.., height at 3n..), B, depth")
    (let [^:mut bmax 0]
      (if (not (spend s (* 2 n))) (return false))
      (let [^:mut i3 (- n 1)]
        (while (>= i3 0)
          (let [op3 (pnw p o i3 0)
                ^:mut ml 0
                ^:mut flv 0
                ^:mut ht 1]
            (if (== op3 P_EMPTY) (set flv (neg 1)))
            (if (or (== op3 P_ENTRY) (== op3 P_MEMBER)) (set ml 1))
            (if (and (== op3 P_MEMBER) (== (pnw p o i3 2) 0)) (set flv (neg 1)))
            (if (== op3 P_CALL) (do (set ml INF) (set flv INF)))
            (if (== op3 P_SEQ)
              (do (let [^:mut pre 0]
                    (set flv (neg 1))
                    (for [^I32 j3 0 (pnw p o i3 2)]
                      (let [k3 (pkid p o i3 j3)
                            kfl (tg s (+ (* 2 n) k3))]
                        (if (!= kfl (neg 1)) (set flv (imax flv (sadd pre kfl))))
                        (set pre (sadd pre (tg s (+ n k3))))
                        (set ht (imax ht (+ 1 (tg s (+ (* 3 n) k3)))))))
                    (set ml pre))))
            (if (== op3 P_CHOICE)
              (do (let [kc (pnw p o i3 2)
                        ^:mut nofail false]
                    (for [^I32 j4 0 kc]
                      (let [k4 (pkid p o i3 j4)
                            kfl4 (tg s (+ (* 2 n) k4))]
                        (set ml (imax ml (tg s (+ n k4))))
                        (if (== kfl4 (neg 1)) (set nofail true) (set flv (imax flv kfl4)))
                        (if (and (< j4 (- kc 1)) (!= kfl4 (neg 1))) (set bmax (imax bmax kfl4)))
                        (set ht (imax ht (+ 1 (tg s (+ (* 3 n) k4)))))))
                    (if nofail (set flv (neg 1))))))
            (if (== op3 P_REP)
              (do (let [ch (pnw p o i3 1)
                        lo (pnw p o i3 2)
                        hi (pnw p o i3 3)
                        cml (tg s (+ n ch))
                        cfl (tg s (+ (* 2 n) ch))]
                    (set ml (smul hi cml))
                    (if (or (== lo 0) (== cfl (neg 1)))
                      (set flv (neg 1))
                      (set flv (sadd (smul (- lo 1) cml) cfl)))
                    (if (!= cfl (neg 1)) (set bmax (imax bmax cfl)))
                    (set ht (+ 1 (tg s (+ (* 3 n) ch)))))))
            (tset s (+ n i3) ml)
            (tset s (+ (* 2 n) i3) flv)
            (tset s (+ (* 3 n) i3) ht))
          (set i3 (- i3 1))))
      (if (!= (pw p (+ o 6)) (tg s (* 3 n))) (return (want s false (+ o 6) C_DERIVED)))
      (comment "nullable and left recursion (budget raised by the fixed point's bound)")
      (more-budget s (smul 4 (smul (+ calls 2) n)))
      (if (not (peg-nullable p s o n calls)) (return false))
      (if (not (no-left-recursion p s o n)) (return (want s false o C_RECURSION)))
      (comment "the array tier and B; maps keep B = 0")
      (let [w (sar (+ npos 31) 5)
            ^:mut ^I32 tier TIER_A2
            ^:mut bs 0]
        (if (== calls 0)
          (do (if (== bmax 0) (set tier TIER_A0))
              (if (and (> bmax 0) (and (< bmax RING_WORDS) (<= (* (+ bmax 1) w) RING_WORDS)))
                (do (set tier TIER_A1) (set bs bmax)))))
        (if (== kind 1) (set bs 0))
        (if (!= (pw p (+ o 4)) bs) (return (want s false (+ o 4) C_DERIVED)))
        (if (and (== kind 0) (!= (pw p (+ o 3)) tier)) (return (want s false (+ o 3) C_DERIVED)))))
    (return (not (failed s)))))

(defn ^Bool check-pegs [^IntsR p ^Ints s]
  (for [^I32 g 0 (pw p W_N_PEGS)]
    (if (not (check-peg p s g)) (return false)))
  (return true))

(defn ^Bool fail-prov-ok [^IntsR p ^I32 o ^I32 lim]
  (comment "Every FAIL's provenance of the program at o is -1 or below lim.")
  (for [^I32 i 0 (pw p (+ o 1))]
    (if (and (== (pnw p o i 0) P_FAIL) (>= (pnw p o i 2) lim)) (return false)))
  (return true))

;; ------------------------------------------------------------ maps (format 2.0)

(defn ^I32 ceil32 [^I32 n] (return (sar (+ n 31) 5)))

(defn ^I32 map-lits [^IntsR p ^I32 o]
  (comment "Literal members (key id >= 0) of the map table at o.")
  (let [^:mut c 0]
    (for [^I32 i 0 (pw p (+ o 1))]
      (if (>= (pw p (+ (+ o 8) (* 5 i))) 0) (set c (+ c 1))))
    (return c)))

(defn ^Bool check-map [^IntsR p ^Ints s ^I32 m]
  (let [o (rec p 7 m)
        peg (pw p o)
        nm (pw p (+ o 1))
        nn (pw p (+ o 2))
        kts (pw p (+ o 3))
        nr (pw p (+ o 6))
        mb (+ o 8)
        nb (+ mb (* 5 nm))
        nlit (map-lits p o)
        rb (+ (+ nb (* 3 nn)) nlit)
        nt (pw p W_N_TYPESETS)
        nkeys (pw p W_N_KEYS)]
    (if (not (spend s (+ (* 5 nm) (+ (* 3 nn) (+ nlit nr))))) (return false))
    (if (not (in-range peg (pw p W_N_PEGS))) (return (want s false o C_MAP)))
    (let [po (peg-at p peg)
          pn (pw p (+ po 1))]
      (if (!= (pw p po) 1) (return (want s false o C_MAP)))
      (if (!= (peg-count p po P_MEMBER) nm) (return (want s false (+ o 1) C_MAP)))
      (if (not (fail-prov-ok p po nm)) (return (want s false o C_MAP)))
      (comment "members: key id or key typeset, value typeset, cut")
      (for [^I32 i 0 nm]
        (let [e (+ mb (* 5 i))
              kid (pw p e)
              kt (pw p (+ e 1))]
          (if (>= kid 0)
            (do (if (or (not (in-range kid nkeys)) (!= kt (neg 1))) (return (want s false e C_MAP))))
            (if (or (!= kid (neg 1)) (not (in-range kt nt))) (return (want s false e C_MAP))))
          (if (not (in-range (pw p (+ e 2)) nt)) (return (want s false e C_MAP)))
          (if (or (< (pw p (+ e 4)) 0) (> (pw p (+ e 4)) 1)) (return (want s false e C_MAP)))))
      (comment "classes [D]: the root (or the root SEQ's kids) marked in TEMP")
      (for [^I32 z 0 pn] (tset s z 0))
      (let [rop (pnw p po 0 0)
            ^:mut flat (or (== rop P_EMPTY) (== rop P_MEMBER))]
        (if (== rop P_MEMBER) (tset s 0 1))
        (if (== rop P_SEQ)
          (do (set flat true)
              (for [^I32 j 0 (pnw p po 0 2)]
                (let [k (pkid p po 0 j)]
                  (tset s k 1)
                  (if (!= (pnw p po k 0) P_MEMBER) (set flat false))))))
        (let [^:mut anyos false
              ^:mut anycut false
              ^:mut class2 false
              ^:mut ri 0]
          (for [^I32 i2 0 pn]
            (if (== (pnw p po i2 0) P_MEMBER)
              (do (let [mi (pnw p po i2 1)
                        e2 (+ mb (* 5 mi))
                        lit (>= (pw p e2) 0)
                        mx (pnw p po i2 3)
                        ^:mut cls 0]
                    (if (!= (pw p (+ e2 4)) 0) (set anycut true))
                    (if (not lit)
                      (do (if (!= mx INF) (set anyos true))
                          (if (and (== (tg s i2) 1) (== mx INF)) (set cls 1) (set cls 2))))
                    (if (== cls 2) (set class2 true))
                    (if (!= (pw p (+ e2 3)) cls) (return (want s false e2 C_DERIVED)))
                    (if (== cls 1)
                      (do (if (or (>= ri nr) (!= (pw p (+ rb ri)) mi)) (return (want s false (+ o 6) C_DERIVED)))
                          (set ri (+ ri 1))))))))
          (if (!= ri nr) (return (want s false (+ o 6) C_DERIVED)))
          (comment "tier and flags [D]")
          (let [^:mut ^I32 tier TIER_T
                ^:mut pf 0
                ^:mut mf 0]
            (if (and (not class2) (and (not anyos) (== (pw p (+ po 8)) 0))) (set tier TIER_S))
            (if (and flat (not anyos)) (set tier TIER_F))
            (if anyos (do (set pf (bit-or pf 2)) (set mf (bit-or mf 1))))
            (if anycut (do (set pf (bit-or pf 4)) (set mf (bit-or mf 2))))
            (if (!= (pw p (+ po 3)) tier) (return (want s false (+ po 3) C_DERIVED)))
            (if (!= (bit-and (pw p (+ po 7)) 6) pf) (return (want s false (+ po 7) C_DERIVED)))
            (if (!= (pw p (+ o 7)) mf) (return (want s false (+ o 7) C_DERIVED)))
            (comment "named: by key id; namers ascending, naming their key; all literal members")
            (let [^:mut next 0
                  ^:mut nmax 0]
              (for [^I32 q 0 nn]
                (let [qo (+ nb (* 3 q))
                      key (pw p qo)
                      first (pw p (+ qo 1))
                      cnt (pw p (+ qo 2))]
                  (if (not (in-range key nkeys)) (return (want s false qo C_MAP)))
                  (if (and (> q 0) (<= key (pw p (- qo 3)))) (return (want s false qo C_MAP)))
                  (if (or (!= first next) (or (< cnt 1) (> cnt (- nlit first)))) (return (want s false qo C_MAP)))
                  (if (> cnt nmax) (set nmax cnt))
                  (for [^I32 r 0 cnt]
                    (let [na (+ (+ nb (* 3 nn)) (+ first r))
                          mid (pw p na)]
                      (if (not (in-range mid nm)) (return (want s false na C_MAP)))
                      (if (and (> r 0) (<= mid (pw p (- na 1)))) (return (want s false na C_MAP)))
                      (if (!= (pw p (+ mb (* 5 mid))) key) (return (want s false na C_MAP)))))
                  (set next (+ first cnt))))
              (if (!= next nlit) (return (want s false (+ o 2) C_MAP)))
              (comment "slot_words, rec_words [D]")
              (let [^:mut sw 0
                    ^:mut rw 0]
                (if (== tier TIER_S) (set sw (+ (+ 2 (ceil32 nmax)) (* 2 (ceil32 nr)))))
                (if (== tier TIER_T) (set rw (+ 4 (ceil32 (* 2 nm)))))
                (if (!= (pw p (+ o 4)) sw) (return (want s false (+ o 4) C_DERIVED)))
                (if (!= (pw p (+ o 5)) rw) (return (want s false (+ o 5) C_DERIVED)))))))
        (comment "key_ts [D]: the union of the non-literal members' key typesets, or -1")
        (let [e3 (epoch s)
              ^:mut distinct 0
              ^:mut any false]
          (for [^I32 i3 0 nm]
            (let [kt3 (pw p (+ (+ mb (* 5 i3)) 1))]
              (if (>= kt3 0)
                (do (set any true)
                    (let [to (rec p 2 kt3)
                          tn (pw p to)]
                      (if (not (spend s tn)) (return false))
                      (for [^I32 a 0 tn]
                        (let [l (pw p (+ to (+ 2 a)))]
                          (if (!= (mark-get s l) e3)
                            (do (mark-set s l e3) (set distinct (+ distinct 1)))))))))))
          (if (not any)
            (do (if (!= kts (neg 1)) (return (want s false (+ o 3) C_DERIVED))))
            (do (if (not (in-range kts nt)) (return (want s false (+ o 3) C_DERIVED)))
                (let [ko (rec p 2 kts)
                      kn (pw p ko)]
                  (if (!= kn distinct) (return (want s false (+ o 3) C_DERIVED)))
                  (for [^I32 a2 0 kn]
                    (if (!= (mark-get s (pw p (+ ko (+ 2 a2)))) e3) (return (want s false (+ o 3) C_DERIVED))))))))))
    (return (not (failed s)))))

(defn ^Bool check-maps [^IntsR p ^Ints s]
  (for [^I32 m 0 (pw p W_N_MAPS)]
    (if (not (check-map p s m)) (return false)))
  (return true))

;; ------------------------------------------------------------ arrays (format 2.0)

(defn ^Bool vset-or [^Ints s ^I32 dst ^I32 src ^I32 w]
  (comment "TEMP[dst..dst+w) |= TEMP[src..src+w); did it grow?")
  (let [^:mut grew false]
    (for [^I32 k 0 w]
      (let [a (tg s (+ dst k))
            c (bit-or a (tg s (+ src k)))]
        (if (!= c a) (do (tset s (+ dst k) c) (set grew true)))))
    (return grew)))

(defn ^Bool vset-bit [^Ints s ^I32 dst ^I32 q]
  (let [at (+ dst (sar q 5))
        a (tg s at)
        c (bit-or a (shl 1 (bit-and q 31)))]
    (if (== c a) (return false))
    (tset s at c)
    (return true)))

(defn ^Bool array-sets [^IntsR p ^Ints s ^I32 o ^I32 n ^I32 w ^I32 base ^I32 calls]
  (comment "first / last (2w words per node at TEMP[base..)) and nullable (TEMP[0, n))"
           "as least fixed points, exactly as the compiler builds them.")
  (for [^I32 z 0 n] (tset s z 0))
  (for [^I32 z2 0 (* (+ n 1) (* 2 w))] (tset s (+ base z2) 0))
  (forever
   (let [^:mut changed false]
     (if (not (spend s (* n (+ 1 (* 2 w))))) (return false))
     (let [^:mut i (- n 1)]
       (while (>= i 0)
         (let [op (pnw p o i 0)
               fo (+ base (* i (* 2 w)))
               lo (+ fo w)
               ^:mut nu 0]
           (if (== op P_EMPTY) (set nu 1))
           (if (== op P_ENTRY)
             (do (if (vset-bit s fo (pnw p o i 1)) (set changed true))
                 (if (vset-bit s lo (pnw p o i 1)) (set changed true))))
           (if (or (== op P_CALL) (== op P_REP))
             (do (let [t (pnw p o i 1)
                       tf (+ base (* t (* 2 w)))]
                   (if (== op P_CALL) (set nu (tg s t)))
                   (if (and (== op P_REP) (or (== (pnw p o i 2) 0) (!= (tg s t) 0))) (set nu 1))
                   (if (vset-or s fo tf w) (set changed true))
                   (if (vset-or s lo (+ tf w) w) (set changed true)))))
           (if (== op P_CHOICE)
             (for [^I32 j 0 (pnw p o i 2)]
               (let [k (pkid p o i j)
                     kf (+ base (* k (* 2 w)))]
                 (if (!= (tg s k) 0) (set nu 1))
                 (if (vset-or s fo kf w) (set changed true))
                 (if (vset-or s lo (+ kf w) w) (set changed true)))))
           (if (== op P_SEQ)
             (do (let [kc (pnw p o i 2)
                       ^:mut fdone false]
                   (set nu 1)
                   (for [^I32 j2 0 kc]
                     (let [k2 (pkid p o i j2)]
                       (if (not fdone)
                         (if (vset-or s fo (+ base (* k2 (* 2 w))) w) (set changed true)))
                       (if (== (tg s k2) 0) (do (set nu 0) (set fdone true)))))
                   (let [^:mut j3 (- kc 1)]
                     (while (>= j3 0)
                       (let [k3 (pkid p o i j3)]
                         (if (vset-or s lo (+ (+ base (* k3 (* 2 w))) w) w) (set changed true))
                         (if (== (tg s k3) 0) (set j3 0)))
                       (set j3 (- j3 1)))))))
           (if (and (!= nu 0) (== (tg s i) 0))
             (do (tset s i 1) (set changed true))))
         (set i (- i 1))))
     (if (or (not changed) (== calls 0)) (return true)))))

(defn ^Bool varr-edges [^Ints s ^I32 src ^I32 dst ^I32 w ^I32 fol]
  (comment "follow[q] |= TEMP[dst..) for every q in TEMP[src..).")
  (for [^I32 k 0 w]
    (let [v (tg s (+ src k))]
      (if (!= v 0)
        (for [^I32 bit 0 32]
          (if (!= (bit-and (ushr v bit) 1) 0)
            (do (let [q (+ (* k 32) bit)]
                  (if (not (spend s w)) (return false))
                  (for [^I32 x 0 w]
                    (let [fa (+ fol (+ (* q w) x))]
                      (tset s fa (bit-or (tg s fa) (tg s (+ dst x)))))))))))))
  (return true))

(defn ^Bool check-arrays [^IntsR p ^Ints s]
  (let [na (pw p W_N_ARRAYS)
        nt (pw p W_N_TYPESETS)]
    (for [^I32 a 0 na]
      (let [o (rec p 9 a)
            npos (pw p o)
            w (pw p (+ o 1))
            peg (pw p (+ o 2))
            fb (+ o 4)
            pb (+ fb w)
            flb (+ pb npos)]
        (if (not (spend s (+ npos (* npos w)))) (return false))
        (if (!= (pw p (+ o 3)) 0) (return (want s false (+ o 3) C_ARRAY)))
        (if (not (in-range peg (pw p W_N_PEGS))) (return (want s false (+ o 2) C_ARRAY)))
        (let [po (peg-at p peg)
              n (pw p (+ po 1))
              calls (pw p (+ po 8))
              base (* 7 n)
              fol (+ base (* (+ n 1) (* 2 w)))]
          (if (!= (pw p po) 0) (return (want s false (+ o 2) C_ARRAY)))
          (if (!= (peg-count p po P_ENTRY) npos) (return (want s false o C_ARRAY)))
          (if (not (fail-prov-ok p po npos)) (return (want s false (+ o 2) C_ARRAY)))
          (for [^I32 q 0 npos]
            (if (not (in-range (pw p (+ pb q)) nt)) (return (want s false (+ pb q) C_ARRAY))))
          (comment "first and follow [D]: the relaxed automaton recomputed (program-2 §4)")
          (more-budget s (smul 4 (sadd (smul (+ calls 2) (smul n (+ 2 (* 2 w)))) (smul n (smul npos w)))))
          (if (not (array-sets p s po n w base calls)) (return false))
          (for [^I32 z 0 (* npos w)] (tset s (+ fol z) 0))
          (let [acc (+ base (* n (* 2 w)))]
            (for [^I32 i 0 n]
              (let [op (pnw p po i 0)]
                (if (== op P_SEQ)
                  (do (let [kc (pnw p po i 2)
                            k0 (pkid p po i 0)]
                        (for [^I32 z2 0 w] (tset s (+ acc z2) 0))
                        (vset-or s acc (+ (+ base (* k0 (* 2 w))) w) w)
                        (for [^I32 j 1 kc]
                          (let [kj (pkid p po i j)
                                kp (pkid p po i (- j 1))]
                            (if (> j 1)
                              (do (if (== (tg s kp) 0)
                                    (for [^I32 z3 0 w] (tset s (+ acc z3) 0)))
                                  (vset-or s acc (+ (+ base (* kp (* 2 w))) w) w)))
                            (if (not (varr-edges s acc (+ base (* kj (* 2 w))) w fol)) (return false)))))))
                (if (and (== op P_REP) (>= (pnw p po i 3) 2))
                  (do (let [ch (pnw p po i 1)
                            cf (+ base (* ch (* 2 w)))]
                        (if (not (varr-edges s (+ cf w) cf w fol)) (return false))))))))
          (for [^I32 k 0 w]
            (if (!= (pw p (+ fb k)) (tg s (+ base k))) (return (want s false (+ fb k) C_DERIVED))))
          (for [^I32 k2 0 (* npos w)]
            (if (!= (pw p (+ flb k2)) (tg s (+ fol k2))) (return (want s false (+ flb k2) C_DERIVED)))))))
    (return (not (failed s)))))

;; ------------------------------------------------------------ per-leaf sizes (format 2.0)

(defn ^I32 act-words [^I32 ncalls ^I32 depth]
  (let [a (sadd 3 (smul 8 depth))
        x (smul (smul ncalls a) 64)]
    (if (== x INF) (return INF))
    (return (quot (+ x 53) 54))))

(defn ^I32 leaf-peg [^IntsR p ^I32 l]
  (comment "The program offset of a (verified) ARRAY or MAP leaf.")
  (let [o (leaf-at p l)
        k (bit-and (pw p o) 255)]
    (if (== k 15) (return (peg-at p (pw p (rec p 7 (pw p (+ o 2)))))))
    (return (peg-at p (pw p (+ (rec p 9 (pw p (+ o 2))) 2))))))

(defn ^I32 leaf-block [^IntsR p ^I32 l]
  (comment "MAPWORDS / ARRWORDS (program-2 §5.2, §6.3) of a verified leaf.")
  (let [o (leaf-at p l)
        k (bit-and (pw p o) 255)
        po (leaf-peg p l)
        tier (pw p (+ po 3))
        depth (pw p (+ po 6))
        calls (pw p (+ po 8))]
    (if (== k 15)
      (do (let [mo (rec p 7 (pw p (+ o 2)))
                nm (pw p (+ mo 1))
                nn (pw p (+ mo 2))
                ^:mut mw (+ 22 (* 6 nm))]
            (if (== calls 0) (set mw (+ mw (* 8 depth))))
            (if (== tier TIER_S) (set mw (+ mw (* nn (+ (pw p (+ mo 4)) 1)))) (set mw (+ mw nn)))
            (return mw))))
    (let [ao (rec p 9 (pw p (+ o 2)))
          w (pw p (+ ao 1))
          ^:mut aw (+ 16 (* 2 w))]
      (if (== calls 0) (set aw (+ aw (* 4 depth))))
      (if (== tier TIER_A1) (set aw (+ aw (* (+ (pw p (+ po 4)) 1) w))))
      (return aw))))

(defn ^I32 leaf-recwords [^IntsR p ^I32 l]
  (comment "Record words of an A2 array (W) or T map (rec_words), else 0.")
  (let [o (leaf-at p l)
        k (bit-and (pw p o) 255)
        po (leaf-peg p l)
        tier (pw p (+ po 3))]
    (if (and (== k 15) (== tier TIER_T)) (return (pw p (+ (rec p 7 (pw p (+ o 2))) 5))))
    (if (and (== k 14) (== tier TIER_A2)) (return (pw p (+ (rec p 9 (pw p (+ o 2))) 1))))
    (return 0)))

(defn ^Bool row-clean [^IntsR p ^I32 at ^I32 w ^I32 npos]
  (comment "Bits >= npos of the w-word bitset at `at` are zero.")
  (if (== w 0) (return true))
  (let [used (- npos (* 32 (- w 1)))]
    (if (< used 32)
      (do (let [hi (pw p (+ at (- w 1)))]
            (if (!= (ushr hi used) 0) (return false))))))
  (return true))

(defn ^Bool check-regexps [^IntsR p ^Ints s]
  (let [nr (pw p W_N_REGEXPS)]
    (for [^I32 r 0 nr]
      (let [o (rec p 11 r)
            npos (pw p o)
            w (pw p (+ o 1))
            natoms (pw p (+ o 2))
            nul (pw p (+ o 3))
            fo (+ o 4)
            fl (+ fo (* 2 w))
            as (+ fl (* npos w))
            am (+ as natoms)]
        (if (not (spend s (+ npos natoms))) (return false))
        (if (or (< nul 0) (> nul 1)) (return (want s false o C_REGEXP)))
        (if (or (not (row-clean p fo w npos)) (not (row-clean p (+ fo w) w npos))) (return (want s false fo C_REGEXP)))
        (for [^I32 q 0 npos]
          (if (not (row-clean p (+ fl (* q w)) w npos)) (return (want s false (+ fl (* q w)) C_REGEXP))))
        (if (!= (pw p as) 0) (return (want s false as C_REGEXP)))
        (for [^I32 i 0 natoms]
          (let [st (pw p (+ as i))]
            (if (or (< st 0) (> st 1114111)) (return (want s false (+ as i) C_REGEXP)))
            (if (and (> i 0) (<= st (pw p (+ as (- i 1))))) (return (want s false (+ as i) C_REGEXP)))
            (if (not (row-clean p (+ am (* i w)) w npos)) (return (want s false (+ am (* i w)) C_REGEXP)))))))
    (return (not (failed s)))))

;; ------------------------------------------------------------ closure

(defn ^Bool ts-within [^IntsR p ^Ints s ^I32 t ^I32 e]
  (comment "Is every leaf of t's evaluation list marked e?")
  (let [n (ts-eval-n p t)]
    (for [^I32 i 0 n]
      (let [l (ts-eval-at p t i)]
        (if (or (not (in-range l (pw p W_N_LEAVES))) (!= (mark-get s l) e)) (return false))))
    (return true)))

(defn ^I32 child-ts [^IntsR p ^I32 l ^I32 i]
  (comment "Child typeset i of leaf l (program.md §4.2's Children column), or -2 past"
           "the last.")
  (let [o (leaf-at p l)
        k (bit-and (pw p o) 255)
        d0 (pw p (+ o 2))]
    (if (or (== k 1) (and (== k 2) (and (>= d0 4) (<= d0 6))))
      (do (if (== i 0) (return (pw p W_TS_ANY))) (return (neg 2))))
    (if (== k 11) (do (if (== i 0) (return (pw p (+ o 4)))) (return (neg 2))))
    (if (== k 12) (do (if (== i 0) (return (pw p (+ o 6)))) (return (neg 2))))
    (if (== k 13) (do (if (== i 0) (return d0)) (return (neg 2))))
    (if (== k 14)
      (do (let [ao (rec p 9 d0)
                npos (pw p ao)
                w (pw p (+ ao 1))]
            (if (>= i npos) (return (neg 2)))
            (return (pw p (+ (+ (+ ao 4) w) i))))))
    (comment "maps (kind 15): see map-children-within / map-has-children")
    (return (neg 2))))

(defn ^Bool map-children-within [^IntsR p ^Ints s ^I32 l ^I32 e]
  (comment "Every member's key typeset (non-literal keys) and value typeset, and"
           "key_ts, marked e (program-2 §7's closure children).")
  (let [mo (rec p 7 (pw p (+ (leaf-at p l) 2)))
        nm (pw p (+ mo 1))
        kts (pw p (+ mo 3))
        nt (pw p W_N_TYPESETS)]
    (for [^I32 i 0 nm]
      (let [e2 (+ (+ mo 8) (* 5 i))
            kt (pw p (+ e2 1))
            vt (pw p (+ e2 2))]
        (if (not (spend s 2)) (return false))
        (if (>= kt 0)
          (if (or (not (in-range kt nt)) (not (ts-within p s kt e))) (return false)))
        (if (or (not (in-range vt nt)) (not (ts-within p s vt e))) (return false))))
    (if (>= kts 0)
      (if (or (not (in-range kts nt)) (not (ts-within p s kts e))) (return false)))
    (return true)))

(defn ^Bool map-has-children [^IntsR p ^I32 l]
  (let [mo (rec p 7 (pw p (+ (leaf-at p l) 2)))
        nm (pw p (+ mo 1))
        nt (pw p W_N_TYPESETS)]
    (for [^I32 i 0 nm]
      (let [e2 (+ (+ mo 8) (* 5 i))
            kt (pw p (+ e2 1))
            vt (pw p (+ e2 2))]
        (if (and (in-range kt nt) (> (ts-eval-n p kt) 0)) (return true))
        (if (and (in-range vt nt) (> (ts-eval-n p vt) 0)) (return true))))
    (return false)))

(defn ^Bool children-within [^IntsR p ^Ints s ^I32 cs ^I32 e]
  (comment "Is every child (closed) of every leaf of cset cs marked e?")
  (let [co (rec p 16 cs)
        n (pw p co)]
    (for [^I32 i 0 n]
      (let [l (pw p (+ co (+ 3 i)))
            ^:mut j 0]
        (if (== (leaf-kind p l) 15)
          (if (not (map-children-within p s l e)) (return false)))
        (forever
         (if (not (spend s 1)) (return false))
         (let [t (child-ts p l j)]
           (if (== t (neg 2)) (break))
           (if (not (in-range t (pw p W_N_TYPESETS))) (return false))
           (if (not (ts-within p s t e)) (return false)))
         (set j (+ j 1)))))
    (return true)))

(defn ^Bool has-children [^IntsR p ^I32 cs]
  (let [co (rec p 16 cs)
        n (pw p co)]
    (for [^I32 i 0 n]
      (let [l (pw p (+ co (+ 3 i)))]
        (if (and (== (leaf-kind p l) 15) (map-has-children p l)) (return true))
        (if (!= (child-ts p l 0) (neg 2))
          (do (let [t0 (child-ts p l 0)]
                (comment "a child typeset that is empty is no child at all")
                (if (and (in-range t0 (pw p W_N_TYPESETS)) (> (ts-eval-n p t0) 0)) (return true))
                (let [^:mut j 1]
                  (forever
                   (let [t (child-ts p l j)]
                     (if (== t (neg 2)) (break))
                     (if (and (in-range t (pw p W_N_TYPESETS)) (> (ts-eval-n p t) 0)) (return true)))
                   (set j (+ j 1)))))))))
    (return false)))

(defn ^I32 cset-frame [^IntsR p ^I32 co ^I32 n]
  (comment "frame_words of the cset at co (program-2 §9.2 as amended by D311): 2n +"
           "max(MAPAREA, ARRAREA), MAPAREA = the maps' block words + 4 words per member"
           "of each (the pair's candidate list), ARRAREA = the arrays' block words.")
  (let [^:mut maparea 0
        ^:mut arrarea 0]
    (for [^I32 i 0 n]
      (let [l (pw p (+ co (+ 3 i)))
            o (leaf-at p l)
            k (bit-and (pw p o) 255)]
        (if (== k 15)
          (do (let [mo (rec p 7 (pw p (+ o 2)))]
                (set maparea (+ (+ maparea (leaf-block p l)) (* 4 (pw p (+ mo 1))))))))
        (if (== k 14) (set arrarea (+ arrarea (leaf-block p l))))))
    (if (> arrarea maparea) (set maparea arrarea))
    (return (+ (* 2 n) maparea))))

(defn ^I32 cset-regex [^IntsR p ^I32 co ^I32 n]
  (let [^:mut w 0]
    (for [^I32 i 0 n]
      (let [l (pw p (+ co (+ 3 i)))
            o (leaf-at p l)]
        (if (and (== (bit-and (pw p o) 255) 8) (>= (pw p (+ o 4)) 0))
          (do (let [ro (rec p 11 (pw p (+ o 4)))]
                (set w (+ w (* 2 (pw p (+ ro 1))))))))))
    (return w)))

(defn ^Bool check-csets [^IntsR p ^Ints s]
  (let [nc (pw p W_N_CSETS)
        nl (pw p W_N_LEAVES)]
    (for [^I32 c 0 nc]
      (let [co (rec p 16 c)
            n (pw p co)
            e (epoch s)]
        (if (not (spend s (+ 1 n))) (return false))
        (for [^I32 i 0 n]
          (let [l (pw p (+ co (+ 3 i)))]
            (if (not (in-range l nl)) (return (want s false (+ co (+ 3 i)) C_CSET)))
            (if (and (> i 0) (<= l (pw p (+ co (+ 2 i))))) (return (want s false (+ co (+ 3 i)) C_CSET)))
            (mark-set s l e)))
        (comment "closed under combinator operands")
        (for [^I32 j 0 n]
          (let [l2 (pw p (+ co (+ 3 j)))]
            (if (combinator p l2)
              (do (let [lo (leaf-at p l2)]
                    (if (or (!= (mark-get s (pw p (+ lo 2))) e) (!= (mark-get s (pw p (+ lo 3))) e))
                      (return (want s false (+ co (+ 3 j)) C_CSET))))))))
        (if (!= (pw p (+ co 1)) (cset-frame p co n)) (return (want s false (+ co 1) C_DERIVED)))
        (if (!= (pw p (+ co 2)) (cset-regex p co n)) (return (want s false (+ co 2) C_DERIVED)))))
    (return (not (failed s)))))

(defn ^Bool check-arena-words [^IntsR p ^Ints s]
  (comment "Header words 29 R_ITEM_MAX, 62 RECLEAF_MAX and 63 ACT_SUM [D]: over closure"
           "sets, the largest sum of A2 / T record words, count of recursive"
           "ARRAY / MAP leaves and sum of their activation words (program-2 §2, §5.3).")
  (let [nc (pw p W_N_CSETS)
        ^:mut ritem 0
        ^:mut reclmax 0
        ^:mut actsum 0]
    (for [^I32 c 0 nc]
      (let [co (rec p 16 c)
            n (pw p co)
            ^:mut rs 0
            ^:mut rc 0
            ^:mut asum 0]
        (if (not (spend s (+ 1 n))) (return false))
        (for [^I32 i 0 n]
          (let [l (pw p (+ co (+ 3 i)))
                k (leaf-kind p l)]
            (if (or (== k 14) (== k 15))
              (do (let [po (leaf-peg p l)
                        calls (pw p (+ po 8))]
                    (set rs (sadd rs (leaf-recwords p l)))
                    (if (> calls 0)
                      (do (set rc (+ rc 1))
                          (set asum (sadd asum (act-words calls (pw p (+ po 6))))))))))))
        (if (> rs ritem) (set ritem rs))
        (if (> rc reclmax) (set reclmax rc))
        (if (> asum actsum) (set actsum asum))))
    (if (!= (pw p W_R_ITEM_MAX) ritem) (return (want s false W_R_ITEM_MAX C_DERIVED)))
    (if (!= (pw p W_RECLEAF_MAX) reclmax) (return (want s false W_RECLEAF_MAX C_DERIVED)))
    (if (!= (pw p W_ACT_SUM) actsum) (return (want s false W_ACT_SUM C_DERIVED)))
    (return true)))

(defn ^Bool check-chains [^IntsR p ^Ints s]
  (let [nch (pw p W_N_CHAINS)
        ncs (pw p W_N_CSETS)
        d (pw p 32)]
    (for [^I32 c 0 nch]
      (let [o (rec p 18 c)
            n (pw p o)
            r (pw p (+ o 1))]
        (if (> n (+ d 1)) (return (want s false o C_CHAIN)))
        (if (or (< r (neg 1)) (>= r n)) (return (want s false o C_CHAIN)))
        (for [^I32 i 0 n]
          (if (not (in-range (pw p (+ o (+ 2 i))) ncs)) (return (want s false (+ o (+ 2 i)) C_CHAIN))))
        (comment "cset[k+1] holds the children of cset[k]; the period closes; an"
                 "ending chain ends with no children")
        (for [^I32 k 0 (- n 1)]
          (let [e (epoch s)
                nxt (pw p (+ o (+ 3 k)))
                no (rec p 16 nxt)]
            (for [^I32 q 0 (pw p no)]
              (mark-set s (pw p (+ no (+ 3 q))) e))
            (if (not (children-within p s (pw p (+ o (+ 2 k))) e)) (return (want s false (+ o (+ 2 k)) C_CHAIN)))))
        (if (>= r 0)
          (do (let [e2 (epoch s)
                    rc (pw p (+ o (+ 2 r)))
                    ro (rec p 16 rc)]
                (for [^I32 q2 0 (pw p ro)]
                  (mark-set s (pw p (+ ro (+ 3 q2))) e2))
                (if (not (children-within p s (pw p (+ o (+ 2 (- n 1)))) e2)) (return (want s false o C_CHAIN)))))
          (if (<= n d)
            (if (has-children p (pw p (+ o (+ 2 (- n 1))))) (return (want s false o C_CHAIN)))))))
    (return (not (failed s)))))

(defn ^I32 rule-scratch [^IntsR p ^I32 chain]
  (comment "program.md §12.1's scratch words for a rule with this chain (MARK_CAP ="
           "N_LEAVES).")
  (let [o (rec p 18 chain)
        n (pw p o)
        r (pw p (+ o 1))
        d (pw p 32)
        nl (pw p W_N_LEAVES)
        ^:mut sumf 0
        ^:mut maxr 0]
    (for [^I32 k 0 (+ d 1)]
      (let [^:mut idx k]
        (if (>= k n)
          (if (< r 0)
            (set idx (neg 1))
            (set idx (+ r (- (- k r) (* (quot (- k r) (- n r)) (- n r)))))))
        (if (>= idx 0)
          (do (let [co (rec p 16 (pw p (+ o (+ 2 idx))))]
                (set sumf (+ sumf (pw p (+ co 1))))
                (if (> (pw p (+ co 2)) maxr) (set maxr (pw p (+ co 2)))))))))
    (return (+ (+ (+ 48 (* 2 nl)) (* 2 (+ d 1))) (+ maxr sumf)))))

(defn ^Bool check-rule-closure [^IntsR p ^Ints s]
  (comment "R_0 holds the rule's evaluation list; scratch_words; SCRATCH_MAX; flags;"
           "the total-bytes cap.")
  (let [base (sec p 0)
        nr (pw p W_N_RULES)
        ^:mut smax 0]
    (for [^I32 i 0 nr]
      (let [o (+ base (* 5 i))
            t (pw p (+ o 2))
            ch (pw p (+ o 3))
            co (rec p 18 ch)
            c0 (pw p (+ co 2))
            c0o (rec p 16 c0)
            e (epoch s)]
        (if (not (spend s (pw p c0o))) (return false))
        (for [^I32 q 0 (pw p c0o)]
          (mark-set s (pw p (+ c0o (+ 3 q))) e))
        (if (not (ts-within p s t e)) (return (want s false o C_CHAIN)))
        (let [sw (rule-scratch p ch)]
          (if (!= (pw p (+ o 4)) sw) (return (want s false (+ o 4) C_DERIVED)))
          (if (> sw smax) (set smax sw)))))
    (if (!= (pw p 40) smax) (return (want s false 40 C_DERIVED)))
    (let [total (pw p 38)
          words (ilen p)
          pool (pw p 4)]
      (if (or (> smax (quot total 4)) (> words (quot (- (- total pool) (* 4 smax)) 4)))
        (return (want s false 38 C_TOTAL))))
    (return (not (failed s)))))

(defn ^Bool check-flags [^IntsR p ^Bytes b ^Ints s]
  (let [^:mut f 0
        ^:mut needs-any false]
    (for [^I32 kq 0 (pw p W_N_KEYS)]
      (let [ko (pw p (+ (sec p 4) (* 2 kq)))]
        (if (<= (ushr (u8 b ko) 5) 1) (set f (bit-or f 1)))))
    (for [^I32 l 0 (pw p W_N_LEAVES)]
      (let [o (leaf-at p l)
            k (bit-and (pw p o) 255)]
        (if (and (== k 8) (>= (pw p (+ o 4)) 0)) (set f (bit-or f 2)))
        (if (== k 13) (set f (bit-or f 4)))
        (if (or (== k 16) (== k 17)) (set f (bit-or f 8)))
        (if (== k 18) (set f (bit-or f 16)))
        (if (and (== k 14) (== (pw p (+ (leaf-peg p l) 3)) TIER_A2)) (set f (bit-or f 64)))
        (if (and (== k 15) (== (pw p (+ (leaf-peg p l) 3)) TIER_T)) (set f (bit-or f 64)))
        (if (or (== k 1) (and (== k 2) (and (>= (pw p (+ o 2)) 4) (<= (pw p (+ o 2)) 6))))
          (set needs-any true))))
    (comment "bit 5 (CUTS_BRANCH, D301) is the compile option [V]; bit 6 (ARENA) is derived")
    (if (!= (bit-and (pw p 6) (bit-not 32)) f) (return (want s false 6 C_DERIVED)))
    (if (and needs-any (< (pw p W_TS_ANY) 0)) (return (want s false W_TS_ANY C_HEADER)))
    (return true)))

;; ------------------------------------------------------------ extension controls (D141)

(defn ^Bool name-byte-ok [^I32 c ^Bool first]
  (comment "A control name: ASCII letters and `_`, then also digits and `-`.")
  (if (or (and (>= c 65) (<= c 90)) (or (and (>= c 97) (<= c 122)) (== c 95))) (return true))
  (if first (return false))
  (return (or (and (>= c 48) (<= c 57)) (== c 45))))

(defn ^Bool check-exts [^IntsR p ^Bytes b ^Ints s]
  (comment "The names of the N_EXTS extension controls: deterministic CBOR text"
           "strings of 1..64 name bytes, strictly ascending bytewise, back to back"
           "filling pool[W_EXT_NAMES, + W_EXT_NAMES_LEN) exactly; none without any.")
  (let [n (pw p W_N_EXTS)
        off (pw p W_EXT_NAMES)
        len (pw p W_EXT_NAMES_LEN)]
    (if (== n 0) (return (want s (and (== off 0) (== len 0)) W_EXT_NAMES C_EXT)))
    (if (not (want s (byte-range b off len) W_EXT_NAMES C_EXT)) (return false))
    (if (not (spend s (+ n (quot len 4)))) (return false))
    (let [end (+ off len)
          ^:mut i off
          ^:mut po (neg 1)
          ^:mut pl 0]
      (for [^I32 _k 0 n]
        (if (>= i end) (return (want s false W_EXT_NAMES C_EXT)))
        (let [ib (u8 b i)
              ^:mut nl (bit-and ib 31)
              ^:mut c (+ i 1)]
          (if (!= (ushr ib 5) 3) (return (want s false W_EXT_NAMES C_EXT)))
          (if (> nl 24) (return (want s false W_EXT_NAMES C_EXT)))
          (if (== nl 24)
            (do (if (>= c end) (return (want s false W_EXT_NAMES C_EXT)))
                (set nl (u8 b c))
                (if (< nl 24) (return (want s false W_EXT_NAMES C_EXT)))
                (set c (+ c 1))))
          (if (or (< nl 1) (or (> nl 64) (> nl (- end c)))) (return (want s false W_EXT_NAMES C_EXT)))
          (for [^I32 j 0 nl]
            (if (not (name-byte-ok (u8 b (+ c j)) (== j 0))) (return (want s false W_EXT_NAMES C_EXT))))
          (if (and (>= po 0) (>= (bytes-cmp b po pl c nl) 0)) (return (want s false W_EXT_NAMES C_EXT)))
          (set po c)
          (set pl nl)
          (set i (+ c nl))))
      (return (want s (== i end) W_EXT_NAMES C_EXT)))))

;; ------------------------------------------------------------ the entry point

(defn ^:pub ^I32 vm-verify [^IntsR p ^Bytes b ^Ints s]
  (comment "0 valid; -1 refused (detail in S[35], S[36]); -2 the scratch is too small"
           "for the verifier's marks and PEG working area (len(S) >= vm-verify-words,"
           "VM_MARK_CAP >= N_LEAVES).")
  (if (< (ilen s) 48) (return (neg 2)))
  (iset s V_FAILED 0)
  (iset s VM_DETAIL 0)
  (iset s (+ VM_DETAIL 1) 0)
  (if (not (check-header p b s)) (return (neg 1)))
  (let [m (ia s VM_MARK_CAP)
        nl (ia p W_N_LEAVES)]
    (if (or (< m nl) (or (< m 0) (> (+ 48 (* 2 m)) (ilen s)))) (return (neg 2)))
    (if (> (+ (+ 48 (* 2 m)) (vm-verify-temp p)) (ilen s)) (return (neg 2)))
    (comment "the verify budget: 64 * (PROGRAM_WORDS + POOL_BYTES / 4 + 1)")
    (let [units (+ (+ (ilen p) (quot (blen b) 4)) 1)]
      (if (> units (quot INF 64)) (iset s V_BUDGET INF) (iset s V_BUDGET (* 64 units)))))
  (if (not (check-index p s 2 3 (pw p W_N_TYPESETS) 0)) (return (neg 1)))
  (if (not (check-index p s 5 6 (pw p W_N_PEGS) 1)) (return (neg 1)))
  (if (not (check-index p s 7 8 (pw p W_N_MAPS) 2)) (return (neg 1)))
  (if (not (check-index p s 9 10 (pw p W_N_ARRAYS) 3)) (return (neg 1)))
  (if (not (check-index p s 11 12 (pw p W_N_REGEXPS) 4)) (return (neg 1)))
  (if (not (check-index p s 16 17 (pw p W_N_CSETS) 5)) (return (neg 1)))
  (if (not (check-index p s 18 19 (pw p W_N_CHAINS) 6)) (return (neg 1)))
  (if (not (check-exts p b s)) (return (neg 1)))
  (if (not (check-iv-records p b s)) (return (neg 1)))
  (if (not (check-leaves p b s)) (return (neg 1)))
  (if (not (check-typesets p s)) (return (neg 1)))
  (if (not (check-keys p b s)) (return (neg 1)))
  (if (not (check-rules p b s)) (return (neg 1)))
  (if (not (check-pegs p s)) (return (neg 1)))
  (if (not (check-maps p s)) (return (neg 1)))
  (if (not (check-arrays p s)) (return (neg 1)))
  (if (not (check-regexps p s)) (return (neg 1)))
  (if (not (check-flags p b s)) (return (neg 1)))
  (if (not (check-csets p s)) (return (neg 1)))
  (if (not (check-chains p s)) (return (neg 1)))
  (if (not (check-rule-closure p s)) (return (neg 1)))
  (if (not (check-arena-words p s)) (return (neg 1)))
  (if (failed s) (return (neg 1)))
  (return 0))

(defn ^:pub ^I32 vm-verify-temp [^IntsR p]
  (comment "Words of PEG working area vm-verify needs after the marks: the largest"
           "7 n + 2 W (n + 1) + npos W over the programs (n <= 16384) and arrays"
           "(npos <= 4096, so W <= 128), read defensively (checked reads, clamped), so"
           "an unverified Program can ask for at most the hard maxima's worth.")
  (if (< (ilen p) 64) (return 0))
  (let [lim (ilen p)
        ^:mut nmax 1
        ^:mut npmax 0
        ^:mut np (pw p W_N_PEGS)
        ^:mut na (pw p W_N_ARRAYS)]
    (if (or (< np 0) (> np lim)) (set np 0))
    (if (or (< na 0) (> na lim)) (set na 0))
    (for [^I32 g 0 np]
      (let [n (pw p (add32 (pw p (add32 (pw p (+ W_SEC 5)) g)) 1))]
        (if (and (> n nmax) (<= n 16384)) (set nmax n))))
    (for [^I32 a 0 na]
      (let [npos (pw p (pw p (add32 (pw p (+ W_SEC 9)) a)))]
        (if (and (> npos npmax) (<= npos 4096)) (set npmax npos))))
    (let [w (sar (+ npmax 31) 5)]
      (return (+ (+ (* 7 nmax) (* (* 2 w) (+ nmax 1))) (+ (* npmax w) 16))))))

(defn ^:pub ^I32 vm-verify-words [^IntsR p ^I32 mark-cap]
  (comment "The scratch length vm-verify needs with VM_MARK_CAP = max(mark-cap,"
           "N_LEAVES clamped to 2^20): 48 + 2 M + the PEG working area.")
  (let [^:mut m mark-cap
        ^:mut nl 0]
    (if (>= (ilen p) 64) (set nl (pw p W_N_LEAVES)))
    (if (or (< nl 0) (> nl 1048576)) (set nl 1048576))
    (if (> nl m) (set m nl))
    (if (< m 1) (set m 1))
    (return (+ (+ 48 (* 2 m)) (vm-verify-temp p)))))
