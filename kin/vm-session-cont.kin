;; The resumable session's container frames (P6.2): arrays (and `.cborseq`'s
;; virtual array, D040), maps, tags, and their dead (profile-only) forms, for
;; containers that cross the window. Each is snug.vm.eval's GENERIC path (the
;; fast paths give the same out array, D044, and are taken by the children the
;; buffer walk evaluates whole), phase by phase: the same block state machines,
;; query lists, witness and charging functions, called in the same order.
;; Children are items handed back to the session loop (`call`), evaluated whole
;; by the buffer walk when the prescan allows, else framed.
;;
;; Map keys (D092): a key is taken whole -- from the window, or copied into the
;; key arena across windows first -- and evaluated by the buffer walk (eval-item
;; / dead-item) over that copy; the copy then becomes the map's previous key.
(ns snug.vm.scont
  (:require [kin.lang :refer [defn let local return set if while for do comment forever break defconst]]
            [snug.lang :refer [I32 Ext Bool Bytes BytesW Ints IntsR + - * neg shl sar ushr bit-and bit-or bit-xor
                               rem < > <= >= == != and or not u8 blen ia iset bcopy]]
            [snug.cbor.codes :refer [CODE_TRUNCATED CODE_KEY_TYPE CODE_TAG CODE_DEPTH CODE_DECIMAL
                                     CODE_NDARRAY CODE_TYPED_ARRAY CODE_TOO_MANY_ENTRIES O_COSE O_MAX_DEPTH
                                     O_MAX_ENTRIES O_ERR_POS O_HI O_LO O_CSTART O_PROFILE O_VLEN PF_CANON PF_TAGS]]
            [snug.cbor.head :refer [fail head-size enter-container bytes-content]]
            [snug.cbor.tags :refer [typed-size]]
            [snug.cbor.scan :refer [key-peek key-label]]
            [snug.cbor.stdtags :refer [std-allowed any-tags rule-tag typed-any-size std-content-ok]]
            [snug.cbor.keys :refer [key-end-any]]
            [snug.vm.layout :refer [H_S_LEAVES VM_POS VM_Q1 VM_GENERIC VM_FASTM VM_VTAB VM_W_STATE VM_W_REASON
                                    VM_W_SUB VM_W_OFFSET K_INT K_TEXT K_ARRAY K_MAP K_TAG K_TAGSET F_ADMITTED
                                    F_MATCHED F_EVAL R_TYPE R_MISSING R_UNEXPECTED R_VALUE R_TAG R_BUDGET
                                    R_INCONSISTENT P_INDEX P_KEY P_ANYKEY P_TAG CTX_KEY CTX_SIMPLE]]
            [snug.vm.base :refer [charge c64 new-epoch sched2 free-on free-off q-add q-stamp ts-test
                                  q-flag q-set-flag q-kind q-leaf-base cset-rec next-ck cset-width
                                  cset-frame wit-empty wit-clear wit-set path-put rule1]]
            [snug.vm.leaf :refer [eval-scalars scalar-kind cmp-u64]]
            [snug.vm.dead :refer [dead-item dead-int-streak dead-pair-body pair-check decimal-check ndarray-check
                                  dead-std-check]]
            [snug.vm.map :refer [leaf-map block-mt map-block-init key-span-end key-search map-cursor
                                 map-key-query map-key-phase cand-vts cand-vts-mt block-named map-update
                                 map-satisfied map-missing simple-struct key-phase-struct update-struct]]
            [snug.vm.array :refer [leaf-array block-ao array-words array-block-init array-candidates
                                   array-advance array-accepts]]
            [snug.vm.eval :refer [eval-item unit-of simple-of q-filter-x finish-comb finish-scalar
                                  count-pending single-leaf count-matched map-fast-mode map-pair-ok
                                  bstr-tail array-streak if-limit cursors-reset]]
            [snug.vm.sbase :refer [key-max-claim SS_UNK enter-pend pend-note GO SS_PH SS_RET PH_RET IT_PAIR FW FK_ARR FK_MAP FK_TAG FK_DARR FK_DMAP FK_DSEQ SS_ATOP SS_CUT
                                   VMS_NEED VMS_GROW SS_VNEED IND F_IND F_VN F_VLAST F_VMARK F_FLOOR ftop
                                   F_KIND F_PH F_POS F_END F_D F_FB F_CK F_NQ F_CTX F_Q F_N F_EL F_Q0 F_PIN
                                   F_NB F_S2 F_CX F_PEND F_NALIVE F_Q1 F_CNQ F_PAIR F_CL F_CCAP F_SMAP F_KLO
                                   F_COSE F_PS F_PE F_START F_KID F_MCNQ F_NC F_NAMED F_VNQ F_PS2 F_KM F_KE
                                   F_KGOT F_KA F_KQ F_TNUM F_TCLS F_TCNQ F_TCS F_TSTOP F_TSIZE F_TI F_TNOTED
                                   F_TLIVE MODE_ITEM MODE_FRAME
                                   fbase fidx fpush done err cont call need yld ensure suspended must-yield cut-yield
                                   progress keys-save key-order-s set-prev set-prev-arena prescan imin fits-known ret
                                   lits-need bstr-reads notes-init pair-note pair-verdict]]
            [snug.vm.sstr :refer [prologue frame-item open-bstr typed-scan]]
            [snug.cbor.canon :refer [kclass]]
            [snug.vm.svalid :refer [VI_NEED VI_GROW KH vsess vrun vgrow vitem vscan vclean vbuild vfix vorder
                                    vkeep vdescends vdup-end]]))

;; arrays: the streak leaf (P3.6, D044), -1 none
(defconst ^:pub ^I32 F_SLEAF 24)

;; frame phases
(defconst ^:pub ^I32 A_NEXT 0)
(defconst ^:pub ^I32 A_DEAD 1)
(defconst ^:pub ^I32 A_LIVE 2)
(defconst ^:pub ^I32 M_NEXT 0)
(defconst ^:pub ^I32 M_KEY 1)
(defconst ^:pub ^I32 M_DVAL 2)
(defconst ^:pub ^I32 M_LVAL 3)
(defconst ^:pub ^I32 T_CHEAD 1)
(defconst ^:pub ^I32 T_NAN 2)
(defconst ^:pub ^I32 T_TAIL 3)
(defconst ^:pub ^I32 T_TAILRET 4)
(defconst ^:pub ^I32 T_PAIR 5)
(defconst ^:pub ^I32 T_PAIRRET 6)
(defconst ^:pub ^I32 T_FIN 7)
(defconst ^:pub ^I32 T_STD 8)
(defconst ^:pub ^I32 T_STDRET 9)
(defconst ^:pub ^I32 T_STDCHK 10)

(defn ^:pub mark-pair [^Ints ss ^I32 pair]
  (comment "The content of tag frame `pair` is framed: its verdict will come from notes.")
  (if (>= pair 0)
    (do (let [tf (fbase ss pair)]
          (iset ss (+ tf F_TNOTED) 1)))))

;; ------------------------------------------------------------ arrays (FK_ARR)

(defconst ^:pub ^I32 NOINL -1000)

(defn ^:pub ^I32 inline-child [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^Ints vs ^BytesW cb ^I32 base
                               ^I32 pos ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^I32 note ^Ext ext]
  (comment "A child the step's prescan knows to lie before the cut, evaluated by the"
           "buffer walk at once (no round trip through the session loop): its end"
           "or code, or NOINL (take the item path: a note, a yield, or unknown). With"
           "the valid machinery (P8.4, D266) the child is a whole item (vitem); when"
           "it asks for more window or buffers, the item path asks.")
  (if (>= note 0) (return NOINL))
  (let [at (+ pos base)]
    (if (cut-yield s ss at) (return NOINL))
    (if (not (fits-known ss at)) (return NOINL)))
  (if (vsess s ss)
    (do (if (>= pos end) (return NOINL))
        (let [r (vitem p pool b s ss vs cb pos d fb ck nq end (blen b) ctx ext)]
          (if (or (== r VI_NEED) (== r VI_GROW)) (return NOINL))
          (progress ss 1)
          (return r))))
  (progress ss 1)
  (if (> nq 0) (return (eval-item p pool b s pos d fb ck nq end ctx ext)))
  (return (dead-item b s pos d end)))

(defn ^:pub ^I32 arr-start [^IntsR p ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 q0 ^I32 n
                            ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^I32 pair]
  (comment "eval-array's start (generic path): filter, blocks, the schedule-2 shape"
           "(D045 i, iii), then the frame. n < 0: a `.cborseq` virtual array (D040).")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cap (- fw (* 2 w))
        ^:mut nb 0
        ^:mut used 0
        ^:mut sl (neg 1)
        ^:mut s2 0
        ^:mut cx 0]
    (let [na (q-filter-x p s fb w nq 16 pos ctx)]
      (if (< na 0) (return (err ss na))))
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_ARRAY))
        (do (let [words (array-words p (leaf-array p (q-leaf-base p s fb i)))]
              (if (> (+ used words) cap) (return (err ss (neg R_INCONSISTENT))))
              (let [ri (array-block-init s (+ area used) i words pos)]
                (if (< ri 0) (return (err ss ri))))
              (set used (+ used words))
              (set nb (+ nb 1))))))
    (if (== nb 1)
      (do (let [ao1 (block-ao p s fb area)]
            (if (and (and (== (ia p ao1) 1) (== (ia p (+ ao1 2)) 0))
                     (and (== (ia p (+ ao1 4)) 1) (== (bit-and (ia p (+ ao1 8)) 1) 1)))
              (set sl (single-leaf p (ia p (+ ao1 6))))))))
    (if (and (sched2 s) (>= sl 0))
      (do (set s2 1)
          (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 sl))) 255)) (set cx CTX_SIMPLE))))
    (comment "eval-array's streak leaf: an INT over one interval or a TEXT without a"
             "regexp, fast paths on (D044)")
    (let [^:mut sleaf (neg 1)]
      (if (and (>= sl 0) (== (bit-and (ia s VM_GENERIC) 1) 0))
        (do (let [lbf (+ (ia p H_S_LEAVES) (* 8 sl))
                  kf (bit-and (ia p lbf) 255)]
              (if (or (and (== kf K_INT) (== (ia p (+ lbf 3)) 1))
                      (and (== kf K_TEXT) (< (ia p (+ lbf 4)) 0)))
                (set sleaf sl)))))
      (iset ss IT_PAIR sleaf))
    (let [pend (count-pending p s fb w nq)
          sleaf2 (ia ss IT_PAIR)
          f (fpush b ss ka base FK_ARR)]
      (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
      (frame-item ss f base pos end d fb ck nq ctx)
      (iset ss (+ f F_Q) (+ q0 base))
      (iset ss (+ f F_Q0) (+ q0 base))
      (iset ss (+ f F_Q1) (+ q0 base))
      (iset ss (+ f F_N) n)
      (iset ss (+ f F_NB) nb)
      (iset ss (+ f F_S2) s2)
      (iset ss (+ f F_CX) cx)
      (iset ss (+ f F_PEND) pend)
      (iset ss (+ f F_NALIVE) nb)
      (iset ss (+ f F_PAIR) pair)
      (iset ss (+ f F_SLEAF) sleaf2)
      (mark-pair ss pair)
      (return (cont ss f A_NEXT)))))

(defn ^:pub ^I32 indef [^Bytes b ^Ints s ^I32 pos ^I32 d]
  (comment "P8.4 (D266): an indefinite array or map whose head is at pos: its depth"
           "check (the scanner's, before any entry); 1 when it is one, 0 when it is"
           "not, or the negated refusal.")
  (if (!= (bit-and (u8 b pos) 31) 31) (return 0))
  (if (>= d (ia s O_MAX_DEPTH)) (return (fail s pos CODE_DEPTH)))
  (return 1))

(defn ^:pub ^I32 ind-mark [^Ints ss ^I32 r]
  (comment "The container frame just opened (r GO) is an indefinite one.")
  (if (== r GO) (iset ss (+ (ftop ss) F_IND) 1))
  (return r))

(defn ^:pub ^I32 open-arr [^IntsR p ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 d ^I32 fb
                           ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^I32 pair]
  (let [q (prologue p b s pos end ck 1)]
    (if (< q 0) (return (err ss q)))
    (let [id (indef b s pos d)]
      (if (< id 0) (return (err ss id)))
      (if (== id 1)
        (do (let [ra0 (arr-start p b s ss ka base pos q IND d fb ck nq end ctx pair)]
              (return (ind-mark ss ra0))))))
    (let [lo (ia s O_LO)
          hi (ia s O_HI)
          ra (enter-pend b s ss base pos q hi lo d 0 end)]
      (if (< ra 0) (return (err ss ra)))
      (return (arr-start p b s ss ka base pos q lo d fb ck nq end ctx pair)))))

(defn ^:pub ^I32 arr-end [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 f ^Ext ext]
  (let [pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        nq (ia ss (+ f F_NQ))
        ctx (ia ss (+ f F_CTX))
        q (- (ia ss (+ f F_Q)) base)
        q0 (- (ia ss (+ f F_Q0)) base)
        n (ia ss (+ f F_N))
        el (ia ss (+ f F_EL))
        nb (ia ss (+ f F_NB))
        w (cset-width p (cset-rec p s (ia ss (+ f F_CK))))
        area (+ fb (* 2 w))
        ^:mut unacc 0
        ^:mut be area]
    (for [^I32 _bk 0 nb]
      (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
      (let [aok (block-ao p s fb be)]
        (if (!= (ia s (+ be 1)) 0)
          (do (if (not (charge s (ia p (+ aok 1)) pos)) (return (err ss (neg R_BUDGET))))
              (if (array-accepts p s be aok el)
                (q-set-flag s fb w (ia s be) F_MATCHED)
                (do (q-set-flag s fb w (ia s be) (shl R_MISSING 8))
                    (set unacc (+ unacc 1))))))
        (set be (+ be (array-words p aok)))))
    (if (== n 2)
      (do (let [q1 (- (ia ss (+ f F_Q1)) base)]
            (iset s VM_Q1 q1))))
    (let [rs (eval-scalars p pool b s fb w nq pos q0 q 16 0 el (unit-of ctx))]
      (if (< rs 0) (return (err ss rs))))
    (let [m (finish-comb p pool b s fb w nq pos q ext)]
      (if (< m 0) (return (err ss m)))
      (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
        (if (> unacc 0)
          (wit-set s R_MISSING 0 d P_INDEX el pos)
          (do (let [r1 (rule1 s fb w nq d pos)]
                (if (< r1 0) (return (err ss r1))))))))
    (return (done ss base q))))

(defn ^:pub ^I32 arr-ret [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 r]
  (comment "The element ended at r (absolute): after a live element, stamp and"
           "advance the live blocks, then the witness; next.")
  (let [el (ia ss (+ f F_EL))]
    (if (== (ia ss (+ f F_PH)) A_LIVE)
      (do (let [pos (- (ia ss (+ f F_POS)) base)
                d (ia ss (+ f F_D))
                fb (ia ss (+ f F_FB))
                ck (ia ss (+ f F_CK))
                q (- (ia ss (+ f F_Q)) base)
                nb (ia ss (+ f F_NB))
                cnq (ia ss (+ f F_CNQ))
                cr (cset-rec p s ck)
                w (cset-width p cr)
                area (+ fb (* 2 w))
                cw (cset-width p (cset-rec p s (next-ck p s ck)))
                ao1 (block-ao p s fb area)
                ^:mut nalive (ia ss (+ f F_NALIVE))
                ^:mut still 0
                ^:mut bo area]
            (if (== (ia ss (+ f F_S2)) 1) (free-on s))
            (let [ev (q-stamp s (+ fb (cset-frame p cr)) cw cnq pos)]
              (if (< ev 0) (return (err ss ev)))
              (for [^I32 bj 0 nb]
                (let [^:mut aoj ao1]
                  (if (> bj 0) (set aoj (block-ao p s fb bo)))
                  (if (!= (ia s (+ bo 1)) 0)
                    (do (let [adv (array-advance p s bo aoj ev pos)]
                          (if (< adv 0) (return (err ss adv)))
                          (if (== adv 1)
                            (set still (+ still 1))
                            (do (set nalive (- nalive 1))
                                (if (== adv 2)
                                  (q-set-flag s fb w (ia s bo) (shl R_UNEXPECTED 8))
                                  (q-set-flag s fb w (ia s bo) (shl R_TYPE 8))))))))
                  (set bo (+ bo (array-words p aoj))))))
            (free-off s)
            (if (or (> still 0) (> (ia ss (+ f F_PEND)) 0))
              (wit-clear s)
              (if (wit-empty s) (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 q)))
            (iset ss (+ f F_NALIVE) nalive))))
    (iset ss (+ f F_Q) r)
    (if (== el 0) (iset ss (+ f F_Q1) r))
    (iset ss (+ f F_EL) (+ el 1))
    (return (cont ss f A_NEXT))))

;; ------------------------------------------------------------ dead arrays and sequences


(defn ^:pub ^I32 ind-next [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f ^I32 q ^I32 end]
  (comment "P8.4 (D266): before an entry of an indefinite container at q (the"
           "scanner's order): the end of input there -- truncated, before any visit;"
           "its break -- the container ends after it (F_N becomes the entries, F_Q"
           "past the break): 1; the entry bound -- too_many_entries at the"
           "container; else 0 (an entry). GO-or-NEED style: VMS_NEED when the byte is"
           "not in the window; a negated code.")
  (if (>= q end) (return (fail s q CODE_TRUNCATED)))
  (if (or (< q 0) (>= q wend)) (return (need ss base q 1)))
  (if (== (u8 b q) 255)
    (do (iset ss (+ f F_N) (ia ss (+ f F_EL)))
        (iset ss (+ f F_Q) (+ (+ q 1) base))
        (return 1)))
  (if (>= (ia ss (+ f F_EL)) (ia s O_MAX_ENTRIES))
    (return (fail s (- (ia ss (+ f F_POS)) base) CODE_TOO_MANY_ENTRIES)))
  (return 0))

(defn ^I32 ind-limit [^IntsR s ^IntsR ss ^I32 f ^I32 k ^I32 el]
  (comment "A streak's element count k in the frame f: in an indefinite container no"
           "more than the entry bound leaves (the next entry is then refused at the"
           "container, ind-next, before any visit -- the scanner's order).")
  (if (!= (ia ss (+ f F_IND)) 1) (return k))
  (let [m (- (ia s O_MAX_ENTRIES) el)]
    (if (< m k) (return m))
    (return k)))

(defn ^:pub ^I32 arr-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^Ints vs ^BytesW cb ^I32 base ^I32 f ^Ext ext]
  (comment "The next element: its query from the live blocks (charged), then the"
           "element as a child item; or the end.")
  (let [pos (- (ia ss (+ f F_POS)) base)
        end (- (ia ss (+ f F_END)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        ck (ia ss (+ f F_CK))
        q (- (ia ss (+ f F_Q)) base)
        n (ia ss (+ f F_N))
        el (ia ss (+ f F_EL))
        nb (ia ss (+ f F_NB))
        s2 (ia ss (+ f F_S2))
        cx (ia ss (+ f F_CX))
        note (pair-note ss (ia ss (+ f F_PAIR)) el)]
    (if (and (== (ia ss (+ f F_IND)) 1) (< el n))
      (do (let [ix (ind-next b s ss base (blen b) f q end)]
            (if (== ix VMS_NEED) (return ix))
            (if (< ix 0) (return (err ss ix)))
            (if (== ix 1) (return (arr-end p pool b s ss base f ext))))))
    (if (not (or (and (< n 0) (< q end)) (and (>= n 0) (< el n))))
      (return (arr-end p pool b s ss base f ext)))
    (comment "eval-array's streaks over the elements the window (and the quantum's"
             "cut) holds: each checks an element whole before charging it and stops"
             "before one that would not do, so a cut short `end` only ends them sooner")
    (let [cutend (imin end (- (ia ss SS_CUT) base))
          generic (bit-and (ia s VM_GENERIC) 1)]
      (if (and (and (and (>= el 1) (== generic 0)) (< (ia ss (+ f F_PAIR)) 0)) (and (>= q 0) (< q cutend)))
        (do (if (== (ia ss (+ f F_NALIVE)) 0)
              (do (let [qd (dead-int-streak b s q (ind-limit s ss f (if-limit n el) el) cutend)
                        kd (ia s VM_FASTM)]
                    (if (> kd 0)
                      (do (iset ss (+ f F_Q) (+ qd base))
                          (iset ss (+ f F_EL) (+ el kd))
                          (progress ss kd)
                          (return (cont ss f A_NEXT))))))
              (do (let [sleaf (ia ss (+ f F_SLEAF))
                        area0 (+ fb (* 2 (cset-width p (cset-rec p s ck))))]
                    (if (and (>= sleaf 0) (== (ia s (+ area0 2)) 1))
                      (do (let [qs (array-streak p b s q (ind-limit s ss f (if-limit n el) el) cutend sleaf s2)
                                ks (ia s VM_FASTM)]
                            (if (> ks 0)
                              (do (iset ss (+ f F_Q) (+ qs base))
                                  (iset ss (+ f F_EL) (+ el ks))
                                  (progress ss ks)
                                  (return (cont ss f A_NEXT)))))))))))))
    (if (== (ia ss (+ f F_NALIVE)) 0)
      (do (iset ss (+ f F_PH) A_DEAD)
          (let [ir0 (inline-child p pool b s ss vs cb base q (+ d 1) 0 0 0 end 0 note ext)]
            (if (>= ir0 0) (return (arr-ret p s ss base f (+ ir0 base))))
            (if (!= ir0 NOINL) (return (ret ss base ir0))))
          (return (call ss base q (+ d 1) 0 0 0 end 0 MODE_ITEM note (neg 1)))))
    (let [cr (cset-rec p s ck)
          w (cset-width p cr)
          area (+ fb (* 2 w))
          cfb (+ fb (cset-frame p cr))
          cck (next-ck p s ck)
          cw (cset-width p (cset-rec p s cck))
          e (new-epoch s)
          ao1 (block-ao p s fb area)
          ^:mut cnq 0
          ^:mut bo area]
      (if (== s2 1) (free-on s))
      (for [^I32 bi 0 nb]
        (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
        (let [^:mut ao ao1]
          (if (> bi 0) (set ao (block-ao p s fb bo)))
          (if (!= (ia s (+ bo 1)) 0)
            (do (set cnq (array-candidates p s bo ao el cfb cw cnq e pos))
                (if (< cnq 0) (return (err ss cnq)))))
          (set bo (+ bo (array-words p ao)))))
      (free-off s)
      (path-put s (+ d 1) P_INDEX el)
      (iset ss (+ f F_CNQ) cnq)
      (iset ss (+ f F_PH) A_LIVE)
      (let []
        (local ^I32 ir)
        (if (> cnq 0)
          (set ir (inline-child p pool b s ss vs cb base q (+ d 1) cfb cck cnq end cx note ext))
          (set ir (inline-child p pool b s ss vs cb base q (+ d 1) 0 0 0 end 0 note ext)))
        (if (< ir 0)
          (if (!= ir NOINL) (return (ret ss base ir))))
        (if (>= ir 0) (return (arr-ret p s ss base f (+ ir base)))))
      (if (> cnq 0)
        (return (call ss base q (+ d 1) cfb cck cnq end cx MODE_ITEM note (neg 1))))
      (return (call ss base q (+ d 1) 0 0 0 end 0 MODE_ITEM note (neg 1))))))

(defn ^:pub ^I32 open-darr [^IntsR p ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 d
                            ^I32 end ^I32 pair]
  (let [q (prologue p b s pos end 0 0)]
    (if (< q 0) (return (err ss q)))
    (let [id (indef b s pos d)
          ^:mut lo (ia s O_LO)
          hi (ia s O_HI)
          ^:mut ra 0]
      (if (< id 0) (return (err ss id)))
      (if (== id 1)
        (set lo IND)
        (set ra (enter-pend b s ss base pos q hi lo d 0 end)))
      (if (< ra 0) (return (err ss ra)))
      (let [f (fpush b ss ka base FK_DARR)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (iset ss (+ f F_IND) id)
        (frame-item ss f base pos end d 0 0 0 0)
        (iset ss (+ f F_Q) (+ q base))
        (iset ss (+ f F_N) lo)
        (iset ss (+ f F_PAIR) pair)
        (mark-pair ss pair)
        (return (cont ss f A_NEXT))))))

(defn ^:pub ^I32 open-dseq [^Bytes b ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 d ^I32 end]
  (comment "dead-seq: items at depth d from pos until end.")
  (let [f (fpush b ss ka base FK_DSEQ)]
    (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
    (frame-item ss f base pos end d 0 0 0 0)
    (iset ss (+ f F_Q) (+ pos base))
    (return (cont ss f A_NEXT))))

(defn ^:pub ^I32 darr-ret [^Ints ss ^I32 f ^I32 r]
  (iset ss (+ f F_Q) r)
  (iset ss (+ f F_EL) (+ (ia ss (+ f F_EL)) 1))
  (return (cont ss f A_NEXT)))

;; ------------------------------------------------------------ maps (FK_MAP, FK_DMAP)


(defn ^:pub ^I32 darr-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^Ints vs ^BytesW cb ^I32 base ^I32 f ^Ext ext]
  (comment "The next dead element (or sequence item), or the end.")
  (let [el (ia ss (+ f F_EL))
        q (- (ia ss (+ f F_Q)) base)
        end (- (ia ss (+ f F_END)) base)
        kind (ia ss (+ f F_KIND))]
    (if (== kind FK_DSEQ)
      (do (if (>= q end) (return (done ss base q)))
          (let [sd (ia ss (+ f F_D))
                ir2 (inline-child p pool b s ss vs cb base q sd 0 0 0 end 0 (neg 1) ext)]
            (if (>= ir2 0) (return (darr-ret ss f (+ ir2 base))))
            (if (!= ir2 NOINL) (return (ret ss base ir2)))
            (return (call ss base q sd 0 0 0 end 0 MODE_ITEM (neg 1) (neg 1))))))
    (if (and (== (ia ss (+ f F_IND)) 1) (< el (ia ss (+ f F_N))))
      (do (let [ix (ind-next b s ss base (blen b) f q end)]
            (if (== ix VMS_NEED) (return ix))
            (if (< ix 0) (return (err ss ix)))
            (if (== ix 1) (return (done ss base (- (ia ss (+ f F_Q)) base)))))))
    (if (>= el (ia ss (+ f F_N))) (return (done ss base q)))
    (comment "dead-array's integer streak over what the window and the cut hold")
    (let [cutend (imin end (- (ia ss SS_CUT) base))]
      (if (and (and (== (bit-and (ia s VM_GENERIC) 1) 0) (< (ia ss (+ f F_PAIR)) 0)) (and (>= q 0) (< q cutend)))
        (do (let [qd (dead-int-streak b s q (ind-limit s ss f (- (ia ss (+ f F_N)) el) el) cutend)
                  kd (ia s VM_FASTM)]
              (if (> kd 0)
                (do (iset ss (+ f F_Q) (+ qd base))
                    (iset ss (+ f F_EL) (+ el kd))
                    (progress ss kd)
                    (return (cont ss f A_NEXT))))))))
    (let [dnote (pair-note ss (ia ss (+ f F_PAIR)) el)
          dd (+ (ia ss (+ f F_D)) 1)
          ir1 (inline-child p pool b s ss vs cb base q dd 0 0 0 end 0 dnote ext)]
      (if (>= ir1 0) (return (darr-ret ss f (+ ir1 base))))
      (if (!= ir1 NOINL) (return (ret ss base ir1)))
      (return (call ss base q dd 0 0 0 end 0 MODE_ITEM dnote (neg 1))))))

(defn ^:pub ^I32 map-start [^IntsR p ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 q0 ^I32 n
                            ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (comment "eval-map's start (generic path): filter, blocks, then the frame.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cap (- fw (* 2 w))
        ^:mut nb 0
        ^:mut used 0
        ^:mut ccap 0
        ^:mut smap 0]
    (let [na (q-filter-x p s fb w nq 32 pos ctx)]
      (if (< na 0) (return (err ss na))))
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_MAP))
        (do (let [mt (leaf-map p (q-leaf-base p s fb i))
                  sw (ia p (+ mt 6))]
              (if (> (+ used sw) cap) (return (err ss (neg R_INCONSISTENT))))
              (let [ri (map-block-init p s (+ area used) i mt pos)]
                (if (< ri 0) (return (err ss ri))))
              (set used (+ used sw))
              (set ccap (+ ccap (ia p (+ mt 7))))
              (set nb (+ nb 1))))))
    (if (> (+ used (* 4 ccap)) cap) (return (err ss (neg R_INCONSISTENT))))
    (if (== nb 1) (set smap (map-fast-mode p (block-mt p s fb area))))
    (let [pend (count-pending p s fb w nq)
          f (fpush b ss ka base FK_MAP)]
      (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
      (frame-item ss f base pos end d fb ck nq ctx)
      (iset ss (+ f F_Q) (+ q0 base))
      (iset ss (+ f F_Q0) (+ q0 base))
      (iset ss (+ f F_N) n)
      (iset ss (+ f F_NB) nb)
      (iset ss (+ f F_CL) (+ area used))
      (iset ss (+ f F_CCAP) ccap)
      (iset ss (+ f F_PEND) pend)
      (iset ss (+ f F_NALIVE) nb)
      (iset ss (+ f F_SMAP) smap)
      (iset ss (+ f F_PS) (neg 1))
      (iset ss (+ f F_PE) (neg 1))
      (iset ss (+ f F_VLAST) (neg 1))
      (if (and (== d 0) (!= (ia s O_COSE) 0)) (iset ss (+ f F_COSE) 1))
      (return (cont ss f M_NEXT)))))

(defn ^:pub ^I32 open-map [^IntsR p ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 d ^I32 fb
                           ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (let [q (prologue p b s pos end ck 1)]
    (if (< q 0) (return (err ss q)))
    (let [id (indef b s pos d)]
      (if (< id 0) (return (err ss id)))
      (if (== id 1)
        (do (let [rm0 (map-start p b s ss ka base pos q IND d fb ck nq end ctx)]
              (return (ind-mark ss rm0))))))
    (let [lo (ia s O_LO)
          hi (ia s O_HI)
          rm (enter-pend b s ss base pos q hi lo d 1 end)]
      (if (< rm 0) (return (err ss rm)))
      (return (map-start p b s ss ka base pos q lo d fb ck nq end ctx)))))

(defn ^:pub ^I32 open-dmap [^IntsR p ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 d ^I32 end]
  (let [q (prologue p b s pos end 0 0)]
    (if (< q 0) (return (err ss q)))
    (let [id (indef b s pos d)
          ^:mut lo (ia s O_LO)
          hi (ia s O_HI)
          ^:mut rm 0]
      (if (< id 0) (return (err ss id)))
      (if (== id 1)
        (set lo IND)
        (set rm (enter-pend b s ss base pos q hi lo d 1 end)))
      (if (< rm 0) (return (err ss rm)))
      (let [f (fpush b ss ka base FK_DMAP)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (iset ss (+ f F_IND) id)
        (frame-item ss f base pos end d 0 0 0 0)
        (iset ss (+ f F_Q) (+ q base))
        (iset ss (+ f F_N) lo)
        (iset ss (+ f F_PS) (neg 1))
        (iset ss (+ f F_PE) (neg 1))
        (iset ss (+ f F_VLAST) (neg 1))
        (if (and (== d 0) (!= (ia s O_COSE) 0)) (iset ss (+ f F_COSE) 1))
        (return (cont ss f M_NEXT))))))

(defn ^:pub ^I32 vmap-end [^Ints s ^Ints ss ^Ints vs ^BytesW cb ^BytesW ka ^I32 base ^I32 f]
  (comment "P8.4 (D263, D277): a marked map's deferred duplicate check over its kept"
           "keys at its end, before anything else there: GO, a negated code, or"
           "VMS_GROW.")
  (if (!= (ia ss (+ f F_VMARK)) 1) (return GO))
  (let [rd (vdup-end s ss vs cb ka (ia ss (+ f F_FLOOR)) (ia ss (+ f F_VN))
                     (- (ia ss (+ f F_POS)) base) base)]
    (if (== rd VI_GROW) (return VMS_GROW))
    (if (< rd 0) (return rd))
    (return GO)))

(defn ^:pub ^I32 dmap-end [^Ints s ^Ints ss ^Ints vs ^BytesW cb ^BytesW ka ^I32 base ^I32 f]
  (let [rv (vmap-end s ss vs cb ka base f)]
    (if (== rv VMS_GROW) (return rv))
    (if (< rv 0) (return (err ss rv))))
  (return (done ss base (- (ia ss (+ f F_Q)) base))))

(defn ^:pub ^I32 map-end [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^Ints vs ^BytesW cb ^BytesW ka
                          ^I32 base ^I32 f ^Ext ext]
  (let [rv (vmap-end s ss vs cb ka base f)]
    (if (== rv VMS_GROW) (return rv))
    (if (< rv 0) (return (err ss rv))))
  (let [pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        nq (ia ss (+ f F_NQ))
        ctx (ia ss (+ f F_CTX))
        q (- (ia ss (+ f F_Q)) base)
        q0 (- (ia ss (+ f F_Q0)) base)
        n (ia ss (+ f F_N))
        nb (ia ss (+ f F_NB))
        w (cset-width p (cset-rec p s (ia ss (+ f F_CK))))
        area (+ fb (* 2 w))
        ^:mut be area
        ^:mut best (neg 1)
        ^:mut bestbo 0
        ^:mut unsat 0]
    (for [^I32 _bm 0 nb]
      (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
      (let [mtm (block-mt p s fb be)]
        (if (!= (ia s (+ be 1)) 0)
          (do (if (not (charge s (+ (ia p (+ mtm 2)) (ia p (+ mtm 1))) pos)) (return (err ss (neg R_BUDGET))))
              (if (map-satisfied p s be mtm)
                (q-set-flag s fb w (ia s be) F_MATCHED)
                (do (q-set-flag s fb w (ia s be) (shl R_MISSING 8))
                    (set unsat (+ unsat 1))
                    (let [lid (ia s (+ fb (ia s be)))]
                      (if (or (< best 0) (< lid best))
                        (do (set best lid) (set bestbo be))))))))
        (set be (+ be (ia p (+ mtm 6))))))
    (let [rs (eval-scalars p pool b s fb w nq pos q0 q 32 0 n (unit-of ctx))]
      (if (< rs 0) (return (err ss rs))))
    (let [m (finish-comb p pool b s fb w nq pos q ext)]
      (if (< m 0) (return (err ss m)))
      (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
        (if (> unsat 0)
          (do (let [r4 (map-missing p s bestbo (block-mt p s fb bestbo) d pos)]
                (if (< r4 0) (return (err ss r4)))))
          (do (let [r1 (rule1 s fb w nq d pos)]
                (if (< r1 0) (return (err ss r1))))))))
    (return (done ss base q))))

(defn ^:pub ^I32 key-fix [^Ints s ^I32 r ^I32 delta]
  (comment "A key evaluated over its arena copy (delta = window start - arena"
           "start): its end, error offset or budget stop moved back to the window.")
  (if (>= r 0) (return (+ r delta)))
  (if (== r (neg R_BUDGET))
    (do (let [vp (ia s VM_POS)]
          (iset s VM_POS (+ vp delta)))
        (return r)))
  (if (!= r (neg R_INCONSISTENT))
    (do (let [ep (ia s O_ERR_POS)]
          (iset s O_ERR_POS (+ ep delta)))))
  (return r))

(defn ^:pub ^I32 map-ret [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 r]
  (comment "The value ended at r (absolute): after a live value, each candidate's"
           "value test and each block's update, then the witness; next pair.")
  (if (== (ia ss (+ f F_PH)) M_LVAL)
    (do (let [pos (- (ia ss (+ f F_POS)) base)
              d (ia ss (+ f F_D))
              fb (ia ss (+ f F_FB))
              ck (ia ss (+ f F_CK))
              nb (ia ss (+ f F_NB))
              cl (ia ss (+ f F_CL))
              kid (ia ss (+ f F_KID))
              nc (ia ss (+ f F_NC))
              vnq (ia ss (+ f F_VNQ))
              start (- (ia ss (+ f F_START)) base)
              cr (cset-rec p s ck)
              w (cset-width p cr)
              area (+ fb (* 2 w))
              cfb (+ fb (cset-frame p cr))
              cw (cset-width p (cset-rec p s (next-ck p s ck)))
              ^:mut nalive (ia ss (+ f F_NALIVE))
              ^:mut still 0
              ^:mut bo area]
          (if (== (ia ss (+ f F_PS2)) 1) (free-on s))
          (let [ev (q-stamp s cfb cw vnq pos)]
            (if (< ev 0) (return (err ss ev)))
            (for [^I32 _bl 0 nb]
              (let [mtl (block-mt p s fb bo)]
                (if (!= (ia s (+ bo 1)) 0)
                  (do (let [^:mut c3 (ia s (+ bo 3))]
                        (while (and (< c3 nc) (== (ia s (+ cl (* 4 c3))) bo))
                          (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                          (let [vts3 (cand-vts-mt p s mtl cl c3)
                                t (ts-test p s vts3 ev pos)]
                            (if (< t 0) (return (err ss t)))
                            (if (== t 1)
                              (do (let [kw (+ (+ cl (* 4 c3)) 1)
                                        kv (ia s kw)]
                                    (iset s kw (bit-or kv 2))))))
                          (set c3 (+ c3 1))))
                      (local ^I32 u)
                      (if (simple-struct p mtl)
                        (set u (update-struct p s bo mtl kid cl nc pos))
                        (set u (map-update p s bo mtl kid cl nc pos)))
                      (if (< u 0) (return (err ss u)))
                      (if (== u 1)
                        (set still (+ still 1))
                        (do (set nalive (- nalive 1))
                            (if (block-named s bo cl nc)
                              (q-set-flag s fb w (ia s bo) (shl R_VALUE 8))
                              (q-set-flag s fb w (ia s bo) (shl R_UNEXPECTED 8)))))))
                (set bo (+ bo (ia p (+ mtl 6)))))))
          (free-off s)
          (if (or (> still 0) (> (ia ss (+ f F_PEND)) 0))
            (wit-clear s)
            (if (wit-empty s)
              (if (== (ia ss (+ f F_NAMED)) 1)
                (wit-set s R_VALUE 0 (+ d 1) (neg 1) 0 start)
                (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 start))))
          (iset ss (+ f F_NALIVE) nalive))))
  (iset ss (+ f F_Q) r)
  (iset ss (+ f F_EL) (+ (ia ss (+ f F_EL)) 1))
  (return (cont ss f M_NEXT)))

;; ------------------------------------------------------------ tags (FK_TAG)


(defn ^:pub ^I32 map-pair [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^Ints vs ^BytesW cb
                           ^I32 base ^I32 f ^I32 inka ^Ext ext]
  (comment "A pair whose key is whole -- in the window (inka 0) or copied into the"
           "arena (inka 1) -- after the key's first checks: dead (a dead map, or no"
           "live block) or live (eval-map's generic pair up to the value), then the"
           "value as a child item.")
  (let [start (- (ia ss (+ f F_START)) base)
        end (- (ia ss (+ f F_END)) base)
        pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        km (ia ss (+ f F_KM))
        kea (ia ss (+ f F_KE))
        ka0 (ia ss (+ f F_KA))
        ^:mut klen 0
        ^:mut kks start
        ^:mut kend end
        ^:mut delta 0]
    (if (>= kea 0) (set klen (- kea (ia ss (+ f F_START)))))
    (comment "D085: a key the message ended inside (vms-eof): what was copied, ending there")
    (if (and (< kea 0) (== inka 1)) (set klen (ia ss (+ f F_KGOT))))
    (if (== inka 1)
      (do (set kks ka0)
          (set kend (+ ka0 klen))
          (set delta (- start ka0))))
    (if (or (== (ia ss (+ f F_KIND)) FK_DMAP) (== (ia ss (+ f F_NALIVE)) 0))
      (do (local ^I32 kq0)
          (if (== inka 1)
            (do (let [kr0 (dead-item ka s kks (+ d 1) kend)]
                  (set kq0 (key-fix s kr0 delta))))
            (set kq0 (dead-item b s kks (+ d 1) kend)))
          (if (< kq0 0) (return (err ss kq0)))
          (if (<= km 1)
            (if (not (key-label b s start km)) (return (err ss (fail s start CODE_KEY_TYPE)))))
          (let [ko (key-order-s b ka s ss f base start inka kks (- kq0 start))]
            (if (< ko 0) (return (err ss ko))))
          (if (== inka 1)
            (set-prev-arena ss ka f ka0 klen)
            (set-prev ss f (+ start base) (+ kq0 base)))
          (iset ss (+ f F_PH) M_DVAL)
          (let [ir3 (inline-child p pool b s ss vs cb base kq0 (+ d 1) 0 0 0 end 0 (neg 1) ext)]
            (if (>= ir3 0) (return (map-ret p s ss base f (+ ir3 base))))
            (if (!= ir3 NOINL) (return (ret ss base ir3))))
          (return (call ss base kq0 (+ d 1) 0 0 0 end 0 MODE_ITEM (neg 1) (neg 1)))))
    (let [fb (ia ss (+ f F_FB))
          ck (ia ss (+ f F_CK))
          nb (ia ss (+ f F_NB))
          cl (ia ss (+ f F_CL))
          ccap (ia ss (+ f F_CCAP))
          smap (ia ss (+ f F_SMAP))
          cr (cset-rec p s ck)
          w (cset-width p cr)
          area (+ fb (* 2 w))
          cfb (+ fb (cset-frame p cr))
          cck (next-ck p s ck)
          cw (cset-width p (cset-rec p s cck))
          ^:mut kid (neg 1)
          ^:mut klo (ia ss (+ f F_KLO))
          ^:mut ps2 0
          ^:mut cnq 0
          ^:mut nc 0
          ^:mut named 0
          ^:mut vnq 0]
      (comment "The key's id in the schema-wide key table.")
      (if (>= kea 0)
        (do (if (== inka 1)
              (set kid (key-search p pool ka s kks (+ kks klen) klo pos))
              (set kid (key-search p pool b s kks (+ kks klen) klo pos)))
            (if (== kid (neg 2)) (return (err ss (neg R_BUDGET))))
            (set klo (ia s O_HI))))
      (comment "Cursors, and schedule 2's simple pair (D045 ii).")
      (if (> smap 0)
        (do (let [c0 (ia s (+ area 2))
                  mt0 (block-mt p s fb area)]
              (free-on s)
              (map-cursor p s area mt0 kid pos)
              (free-off s)
              (if (and (sched2 s) (map-pair-ok p s area mt0 kid smap))
                (do (set ps2 1)
                    (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET)))))
                (do (let [c1 (ia s (+ area 2))]
                      (if (not (charge s (+ 1 (- c1 c0)) pos)) (return (err ss (neg R_BUDGET))))))))))
      (comment "The key, queried with the live residual key typesets.")
      (if (== ps2 1) (free-on s))
      (let [e (new-epoch s)
            ^:mut bo area]
        (for [^I32 _bj 0 nb]
          (let [mtj (block-mt p s fb bo)]
            (if (== smap 0)
              (do (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                  (if (!= (ia s (+ bo 1)) 0)
                    (do (let [rc2 (map-cursor p s bo mtj kid pos)]
                          (if (< rc2 0) (return (err ss rc2))))))))
            (if (!= (ia s (+ bo 1)) 0)
              (do (set cnq (map-key-query p s bo mtj cfb cw cnq e pos))
                  (if (< cnq 0) (return (err ss cnq)))))
            (set bo (+ bo (ia p (+ mtj 6)))))))
      (free-off s)
      (local ^I32 kq)
      (if (> cnq 0)
        (do (let [kctx (bit-or CTX_KEY (simple-of p s ps2 cfb cnq))]
              (if (== inka 1)
                (do (let [kr1 (eval-item p pool ka s kks (+ d 1) cfb cck cnq kend kctx ext)]
                      (set kq (key-fix s kr1 delta))))
                (set kq (eval-item p pool b s kks (+ d 1) cfb cck cnq kend kctx ext)))))
        (if (== inka 1)
          (do (let [kr2 (dead-item ka s kks (+ d 1) kend)]
                (set kq (key-fix s kr2 delta))))
          (set kq (dead-item b s kks (+ d 1) kend))))
      (if (< kq 0) (return (err ss kq)))
      (if (<= km 1)
        (if (not (key-label b s start km)) (return (err ss (fail s start CODE_KEY_TYPE)))))
      (let [ko2 (key-order-s b ka s ss f base start inka kks (- kq start))]
        (if (< ko2 0) (return (err ss ko2))))
      (if (== inka 1)
        (set-prev-arena ss ka f ka0 klen)
        (set-prev ss f (+ start base) (+ kq base)))
      (comment "Key phase: candidates.")
      (if (== ps2 1) (free-on s))
      (let [ek (q-stamp s cfb cw cnq pos)
            ^:mut bo2 area]
        (if (< ek 0) (return (err ss ek)))
        (for [^I32 _bk 0 nb]
          (let [mtk (block-mt p s fb bo2)]
            (if (!= (ia s (+ bo2 1)) 0)
              (do (if (simple-struct p mtk)
                    (set nc (key-phase-struct p s bo2 mtk kid cl nc ccap pos))
                    (set nc (map-key-phase p s bo2 mtk kid ek cl nc ccap pos)))
                  (if (< nc 0) (return (err ss nc)))))
            (set bo2 (+ bo2 (ia p (+ mtk 6)))))))
      (for [^I32 c 0 nc]
        (if (== (bit-and (ia s (+ (+ cl (* 4 c)) 1)) 1) 0) (set named 1)))
      (if (== named 1) (path-put s (+ d 1) P_KEY kid) (path-put s (+ d 1) P_ANYKEY 0))
      (comment "The value, queried with the candidates' value typesets.")
      (let [e2 (new-epoch s)]
        (for [^I32 c2 0 nc]
          (let [vts (cand-vts p s fb cl c2)]
            (set vnq (q-add p s cfb cw vnq vts e2 pos)))
          (if (< vnq 0) (return (err ss vnq)))))
      (free-off s)
      (iset ss (+ f F_KLO) klo)
      (iset ss (+ f F_KID) kid)
      (iset ss (+ f F_MCNQ) cnq)
      (iset ss (+ f F_NC) nc)
      (iset ss (+ f F_NAMED) named)
      (iset ss (+ f F_VNQ) vnq)
      (iset ss (+ f F_PS2) ps2)
      (iset ss (+ f F_PH) M_LVAL)
      (let [vctx (simple-of p s ps2 cfb vnq)]
        (local ^I32 ir4)
        (if (> vnq 0)
          (set ir4 (inline-child p pool b s ss vs cb base kq (+ d 1) cfb cck vnq end vctx (neg 1) ext))
          (set ir4 (inline-child p pool b s ss vs cb base kq (+ d 1) 0 0 0 end 0 (neg 1) ext)))
        (if (>= ir4 0) (return (map-ret p s ss base f (+ ir4 base))))
        (if (!= ir4 NOINL) (return (ret ss base ir4)))
        (if (> vnq 0)
          (return (call ss base kq (+ d 1) cfb cck vnq end vctx MODE_ITEM (neg 1) (neg 1))))
        (return (call ss base kq (+ d 1) 0 0 0 end 0 MODE_ITEM (neg 1) (neg 1)))))))

(defn ^:pub ^I32 vkey-eval [^IntsR p ^Bytes pool ^Bytes b ^Bytes kb ^Ints s ^Ints vs ^Bytes cb ^I32 start
                            ^I32 ks ^I32 kend ^I32 copy ^I32 kr ^I32 d ^I32 cfb ^I32 cck ^I32 cnq ^I32 kctx ^Ext ext]
  (comment "P8.4 (D266): a map key evaluated whole (live with cnq > 0) -- in the window"
           "(copy 0: kb is the window, ks the key's start), or over its canonical copy"
           "with its events (copy 1, D264/D280), its offsets mapped back. The key's end"
           "in the window, or a negated code.")
  (if (== copy 0)
    (do (if (> cnq 0) (return (eval-item p pool kb s ks d cfb cck cnq kend kctx ext)))
        (return (dead-item kb s ks d kend))))
  (let [pf (ia s O_PROFILE)
        w0 (ia s VM_W_STATE)
        wr0 (ia s VM_W_REASON)
        ws0 (ia s VM_W_SUB)
        wo0 (ia s VM_W_OFFSET)]
    (local ^I32 r)
    (iset s O_PROFILE (bit-or pf PF_CANON))
    (if (> cnq 0)
      (set r (eval-item p pool kb s ks d cfb cck cnq kend kctx ext))
      (set r (dead-item kb s ks d kend)))
    (iset s O_PROFILE pf)
    (iset s VM_VTAB 0)
    (let [rr (vfix b cb s vs start r w0 wr0 ws0 wo0)]
      (if (>= rr 0)
        (do (if (< kr 0) (iset s O_ERR_POS (ia vs O_ERR_POS)))
            (return kr)))
      (return rr))))

(defn ^:pub ^I32 vkey-pair [^IntsR p ^Bytes pool ^Bytes b ^Bytes kb ^Ints s ^Ints ss ^BytesW ka ^Ints vs
                            ^Bytes cb ^I32 base ^I32 f ^I32 ks ^I32 kend ^I32 klen ^I32 copy ^I32 kr
                            ^I32 canon ^Ext ext]
  (comment "map-pair for a session's valid-CBOR machinery (P8.4, D266): the key whole"
           "in kb[ks, kend) (the window, or its canonical copy), searched, evaluated,"
           "ordered and kept as the walk over a copy does it (vorder, vkeep); then"
           "eval-map's generic pair up to the value, as map-pair.")
  (let [start (- (ia ss (+ f F_START)) base)
        end (- (ia ss (+ f F_END)) base)
        pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        km (ia ss (+ f F_KM))
        prev (ia ss (+ f F_VLAST))
        ^:mut valid 0]
    (if (vrun s) (set valid 1))
    (if (and (>= kr 0) (> (+ (+ (ia ss SS_ATOP) KH) klen) (blen ka)))
      (do (iset s VM_VTAB 0)
          (vgrow ss 0 0 0 (+ (* 2 (blen ka)) (+ KH klen)))
          (return VMS_GROW)))
    (if (or (== (ia ss (+ f F_KIND)) FK_DMAP) (== (ia ss (+ f F_NALIVE)) 0))
      (do (let [kq0 (vkey-eval p pool b kb s vs cb start ks kend copy kr (+ d 1) 0 0 0 0 ext)]
            (if (< kq0 0) (return (err ss kq0)))
            (if (<= km 1)
              (if (not (key-label kb s ks km)) (return (err ss (fail s start CODE_KEY_TYPE)))))
            (let [vo (vorder kb ka s vs ks klen prev canon start valid)]
              (if (< vo 0) (return (err ss vo)))
              (let [ent (vkeep kb ss ka ks klen (+ start base) canon)]
                (iset ss (+ f F_VLAST) ent)
                (iset ss (+ f F_VN) (+ (ia ss (+ f F_VN)) 1))
                (if (!= vo 0) (iset ss (+ f F_VMARK) 1))))
            (iset ss (+ f F_PH) M_DVAL)
            (return (call ss base kq0 (+ d 1) 0 0 0 end 0 MODE_ITEM (neg 1) (neg 1))))))
    (let [fb (ia ss (+ f F_FB))
          ck (ia ss (+ f F_CK))
          nb (ia ss (+ f F_NB))
          cl (ia ss (+ f F_CL))
          ccap (ia ss (+ f F_CCAP))
          smap (ia ss (+ f F_SMAP))
          cr (cset-rec p s ck)
          w (cset-width p cr)
          area (+ fb (* 2 w))
          cfb (+ fb (cset-frame p cr))
          cck (next-ck p s ck)
          cw (cset-width p (cset-rec p s cck))
          kke (key-span-end kb ks kend)
          ^:mut kid (neg 1)
          ^:mut klo (ia ss (+ f F_KLO))
          ^:mut ps2 0
          ^:mut cnq 0
          ^:mut nc 0
          ^:mut named 0
          ^:mut vnq 0]
      (comment "Over a copy keys come in wire order: one at or below the previous key"
               "restarts the search bound and every block's cursor (eval-map, PF_CANON).")
      (if (and (> kke ks) (and (>= prev 0) (== valid 1)))
        (if (vdescends kb ka ks kke prev)
          (do (set klo 0)
              (cursors-reset p s fb area nb))))
      (if (> kke ks)
        (do (set kid (key-search p pool kb s ks kke klo pos))
            (if (== kid (neg 2)) (return (err ss (neg R_BUDGET))))
            (set klo (ia s O_HI))))
      (if (> smap 0)
        (do (let [c0 (ia s (+ area 2))
                  mt0 (block-mt p s fb area)]
              (free-on s)
              (map-cursor p s area mt0 kid pos)
              (free-off s)
              (if (and (sched2 s) (map-pair-ok p s area mt0 kid smap))
                (do (set ps2 1)
                    (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET)))))
                (do (let [c1 (ia s (+ area 2))]
                      (if (not (charge s (+ 1 (- c1 c0)) pos)) (return (err ss (neg R_BUDGET))))))))))
      (if (== ps2 1) (free-on s))
      (let [e (new-epoch s)
            ^:mut bo area]
        (for [^I32 _bj 0 nb]
          (let [mtj (block-mt p s fb bo)]
            (if (== smap 0)
              (do (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                  (if (!= (ia s (+ bo 1)) 0)
                    (do (let [rc2 (map-cursor p s bo mtj kid pos)]
                          (if (< rc2 0) (return (err ss rc2))))))))
            (if (!= (ia s (+ bo 1)) 0)
              (do (set cnq (map-key-query p s bo mtj cfb cw cnq e pos))
                  (if (< cnq 0) (return (err ss cnq)))))
            (set bo (+ bo (ia p (+ mtj 6)))))))
      (free-off s)
      (let [kctx (bit-or CTX_KEY (simple-of p s ps2 cfb cnq))
            kq (vkey-eval p pool b kb s vs cb start ks kend copy kr (+ d 1) cfb cck cnq kctx ext)]
        (if (< kq 0) (return (err ss kq)))
        (if (<= km 1)
          (if (not (key-label kb s ks km)) (return (err ss (fail s start CODE_KEY_TYPE)))))
        (let [vo2 (vorder kb ka s vs ks klen prev canon start valid)]
          (if (< vo2 0) (return (err ss vo2)))
          (let [ent2 (vkeep kb ss ka ks klen (+ start base) canon)]
            (iset ss (+ f F_VLAST) ent2)
            (iset ss (+ f F_VN) (+ (ia ss (+ f F_VN)) 1))
            (if (!= vo2 0) (iset ss (+ f F_VMARK) 1))))
        (if (== ps2 1) (free-on s))
        (let [ek (q-stamp s cfb cw cnq pos)
              ^:mut bo2 area]
          (if (< ek 0) (return (err ss ek)))
          (for [^I32 _bk 0 nb]
            (let [mtk (block-mt p s fb bo2)]
              (if (!= (ia s (+ bo2 1)) 0)
                (do (if (simple-struct p mtk)
                      (set nc (key-phase-struct p s bo2 mtk kid cl nc ccap pos))
                      (set nc (map-key-phase p s bo2 mtk kid ek cl nc ccap pos)))
                    (if (< nc 0) (return (err ss nc)))))
              (set bo2 (+ bo2 (ia p (+ mtk 6)))))))
        (for [^I32 c 0 nc]
          (if (== (bit-and (ia s (+ (+ cl (* 4 c)) 1)) 1) 0) (set named 1)))
        (if (== named 1) (path-put s (+ d 1) P_KEY kid) (path-put s (+ d 1) P_ANYKEY 0))
        (let [e2 (new-epoch s)]
          (for [^I32 c2 0 nc]
            (let [vts (cand-vts p s fb cl c2)]
              (set vnq (q-add p s cfb cw vnq vts e2 pos)))
            (if (< vnq 0) (return (err ss vnq)))))
        (free-off s)
        (iset ss (+ f F_KLO) klo)
        (iset ss (+ f F_KID) kid)
        (iset ss (+ f F_MCNQ) cnq)
        (iset ss (+ f F_NC) nc)
        (iset ss (+ f F_NAMED) named)
        (iset ss (+ f F_VNQ) vnq)
        (iset ss (+ f F_PS2) ps2)
        (iset ss (+ f F_PH) M_LVAL)
        (let [vctx (simple-of p s ps2 cfb vnq)]
          (if (> vnq 0)
            (return (call ss base kq (+ d 1) cfb cck vnq end vctx MODE_ITEM (neg 1) (neg 1))))
          (return (call ss base kq (+ d 1) 0 0 0 end 0 MODE_ITEM (neg 1) (neg 1))))))))

(defn ^:pub ^I32 vkey-start [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^Ints vs ^BytesW cb
                             ^I32 base ^I32 wend ^I32 f ^Ext ext]
  (comment "P8.4 (D266): the key at F_START taken whole by the scanner over the window"
           "(asked for whole, never copied across windows): clean, it is used where it"
           "is; else (not its own DC form, a marked key, refused) its canonical copy.")
  (let [start (- (ia ss (+ f F_START)) base)
        end (- (ia ss (+ f F_END)) base)
        d (ia ss (+ f F_D))
        kr (vscan b s ss vs cb start end wend (+ d 1))]
    (if (== kr VI_NEED) (return (need ss base start (ia ss SS_VNEED))))
    (if (== kr VI_GROW) (return VMS_GROW))
    (if (and (vclean p s vs kr) (or (>= kr 0) (<= end wend)))
      (return (vkey-pair p pool b b s ss ka vs cb base f start end (- kr start) 0 kr 1 ext)))
    (let [^:mut iend kr
          ^:mut refused 0
          ^:mut canon 0]
      (if (< kr 0)
        (do (set refused (neg kr))
            (set iend (imin end wend))))
      (if (and (>= kr 0) (== (bit-and (kclass b vs start) 1) 0)) (set canon 1))
      (let [cs (vbuild p b s ss vs cb start iend refused)]
        (if (== cs VI_GROW) (return VMS_GROW))
        (let [l (ia vs O_VLEN)]
          (return (vkey-pair p pool b cb s ss ka vs cb base f cs l (- l cs) 1 kr canon ext)))))))

(defn ^:pub ^I32 map-next [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^Ints vs ^BytesW cb
                           ^I32 base ^I32 wend ^I32 f ^Ext ext]
  (comment "A pair starts (or the map ends): the key's first byte, major type and"
           "head; then the key whole -- in the window, or copied into the arena"
           "across windows (phase M_KEY) when it crosses.")
  (if (>= (ia ss (+ f F_EL)) (ia ss (+ f F_N)))
    (do (if (== (ia ss (+ f F_KIND)) FK_DMAP)
          (return (dmap-end s ss vs cb ka base f)))
        (return (map-end p pool b s ss vs cb ka base f ext))))
  (let [start (- (ia ss (+ f F_Q)) base)
        end (- (ia ss (+ f F_END)) base)]
    (if (== (ia ss (+ f F_IND)) 1)
      (do (let [ix (ind-next b s ss base wend f start end)]
            (if (== ix VMS_NEED) (return ix))
            (if (< ix 0) (return (err ss ix)))
            (if (== ix 1)
              (do (if (== (ia ss (+ f F_KIND)) FK_DMAP)
                    (return (dmap-end s ss vs cb ka base f)))
                  (return (map-end p pool b s ss vs cb ka base f ext)))))))
    (if (>= start end) (return (err ss (fail s start CODE_TRUNCATED))))
    (if (or (< start 0) (>= start wend)) (return (need ss base start 1)))
    (let [ib (u8 b start)
          km (ushr ib 5)
          ai (bit-and ib 31)
          ^:mut h 1]
      (if (!= km 3)
        (if (not (key-peek s km (== (ia ss (+ f F_COSE)) 1)))
          (return (err ss (fail s start CODE_KEY_TYPE)))))
      (if (<= ai 27) (set h (head-size ai)))
      (let [hh (imin h (- end start))]
        (if (> (+ start hh) wend) (return (need ss base start hh))))
      (if (cut-yield s ss (+ start base)) (return (yld ss base start)))
      (if (vsess s ss)
        (do (iset ss (+ f F_START) (+ start base))
            (iset ss (+ f F_KM) km)
            (progress ss 1)
            (return (vkey-start p pool b s ss ka vs cb base wend f ext))))
      (let [^:mut ke (key-span-end b start end)]
        (comment "A key of any other kind (PF_KEYS any) is asked for whole: its end"
                 "is known only once all its heads are in the window (D124).")
        (if (and (< ke 0) (and (> km 1) (!= km 3)))
          (do (let [kx (key-end-any b start end wend)]
                (comment "D085: a refusal inside the key, after a count that claims past the"
                         "window: the window must reach the claim first")
                (if (and (== kx (neg 1)) (== (ia ss SS_UNK) 1))
                  (do (let [mc (key-max-claim b start end wend)]
                        (if (> mc wend) (return (need ss base start (- mc start)))))))
                (if (< kx (neg 1))
                  (do (let [want (- (- (neg 2) kx) start)]
                        (comment "D212 liveness: exactly what key-end-any needs next (never a"
                                 "doubled window: it could reach past the key and the message)")
                        (return (need ss base start want)))))
                (set ke kx))))
        (iset ss (+ f F_START) (+ start base))
        (iset ss (+ f F_KM) km)
        (if (>= ke 0) (iset ss (+ f F_KE) (+ ke base)) (iset ss (+ f F_KE) (neg 1)))
        (progress ss 1)
        (if (> ke wend)
          (do (keys-save b ss ka base)
              (let [top (ia ss SS_ATOP)]
                (iset ss (+ f F_KA) top)
                (iset ss (+ f F_KGOT) 0)
                (iset ss SS_ATOP (+ top (- ke start))))
              (return (cont ss f M_KEY))))
        (return (map-pair p pool b s ss ka vs cb base f 0 ext))))))

(defn ^:pub ^I32 map-key [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^Ints vs ^BytesW cb
                          ^I32 base ^I32 wend ^I32 f ^Ext ext]
  (comment "Copy the crossing key into the arena, a window at a time (D092). D085:"
           "F_KE -1 is a key the message ended inside -- its pair goes on over the copy.")
  (if (< (ia ss (+ f F_KE)) 0) (return (map-pair p pool b s ss ka vs cb base f 1 ext)))
  (let [start (ia ss (+ f F_START))
        klen (- (ia ss (+ f F_KE)) start)
        got (ia ss (+ f F_KGOT))
        x (- (+ start got) base)]
    (if (or (< x 0) (>= x wend)) (return (need ss base x 1)))
    (if (must-yield s ss) (return (yld ss base x)))
    (let [n (imin (- klen got) (- wend x))
          at (+ (ia ss (+ f F_KA)) got)]
      (bcopy ka at b x n)
      (iset ss (+ f F_KGOT) (+ got n))
      (progress ss (+ 1 (sar n 6)))
      (if (< (+ got n) klen) (return (need ss base (+ x n) 1)))
      (return (map-pair p pool b s ss ka vs cb base f 1 ext)))))

(defn ^:pub ^I32 if-live [^I32 nq]
  (if (> nq 0) (return 1))
  (return 0))

(defn ^:pub ^I32 if-code [^I32 lo]
  (if (== lo 4) (return CODE_DECIMAL))
  (return CODE_NDARRAY))

(defn ^:pub ^I32 ret-direct [^Ints ss ^I32 base ^I32 st]
  (comment "The tag's content was walked whole here: return it to the tag frame"
           "itself, as a child's return.")
  (if (>= st 0) (iset ss SS_RET (+ st base)) (iset ss SS_RET st))
  (iset ss SS_PH PH_RET)
  (return GO))

(defn ^:pub ^I32 open-tag [^IntsR p ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 pos ^I32 d ^I32 fb
                           ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (comment "A tag item whose content crosses the window (tags 4/40, typed arrays"
           "and the standard set's tags; a bignum is always asked whole):"
           "eval-tag's / dead-tag's checks, filter and TAG/TAGSET tests up to the"
           "content.")
  (let [live (if-live nq)
        q (prologue p b s pos end ck live)]
    (if (< q 0) (return (err ss q)))
    (let [hi (ia s O_HI)
          lo (ia s O_LO)
          rt (rule-tag hi lo)
          tsize (typed-size rt)
          std (and (and (!= rt 4) (and (!= rt 40) (== tsize 0))) (std-allowed (ia s O_PROFILE) rt d))]
      (comment "rt: the rule tag (D180); F_TNUM holds it, the TAG/TAGSET tests hi:lo")
      (if (>= d (ia s O_MAX_DEPTH)) (return (err ss (fail s pos CODE_DEPTH))))
      (if (and (!= hi 0) (not (any-tags (ia s O_PROFILE)))) (return (err ss (fail s pos CODE_TAG))))
      (if (and (!= rt 4) (and (!= rt 40) (and (== tsize 0) (not std)))) (return (err ss (fail s pos CODE_TAG))))
      (let [f (fpush b ss ka base FK_TAG)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (frame-item ss f base pos end d fb ck nq ctx)
        (notes-init ss f)
        (iset ss (+ f F_Q) (+ q base))
        (iset ss (+ f F_TNUM) rt)
        (iset ss (+ f F_TSIZE) tsize)
        (iset ss (+ f F_TLIVE) live)
        (iset ss (+ f F_TCLS) 64)
        (iset ss (+ f F_TCS) (+ q base))
        (if (== live 1)
          (do (let [cr (cset-rec p s ck)
                    w (cset-width p cr)
                    cfb (+ fb (cset-frame p cr))
                    cck (next-ck p s ck)
                    cw (cset-width p (cset-rec p s cck))
                    na (q-filter-x p s fb w nq 64 pos ctx)
                    ^:mut cnq 0]
                (if (< na 0) (return (err ss na)))
                (let [e (new-epoch s)]
                  (for [^I32 i 0 nq]
                    (let [fi (q-flag s fb w i)
                          kind (q-kind p s fb i)]
                      (if (and (!= (bit-and fi F_ADMITTED) 0) (or (== kind K_TAG) (== kind K_TAGSET)))
                        (do (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                            (let [lb (q-leaf-base p s fb i)
                                  istag (== kind K_TAG)
                                  hit (or (and istag (and (== (ia p (+ lb 2)) hi) (== (ia p (+ lb 3)) lo)))
                                          (and (not istag)
                                               (and (<= (cmp-u64 (ia p (+ lb 2)) (ia p (+ lb 3)) hi lo) 0)
                                                    (>= (cmp-u64 (ia p (+ lb 4)) (ia p (+ lb 5)) hi lo) 0))))
                                  ^:mut cts (ia p (+ lb 6))]
                              (if istag (set cts (ia p (+ lb 4))))
                              (if hit
                                (do (q-set-flag s fb w i F_EVAL)
                                    (set cnq (q-add p s cfb cw cnq cts e pos))
                                    (if (< cnq 0) (return (err ss cnq))))
                                (q-set-flag s fb w i (shl R_TAG 8)))))))))
                (if (> cnq 0) (path-put s (+ d 1) P_TAG 0))
                (iset ss (+ f F_TCNQ) cnq))))
        (if (> tsize 0)
          (do (if (== live 1)
                (if (not (charge s 1 q)) (return (err ss (neg R_BUDGET)))))
              (return (cont ss f T_CHEAD))))
        (if std
          (do (comment "tags 0, 1, 24, 32 read their content again after its walk:"
                       "pinned until then (D094 replay)")
                (if (or (or (== rt 0) (== rt 1)) (or (== rt 24) (== rt 32))) (iset ss (+ f F_PIN) (+ q base)))
                (return (cont ss f T_STD))))
        (return (cont ss f T_PAIR))))))

(defn ^:pub ^I32 std-need [^Bytes b ^I32 tag ^I32 q ^I32 stop ^I32 wend]
  (comment "How far from q a standard tag's content b[q, stop) must be in the window"
           "for dead-std-check: nothing for tags 21-23 and 55799 (q); else its first"
           "byte, then the whole of a text (tags 0, 32) or byte string (24), at most 9"
           "bytes for tag 1 (these four are pinned). An any-level typed array's rule"
           "was decided at its content's head (T_STD, D180): nothing. Ask again once"
           "the window holds the answer.")
  (if (not (or (or (== tag 0) (== tag 1)) (or (== tag 24) (== tag 32)))) (return q))
  (if (or (< q 0) (>= q wend)) (return (+ q 1)))
  (let [major (ushr (u8 b q) 5)]
    (if (== tag 1) (return (imin stop (+ q 9))))
    (if (and (== major 3) (or (== tag 0) (== tag 32))) (return stop))
    (if (and (== major 2) (== tag 24)) (return stop))
    (return (+ q 1))))

(defn ^:pub ^I32 tail-need [^IntsR p ^IntsR s ^Ints ss ^I32 f]
  (comment "Does the typed array's content query read its content (bstr-tail's"
           "LIT/LITSET, `.bits` or EMBED)? 1 or 0.")
  (if (== (ia ss (+ f F_TLIVE)) 0) (return 0))
  (let [cnq (ia ss (+ f F_TCNQ))]
    (if (== cnq 0) (return 0))
    (let [ck (ia ss (+ f F_CK))
          fb (ia ss (+ f F_FB))
          cr (cset-rec p s ck)
          cfb (+ fb (cset-frame p cr))
          q (ia ss (+ f F_Q))
          cs (ia ss (+ f F_TCS))
          stop (ia ss (+ f F_TSTOP))]
      (if (!= (lits-need p s cfb cnq 4 (- stop q)) 0) (return 1))
      (if (bstr-reads p s cfb cnq (- stop cs)) (return 1))
      (return 0))))

(defn ^:pub ^I32 tag-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^BytesW ka ^I32 base ^I32 wend ^I32 f ^Ext ext]
  (let [ph (ia ss (+ f F_PH))
        pos (- (ia ss (+ f F_POS)) base)
        end (- (ia ss (+ f F_END)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        ck (ia ss (+ f F_CK))
        q (- (ia ss (+ f F_Q)) base)
        lo (ia ss (+ f F_TNUM))
        live (ia ss (+ f F_TLIVE))
        cnq (ia ss (+ f F_TCNQ))]
    (if (== ph T_CHEAD)
      (do (comment "dead-typed: the content's byte-string head, its length, the element"
                   "size-h, the NaN scan's charge.")
          (if (< q end)
            (do (if (or (< q 0) (>= q wend)) (return (need ss base q 1)))
                (let [ai-h (bit-and (u8 b q) 31)
                      ^:mut h-h 1]
                  (if (<= ai-h 27) (set h-h (head-size ai-h)))
                  (let [hh-h (imin h-h (- end q))]
                    (if (> (+ q hh-h) wend) (return (need ss base q hh-h)))))))
          (let [stop-h (bytes-content b s q CODE_TYPED_ARRAY end)]
            (if (< stop-h 0) (return (err ss stop-h)))
            (pend-note b s ss base stop-h q)
            (let [cs-h (ia s O_CSTART)
                  size-h (ia ss (+ f F_TSIZE))]
              (if (!= (rem (- stop-h cs-h) size-h) 0) (return (err ss (fail s pos CODE_TYPED_ARRAY))))
              (iset ss (+ f F_TCS) (+ cs-h base))
              (iset ss (+ f F_TSTOP) (+ stop-h base))
              (iset ss (+ f F_TI) (+ cs-h base))
              (comment "the NaN rule is the Bindle tag set's (tag level 0, D265: dead-typed)")
              (if (and (>= lo 84) (== (bit-and (ia s O_PROFILE) PF_TAGS) 0))
                (do (if (not (charge s (c64 (- stop-h cs-h)) pos)) (return (err ss (neg R_BUDGET))))
                    (if (== (tail-need p s ss f) 1) (iset ss (+ f F_PIN) (+ q base)))
                    (return (cont ss f T_NAN))))
              (return (cont ss f T_TAIL))))))
    (if (== ph T_NAN)
      (do (let [r (typed-scan b s ss base wend f)]
            (if (suspended r) (return r))
            (if (< r 0) (return (err ss r)))
            (return (cont ss f T_TAIL)))))
    (if (== ph T_TAIL)
      (do (let [cs-t (- (ia ss (+ f F_TCS)) base)
                stop-t (- (ia ss (+ f F_TSTOP)) base)]
            (if (and (== live 1) (> cnq 0))
              (do (let [cr-t (cset-rec p s ck)
                        cfb-t (+ fb (cset-frame p cr-t))
                        cck-t (next-ck p s ck)
                        ln-t (lits-need p s cfb-t cnq 4 (- stop-t q))]
                    (if (< ln-t 0)
                      (do (let [g-t (ensure ss base wend q stop-t)]
                            (if (suspended g-t) (return g-t))))
                      (do (let [g2-t (ensure ss base wend q (+ q ln-t))]
                            (if (suspended g2-t) (return g2-t)))
                          (if (bstr-reads p s cfb-t cnq (- stop-t cs-t))
                            (do (iset ss (+ f F_PH) T_TAILRET)
                                (return (open-bstr p pool b s ss ka base q (+ d 1) cfb-t cck-t cnq end 0 1 cs-t stop-t))))))
                    (let [rb-t (bstr-tail p pool b s q cs-t stop-t (+ d 1) cfb-t cck-t cnq 0 ext)]
                      (if (< rb-t 0) (return (err ss rb-t)))))))
            (return (cont ss f T_FIN)))))
    (if (== ph T_STD)
      (do (comment "A standard-set tag's content: the child item (live or dead) at d + 1."
                   "An any-level typed array (D180) decides its rule from the content's"
                   "head first, held in F_TNOTED (1 refused) and reported after the walk,"
                   "so its content is never pinned.")
          (if (> (typed-any-size lo) 0)
            (do (let [^:mut bad 1]
                  (if (< q end)
                    (do (if (or (< q 0) (>= q wend)) (return (need ss base q 1)))
                        (let [ai-s (bit-and (u8 b q) 31)
                              ^:mut h-s 1]
                          (if (<= ai-s 27) (set h-s (head-size ai-s)))
                          (let [hh-s (imin h-s (- end q))]
                            (if (> (+ q hh-s) wend) (return (need ss base q hh-s))))
                          (if (and (<= ai-s 27) (<= (+ q h-s) end))
                            (if (std-content-ok b lo q end) (set bad 0))))))
                  (iset ss (+ f F_TNOTED) bad))))
          (iset ss (+ f F_PH) T_STDRET)
          (if (and (== live 1) (> cnq 0))
            (do (let [crs (cset-rec p s ck)
                      cfbs (+ fb (cset-frame p crs))
                      ccks (next-ck p s ck)]
                  (return (call ss base q (+ d 1) cfbs ccks cnq end 0 MODE_ITEM (neg 1) (neg 1))))))
          (return (call ss base q (+ d 1) 0 0 0 end 0 MODE_ITEM (neg 1) (neg 1)))))
    (if (== ph T_STDCHK)
      (do (comment "dead-std-check over the content, read again (pinned).")
          (let [stop-s (- (ia ss (+ f F_TSTOP)) base)
                rq1 (std-need b lo q stop-s wend)
                g1 (ensure ss base wend q rq1)]
            (if (suspended g1) (return g1))
            (let [rq2 (std-need b lo q stop-s wend)
                  g2 (ensure ss base wend q rq2)]
              (if (suspended g2) (return g2)))
            (let [ta (typed-any-size lo)
                  ^:mut rs lo]
              (if (> ta 0) (set rs (neg 1)))
              (let [vs (dead-std-check b s pos rs q stop-s d)]
                (if (< vs 0) (return (err ss vs))))
              (if (and (> ta 0) (== (ia ss (+ f F_TNOTED)) 1)) (return (err ss (fail s pos CODE_TAG)))))
            (iset ss (+ f F_PIN) (neg 1))
            (iset ss (+ f F_TCS) (+ q base))
            (return (cont ss f T_FIN)))))
    (if (== ph T_PAIR)
      (do (if (< q end)
            (if (or (< q 0) (>= q wend)) (return (need ss base q 1))))
          (let [pc (pair-check b s pos q (if-code lo) end)]
            (if (< pc 0) (return (err ss pc))))
          (iset ss (+ f F_PH) T_PAIRRET)
          (let [me (fidx ss f)]
            (if (and (== live 1) (> cnq 0))
              (do (let [cr2 (cset-rec p s ck)
                        cfb2 (+ fb (cset-frame p cr2))
                        cck2 (next-ck p s ck)]
                    (return (call ss base q (+ d 1) cfb2 cck2 cnq end 0 MODE_ITEM (neg 1) me)))))
            (if (== (prescan b ss base q end (- (ia ss SS_CUT) base)) 1)
              (do (let [st (dead-pair-body b s q d end)]
                    (return (ret-direct ss base st)))))
            (return (call ss base q (+ d 1) 0 0 0 end 0 MODE_FRAME (neg 1) me)))))
    (comment "T_FIN: the content's typeset tests, the tag's scalar leaves, the end.")
    (let [stop-f (- (ia ss (+ f F_TSTOP)) base)
          cs-f (- (ia ss (+ f F_TCS)) base)]
      (if (== live 0) (return (done ss base stop-f)))
      (let [cr-f (cset-rec p s ck)
            w-f (cset-width p cr-f)
            nq-f (ia ss (+ f F_NQ))
            ctx-f (ia ss (+ f F_CTX))
            cfb-f (+ fb (cset-frame p cr-f))
            cw-f (cset-width p (cset-rec p s (next-ck p s ck)))
            ec-f (q-stamp s cfb-f cw-f cnq pos)]
        (if (< ec-f 0) (return (err ss ec-f)))
        (for [^I32 j-f 0 nq-f]
          (let [fj-f (q-flag s fb w-f j-f)]
            (if (!= (bit-and fj-f F_EVAL) 0)
              (do (let [lbj-f (q-leaf-base p s fb j-f)
                        ^:mut ctj-f (ia p (+ lbj-f 4))]
                    (if (== (q-kind p s fb j-f) K_TAGSET) (set ctj-f (ia p (+ lbj-f 6))))
                    (let [t-f (ts-test p s ctj-f ec-f pos)]
                      (if (< t-f 0) (return (err ss t-f)))
                      (if (== t-f 1)
                        (q-set-flag s fb w-f j-f F_MATCHED)
                        (q-set-flag s fb w-f j-f (shl R_TYPE 8)))))))))
        (let [r2-f (eval-scalars p pool b s fb w-f nq-f pos cs-f stop-f 64 0 lo (unit-of ctx-f))]
          (if (< r2-f 0) (return (err ss r2-f))))
        (if (> (count-matched p s fb w-f nq-f) 0) (wit-clear s))
        (let [r3-f (finish-scalar p pool b s fb w-f nq-f d pos stop-f ctx-f ext)]
          (if (< r3-f 0) (return (err ss r3-f))))
        (return (done ss base stop-f))))))

(defn ^:pub ^I32 tag-ret [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 r]
  (comment "The tag's content (or its typed array's tail) ended at r (absolute).")
  (if (== (ia ss (+ f F_PH)) T_TAILRET) (return (cont ss f T_FIN)))
  (if (== (ia ss (+ f F_PH)) T_STDRET)
    (do (iset ss (+ f F_TSTOP) r)
        (return (cont ss f T_STDCHK))))
  (let [pos (- (ia ss (+ f F_POS)) base)
        q (- (ia ss (+ f F_Q)) base)
        lo (ia ss (+ f F_TNUM))
        stop (- r base)]
    (local ^I32 v)
    (if (== (ia ss (+ f F_TNOTED)) 0)
      (if (== lo 4)
        (set v (decimal-check b s pos q stop))
        (set v (ndarray-check b s pos q stop)))
      (set v (pair-verdict s ss f lo pos)))
    (if (< v 0) (return (err ss v)))
    (iset ss (+ f F_TSTOP) r)
    (iset ss (+ f F_TCS) (+ q base))
    (return (cont ss f T_FIN))))
