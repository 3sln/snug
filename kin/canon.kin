;; Canonical forms of CHECKED CBOR (P8.4; D261-D264, architecture §19.2-§19.5).
;; Every function here reads bytes a walk has already validated as well-formed
;; items (so a head is in bounds, a count is real, a break is where it must be)
;; and decides nothing about validity: it reads values (any head width, either
;; length kind), writes canonical forms and compares them.
;;
;; * DC, the deterministic canonical form: the RFC 8949 §4.2.1 encoding of the
;;   item's value with map pairs in WIRE order -- shortest heads, definite
;;   lengths, a string's chunks concatenated, every float in the shortest width
;;   that holds its exact bits (sign, NaN payload, signalling bit), bignum and
;;   string content byte for byte.
;; * EC, the equivalence form of §5.6.1: DC with float zeros positive, NaN signs
;;   cleared, and every map's pairs sorted by their keys' EC bytes. Two map keys
;;   are duplicates iff their EC forms are equal.
;;
;; The writer works WITHIN one byte buffer (the source item is already in it, the
;; form is written after it), so one implementation serves the canonical copy,
;; the duplicate check's key forms and the session's key arena. Records (three
;; words: form address, form length, key offset or pair end) live on a stack in
;; the scanner's options array past its 16 frozen words (codes.kin O_S_*); a
;; form address >= 0 is a byte of the buffer, < 0 is the input byte -1 - a.
;; Integer-only (D009).
(ns snug.cbor.canon
  (:require [kin.lang :refer [defn let local return set if while for do comment declarefn break forever]]
            [snug.lang :refer [I32 Bool Bytes BytesW Ints IntsR + - * neg shl sar ushr bit-and bit-or
                               bit-xor bit-not < > <= >= == != and or not ult u8 blen ia iset ilen bset bcopy hex]]
            [snug.cbor.codes :refer [O_HI O_LO O_CSTART O_ERR_POS CODE_DUPLICATE_KEY CODE_SCRATCH
                                     O_S_RTOP O_S_DLOW O_S_UNITS O_S_CBTOP O_VNEEDW O_VNEEDB]]
            [snug.cbor.head :refer [be16 be32 fail]]
            [snug.cbor.float :refer [low-zero low-zero64]]
            [snug.cbor.keys :refer [compare-spans]]))

(declarefn tskip cw kclass-rec)

;; ------------------------------------------------------------ trusted reading

(defn ^:pub ^I32 targ [^Bytes b ^Ints o ^I32 x]
  (comment "The CHECKED head at x: its argument into o[O_HI], o[O_LO] (0 for an"
           "indefinite head, whose AI 31 says so), any width; answers the position"
           "after the head. Float heads read their bits the same way.")
  (let [ai (bit-and (u8 b x) 31)]
    (iset o O_HI 0)
    (if (< ai 24) (do (iset o O_LO ai) (return (+ x 1))))
    (if (== ai 24) (do (iset o O_LO (u8 b (+ x 1))) (return (+ x 2))))
    (if (== ai 25) (do (iset o O_LO (be16 b (+ x 1))) (return (+ x 3))))
    (if (== ai 26) (do (iset o O_LO (be32 b (+ x 1))) (return (+ x 5))))
    (if (== ai 27)
      (do (iset o O_HI (be32 b (+ x 1)))
          (iset o O_LO (be32 b (+ x 5)))
          (return (+ x 9))))
    (iset o O_LO 0)
    (return (+ x 1))))

(defn ^:pub ^I32 tskip [^Bytes b ^Ints o ^I32 x]
  (comment "The end of the CHECKED item at x: heads of any width, both length"
           "kinds, a tag's content; recursion as deep as the item.")
  (let [ib (u8 b x)
        major (ushr ib 5)
        ai (bit-and ib 31)
        ^:mut q (targ b o x)]
    (if (or (<= major 1) (== major 7)) (return q))
    (if (== major 6) (return (tskip b o q)))
    (if (<= major 3)
      (do (if (!= ai 31) (return (+ q (ia o O_LO))))
          (while (!= (u8 b q) 255)
            (set q (targ b o q))
            (set q (+ q (ia o O_LO))))
          (return (+ q 1))))
    (if (== ai 31)
      (do (while (!= (u8 b q) 255)
            (set q (tskip b o q)))
          (return (+ q 1))))
    (let [^:mut n (ia o O_LO)]
      (if (== major 5) (set n (* 2 n)))
      (for [^I32 _i 0 n]
        (set q (tskip b o q)))
      (return q))))

(defn ^:pub ^I32 tcount [^Bytes b ^Ints o ^I32 x]
  (comment "The items between x and the break that ends an indefinite array or map"
           "(a map's are twice its pairs).")
  (let [^:mut q x
        ^:mut k 0]
    (while (!= (u8 b q) 255)
      (set q (tskip b o q))
      (set k (+ k 1)))
    (return k)))

(defn ^:pub ^I32 tlength [^Bytes b ^Ints o ^I32 x]
  (comment "The content length of the CHECKED string item at x: its argument, or"
           "for an indefinite string the sum of its chunks' lengths.")
  (let [ai (bit-and (u8 b x) 31)
        ^:mut q (targ b o x)
        ^:mut t 0]
    (if (!= ai 31) (return (ia o O_LO)))
    (while (!= (u8 b q) 255)
      (set q (targ b o q))
      (set t (+ t (ia o O_LO)))
      (set q (+ q (ia o O_LO))))
    (return t)))

(defn ^:pub ^I32 chunk-pos [^Bytes b ^Ints o ^I32 x ^I32 k]
  (comment "Where content byte k (0 <= k < its length) of the CHECKED string item at"
           "x lies in b: after the head for a definite string, inside its chunk for"
           "an indefinite one.")
  (let [ai (bit-and (u8 b x) 31)
        ^:mut q (targ b o x)
        ^:mut left k]
    (if (!= ai 31) (return (+ q k)))
    (while (!= (u8 b q) 255)
      (set q (targ b o q))
      (let [n (ia o O_LO)]
        (if (< left n) (return (+ q left)))
        (set left (- left n))
        (set q (+ q n))))
    (return q)))

;; ------------------------------------------------------------ float widths

(defn ^:pub ^Bool fits16 [^I32 w]
  (comment "Does float16 hold the float32 pattern w exactly, bit for bit (sign, NaN"
           "payload and signalling bit included)?")
  (let [e (bit-and (sar w 23) 255)
        m (bit-and w (hex 8388607))]
    (if (== e 255) (return (low-zero m 13)))
    (if (== e 0) (return (== m 0)))
    (let [x (- e 127)]
      (if (and (>= x (neg 14)) (<= x 15)) (return (low-zero m 13)))
      (if (and (>= x (neg 24)) (<= x (neg 15))) (return (low-zero m (- (neg 1) x))))
      (return false))))

(defn ^:pub ^I32 to16 [^I32 w]
  (comment "The float16 pattern of a float32 pattern w that fits16.")
  (let [sg (bit-and (ushr w 16) (hex 32768))
        e (bit-and (sar w 23) 255)
        m (bit-and w (hex 8388607))]
    (if (== e 255) (return (bit-or (bit-or sg (hex 31744)) (ushr m 13))))
    (if (== e 0) (return sg))
    (let [x (- e 127)]
      (if (>= x (neg 14)) (return (bit-or (bit-or sg (shl (+ x 15) 10)) (ushr m 13))))
      (return (bit-or sg (ushr (bit-or m (hex 8388608)) (- (neg 1) x)))))))

(defn ^:pub ^Bool fits32 [^I32 hi ^I32 lo]
  (comment "Does float32 hold the float64 pattern hi:lo exactly, bit for bit?")
  (let [e (bit-and (sar hi 20) (hex 2047))
        mh (bit-and hi (hex 1048575))]
    (if (== e 2047) (return (low-zero lo 29)))
    (if (== e 0) (return (and (== mh 0) (== lo 0))))
    (let [x (- e 1023)]
      (if (and (>= x (neg 126)) (<= x 127)) (return (low-zero lo 29)))
      (if (and (>= x (neg 149)) (<= x (neg 127))) (return (low-zero64 mh lo (- (neg 97) x))))
      (return false))))

(defn ^:pub ^I32 to32 [^I32 hi ^I32 lo]
  (comment "The float32 pattern of a float64 pattern hi:lo that fits32.")
  (let [sg (bit-and hi (shl 1 31))
        e (bit-and (sar hi 20) (hex 2047))
        mh (bit-and hi (hex 1048575))
        f23 (bit-or (shl mh 3) (ushr lo 29))]
    (if (== e 2047) (return (bit-or (bit-or sg (hex 2139095040)) f23)))
    (if (== e 0) (return sg))
    (let [x (- e 1023)]
      (if (>= x (neg 126)) (return (bit-or (bit-or sg (shl (+ x 127) 23)) f23)))
      (let [sh (- (neg 97) x)
            h53 (bit-or mh (hex 1048576))]
        (if (>= sh 32) (return (bit-or sg (ushr h53 (- sh 32)))))
        (return (bit-or sg (bit-or (shl h53 (- 32 sh)) (ushr lo sh))))))))

;; ------------------------------------------------------------ classification

(defn ^:pub ^Bool head-short [^Bytes b ^I32 x]
  (comment "Is the CHECKED head at x in shortest form and definite (a float head is"
           "judged by fits16 / fits32, f8 by its value)?")
  (let [ib (u8 b x)
        major (ushr ib 5)
        ai (bit-and ib 31)]
    (if (< ai 24) (return true))
    (if (== ai 31) (return false))
    (if (== major 7)
      (do (if (== ai 24) (return true))
          (if (== ai 25) (return true))
          (if (== ai 26) (return (not (fits16 (be32 b (+ x 1))))))
          (return (not (fits32 (be32 b (+ x 1)) (be32 b (+ x 5)))))))
    (if (== ai 24) (return (>= (u8 b (+ x 1)) 24)))
    (if (== ai 25) (return (!= (u8 b (+ x 1)) 0)))
    (if (== ai 26) (return (!= (ushr (be32 b (+ x 1)) 16) 0)))
    (return (!= (be32 b (+ x 1)) 0))))

(defn ^:pub ^Bool float-ecs [^Bytes b ^I32 x]
  (comment "Is the CHECKED float at x a zero or a NaN (its EC form can differ from"
           "its DC form)?")
  (let [ai (bit-and (u8 b x) 31)]
    (if (== ai 25)
      (do (let [h (be16 b (+ x 1))]
            (if (== (bit-and h (hex 32767)) 0) (return true))
            (return (and (== (bit-and h (hex 31744)) (hex 31744)) (!= (bit-and h 1023) 0))))))
    (if (== ai 26)
      (do (let [w (be32 b (+ x 1))]
            (if (== (bit-and w (hex 2147483647)) 0) (return true))
            (return (and (== (bit-and w (hex 2139095040)) (hex 2139095040)) (!= (bit-and w (hex 8388607)) 0))))))
    (let [hi (be32 b (+ x 1))
          lo (be32 b (+ x 5))]
      (if (and (== (bit-and hi (hex 2147483647)) 0) (== lo 0)) (return true))
      (return (and (== (bit-and hi (hex 2146435072)) (hex 2146435072))
                   (or (!= (bit-and hi (hex 1048575)) 0) (!= lo 0)))))))

(defn ^:pub ^I32 kclass-rec [^Bytes b ^Ints o ^I32 x]
  (comment "kclass's walk: the item's end; bits OR-ed into o[O_CSTART].")
  (let [ib (u8 b x)
        major (ushr ib 5)
        ai (bit-and ib 31)]
    (if (not (head-short b x)) (iset o O_CSTART (bit-or (ia o O_CSTART) 1)))
    (if (and (== major 7) (and (>= ai 25) (<= ai 27)))
      (if (float-ecs b x) (iset o O_CSTART (bit-or (ia o O_CSTART) 2))))
    (let [^:mut q (targ b o x)]
      (if (or (<= major 1) (== major 7)) (return q))
      (if (== major 6) (return (kclass-rec b o q)))
      (if (<= major 3)
        (do (if (!= ai 31) (return (+ q (ia o O_LO))))
            (while (!= (u8 b q) 255)
              (set q (targ b o q))
              (set q (+ q (ia o O_LO))))
            (return (+ q 1))))
      (local ^:mut ^I32 n)
      (if (== ai 31)
        (set n (tcount b o q))
        (do (set n (ia o O_LO))
            (if (== major 5) (set n (* 2 n)))))
      (if (== major 4)
        (for [^I32 _i 0 n]
          (set q (kclass-rec b o q))))
      (if (== major 5)
        (do (comment "a map whose keys are not in canonical order sorts differently in EC")
            (let [^:mut ps (neg 1)
                  ^:mut pe (neg 1)]
              (for [^I32 _j 0 (sar n 1)]
                (let [ks q]
                  (set q (kclass-rec b o q))
                  (if (and (>= ps 0) (>= (compare-spans b ps pe ks q) 0))
                    (iset o O_CSTART (bit-or (ia o O_CSTART) 2)))
                  (set ps ks)
                  (set pe q)
                  (set q (kclass-rec b o q)))))))
      (if (== ai 31) (set q (+ q 1)))
      (return q))))

(defn ^:pub ^I32 kclass [^Bytes b ^Ints o ^I32 x]
  (comment "A CHECKED key's class: bit 0 it is not canonical (a head not shortest or"
           "indefinite, a float in a wider width than its bits need), bit 1 it is"
           "EC-sensitive (it holds a float zero, a NaN or a map whose keys are not"
           "in canonical order, so its EC form may differ from its DC form). With"
           "both bits clear its bytes are its DC and EC form.")
  (iset o O_CSTART 0)
  (kclass-rec b o x)
  (return (ia o O_CSTART)))

;; ------------------------------------------------------------ writing

(defn ^:pub ^I32 put-head [^BytesW cb ^I32 y ^I32 major ^I32 hi ^I32 lo]
  (comment "The shortest head of major with argument hi:lo at cb[y]; answers its end,"
           "or -1 when cb is too short.")
  (let [mt (shl major 5)
        n (blen cb)]
    (if (!= hi 0)
      (do (if (> (+ y 9) n) (return (neg 1)))
          (bset cb y (+ mt 27))
          (bset cb (+ y 1) (ushr hi 24))
          (bset cb (+ y 2) (ushr hi 16))
          (bset cb (+ y 3) (ushr hi 8))
          (bset cb (+ y 4) hi)
          (bset cb (+ y 5) (ushr lo 24))
          (bset cb (+ y 6) (ushr lo 16))
          (bset cb (+ y 7) (ushr lo 8))
          (bset cb (+ y 8) lo)
          (return (+ y 9))))
    (if (and (>= lo 0) (< lo 24))
      (do (if (>= y n) (return (neg 1)))
          (bset cb y (+ mt lo))
          (return (+ y 1))))
    (if (and (>= lo 0) (< lo 256))
      (do (if (> (+ y 2) n) (return (neg 1)))
          (bset cb y (+ mt 24))
          (bset cb (+ y 1) lo)
          (return (+ y 2))))
    (if (and (>= lo 0) (< lo 65536))
      (do (if (> (+ y 3) n) (return (neg 1)))
          (bset cb y (+ mt 25))
          (bset cb (+ y 1) (ushr lo 8))
          (bset cb (+ y 2) lo)
          (return (+ y 3))))
    (if (> (+ y 5) n) (return (neg 1)))
    (bset cb y (+ mt 26))
    (bset cb (+ y 1) (ushr lo 24))
    (bset cb (+ y 2) (ushr lo 16))
    (bset cb (+ y 3) (ushr lo 8))
    (bset cb (+ y 4) lo)
    (return (+ y 5))))

(defn ^:pub ^I32 move-within [^BytesW cb ^I32 from ^I32 to ^I32 n]
  (comment "Copy cb[from, from + n) to cb[to, ...): forward when to <= from, else"
           "backward, so overlap either way is safe. Answers to + n.")
  (if (<= to from)
    (do (let [^:mut j 0]
          (while (< j n)
            (let [v (u8 cb (+ from j))]
              (bset cb (+ to j) v))
            (set j (+ j 1)))))
    (do (let [^:mut k n]
          (while (> k 0)
            (set k (- k 1))
            (let [v2 (u8 cb (+ from k))]
              (bset cb (+ to k) v2))))))
  (return (+ to n)))

(defn ^:pub ^I32 cw-float [^BytesW cb ^I32 x ^I32 y ^I32 mode]
  (comment "A float in its shortest exact width; mode 1 (EC) makes a zero positive"
           "and clears a NaN's sign first.")
  (let [ai (bit-and (u8 cb x) 31)
        n (blen cb)
        ^:mut h 0
        ^:mut w 0
        ^:mut wd 2]
    (if (== ai 25) (set h (be16 cb (+ x 1))))
    (if (== ai 26)
      (do (set w (be32 cb (+ x 1)))
          (if (== mode 1)
            (do (if (== (bit-and w (hex 2147483647)) 0) (set w 0))
                (if (and (== (bit-and w (hex 2139095040)) (hex 2139095040)) (!= (bit-and w (hex 8388607)) 0))
                  (set w (bit-and w (hex 2147483647))))))
          (if (fits16 w) (set h (to16 w)) (set wd 4))))
    (if (== ai 27)
      (do (let [^:mut hi (be32 cb (+ x 1))
                lo (be32 cb (+ x 5))]
            (if (== mode 1)
              (do (if (and (== (bit-and hi (hex 2147483647)) 0) (== lo 0)) (set hi 0))
                  (if (and (== (bit-and hi (hex 2146435072)) (hex 2146435072))
                           (or (!= (bit-and hi (hex 1048575)) 0) (!= lo 0)))
                    (set hi (bit-and hi (hex 2147483647))))))
            (if (fits32 hi lo)
              (do (set w (to32 hi lo))
                  (if (fits16 w) (set h (to16 w)) (set wd 4)))
              (do (if (> (+ y 9) n) (return (neg 1)))
                  (bset cb y (hex 251))
                  (bset cb (+ y 1) (ushr hi 24))
                  (bset cb (+ y 2) (ushr hi 16))
                  (bset cb (+ y 3) (ushr hi 8))
                  (bset cb (+ y 4) hi)
                  (bset cb (+ y 5) (ushr lo 24))
                  (bset cb (+ y 6) (ushr lo 16))
                  (bset cb (+ y 7) (ushr lo 8))
                  (bset cb (+ y 8) lo)
                  (return (+ y 9)))))))
    (if (== wd 4)
      (do (if (> (+ y 5) n) (return (neg 1)))
          (bset cb y (hex 250))
          (bset cb (+ y 1) (ushr w 24))
          (bset cb (+ y 2) (ushr w 16))
          (bset cb (+ y 3) (ushr w 8))
          (bset cb (+ y 4) w)
          (return (+ y 5))))
    (if (== mode 1)
      (do (if (== (bit-and h (hex 32767)) 0) (set h 0))
          (if (and (== (bit-and h (hex 31744)) (hex 31744)) (!= (bit-and h 1023) 0))
            (set h (bit-and h (hex 32767))))))
    (if (> (+ y 3) n) (return (neg 1)))
    (bset cb y (hex 249))
    (bset cb (+ y 1) (ushr h 8))
    (bset cb (+ y 2) h)
    (return (+ y 3))))

;; records: three words each on the stack o[O_S_RTOP] grows UP to o[O_S_DLOW]

(defn ^:pub ^I32 fbyte [^Bytes b ^Bytes cb ^I32 a ^I32 i]
  (comment "Byte i of a form: in cb at a >= 0, in the input at -1 - a.")
  (if (>= a 0) (return (u8 cb (+ a i))))
  (return (u8 b (+ (- (neg 1) a) i))))

(defn ^:pub ^I32 fcmp [^Bytes b ^Bytes cb ^I32 a1 ^I32 l1 ^I32 a2 ^I32 l2]
  (comment "Bytewise order of two forms, shorter first on a common prefix.")
  (let [^:mut m l1
        ^:mut i 0]
    (if (< l2 m) (set m l2))
    (while (< i m)
      (let [x (fbyte b cb a1 i)
            y (fbyte b cb a2 i)]
        (if (!= x y) (return (- x y))))
      (set i (+ i 1)))
    (return (- l1 l2))))

(defn ^:pub ^I32 c64m [^I32 a ^I32 b]
  (comment "A comparison's units, as the VM's key comparison (vm/base c64min, D253):"
           "ceil(min(a, b) / 8), at least 1 (the name is historical).")
  (let [^:mut m a]
    (if (< b m) (set m b))
    (if (<= m 8) (return 1))
    (return (+ (sar (- m 1) 3) 1))))

(defn ^:pub ^I32 rcmp [^Bytes b ^Bytes cb ^Ints o ^I32 r1 ^I32 r2 ^I32 ties]
  (comment "Records r1, r2 (word offsets in o) by their forms; ties != 0 breaks equal"
           "forms by the third word. Adds the comparison's units to o[O_S_UNITS].")
  (let [a1 (ia o r1)
        l1 (ia o (+ r1 1))
        a2 (ia o r2)
        l2 (ia o (+ r2 1))
        u (ia o O_S_UNITS)]
    (iset o O_S_UNITS (+ u (c64m l1 l2)))
    (let [c (fcmp b cb a1 l1 a2 l2)]
      (if (or (!= c 0) (== ties 0)) (return c))
      (return (- (ia o (+ r1 2)) (ia o (+ r2 2)))))))

(defn ^:pub rswap [^Ints o ^I32 r1 ^I32 r2]
  (for [^I32 j 0 3]
    (let [t (ia o (+ r1 j))
          u (ia o (+ r2 j))]
      (iset o (+ r1 j) u)
      (iset o (+ r2 j) t))))

(defn ^:pub rsift [^Bytes b ^Bytes cb ^Ints o ^I32 r0 ^I32 i0 ^I32 n ^I32 ties]
  (comment "Sift record i0 down a max-heap of n records at word r0.")
  (let [^:mut i i0]
    (forever
      (let [l (+ (* 2 i) 1)
            ^:mut m i]
        (if (>= l n) (break))
        (if (> (rcmp b cb o (+ r0 (* 3 l)) (+ r0 (* 3 m)) ties) 0) (set m l))
        (if (< (+ l 1) n)
          (if (> (rcmp b cb o (+ r0 (* 3 (+ l 1))) (+ r0 (* 3 m)) ties) 0) (set m (+ l 1))))
        (if (== m i) (break))
        (rswap o (+ r0 (* 3 i)) (+ r0 (* 3 m)))
        (set i m)))))

(defn ^:pub rsort [^Bytes b ^Bytes cb ^Ints o ^I32 r0 ^I32 n ^I32 ties]
  (comment "Heap sort of n records at word r0 into ascending order. The comparison"
           "sequence is a function of the records alone, so every walker that sorts"
           "the same records is charged the same units.")
  (let [^:mut i (- (sar n 1) 1)]
    (while (>= i 0)
      (rsift b cb o r0 i n ties)
      (set i (- i 1))))
  (let [^:mut k (- n 1)]
    (while (> k 0)
      (rswap o r0 (+ r0 (* 3 k)))
      (rsift b cb o r0 0 k ties)
      (set k (- k 1)))))

(defn ^:pub ^I32 cw [^BytesW cb ^Ints o ^I32 x ^I32 y ^I32 mode]
  (comment "Write the canonical form (mode 0 DC, 1 EC) of the CHECKED item at cb[x]"
           "to cb[y, ...), where y is past the item; answers the form's end, or -1"
           "when cb or the record stack in o is too small. EC sorts a map's pairs"
           "by their keys' EC bytes (no two are equal: the map was checked).")
  (let [ib (u8 cb x)
        major (ushr ib 5)
        ai (bit-and ib 31)
        n (blen cb)]
    (if (== major 7)
      (do (if (and (>= ai 25) (<= ai 27)) (return (cw-float cb x y mode)))
          (if (== ai 24)
            (do (if (> (+ y 2) n) (return (neg 1)))
                (let [v (u8 cb (+ x 1))]
                  (bset cb y ib)
                  (bset cb (+ y 1) v))
                (return (+ y 2))))
          (if (>= y n) (return (neg 1)))
          (bset cb y ib)
          (return (+ y 1))))
    (let [^:mut q (targ cb o x)
          hi (ia o O_HI)
          lo (ia o O_LO)]
      (if (<= major 1) (return (put-head cb y major hi lo)))
      (if (== major 6)
        (do (let [y6 (put-head cb y 6 hi lo)]
              (if (< y6 0) (return y6))
              (return (cw cb o q y6 mode)))))
      (if (<= major 3)
        (do (if (!= ai 31)
              (do (let [y2 (put-head cb y major 0 lo)]
                    (if (or (< y2 0) (> (+ y2 lo) n)) (return (neg 1)))
                    (return (move-within cb q y2 lo)))))
            (let [total (tlength cb o x)
                  ^:mut y3 (put-head cb y major 0 total)]
              (if (or (< y3 0) (> (+ y3 total) n)) (return (neg 1)))
              (while (!= (u8 cb q) 255)
                (set q (targ cb o q))
                (let [cl (ia o O_LO)]
                  (set y3 (move-within cb q y3 cl))
                  (set q (+ q cl))))
              (return y3))))
      (local ^:mut ^I32 cnt)
      (if (== ai 31)
        (do (set cnt (tcount cb o q))
            (if (== major 5) (set cnt (sar cnt 1))))
        (set cnt lo))
      (if (or (== major 4) (or (== mode 0) (< cnt 2)))
        (do (let [^:mut y4 (put-head cb y major 0 cnt)
                  ^:mut k cnt]
              (if (== major 5) (set k (* 2 cnt)))
              (for [^I32 _i 0 k]
                (if (< y4 0) (return y4))
                (set y4 (cw cb o q y4 mode))
                (set q (tskip cb o q)))
              (return y4))))
      (comment "EC map of two or more pairs: the pairs' forms after a 9-byte gap, a"
               "record (key form, key length, pair end) each, sorted; then the head"
               "and the pairs in order after them, moved down to y.")
      (let [r0 (ia o O_S_RTOP)
            ^:mut t (+ y 9)]
        (if (> (+ r0 (* 3 cnt)) (ia o O_S_DLOW)) (return (neg 1)))
        (iset o O_S_RTOP (+ r0 (* 3 cnt)))
        (for [^I32 i 0 cnt]
          (let [ks t
                ke (cw cb o q t mode)]
            (if (< ke 0) (do (iset o O_S_RTOP r0) (return ke)))
            (set q (tskip cb o q))
            (let [ve (cw cb o q ke mode)]
              (if (< ve 0) (do (iset o O_S_RTOP r0) (return ve)))
              (set q (tskip cb o q))
              (iset o (+ r0 (* 3 i)) ks)
              (iset o (+ (+ r0 (* 3 i)) 1) (- ke ks))
              (iset o (+ (+ r0 (* 3 i)) 2) ve)
              (set t ve))))
        (let [u0 (ia o O_S_UNITS)]
          (rsort cb cb o r0 cnt 0)
          (comment "the inner sort is part of writing a form: not a duplicate-check charge")
          (iset o O_S_UNITS u0))
        (let [^:mut z (put-head cb t 5 0 cnt)]
          (if (< z 0) (do (iset o O_S_RTOP r0) (return z)))
          (for [^I32 j 0 cnt]
            (let [rj (+ r0 (* 3 j))
                  ps (ia o rj)
                  pe (ia o (+ rj 2))]
              (if (> (+ z (- pe ps)) n) (do (iset o O_S_RTOP r0) (return (neg 1))))
              (set z (move-within cb ps z (- pe ps)))))
          (iset o O_S_RTOP r0)
          (return (move-within cb t y (- z t))))))))

;; ------------------------------------------------------------ duplicate keys
;; D263's deferred check of a CHECKED map, in three steps so that a walk without a
;; canonical buffer can run it when every key is its own comparison form: build the
;; records (dup-input: input bytes only; dup-forms: EC forms written to a buffer),
;; then dup-finish. A record is (form address, form length, key offset); the
;; records of a map sit on top of o's record stack while the check runs.

(defn ^:pub ^I32 dup-pairs [^Bytes b ^Ints o ^I32 q0 ^I32 npairs]
  (comment "The pairs of a CHECKED map whose first key is at q0: npairs, or for an"
           "indefinite map (npairs -1) half the items before its break.")
  (if (>= npairs 0) (return npairs))
  (return (sar (tcount b o q0) 1)))

(defn ^:pub ^I32 dup-room [^Ints o ^I32 n]
  (comment "Push n records (0), or -CODE_SCRATCH with o[O_VNEEDW] raised.")
  (let [r0 (ia o O_S_RTOP)]
    (if (> (+ r0 (* 3 n)) (ia o O_S_DLOW))
      (do (iset o O_VNEEDW (+ (ilen o) (+ (* 3 n) 64)))
          (return (neg CODE_SCRATCH))))
    (iset o O_S_RTOP (+ r0 (* 3 n)))
    (return 0)))

(defn ^:pub ^I32 dup-input [^Bytes b ^Ints o ^I32 q0 ^I32 n]
  (comment "Records for the n pairs from q0 when every key is canonical and not"
           "EC-sensitive (its input bytes are its form): 0; 1 (records popped) when"
           "some key needs its EC form written; or -CODE_SCRATCH.")
  (let [g (dup-room o n)]
    (if (< g 0) (return g)))
  (let [r0 (- (ia o O_S_RTOP) (* 3 n))
        ^:mut q q0]
    (for [^I32 i 0 n]
      (let [ke (tskip b o q)
            rr (+ r0 (* 3 i))]
        (if (!= (kclass b o q) 0)
          (do (iset o O_S_RTOP r0)
              (return 1)))
        (iset o rr (- (neg 1) q))
        (iset o (+ rr 1) (- ke q))
        (iset o (+ rr 2) q)
        (set q (tskip b o ke))))
    (return 0)))

(defn ^:pub ^I32 dup-forms [^Bytes b ^Ints o ^BytesW cb ^I32 q0 ^I32 n]
  (comment "Records for the n pairs from q0, writing the EC form of every key that"
           "is not canonical or is EC-sensitive into cb from o[O_S_CBTOP] (the key's"
           "bytes first, its form after them). 0, or -CODE_SCRATCH with o[O_VNEEDW] /"
           "o[O_VNEEDB] raised (nothing left pushed).")
  (let [g (dup-room o n)]
    (if (< g 0) (return g)))
  (let [r0 (- (ia o O_S_RTOP) (* 3 n))
        cb0 (ia o O_S_CBTOP)
        ^:mut ctop cb0
        ^:mut q q0]
    (for [^I32 i 0 n]
      (let [ke (tskip b o q)
            rr (+ r0 (* 3 i))]
        (if (== (kclass b o q) 0)
          (do (iset o rr (- (neg 1) q))
              (iset o (+ rr 1) (- ke q)))
          (do (let [kl (- ke q)]
                (if (> (+ ctop kl) (blen cb))
                  (do (iset o O_S_RTOP r0)
                      (iset o O_VNEEDB (+ (blen cb) (* 4 (+ kl 64))))
                      (return (neg CODE_SCRATCH))))
                (for [^I32 j 0 kl]
                  (let [v (u8 b (+ q j))]
                    (bset cb (+ ctop j) v)))
                (let [fe (cw cb o ctop (+ ctop kl) 1)]
                  (if (< fe 0)
                    (do (iset o O_S_RTOP r0)
                        (iset o O_VNEEDB (+ (blen cb) (* 4 (+ kl 64))))
                        (iset o O_VNEEDW (+ (ilen o) 64))
                        (return (neg CODE_SCRATCH))))
                  (iset o rr (+ ctop kl))
                  (iset o (+ rr 1) (- fe (+ ctop kl)))
                  (set ctop fe)))))
        (iset o (+ rr 2) q)
        (set q (tskip b o ke))))
    (iset o O_S_CBTOP ctop)
    (return 0)))

(defn ^:pub ^I32 dup-forms-within [^BytesW cb ^Ints o ^I32 q0 ^I32 n]
  (comment "dup-forms for a map that is itself in cb (inside a gathered payload,"
           "below o[O_S_CBTOP]): the same records, the forms written after it.")
  (let [g (dup-room o n)]
    (if (< g 0) (return g)))
  (let [r0 (- (ia o O_S_RTOP) (* 3 n))
        ^:mut ctop (ia o O_S_CBTOP)
        ^:mut q q0]
    (for [^I32 i 0 n]
      (let [ke (tskip cb o q)
            rr (+ r0 (* 3 i))]
        (if (== (kclass cb o q) 0)
          (do (iset o rr (- (neg 1) q))
              (iset o (+ rr 1) (- ke q)))
          (do (let [kl (- ke q)]
                (if (> (+ ctop kl) (blen cb))
                  (do (iset o O_S_RTOP r0)
                      (iset o O_VNEEDB (+ (blen cb) (* 4 (+ kl 64))))
                      (return (neg CODE_SCRATCH))))
                (move-within cb q ctop kl)
                (let [fe (cw cb o ctop (+ ctop kl) 1)]
                  (if (< fe 0)
                    (do (iset o O_S_RTOP r0)
                        (iset o O_VNEEDB (+ (blen cb) (* 4 (+ kl 64))))
                        (iset o O_VNEEDW (+ (ilen o) 64))
                        (return (neg CODE_SCRATCH))))
                  (iset o rr (+ ctop kl))
                  (iset o (+ rr 1) (- fe (+ ctop kl)))
                  (set ctop fe)))))
        (iset o (+ rr 2) q)
        (set q (tskip cb o ke))))
    (iset o O_S_CBTOP ctop)
    (return 0)))

(defn ^:pub ^I32 dup-finish [^Bytes b ^Bytes cbr ^Ints o ^I32 n ^I32 cb0]
  (comment "The top n records (built by dup-input or dup-forms, or retained by a"
           "session): 1 unit each, the heap sort by form (ties by offset), then the"
           "neighbours, each comparison ceil(min/64) units (o[O_S_UNITS]); pops"
           "them and resets o[O_S_CBTOP] to cb0. 0, or duplicate_key at the"
           "earliest second occurrence: the smallest offset of a key equal to an"
           "earlier one. cbr holds the forms at addresses >= 0 (any buffer when"
           "there are none).")
  (let [r0 (- (ia o O_S_RTOP) (* 3 n))
        ^:mut best (neg 1)
        ^:mut eqprev false]
    (iset o O_S_UNITS (+ (ia o O_S_UNITS) n))
    (rsort b cbr o r0 n 1)
    (for [^I32 k 1 n]
      (let [c (rcmp b cbr o (+ r0 (* 3 (- k 1))) (+ r0 (* 3 k)) 0)]
        (if (== c 0)
          (do (if (not eqprev)
                (do (let [off (ia o (+ (+ r0 (* 3 k)) 2))]
                      (if (or (< best 0) (< off best)) (set best off)))))
              (set eqprev true))
          (set eqprev false))))
    (iset o O_S_RTOP r0)
    (iset o O_S_CBTOP cb0)
    (if (>= best 0) (return (fail o best CODE_DUPLICATE_KEY)))
    (return 0)))

;; ------------------------------------------------------------ gathering

(defn ^:pub ^I32 gather [^Bytes b ^Ints o ^BytesW cb ^I32 x ^I32 y]
  (comment "The content of the CHECKED string item at x (any length kind) into"
           "cb[y, ...): answers its end, or -1 when cb is too short.")
  (let [ai (bit-and (u8 b x) 31)
        ^:mut q (targ b o x)
        ^:mut z y]
    (if (!= ai 31)
      (do (let [l (ia o O_LO)]
            (if (> (+ y l) (blen cb)) (return (neg 1)))
            (for [^I32 j 0 l]
              (let [v (u8 b (+ q j))]
                (bset cb (+ y j) v)))
            (return (+ y l)))))
    (while (!= (u8 b q) 255)
      (set q (targ b o q))
      (let [l2 (ia o O_LO)]
        (if (> (+ z l2) (blen cb)) (return (neg 1)))
        (for [^I32 j2 0 l2]
          (let [v2 (u8 b (+ q j2))]
            (bset cb (+ z j2) v2)))
        (set z (+ z l2))
        (set q (+ q l2))))
    (return z)))

(defn ^:pub ^I32 gather-within [^BytesW cb ^Ints o ^I32 x ^I32 y]
  (comment "gather for a string item that is itself in cb, before y.")
  (let [ai (bit-and (u8 cb x) 31)
        ^:mut q (targ cb o x)
        ^:mut z y]
    (if (!= ai 31)
      (do (let [l (ia o O_LO)]
            (if (> (+ y l) (blen cb)) (return (neg 1)))
            (return (move-within cb q y l)))))
    (while (!= (u8 cb q) 255)
      (set q (targ cb o q))
      (let [l2 (ia o O_LO)]
        (if (> (+ z l2) (blen cb)) (return (neg 1)))
        (set z (move-within cb q z l2))
        (set q (+ q l2))))
    (return z)))

;; ------------------------------------------------------------ the canonical copy

(defn ^:pub ^I32 dc-copy [^Bytes b ^Ints o ^BytesW cb]
  (comment "The DC form of the CHECKED document b (the codec's copy of valid input that"
           "is not its own DC form, D262): b copied to cb[0, n), cw's mode 0 after it."
           "Answers the form's end (the form is cb[n, end)), or -1 when cb is too"
           "short (2n + n/128 + 64 bytes always suffice).")
  (let [n (blen b)]
    (if (> n (blen cb)) (return (neg 1)))
    (bcopy cb 0 b 0 n)
    (return (cw cb o 0 n 0))))

