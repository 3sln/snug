#!/bin/sh
# Build the Rust VM test host (host/rust/src/bin/vm.rs) in its own crate, .cache/snug-vm:
# the generated cbor, vm and program modules and the Rust schema host (no compile host),
# so a sibling's unfinished compiler cannot break it. Prints the binary's path.
# Used by vm-test and by compile-test (regexp-test's Rust VM arm, P9.13 WP3 S5).
set -e
cd "$(dirname "$0")/../.."
bb -cp kin/src:../kin/src kin/scripts/vm-emit > /dev/null
host=.cache/vm-host
mkdir -p "$host/bin"
printf '//! VM test crate: the generated cbor, vm and program modules and the Rust schema host.\npub mod snug;\npub mod schema;\npub mod controls;\npub mod sessions;\n' > "$host/lib.rs.new"
cmp -s "$host/lib.rs.new" "$host/lib.rs" 2>/dev/null || mv "$host/lib.rs.new" "$host/lib.rs"; rm -f "$host/lib.rs.new"
cmp -s host/rust/src/bin/vm.rs "$host/bin/vm.rs" 2>/dev/null || cp host/rust/src/bin/vm.rs "$host/bin/vm.rs"
cmp -s host/rust/src/schema.rs "$host/schema.rs" 2>/dev/null || cp host/rust/src/schema.rs "$host/schema.rs"
cmp -s host/rust/src/sessions.rs "$host/sessions.rs" 2>/dev/null || cp host/rust/src/sessions.rs "$host/sessions.rs"
cmp -s host/rust/src/controls.rs "$host/controls.rs" 2>/dev/null || cp host/rust/src/controls.rs "$host/controls.rs"
crate=.cache/snug-vm
SNUG_RS_ONLY="cbor vm program" ./kin/scripts/rust-crate "$crate" "$host"
if ! build=$(cd "$crate" && RUSTFLAGS="-D warnings" cargo build --quiet --bin vm 2>&1); then
  echo "  FAIL cargo refused the generated code:"; printf '%s\n' "$build" | sed 's/^/    /'; exit 1
fi
echo "$crate/target/debug/vm"
