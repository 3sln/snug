#!/bin/sh
# The validator VM (P3.4) on generated JS and a DEBUG Rust build: program.md
# §15, profile identity against the scanner, the conformance corpus through
# the compiler, assembled programs, JS == Rust.
#     kin/scripts/vm-test [mutations] [seed]
#
# The Rust crate holds the generated cbor, vm and program modules, the Rust
# schema host and the vm test binary (no compile host), so a sibling's
# unfinished compiler cannot break it.
[ -n "$SNUG_WATCHDOG" ] || exec node "$(dirname "$0")/watchdog.mjs" vm-test -- "$0" "$@"   # P9.1 caps
set -e
cd "$(dirname "$0")/../.."
if ! vm=$(kin/scripts/vm-bin); then printf '%s\n' "$vm"; exit 1; fi
# and the wasm build when its toolchain is present (otherwise vm-test.mjs prints SKIP). Any other
# wasm-build failure fails the gate, and a stale SNUG_VM_WASM from the caller is never used
# (P9.13 WP3 N1).
unset SNUG_VM_WASM
set +e; wasm=$(./kin/scripts/wasm-build speed); st=$?; set -e
case $st in 0) export SNUG_VM_WASM="$wasm" ;; 3) ;; *) echo "  FAIL kin/scripts/wasm-build speed exited $st"; exit 1 ;; esac
node kin/scripts/vm-test.mjs "$vm" "$@"
