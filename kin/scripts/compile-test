#!/bin/sh
# The CDDL compiler's gates on JS and Rust:   kin/scripts/compile-test [corruptions per program] [seed]
#
# Format 2.0 (P8.5 phase 2): format 1's gate (kin/scripts/compile-test.mjs: program.md
# §15's Program, the D011/D012 refusals, format 1 verification) is retired; the
# compiler's gate is kin/scripts/compile2-test (bb compile2-test), run here,
# followed by the regexp gate on the compile-test binary.
[ -n "$SNUG_WATCHDOG" ] || exec node "$(dirname "$0")/watchdog.mjs" compile-test -- "$0" "$@"   # P9.1 caps
set -e
cd "$(dirname "$0")/../.."
kin/scripts/compile2-test "$@"
crate=.cache/snug-compile-gate
if ! build=$(cd "$crate" && RUSTFLAGS="-D warnings" cargo build --quiet --bin compile-test 2>&1); then
  echo "  FAIL cargo refused the generated code:"; printf '%s\n' "$build" | sed 's/^/    /'; exit 1
fi
node kin/scripts/regexp-test.mjs "$crate/target/debug/compile-test"
