#!/bin/sh
# Every CBOR vector, fixed edge cases and seeded mutations through the
# generated JS and the Rust build; codes must equal cbor.mjs's, and JS and
# Rust must agree on the error offset too.   kin/scripts/scan-test [mutations] [seed]
#
# The Rust build is DEBUG (overflow checks on): the scanner must never panic,
# and a broken no-overflow guarantee in the source shows up here as a panic.
[ -n "$SNUG_WATCHDOG" ] || exec node "$(dirname "$0")/watchdog.mjs" scan-test -- "$0" "$@"   # P9.1 caps
set -e
cd "$(dirname "$0")/../.."
./kin/scripts/emit > /dev/null
crate=.cache/snug-rs
SNUG_RS_ONLY="cbor vm compile program hello.rs" ./kin/scripts/rust-crate "$crate"
if ! build=$(cd "$crate" && RUSTFLAGS="-D warnings" cargo build --quiet --bin scan 2>&1); then
  echo "  FAIL cargo refused the generated code:"; printf '%s\n' "$build" | sed 's/^/    /'; exit 1
fi
# And the wasm build, when its toolchain is present (otherwise SKIP, loudly).
if wasm=$(./kin/scripts/wasm-build speed 2>/dev/null); then export SNUG_SCAN_WASM="$wasm"; fi
node kin/scripts/scan-test.mjs "$crate/target/debug/scan" "$@"
