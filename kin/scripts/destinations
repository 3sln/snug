#!/usr/bin/env bb
;; Every [target path] this project would write -- the drift gate's input.
;; Refuses a short answer: a source that cannot be analysed names no
;; destination, and a gate whose input can shrink silently is not a gate.
(require '[kin.project :as kp] '[snug.project :as p])
(let [{:keys [destinations unanalysable unresolved]}
      (kp/destination-report @p/project)]
  (when unresolved
    (binding [*out* *err*]
      (println "  FAIL the project's exports will not resolve:" unresolved))
    (System/exit 1))
  (when (seq unanalysable)
    (binding [*out* *err*]
      (println "  FAIL" (count unanalysable) "sources cannot be analysed:")
      (doseq [[label msg] unanalysable] (println "   " label "--" msg)))
    (System/exit 1))
  (doseq [[t path] destinations]
    (println (format "  %-5s %s" (name t) path))))
