#!/bin/sh
# Assemble the Rust crate: kin/scripts/rust-crate DIR [HOST_SRC [MANIFEST]]
#
#   DIR/Cargo.toml        host/rust/Cargo.toml
#   DIR/build.rs          host/rust/build.rs, with that manifest only (P9.16)
#   DIR/src/              HOST_SRC/* (default host/rust/src)
#   DIR/src/snug/...      gen/rust/snug/** (kin's modules)
#   DIR/src/snug.rs, DIR/src/snug/<d>.rs   `pub mod` lines, generated from the
#                         tree, so a new module is compiled the day it is emitted.
#   DIR/README.md         host/rust/README.md, the crate's own, less its pre-release block (P9.15, D366)
#   DIR/LICENSE, THIRD_PARTY_NOTICES.md, SECURITY.md, CHANGELOG.md   the repository's (P9.15)
#                         The manifest's `readme` and `include` name these, so
#                         `cargo package --list` in DIR is the crate to publish.
#
# Copies only what changed (cargo's incremental build keys on mtimes).
#
# SNUG_RS_ONLY="cbor hello.rs" limits the crate to those entries of
# gen/rust/snug (default: all), so a sibling work item's unfinished modules
# cannot break this item's gates.
set -e
cd "$(dirname "$0")/../.."
dir="$1"; host="${2:-host/rust/src}"; manifest="${3:-host/rust/Cargo.toml}"
# The full host now exposes navigation and encoding alongside the legacy APIs.
# Preserve the older scanner/check subset callers without changing their hosts.
# (abnf.rs: the host's snug::abnf, D334.)
if [ "$host" = host/rust/src ] && [ -n "$SNUG_RS_ONLY" ]; then
  SNUG_RS_ONLY="$SNUG_RS_ONLY nav write abnf.rs"
fi
[ -n "$dir" ] || { echo "usage: rust-crate DIR [HOST_SRC]" >&2; exit 2; }
mkdir -p "$dir/src"
put() { mkdir -p "$(dirname "$2")"; cmp -s "$1" "$2" 2>/dev/null || cp "$1" "$2"; }
puttext() { tmp=$(mktemp); printf '%s' "$1" > "$tmp"; put "$tmp" "$2"; rm -f "$tmp"; }
put "$manifest" "$dir/Cargo.toml"
if [ "$manifest" = host/rust/Cargo.toml ]; then put host/rust/build.rs "$dir/build.rs"; fi
# The README without its pre-release block (GitHub only; kin/scripts/prerelease.mjs, D366)
readme=$(mktemp); node kin/scripts/prerelease.mjs strip host/rust/README.md "$readme"; put "$readme" "$dir/README.md"; rm -f "$readme"
for f in LICENSE THIRD_PARTY_NOTICES.md SECURITY.md CHANGELOG.md; do put "$f" "$dir/$f"; done
(cd "$host" && find . -type f -name '*.rs') | while read -r f; do put "$host/$f" "$dir/src/$f"; done
# Public API integration tests accompany the default host only.
if [ "$host" = host/rust/src ] && [ -d host/rust/tests ]; then
  (cd host/rust/tests && find . -type f) | while read -r f; do put "host/rust/tests/$f" "$dir/tests/$f"; done
fi
# kin's modules, and a mod file per directory.
rm -rf "$dir/src/snug.new" "$dir/src/snug" "$dir/src/snug.rs"
keep() {  # keep <path under gen/rust>: is it in SNUG_RS_ONLY?
  [ -z "$SNUG_RS_ONLY" ] && return 0
  top=$(printf '%s' "$1" | cut -d/ -f2)
  for k in $SNUG_RS_ONLY; do [ "$k" = "$top" ] && return 0; done
  return 1
}
(cd gen/rust && find snug -type f -name '*.rs') | while read -r f; do if keep "$f"; then put "gen/rust/$f" "$dir/src/$f"; fi; done
modfile() {  # modfile <gen dir> -> mod lines for its children
  for e in $(ls "gen/rust/$1" | sort); do
    if ! keep "$1/$e"; then continue; fi
    case "$e" in *.rs) echo "pub mod ${e%.rs};" ;; *) [ -d "gen/rust/$1/$e" ] && echo "pub mod $e;" ;; esac
  done
}
puttext "$(modfile snug)
" "$dir/src/snug.rs"
(cd gen/rust && find snug -mindepth 1 -type d) | while read -r d; do
  if ! keep "$d"; then continue; fi
  puttext "$(modfile "$d")
" "$dir/src/$d.rs"
done
rm -rf "$dir/src/snug.new"
