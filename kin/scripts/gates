#!/usr/bin/env bb
;; Run gates from ci/gate-map.edn, each under the P9.1 watchdog (P9.15).
;;
;;     kin/scripts/gates <set|gate>...    run them in order (bb gates release)
;;     kin/scripts/gates --list           the gates and sets
;;     kin/scripts/gates --check          the map against bb.edn and the watchdog's caps
;;                                        (and each :partitions entry against its set, and
;;                                        the CI release matrix against :partitions :release)
;;     --fail-fast                        stop at the first gate that is not ok
;;
;; A gate is ok only if it exits 0 and prints no NOT RUN line (not-run?, on stdout or
;; stderr): a `SKIP` line, "<tool> unavailable/missing/not installed/not found ...
;; skipped", or node:test reporting a skipped or todo test. A NOT RUN, or a :blocked
;; gate (never run), fails the run (policy §2, §4).
;; The summary names every gate's result and wall time. Exit 0 only if all ok.
;;
;; D370 (P9.13 gates N2, N8):
;; - each gate runs without the coverage knobs of ci/gate-map.edn :knobs :clear in its
;;   environment, and with a :floor knob only on its toolchain floor; the runner prints what
;;   it removed (gate-env);
;; - --check (and every run) compares ../kin/src, which bb.edn puts on the classpath, with
;;   the KIN_REF commit that ci.yml and release.yml build with: a difference is a warning
;;   locally and an error in GitHub Actions (kin-problems).
(require '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str]
         '[cheshire.core :as json]
         '[clj-yaml.core :as yaml])

(def root (str (fs/canonicalize (fs/path (fs/parent *file*) "../.."))))
(def gate-map (edn/read-string (slurp (str root "/ci/gate-map.edn"))))
(def gates (:gates gate-map))

(def defaults-once
  (delay (-> (p/shell {:dir root :out :string}
                      "node" "--input-type=module" "-e"
                      "import {DEFAULTS} from './kin/scripts/watchdog.mjs'; console.log(JSON.stringify(DEFAULTS))")
             :out json/parse-string)))
(defn watchdog-defaults [] @defaults-once)

;; A CI shard's wall caps may sum to at most this: each hosted job's
;; timeout-minutes sits above its shard's sum and at most 360 (P9.20).
(def shard-wall-max (* 330 60))

(defn partition-problems
  "Each :partitions entry's shards hold exactly its set's gates, each once,
  and each shard's wall caps fit one hosted CI job."
  []
  (let [sets (:sets gate-map)]
    (concat
     (for [[s shards] (:partitions gate-map)
           :let [whole (get sets s)
                 parts (map #(get sets (keyword %)) shards)
                 all (apply concat parts)]
           e (cond (nil? whole) [(str "partition " (name s) ": no set " (name s))]
                   (some nil? parts) [(str "partition " (name s) ": not a set: "
                                           (str/join " " (remove #(get sets (keyword %)) shards)))]
                   (not= (frequencies whole) (frequencies all))
                   [(str "partition " (name s) ": its shards must hold exactly the set's gates, each once; missing "
                         (vec (remove (set all) whole)) ", extra or repeated "
                         (vec (for [[g n] (frequencies all) :when (or (> n 1) (not (some #{g} whole)))] g)))]
                   :else [])]
       e)
     (for [[_ shards] (:partitions gate-map) sh shards
           :let [members (get (:sets gate-map) (keyword sh))
                 wall (reduce + (map #(or (first (:caps (get gates %))) 0) members))]
           :when (> wall shard-wall-max)]
       (str "shard " sh ": wall caps sum to " wall " s, past " shard-wall-max " s (one CI job)")))))

(defn job-needs
  "A workflow job's `needs` as a list of job ids (strings): GitHub takes one id or a list."
  [job]
  (let [n (:needs job)]
    (map name (cond (nil? n) [] (sequential? n) n :else [n]))))

(defn needs-problems
  "D375: in workflow `file` (parsed), every job's `needs` names a job of the same workflow (a
  dangling one makes GitHub refuse to start the run), and every `needs.<id>` a job's
  expressions read is one of that job's needs (anything else is empty at run time)."
  [file doc]
  (let [jobs (:jobs doc)
        ids (set (map name (keys jobs)))]
    (concat
     (for [[jk job] jobs, n (job-needs job) :when (not (ids n))]
       (str file ": job " (name jk) " needs " n ", which is not a job of " file))
     (for [[jk job] jobs
           :let [own (set (job-needs job))]
           n (distinct (for [s (tree-seq coll? seq job) :when (string? s)
                             [_ n] (re-seq #"\bneeds\.([A-Za-z_][A-Za-z0-9_-]*)" s)] n))
           :when (not (own n))]
       (str file ": job " (name jk) " reads needs." n " but does not need " n)))))

(defn ci-matrix-problems
  "P9.13 WP3 (S10), D368: hosted CI (.github/workflows/ci.yml) runs what this map says.
  - release: a step per shard, exactly :partitions :release in order, each running even after an
    earlier one failed (if: success() || failure()), each step's timeout-minutes above the
    largest wall cap of its shard's gates (the watchdog, not GitHub, stops a stuck gate), the
    job's at most 360;
  - land: `bb gates land`, the job's timeout-minutes above the set's wall caps and at most 360;
  - linux (Ubuntu): exactly the :ci-compat cells (npm-test per Node major, rust-api-test per Rust
    toolchain), each running after a failure, the job's timeout-minutes above their caps and at
    most 360 (D375 dropped D368's macOS compat job, which ran the same cells);
  - ci: needs exactly every other job of ci.yml (workflow-problems checks that each `needs`
    names a job)."
  []
  (let [f (str root "/.github/workflows/ci.yml")]
    (if-not (fs/exists? f)
      ["ci.yml: .github/workflows/ci.yml is missing"]
      (let [jobs (:jobs (yaml/parse-string (slurp f)))
            cap-min (fn [g] (quot (or (first (:caps (get gates g))) 0) 60))
            sum-min (fn [gs] (reduce + (map cap-min gs)))
            always? (fn [st] (some-> (:if st) str (str/includes? "success() || failure()")))
            job-timeout (fn [k] (get-in jobs [k :timeout-minutes]))
            within (fn [k need] (let [t (job-timeout k)]
                                  (when (or (not (number? t)) (<= t need) (> t 360))
                                    [(str "ci.yml: job " (name k) " has timeout-minutes " t
                                          " (it must be above " need " and at most 360)")])))
            ;; release
            rsteps (filter #(some->> (:run %) (re-find #"^bb gates (release-\S+)$")) (get-in jobs [:release :steps]))
            shards (map #(second (re-find #"^bb gates (release-\S+)$" (:run %))) rsteps)
            want (map name (get-in gate-map [:partitions :release]))
            ;; linux cells: [kind value step]
            cells (fn [k npm-re rust-re]
                    (loop [[st & more] (get-in jobs [k :steps]) node nil acc []]
                      (if-not st
                        acc
                        (let [run (str (:run st))
                              node (if (some-> (:uses st) (str/starts-with? "actions/setup-node@"))
                                     (str (get-in st [:with :node-version])) node)
                              rust (second (re-find rust-re run))]
                          (recur more node
                                 (cond (re-find npm-re run) (conj acc [:node node st])
                                       rust (conj acc [:rust (if (str/includes? rust "SNUG_RUST_VERSION") "rust-version" rust) st])
                                       :else acc))))))
            want-cells (fn [] (let [{:keys [node rust]} (:ci-compat gate-map)]
                                (sort (concat (map #(str "node " %) node) (map #(str "rust " %) rust)))))
            cell-problems (fn [k npm-re rust-re]
                            (let [cs (cells k npm-re rust-re)
                                  got (sort (map (fn [[kind v]] (str (name kind) " " v)) cs))]
                              (concat
                               (when (not= got (want-cells))
                                 [(str "ci.yml: job " (name k) " runs the cells " (vec got) ", :ci-compat is " (vec (want-cells)))])
                               (for [[kind v st] cs :when (not (always? st))]
                                 (str "ci.yml: job " (name k) "'s " (name kind) " " v " cell must run after a failure (if: success() || failure())"))
                               (within k (+ (* (count (filter #(= :node (first %)) cs)) (cap-min 'npm-test))
                                            (* (count (filter #(= :rust (first %)) cs)) (cap-min 'rust-api-test)))))))]
        (concat
         (when (not= shards want)
           [(str "ci.yml: the release job's steps run " (vec shards) ", :partitions :release is " (vec want) " (in that order)")])
         (for [st rsteps
               :let [shard (second (re-find #"^bb gates (release-\S+)$" (:run st)))
                     members (get (:sets gate-map) (keyword shard))
                     biggest (reduce max 0 (map cap-min members))
                     t (:timeout-minutes st)]
               :when (and members (or (not (number? t)) (<= t biggest) (not (always? st))))]
           (str "ci.yml: release step " shard " needs timeout-minutes above " biggest
                " (its largest gate wall cap) and if: success() || failure(); it has " t ", " (pr-str (:if st))))
         (let [t (job-timeout :release)] (when (or (not (number? t)) (> t 360)) [(str "ci.yml: job release has timeout-minutes " t " (at most 360)")]))
         (when-not (some #(= "bb gates land" (:run %)) (get-in jobs [:land :steps])) ["ci.yml: job land does not run `bb gates land`"])
         (within :land (sum-min (get-in gate-map [:sets :land])))
         (cell-problems :linux #"ci/run-gate\.sh npm-test " #"^rustup run (\S+) bash ci/run-gate\.sh rust-api-test ")
         (let [needs (set (map keyword (job-needs (:ci jobs))))
               others (disj (set (keys jobs)) :ci)]
           (concat
            (for [k (sort others) :when (not (needs k))]
              (str "ci.yml: job ci does not need " (name k)))
            (for [k (sort needs) :when (not (others k))]
              (str "ci.yml: job ci needs " (name k) ", which is not another job of ci.yml")))))))))

(defn workflow-problems
  "D368: every action a workflow or the setup action uses is local (./) or pinned by a full
  commit SHA; release.yml builds against ci.yml's KIN_REF; and every release.yml job that may
  write (contents: write, or id-token: write for trusted publishing) runs only when the guard
  allows writes (needs.guard.outputs.write == 'true': main, a push or a non-dry-run dispatch).
  D375: in both workflows every `needs` names an existing job (needs-problems)."
  []
  (let [dir (str root "/.github")
        files (concat (fs/glob dir "workflows/*.yml") (fs/glob dir "actions/*/action.yml"))
        uses (fn uses [x] (cond (map? x) (concat (when-let [u (:uses x)] [u]) (mapcat uses (vals x)))
                                (sequential? x) (mapcat uses x) :else []))
        rel (fn [f] (str (fs/relativize root f)))
        doc (fn [n] (let [f (str dir "/workflows/" n)] (when (fs/exists? f) (yaml/parse-string (slurp f)))))
        ci (doc "ci.yml") release (doc "release.yml")]
    (concat
     (for [f files, u (uses (yaml/parse-string (slurp (str f))))
           :when (not (or (str/starts-with? u "./") (re-matches #"[\w.-]+/[\w./-]+@[0-9a-f]{40}" u)))]
       (str (rel f) ": " u " is not pinned by a full commit SHA"))
     (when-not release [".github/workflows/release.yml is missing"])
     (when ci (needs-problems "ci.yml" ci))
     (when release (needs-problems "release.yml" release))
     (when (and release (not= (get-in release [:env :KIN_REF]) (get-in ci [:env :KIN_REF])))
       [(str "release.yml: KIN_REF " (get-in release [:env :KIN_REF]) " is not ci.yml's " (get-in ci [:env :KIN_REF]))])
     (for [[k job] (:jobs release)
           :let [perms (:permissions job)]
           :when (and (map? perms) (or (= "write" (some-> (:contents perms) name)) (= "write" (some-> (:id-token perms) name))))
           :when (not (some-> (:if job) str (str/includes? "needs.guard.outputs.write == 'true'")))]
       (str "release.yml: job " (name k) " may write but does not require needs.guard.outputs.write == 'true'")))))

;; ------------------------------------------------------------------ D370: knobs (N2)
(def knobs (:knobs gate-map))
(def clear-knobs (set (map str (:clear knobs))))
(def floor-knobs (into {} (for [[k v] (:floor knobs)] [(str k) v])))
(def keep-knobs (map str (:keep knobs)))
(def knob-prefix #"^(SNUG|SEQ|VMTEST|RUBY|CDDL|RFC|PEG)_")

(defn classified? [n]
  (or (clear-knobs n) (contains? floor-knobs n)
      (some #(if (str/ends-with? % "*") (str/starts-with? n (subs % 0 (dec (count %)))) (= % n)) keep-knobs)))

(defn floor-version
  "The toolchain floor a :floor knob is for: the engines.node major, or the rust-version."
  [on]
  (case on
    :node (second (re-find #"^>=(\d+)$" (str (get-in (json/parse-string (slurp (str root "/host/js/package.json"))) ["engines" "node"]))))
    :rust (second (re-find #"(?m)^rust-version\s*=\s*\"([0-9.]+)\"" (slurp (str root "/host/rust/Cargo.toml"))))))

(def toolchain-version
  (memoize (fn [on]
             (try (case on
                    :node (str/trim (:out (p/shell {:out :string} "node" "-p" "process.versions.node")))
                    :rust (second (re-find #"^rustc (\S+)" (:out (p/shell {:out :string} "rustc" "--version")))))
                  (catch Exception _ nil)))))

(defn on-floor? [on]
  (let [f (floor-version on) v (toolchain-version on)]
    (boolean (and f v (or (= v f) (str/starts-with? v (str f ".")))))))

(defn gate-env
  "The environment gate g runs with: this process's, less every :clear knob and every :floor
  knob that is not for g on its floor. Answers {:env :removed :floor}."
  [g]
  (let [env (into {} (System/getenv))
        removed (sort (concat (filter #(contains? env %) clear-knobs)
                              (for [[k {:keys [gates on]}] floor-knobs
                                    :when (contains? env k)
                                    :when (not (and (some #{g} gates) (on-floor? on)))]
                                k)))
        floor (for [[k {:keys [on]}] floor-knobs :when (and (contains? env k) (not (some #{k} removed)))]
                (str k "=" (get env k) " (" (name on) " " (toolchain-version on) ", the floor)"))]
    {:env (apply dissoc env removed) :removed removed :floor floor}))

(defn knob-reads
  "Env variable names (knob-prefix) that tracked gate code reads: process.env.X, env.X,
  process.env['X'], env::var(\"X\"), and in sh scripts $X / ${X}. Answers {name #{files}}."
  []
  (let [files (->> (str/split-lines (:out (p/shell {:dir root :out :string} "git" "ls-files" "kin/scripts" "tools" "host" "corpus/tools" "ci")))
                   (remove #(re-find #"\.(md|json|cddl|cbor|edn|txt|wasm|bin|capnp|toml|lock|diag|hex|csv|abnf|abnfb)$" %))
                   (filter #(fs/regular-file? (str root "/" %))))
        pats [#"\benv\.([A-Z][A-Z0-9_]*)" #"\benv\[['\"]([A-Z][A-Z0-9_]*)['\"]\]"
              #"env::var(?:_os)?\(\"([A-Z][A-Z0-9_]*)\""]
        sh-pat #"\$\{?([A-Z][A-Z0-9_]*)"]
    (reduce (fn [acc f]
              (let [text (slurp (str root "/" f))
                    sh? (or (str/ends-with? f ".sh") (re-find #"^#!\S*\b(sh|bash)\b" text))]
                (reduce (fn [acc n] (update acc n (fnil conj #{}) f)) acc
                        (for [re (if sh? (conj pats sh-pat) pats) [_ n] (re-seq re text) :when (re-find knob-prefix n)] n))))
            {} files)))

(defn knob-problems
  "D370: every knob gate code reads is classified; no workflow sets a :clear knob, nor a :floor
  knob outside its floor's cells; ci/run-gate.sh removes exactly the :clear knobs."
  []
  (let [wf (fn [n] (let [f (str root "/.github/workflows/" n)] (when (fs/exists? f) (yaml/parse-string (slurp f)))))
        floor-major (floor-version :node)
        step-problems
        (fn [file doc]
          (concat
           (for [[k v] (:env doc) :let [k (name k)] :when (or (clear-knobs k) (floor-knobs k))]
             (str file ": the workflow's env sets " k "=" v " (ci/gate-map.edn :knobs; only a step may set a :floor knob)"))
           (for [[jk job] (:jobs doc) [k v] (:env job) :let [k (name k)] :when (or (clear-knobs k) (floor-knobs k))]
             (str file ": job " (name jk) "'s env sets " k "=" v " (ci/gate-map.edn :knobs; only a step may set a :floor knob)"))
           (for [[jk job] (:jobs doc)
                 [st node] (loop [[st & more] (:steps job) node nil acc []]
                             (if-not st acc
                                     (let [node (if (some-> (:uses st) (str/starts-with? "actions/setup-node@"))
                                                  (str (get-in st [:with :node-version])) node)]
                                       (recur more node (conj acc [st node])))))
                 [k v] (:env st) :let [k (name k) run (str (:run st)) fl (floor-knobs k)]
                 :when (or (clear-knobs k) fl)
                 :let [ok (and fl (some #(str/includes? run (str %)) (:gates fl))
                               (case (:on fl)
                                 :node (= node floor-major)
                                 :rust (str/includes? run "$SNUG_RUST_VERSION")))]
                 :when (not ok)]
             (str file ": job " (name jk) " step " (pr-str (or (:name st) run)) " sets " k "=" v
                  (if fl (str ", a :floor knob, outside its floor (" (str/join "/" (:gates fl)) " on the " (name (:on fl)) " floor)")
                      ", a :clear knob")))))
        action (let [f (str root "/.github/actions/setup/action.yml")] (if (fs/exists? f) (slurp f) ""))
        run-gate (slurp (str root "/ci/run-gate.sh"))
        rg-list (some->> (re-find #"(?m)^knobs=\"([^\"]*)\"" run-gate) second (re-seq #"\S+") set)]
    (concat
     (for [[n readers] (sort (knob-reads)) :when (not (classified? n))]
       (str "knob " n " (read by " (str/join ", " (sort readers)) ") is not in ci/gate-map.edn :knobs (:clear, :floor or :keep)"))
     (step-problems "ci.yml" (wf "ci.yml"))
     (step-problems "release.yml" (wf "release.yml"))
     (for [[_ k] (re-seq #"([A-Z][A-Z0-9_]*)=[^\n]*>>\s*\"?\$GITHUB_ENV" action) :when (or (clear-knobs k) (floor-knobs k))]
       (str ".github/actions/setup/action.yml: writes " k " to GITHUB_ENV (ci/gate-map.edn :knobs)"))
     (when (not= rg-list clear-knobs)
       [(str "ci/run-gate.sh: its knobs=\"...\" line must name exactly ci/gate-map.edn :knobs :clear; it has "
             (vec (sort rg-list)) ", the map " (vec (sort clear-knobs)))]))))

;; ------------------------------------------------------------------ D370: ../kin (N8)
(defn kin-problems
  "../kin/src (bb.edn's classpath) against ci.yml's KIN_REF: [errors warnings]. A difference
  is an error under GitHub Actions (GITHUB_ACTIONS=true), where ../kin must be KIN_REF, and a
  warning elsewhere."
  []
  (let [ci (let [f (str root "/.github/workflows/ci.yml")] (when (fs/exists? f) (yaml/parse-string (slurp f))))
        ref (some-> (get-in ci [:env :KIN_REF]) str)
        kin (str root "/../kin")
        git (fn [& args] (let [r (apply p/shell {:dir kin :out :string :err :string :continue true} "git" args)]
                           (when (zero? (:exit r)) (str/trim (:out r)))))
        msg (cond (not (re-matches #"[0-9a-f]{40}" (str ref))) (str "ci.yml: KIN_REF " (pr-str ref) " is not a full commit SHA")
                  (not (fs/exists? (str kin "/src"))) "../kin/src is missing (bb.edn's :paths needs kin checked out next to snug)"
                  (not (git "cat-file" "-e" (str ref "^{commit}"))) (str "../kin does not have KIN_REF " ref " (git -C ../kin fetch); its src cannot be checked")
                  :else (let [changed (concat (some-> (git "diff" "--name-only" ref "--" "src") str/split-lines)
                                              (some-> (git "ls-files" "--others" "--exclude-standard" "--" "src") str/split-lines))
                              changed (remove str/blank? changed)]
                          (when (seq changed)
                            (str "../kin/src differs from KIN_REF " (subs ref 0 12) " (../kin HEAD " (some-> (git "rev-parse" "--short=12" "HEAD")) "): "
                                 (count changed) " file(s), e.g. " (str/join ", " (take 3 changed))
                                 "; hosted CI builds with KIN_REF, so this run may not be what CI sees"))))]
    (cond (nil? msg) [[] []]
          (= "true" (System/getenv "GITHUB_ACTIONS")) [[msg] []]
          :else [[] [msg]])))

(defn problems
  "The map's disagreements with bb.edn and the watchdog: [errors warnings]."
  []
  (let [defaults (watchdog-defaults)
        tasks (set (map str (keys (:tasks (edn/read-string (slurp (str root "/bb.edn")))))))
        named (set (map str (concat (keys gates) (:not-gates gate-map))))
        errors (concat
                (for [[g {:keys [caps watchdog blocked]}] gates
                      :let [w (or watchdog (str g)) d (get defaults w)]
                      :when (and (not blocked) d (not= (vec d) caps))]
                  (str g ": caps " caps " but kin/scripts/watchdog.mjs DEFAULTS has " (vec d) " for " w))
                (for [[g {:keys [cmd blocked caps]}] gates
                      :when (and (not blocked) (not (and (seq cmd) (= 2 (count caps)))))]
                  (str g ": needs :cmd and :caps [wall cpu] (or :blocked)"))
                (for [[s members] (:sets gate-map) m members :when (not (contains? gates m))]
                  (str "set " (name s) " names " m ", which is not a gate"))
                (partition-problems)
                (ci-matrix-problems)
                (workflow-problems)
                (knob-problems))
        [kin-errors kin-warnings] (kin-problems)
        warnings (concat
                  (for [t (sort tasks) :when (not (contains? named t))]
                    (str "bb task " t " is in neither :gates nor :not-gates"))
                  kin-warnings)]
    [(vec (concat errors kin-errors)) (vec warnings)]))

(def not-run-patterns
  "P9.13 WP3 (S4): lines that mean part of a gate did not run. Each one fails its gate."
  [#"^\s*SKIP\b"
   #"(?i)\b(unavailable|missing|not installed|not found)\b.*\bskipped\b"
   #"^\s*ℹ (skipped|todo) [1-9]"
   #"^# (skip|todo) [1-9]"])
(defn not-run? [line] (some #(re-find % line) not-run-patterns))

(defn run-gate [g]
  (let [{:keys [cmd dir watchdog caps blocked]} (get gates g)
        w (or watchdog (str g))
        t0 (System/currentTimeMillis)]
    (println (str "\n==== gate " g (when blocked " (blocked)")))
    (if blocked
      (do (println (str "  BLOCKED: " blocked)) {:gate g :result "BLOCKED" :why blocked :secs 0})
      (let [known (contains? (watchdog-defaults) w)
            argv (concat ["node" (str root "/kin/scripts/watchdog.mjs") w "--"] cmd
                         (when-not known [(str "--gate-wall=" (first caps)) (str "--gate-cpu=" (second caps))]))
            {:keys [env removed floor]} (gate-env g)
            _ (when (seq removed)
                (println (str "  env  removed " (str/join " " removed) " (coverage knobs: ci/gate-map.edn :knobs; the gate runs at full coverage)")))
            _ (doseq [f floor] (println (str "  env  kept " f)))
            proc (apply p/process {:dir (str root "/" (or dir ".")) :in :inherit :env env} argv)
            skip (atom nil)
            seen (fn [line] (when (not-run? line) (swap! skip #(or % line))))
            ;; stderr is read too (S4): echoed to stderr, checked like stdout
            err (future (with-open [r (io/reader (:err proc))]
                          (doseq [line (line-seq r)]
                            (binding [*out* *err*] (println line))
                            (seen line))))]
        (with-open [r (io/reader (:out proc))]
          (doseq [line (line-seq r)]
            (println line)
            (seen line)))
        @err
        (let [exit (:exit @proc)
              secs (quot (- (System/currentTimeMillis) t0) 1000)]
          (cond (not (zero? exit)) {:gate g :result (if (= exit 124) "WATCHDOG" "FAIL") :why (str "exit " exit) :secs secs}
                @skip {:gate g :result "NOT RUN" :why (str/trim @skip) :secs secs}
                :else {:gate g :result "ok" :secs secs}))))))

(defn expand [args]
  (mapcat (fn [a]
            (let [s (get (:sets gate-map) (keyword a))]
              (cond s s
                    (contains? gates (symbol a)) [(symbol a)]
                    :else (do (binding [*out* *err*] (println "gates: no set or gate named" a)) (System/exit 2)))))
          args))

(let [args *command-line-args*
      flags (set (filter #(str/starts-with? % "--") args))
      names (remove #(str/starts-with? % "--") args)]
  (cond
    (flags "--list")
    (do (doseq [[g {:keys [caps mode doc blocked]}] (sort-by key gates)]
          (println (format "  %-19s %s" g (if blocked (str "BLOCKED: " blocked)
                                              (str "caps " (first caps) "/" (second caps) " s"
                                                   (when mode (str "; " mode)) (when doc (str "; " doc)))))))
        (doseq [[s members] (:sets gate-map)]
          (println (str "  set " (name s) ": " (str/join " " members)))))

    (or (flags "--check") (empty? names))
    (let [[errors warnings] (problems)]
      (doseq [w warnings] (println "  warn" w))
      (doseq [e errors] (println "  FAIL" e))
      (when-not (flags "--check") (println "usage: bb gates <set|gate>... | --list | --check"))
      (println (if (seq errors) (str "  FAIL gate map: " (count errors) " problem(s)") "  ok   gate map"))
      (System/exit (if (or (seq errors) (not (flags "--check"))) 1 0)))

    :else
    (let [[errors warnings] (problems)]
      (doseq [w warnings] (println "  warn" w))
      (when (seq errors)
        (doseq [e errors] (println "  FAIL" e))
        (System/exit 1))
      (let [todo (expand names)
            results (reduce (fn [acc g]
                              (let [r (run-gate g)]
                                (if (and (flags "--fail-fast") (not= "ok" (:result r)))
                                  (reduced (conj acc r))
                                  (conj acc r))))
                            [] todo)
            bad (remove #(= "ok" (:result %)) results)]
        (println (str "\n==== gates: " (str/join " " names)))
        (doseq [{:keys [gate result why secs]} results]
          (println (format "  %-8s %-19s %6d s%s" result gate secs (if why (str "  (" why ")") ""))))
        (when (< (count results) (count todo))
          (println (format "  %-8s %s" "NOT RUN" (str/join " " (drop (count results) todo)))))
        (println (if (or (seq bad) (< (count results) (count todo)))
                   (str "  FAIL " (count bad) " of " (count todo) " gate(s) not ok")
                   (str "  ok   all " (count todo) " gate(s)")))
        (System/exit (if (or (seq bad) (< (count results) (count todo))) 1 0))))))
