;; The DEAD walk: an item evaluated with an empty query (program.md §14: "a
;; dead item costs 1 + its profile scans"). It is the profile scanner's walk
;; (kin/scan.kin, docs/scanner.md) -- the same checks, order, codes, error
;; offsets and item counting -- with the step budget charged per item visit,
;; per 64 bytes of UTF-8 validation, per key-order comparison and per 64 bytes
;; of typed-array NaN scan. After a schema failure everything left is walked
;; here, which is the profile-only continuation of architecture §4.5. It is
;; also the hot path of profile-only decode (the VM against `any`).
;;
;; `s` is the VM scratch; its first 16 words are the scanner's `o`.
(ns snug.vm.dead
  (:require [kin.lang :refer [defn let local return set if while for do comment declarefn break]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR + - * neg rem shl sar ushr bit-and bit-or
                               < > <= >= == != and or not u8 ia iset hex]]
            [snug.cbor.codes :refer [CODE_TRUNCATED CODE_KEY_TYPE CODE_KEY_ORDER
                                     CODE_DUPLICATE_KEY CODE_TAG CODE_DECIMAL
                                     CODE_TYPED_ARRAY CODE_NDARRAY CODE_DEPTH CODE_TOO_MANY_ITEMS
                                     O_COSE O_MAX_DEPTH O_MAX_ITEMS O_ITEMS O_HI O_LO O_CSTART
                                     O_PROFILE CODE_BIGNUM CODE_TRAILING MAX_BIGNUM_BYTES
                                     O_VCTL VC_ECS PF_CANON PF_VREL PF_TAGS
                                     EV_HEAD EV_END EV_KEY EV_EMB EV_UNITS EV_WORDS]]
            [snug.cbor.head :refer [fail read-arg take-len count-item enter-container bytes-content]]
            [snug.cbor.text :refer [utf8-invalid-at]]
            [snug.cbor.keys :refer [compare-spans]]
            [snug.cbor.tags :refer [typed-size exponent-ok mantissa-ok data-count shape-ok decimal-v ndarray-v vcount]]
            [snug.cbor.canon :refer [kclass]]
            [snug.cbor.scan :refer [scan-float scan-simple key-peek key-label text-bad typed-nan-at]]
            [snug.cbor.stdtags :refer [std-allowed std-content-ok std-inner rule-tag]]
            [snug.vm.layout :refer [R_BUDGET VM_Q1 VM_BIGNUM_MAX VM_BUDGET VM_FASTM VM_GENERIC VM_VTAB]]
            [snug.vm.base :refer [charge c8 c64 c64min]]))

(declarefn dead-item pair-walk if-pair-code)

;; ------------------------------------------------------------ replay (P8.4, D277, D280)
;; Over a canonical copy the driver puts the copy's events (vcopy.kin) in S at
;; s[VM_VTAB] (0: none): s[base] their count, the events from base + 4.

(defn ^I32 ev-lb [^IntsR s ^I32 pos ^I32 kind]
  (comment "The word offset in s of the first event at or after (pos, kind), or -1"
           "(none, or no event table): a binary search, the events being sorted by"
           "position, then kind.")
  (let [base (ia s VM_VTAB)]
    (if (== base 0) (return (neg 1)))
    (let [n (ia s base)
          ^:mut lo 0
          ^:mut hi n]
      (while (< lo hi)
        (let [mid (sar (+ lo hi) 1)
              e (+ (+ base 4) (* EV_WORDS mid))
              v (ia s e)]
          (if (or (< v pos) (and (== v pos) (< (ia s (+ e 1)) kind))) (set lo (+ mid 1)) (set hi mid))))
      (if (>= lo n) (return (neg 1)))
      (return (+ (+ base 4) (* EV_WORDS lo))))))

(defn ^:pub ^I32 rfind [^IntsR s ^I32 pos ^I32 kind]
  (comment "The word offset in s of the event (pos, kind), or -1.")
  (let [e (ev-lb s pos kind)]
    (if (and (>= e 0) (and (== (ia s e) pos) (== (ia s (+ e 1)) kind))) (return e))
    (return (neg 1))))

(defn ^:pub ^I32 ev-next [^IntsR s ^I32 pos]
  (comment "The position of the first recorded event at or after pos, or 2^31 - 1"
           "(none, or no event table): a streak takes no item an event lies in.")
  (let [e (ev-lb s pos 0)]
    (if (< e 0) (return 2147483647))
    (return (ia s e))))

(defn ^:pub ^I32 head-fail [^Bytes b ^Ints s ^I32 pos ^I32 ai ^I32 depth ^I32 r]
  (comment "read-arg answered r < 0 at pos. Over a canonical copy a definite array or"
           "map head is planted malformed where the scanner refused it after its"
           "depth check (a declared length past the end: EV_HEAD word 7 odd); a walk"
           "whose own depth bound it reaches refuses depth there first, as"
           "enter-container would (a tag-24 payload's walk may be bounded tighter"
           "than the copy's, D264). r otherwise.")
  (if (or (== (ia s VM_VTAB) 0) (!= ai 28)) (return r))
  (let [major (ushr (u8 b pos) 5)]
    (if (and (!= major 4) (!= major 5)) (return r)))
  (if (< depth (ia s O_MAX_DEPTH)) (return r))
  (let [e (rfind s pos EV_HEAD)]
    (if (or (< e 0) (== (bit-and (ia s (+ e 7)) 1) 0)) (return r))
    (return (fail s pos CODE_DEPTH))))

(defn ^:pub ^I32 rfail [^Ints s ^I32 e]
  (comment "Refuse with the event e's code at its copy offset (which maps to the"
           "refusal's source offset).")
  (return (fail s (ia s (+ e 3)) (ia s (+ e 2)))))

(defn ^:pub ^I32 replay-end [^Ints s ^I32 cs]
  (comment "At the end of the container whose content starts at cs, before anything"
           "else there: its deferred duplicate check's units (D277; a budget stop is"
           "reported at the map), then a refusal recorded for it (D280). 0, or the"
           "negated refusal.")
  (let [eu (rfind s cs EV_UNITS)]
    (if (>= eu 0)
      (if (not (charge s (ia s (+ eu 2)) (ia s (+ eu 3)))) (return (neg R_BUDGET)))))
  (let [ee (rfind s cs EV_END)]
    (if (>= ee 0) (return (rfail s ee))))
  (return 0))

(defn ^:pub ^I32 replay-key [^Ints s ^I32 start]
  (comment "After the key at start's key-order comparison: its recorded duplicate"
           "refusal (D280). 0, or the negated refusal.")
  (let [ek (rfind s start EV_KEY)]
    (if (>= ek 0) (return (rfail s ek))))
  (return 0))

(defn ^:pub ^Bool replay-trunc [^IntsR s ^I32 p]
  (comment "Is p a stop planted where the source had no byte (truncated before any"
           "visit, as at the end of input)?")
  (let [e (rfind s p EV_HEAD)]
    (if (< e 0) (return false))
    (return (== (ia s (+ e 4)) CODE_TRUNCATED))))

(defn ^:pub ^I32 dead-text [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 hi ^I32 lo ^I32 end]
  (comment "Text: its length, then UTF-8 (charged ceil(len/8) before the scan, D253).")
  (let [stop (take-len s pos p hi lo end)]
    (if (< stop 0) (return stop))
    (if (not (charge s (c8 (- stop p)) pos)) (return (neg R_BUDGET)))
    (let [bad (utf8-invalid-at b p stop)]
      (if (>= bad 0) (return (text-bad b s bad stop)))
      (return stop))))

(defn ^:pub ^I32 dead-int-streak [^Bytes b ^Ints s ^I32 q0 ^I32 limit ^I32 end]
  (comment "P3.6 (D044): up to `limit` consecutive dead integer items (major 0/1,"
           "a shortest head, its bytes present), each charged its visit and counted"
           "exactly as dead-item would; stops BEFORE any item that is not one, or"
           "that the items limit or the budget would refuse. Answers the next"
           "position; the count in s[VM_FASTM].")
  (let [maxit (ia s O_MAX_ITEMS)
        ^:mut q q0
        ^:mut k 0
        ^:mut items (ia s O_ITEMS)
        ^:mut left (ia s VM_BUDGET)]
    (while (and (< k limit) (< q end))
      (let [ib (u8 b q)
            ai (bit-and ib 31)
            ^:mut h 1]
        (if (> (ushr ib 5) 1) (break))
        (if (or (>= items maxit) (< left 1)) (break))
        (if (>= ai 24)
          (do (if (> ai 27) (break))
              (set h (+ 1 (shl 1 (- ai 24))))
              (if (> h (- end q)) (break))
              (if (and (== ai 24) (< (u8 b (+ q 1)) 24)) (break))
              (if (and (== ai 25) (== (u8 b (+ q 1)) 0)) (break))
              (if (and (== ai 26) (== (bit-or (u8 b (+ q 1)) (u8 b (+ q 2))) 0)) (break))
              (if (and (== ai 27) (== (bit-or (bit-or (u8 b (+ q 1)) (u8 b (+ q 2))) (bit-or (u8 b (+ q 3)) (u8 b (+ q 4)))) 0)) (break))))
        (set left (- left 1))
        (set items (+ items 1))
        (set q (+ q h))
        (set k (+ k 1))))
    (iset s VM_BUDGET left)
    (iset s O_ITEMS items)
    (iset s VM_FASTM k)
    (return q)))

(defn ^:pub ^I32 dead-array [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 hi ^I32 lo ^I32 depth ^I32 end]
  (let [r (enter-container s pos p hi lo depth 0 end)
        inner (+ depth 1)
        ^:mut q p
        ^:mut i 0]
    (if (< r 0) (return r))
    (while (< i lo)
      (if (== (bit-and (ia s VM_GENERIC) 1) 0)
        (do (set q (dead-int-streak b s q (- lo i) end))
            (set i (+ i (ia s VM_FASTM)))))
      (if (< i lo)
        (do (set q (dead-item b s q inner end))
            (if (< q 0) (return q))
            (set i (+ i 1)))))
    (if (!= (ia s VM_VTAB) 0)
      (do (let [re (replay-end s p)]
            (if (< re 0) (return re)))))
    (return q)))

(defn ^:pub key-ecs [^Bytes b ^Ints s ^I32 start]
  (comment "P8.4 (D263): a key that is not text or an integer and is EC-sensitive (it"
           "holds a float zero or a NaN, or a map out of canonical order) notes"
           "VC_ECS in s[O_VCTL]: its duplicates are not bytewise, so the run's verdict"
           "takes the canonical path, whose scan checks them by value. O_HI, O_LO and"
           "O_CSTART are kept.")
  (let [km (ushr (u8 b start) 5)]
    (if (and (!= km 3) (> km 1))
      (do (let [h (ia s O_HI)
                l (ia s O_LO)
                c (ia s O_CSTART)]
            (if (!= (bit-and (kclass b s start) 2) 0)
              (do (let [v (ia s O_VCTL)]
                    (iset s O_VCTL (bit-or v VC_ECS)))))
            (iset s O_HI h)
            (iset s O_LO l)
            (iset s O_CSTART c))))))

(defn ^:pub ^I32 key-order [^Bytes b ^Ints s ^I32 ps ^I32 pe ^I32 start ^I32 q]
  (comment "The key b[start, q) against the previous key b[ps, pe) (ps < 0: none):"
           "charged ceil(min(len)/64), at least 1; 0, or the negated refusal. Over a"
           "canonical copy (PF_CANON, P8.4) the order is the wire's and duplicates are"
           "already checked: charged, never refused; elsewhere an EC-sensitive key is"
           "noted (key-ecs).")
  (let [canon (!= (bit-and (ia s O_PROFILE) PF_CANON) 0)]
    (if (not canon) (key-ecs b s start))
    (if (< ps 0) (return 0))
    (if (not (charge s (c64min (- pe ps) (- q start)) start)) (return (neg R_BUDGET)))
    (if canon (return 0))
    (let [order (compare-spans b ps pe start q)]
      (if (== order 0) (return (fail s start CODE_DUPLICATE_KEY)))
      (if (> order 0) (return (fail s start CODE_KEY_ORDER)))
      (return 0))))

(defn ^:pub ^I32 dead-map-pairs [^Bytes b ^Ints s ^I32 p ^I32 lo ^I32 depth ^I32 end]
  (comment "The lo pairs of a map at depth (after its container checks), dead.")
  (let [cose (and (== depth 0) (!= (ia s O_COSE) 0))
        inner (+ depth 1)
        ^:mut q p
        ^:mut ps (neg 1)
        ^:mut pe (neg 1)]
    (for [^I32 _k 0 lo]
      (let [start q]
        (if (>= start end) (return (fail s start CODE_TRUNCATED)))
        (let [km (ushr (u8 b start) 5)]
          (if (!= km 3)
            (if (not (key-peek s km cose)) (return (fail s start CODE_KEY_TYPE))))
          (set q (dead-item b s start inner end))
          (if (< q 0) (return q))
          (if (<= km 1)
            (if (not (key-label b s start km)) (return (fail s start CODE_KEY_TYPE))))
          (let [ko (key-order b s ps pe start q)]
            (if (< ko 0) (return ko)))
          (if (!= (ia s VM_VTAB) 0)
            (do (let [rk (replay-key s start)]
                  (if (< rk 0) (return rk)))))
          (set ps start)
          (set pe q)
          (set q (dead-item b s q inner end))
          (if (< q 0) (return q)))))
    (if (!= (ia s VM_VTAB) 0)
      (do (let [re (replay-end s p)]
            (if (< re 0) (return re)))))
    (return q)))

(defn ^:pub ^I32 dead-map [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 hi ^I32 lo ^I32 depth ^I32 end]
  (let [r (enter-container s pos p hi lo depth 1 end)]
    (if (< r 0) (return r))
    (return (dead-map-pairs b s p lo depth end))))

(defn ^:pub ^I32 dead-array-elems [^Bytes b ^Ints s ^I32 p ^I32 lo ^I32 depth ^I32 end]
  (comment "The lo elements of an array at depth (after its container checks),"
           "dead; the second element's start goes in s[VM_Q1] when lo = 2.")
  (let [inner (+ depth 1)
        ^:mut q p
        ^:mut q1 p]
    (for [^I32 i 0 lo]
      (set q (dead-item b s q inner end))
      (if (< q 0) (return q))
      (if (== i 0) (set q1 q)))
    (if (!= (ia s VM_VTAB) 0)
      (do (let [re (replay-end s p)]
            (if (< re 0) (return re)))))
    (if (== lo 2) (iset s VM_Q1 q1))
    (return q)))

(defn ^:pub ^I32 dead-typed [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 tag ^I32 size ^I32 end]
  (comment "scan-typed, with the NaN scan of float arrays charged ceil(len/64)"
           "after the length checks and before the scan.")
  (let [stop (bytes-content b s p CODE_TYPED_ARRAY end)]
    (if (< stop 0) (return stop))
    (let [cs (ia s O_CSTART)]
      (if (!= (rem (- stop cs) size) 0) (return (fail s pos CODE_TYPED_ARRAY)))
      (comment "the NaN rule is the Bindle tag set's (tag level 0, D265)")
      (if (!= (bit-and (ia s O_PROFILE) PF_TAGS) 0) (return stop))
      (if (>= tag 84)
        (if (not (charge s (c64 (- stop cs)) pos)) (return (neg R_BUDGET))))
      (let [bad (typed-nan-at b cs stop tag)]
        (if (>= bad 0) (return (fail s bad CODE_TYPED_ARRAY))))
      (return stop))))

(defn ^:pub ^I32 dead-bignum [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 bmax ^I32 end]
  (comment "Tags 2/3 (scan-bignum): a byte string of 9..bmax bytes (bmax <= 128) with"
           "no leading zero. The content is not an item. Its start goes in"
           "s[O_CSTART].")
  (let [stop (bytes-content b s p CODE_BIGNUM end)]
    (if (< stop 0) (return stop))
    (let [cs (ia s O_CSTART)
          len (- stop cs)]
      (comment "a valid-CBOR run (PF_VREL, P8.4, D265) admits leading zeros and small values")
      (if (== (bit-and (ia s O_PROFILE) PF_VREL) 0)
        (if (or (< len 9) (== (u8 b cs) 0)) (return (fail s pos CODE_BIGNUM))))
      (if (or (> len MAX_BIGNUM_BYTES) (> len bmax)) (return (fail s pos CODE_BIGNUM)))
      (return stop))))

(defn ^:pub ^I32 dead-pair-body [^Bytes b ^Ints s ^I32 p ^I32 depth ^I32 end]
  (comment "The `[x, y]` content of tag 4/40 at p, after its 0x82 was checked: the"
           "inner array is an item (visit charged, counted, a level), then both"
           "elements, dead. The second element's start goes in s[VM_Q1].")
  (if (not (charge s 1 p)) (return (neg R_BUDGET)))
  (let [c (count-item s p)]
    (if (< c 0) (return c)))
  (let [r (enter-container s p (+ p 1) 0 2 (+ depth 1) 0 end)]
    (if (< r 0) (return r)))
  (let [^I32 q1 (dead-item b s (+ p 1) (+ depth 2) end)]
    (if (< q1 0) (return q1))
    (let [^I32 q2 (dead-item b s q1 (+ depth 2) end)]
      (if (< q2 0) (return q2))
      (iset s VM_Q1 q1)
      (return q2))))

(defn ^:pub ^Bool pair-v [^IntsR s]
  (comment "Do tags 4 and 40 take the any-width path (scan.kin pair-v-on): a tag level"
           "above the Bindle set's, or a valid-CBOR run (PF_VREL)?")
  (return (!= (bit-and (ia s O_PROFILE) (bit-or PF_TAGS PF_VREL)) 0)))

(defn ^:pub ^I32 pair-check [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 shape-code ^I32 end]
  (comment "scan-pair's first two checks: a byte is left, and it is 0x82 -- at tag"
           "levels 1-3 or in a valid-CBOR run (D265, scan-pair-v) an array of any count, walked as an item"
           "and counted after (pair-count).")
  (if (>= p end) (return (fail s p CODE_TRUNCATED)))
  (if (and (!= (ia s VM_VTAB) 0) (replay-trunc s p)) (return (fail s p CODE_TRUNCATED)))
  (local ^:mut ^I32 hb)
  (set hb (u8 b p))
  (comment "over a canonical copy, a content head planted for a declared length past"
           "the end is checked as its source byte (D280: the check phase the input"
           "reaches)")
  (if (!= (ia s VM_VTAB) 0)
    (do (let [e (rfind s p EV_HEAD)]
          (if (and (>= e 0) (!= (bit-and (ia s (+ e 7)) 1) 0)) (set hb (ushr (ia s (+ e 7)) 1))))))
  (if (pair-v s)
    (do (if (!= (ushr hb 5) 4) (return (fail s pos shape-code)))
        (return 0)))
  (if (!= hb (hex 130)) (return (fail s pos shape-code)))
  (return 0))

(defn ^:pub ^I32 pair-count [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 shape-code ^I32 stop]
  (comment "At tag levels 1-3, after the content array at p was walked: it holds two"
           "items (else shape-code at the tag). stop, or the negated refusal.")
  (if (not (pair-v s)) (return stop))
  (if (!= (vcount b s p) 2) (return (fail s pos shape-code)))
  (return stop))

(defn ^:pub ^I32 decimal-check [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 stop]
  (comment "Tag 4's rule over its walked [e, m] at p: the Bindle rule at tag level 0,"
           "RFC 8949 §3.4.4's at levels 1-3 (D265).")
  (let [lvl (bit-and (sar (ia s O_PROFILE) 2) 3)]
    (if (pair-v s)
      (do (if (not (decimal-v b s p lvl)) (return (fail s pos CODE_DECIMAL)))
          (return stop))))
  (let [q1 (ia s VM_Q1)]
    (if (not (exponent-ok b (+ p 1))) (return (fail s pos CODE_DECIMAL)))
    (if (not (mantissa-ok b q1 stop)) (return (fail s pos CODE_DECIMAL)))
    (return stop)))

(defn ^:pub ^I32 ndarray-check [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 stop]
  (comment "Tag 40's rule over its walked [shape, data] at p: the Bindle rule at tag"
           "level 0, RFC 8746 §3.1.1's at levels 1-3 (D265).")
  (let [lvl (bit-and (sar (ia s O_PROFILE) 2) 3)]
    (if (pair-v s)
      (do (if (not (ndarray-v b s p lvl)) (return (fail s pos CODE_NDARRAY)))
          (return stop))))
  (let [count (data-count b (ia s VM_Q1))]
    (if (< count 0) (return (fail s pos CODE_NDARRAY)))
    (if (not (shape-ok b (+ p 1) count)) (return (fail s pos CODE_NDARRAY)))
    (return stop)))

(defn ^:pub ^I32 vtab-find [^IntsR s ^I32 cs]
  (comment "Over a canonical copy (P8.4, D264): the EV_EMB event (word offset in s) of"
           "the byte-string content starting at cs -- content walked in its own copy"
           "(copy start and end at +3, +4) -- or -1.")
  (return (rfind s cs EV_EMB)))

(defn ^:pub ^I32 dead-std-check [^Bytes b ^Ints s ^I32 pos ^I32 tag ^I32 q ^I32 stop ^I32 depth]
  (comment "A standard-set tag at pos (depth `depth`) whose content item b[q, stop)"
           "was walked (snug.cbor.stdtags, D121): 1 unit, + ceil(len/8) (D253) for the"
           "syntax scan of a tag-0/32 text; the content rule (tag); then a tag-24"
           "byte string's content walked dead as one item at depth + 2, bounded by"
           "its end (trailing after it). Answers stop, or a negated code. Shared by"
           "the dead walk, the live walk and the resumable session.")
  (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
  (if (and (or (== tag 0) (== tag 32)) (== (ushr (u8 b q) 5) 3))
    (if (not (charge s (c8 (- stop q)) pos)) (return (neg R_BUDGET))))
  (if (not (std-content-ok b tag q stop)) (return (fail s pos CODE_TAG)))
  (if (== tag 24)
    (do (let [cs (std-inner b q)
              e (vtab-find s cs)
              ^:mut wcs cs
              ^:mut wce stop]
          (comment "over a canonical copy a payload that is not its own DC form, or is"
                   "refused, is walked in its own copy (D264, D280)")
          (if (>= e 0)
            (do (set wcs (ia s (+ e 3)))
                (set wce (ia s (+ e 4)))))
          (let [^I32 r (dead-item b s wcs (+ depth 2) wce)]
            (if (< r 0) (return r))
            (if (!= r wce) (return (fail s r CODE_TRAILING)))))))
  (return stop))

(defn ^:pub ^I32 if-pair-code [^I32 lo]
  (if (== lo 4) (return CODE_DECIMAL))
  (return CODE_NDARRAY))

(defn ^:pub ^I32 pair-walk [^Bytes b ^Ints s ^I32 p ^I32 depth ^I32 end]
  (comment "The content array of tag 4/40 walked dead: as dead-pair-body (two elements)"
           "at tag level 0, as an item of any count at levels 1-3.")
  (if (not (pair-v s)) (return (dead-pair-body b s p depth end)))
  (return (dead-item b s p (+ depth 1) end)))

(defn ^:pub ^I32 dead-tag [^Bytes b ^Ints s ^I32 pos ^I32 p ^I32 hi ^I32 lo ^I32 depth ^I32 end]
  (if (>= depth (ia s O_MAX_DEPTH)) (return (fail s pos CODE_DEPTH)))
  (if (!= hi 0)
    (do (comment "a tag number of more than 32 bits: its rule tag (D180)")
        (let [rw (rule-tag hi lo)]
          (if (not (std-allowed (ia s O_PROFILE) rw depth)) (return (fail s pos CODE_TAG)))
          (let [^I32 qh (dead-item b s p (+ depth 1) end)]
            (if (< qh 0) (return qh))
            (return (dead-std-check b s pos rw p qh depth))))))
  (if (or (== lo 2) (== lo 3)) (return (dead-bignum b s pos p (ia s VM_BIGNUM_MAX) end)))
  (if (or (== lo 4) (== lo 40))
    (do (let [code (if-pair-code lo)
              c4 (pair-check b s pos p code end)]
          (if (< c4 0) (return c4)))
        (let [^I32 st4 (pair-walk b s p depth end)]
          (if (< st4 0) (return st4))
          (let [st5 (pair-count b s pos p (if-pair-code lo) st4)]
            (if (< st5 0) (return st5))
            (if (== lo 4) (return (decimal-check b s pos p st5)))
            (return (ndarray-check b s pos p st5))))))
  (let [size (typed-size lo)]
    (if (> size 0) (return (dead-typed b s pos p lo size end)))
    (if (std-allowed (ia s O_PROFILE) lo depth)
      (do (let [^I32 qs (dead-item b s p (+ depth 1) end)]
            (if (< qs 0) (return qs))
            (return (dead-std-check b s pos lo p qs depth)))))
    (return (fail s pos CODE_TAG))))

(defn ^:pub ^I32 dead-item [^Bytes b ^Ints s ^I32 pos ^I32 depth ^I32 end]
  (comment "One dead item at pos: visit charged, counted, then its head (scan.kin `item`).")
  (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
  (let [it (+ (ia s O_ITEMS) 1)]
    (iset s O_ITEMS it)
    (if (> it (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
  (if (>= pos end) (return (fail s pos CODE_TRUNCATED)))
  (let [ib (u8 b pos)
        major (ushr ib 5)
        ai (bit-and ib 31)
        ^:mut hi 0
        ^:mut lo ai
        ^:mut p (+ pos 1)]
    (if (>= ai 24)
      (do (if (== major 7)
            (if (and (>= ai 25) (<= ai 27)) (return (scan-float b s pos ai end))))
          (set p (read-arg b s pos ai end))
          (if (< p 0) (return (head-fail b s pos ai depth p)))
          (set hi (ia s O_HI))
          (set lo (ia s O_LO))))
    (if (<= major 1) (return p))
    (if (== major 2) (return (take-len s pos p hi lo end)))
    (if (== major 3) (return (dead-text b s pos p hi lo end)))
    (if (== major 4) (return (dead-array b s pos p hi lo depth end)))
    (if (== major 5) (return (dead-map b s pos p hi lo depth end)))
    (if (== major 6) (return (dead-tag b s pos p hi lo depth end)))
    (return (scan-simple s pos ai))))

(defn ^:pub ^I32 dead-seq [^Bytes b ^Ints s ^I32 p ^I32 depth ^I32 end]
  (comment "A CBOR sequence b[p, end) walked dead: items until end.")
  (let [^:mut q p]
    (while (< q end)
      (set q (dead-item b s q depth end))
      (if (< q 0) (return q)))
    (return q)))
