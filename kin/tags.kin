;; The semantics of the allowed tags, checked on bytes the walk has ALREADY
;; validated as well-formed items (so every head read here is in bounds and in
;; shortest form). Integer-only (D009): a decimal mantissa's divisibility by 10
;; is a remainder over its bytes; a tag-40 product is checked by division, so
;; it never overflows on either target.
(ns snug.cbor.tags
  (:require [kin.lang :refer [defn let return set if while for do comment case]]
            [snug.lang :refer [I32 Bool Bytes Ints + - * neg quot rem ushr bit-and bit-or
                               < > <= >= == != and or not u8 ia hex]]
            [snug.cbor.codes :refer [MAX_DIMENSIONS O_HI O_LO]]
            [snug.cbor.head :refer [be16 be32 head-size small-arg]]
            [snug.cbor.canon :refer [targ tskip tcount tlength]]))

(defn ^:pub ^I32 typed-size [^I32 tag]
  (comment "The element size of an allowed RFC 8746 little-endian typed-array tag,"
           "or 0 (big-endian forms, uint8 (64), clamped (68) and float128 are refused).")
  (case tag
    [72] 1
    [69 77 84] 2
    [70 78 85] 4
    [71 79 86] 8
    :else 0))

(defn ^:pub ^I32 mod10 [^Bytes b ^I32 s ^I32 e]
  (comment "The big-endian unsigned integer b[s..e) modulo 10.")
  (let [^:mut r 0
        ^:mut i s]
    (while (< i e)
      (set r (rem (+ (* r 256) (u8 b i)) 10))
      (set i (+ i 1)))
    (return r)))

(defn ^:pub ^Bool exponent-ok [^Bytes b ^I32 x]
  (comment "A decimal exponent: a negative integer (major 1) at least -1024, i.e."
           "argument n <= 1023. Anything else -- a non-negative integer, a bignum,"
           "a float, any other item -- is not.")
  (let [ib (u8 b x)
        ai (bit-and ib 31)]
    (if (!= (ushr ib 5) 1) (return false))
    (if (<= ai 24) (return true))
    (if (== ai 25) (return (<= (be16 b (+ x 1)) 1023)))
    (return false)))

(defn ^:pub ^Bool mantissa-ok [^Bytes b ^I32 s ^I32 e]
  (comment "A decimal mantissa b[s..e): an integer (major 0/1) or a bignum (tag 2/3),"
           "non-zero and not divisible by 10. Major 1 and tag 3 hold -1-n, so test"
           "n + 1.")
  (let [ib (u8 b s)
        major (ushr ib 5)
        ai (bit-and ib 31)]
    (if (or (== major 0) (== major 1))
      (do (let [^:mut r ai]
            (if (>= ai 24) (set r (mod10 b (+ s 1) e)))
            (if (< ai 24) (set r (rem ai 10)))
            (if (== major 1) (set r (rem (+ r 1) 10)))
            (if (and (== major 0) (== ai 0)) (return false))
            (return (!= r 0)))))
    (if (or (== ib (hex 194)) (== ib (hex 195)))
      (do (comment "A bignum: its byte-string head follows the tag byte.")
          (let [cs (+ (+ s 1) (head-size (bit-and (u8 b (+ s 1)) 31)))
                ^:mut r2 (mod10 b cs e)]
            (if (== ib (hex 195)) (set r2 (rem (+ r2 1) 10)))
            (return (!= r2 0)))))
    (return false)))

(defn ^:pub ^I32 data-count [^Bytes b ^I32 x]
  (comment "Elements in a tag-40 data item at x: an array's length, or a typed"
           "array's byte length over its element size; -1 for anything else.")
  (let [ib (u8 b x)
        major (ushr ib 5)]
    (if (== major 4) (return (small-arg b x)))
    (if (== major 6)
      (do (if (!= ib (hex 216)) (return (neg 1)))
          (let [size (typed-size (u8 b (+ x 1)))]
            (if (== size 0) (return (neg 1)))
            (return (quot (small-arg b (+ x 2)) size)))))
    (return (neg 1))))

(defn ^:pub ^Bool shape-ok [^Bytes b ^I32 s ^I32 count]
  (comment "A tag-40 shape at s: an array of 1..8 integers (major 0), each positive"
           "and at most 2^53 - 1, whose product equals count. The product is"
           "checked by division (d <= count / p), so it never overflows; any"
           "dimension past 31 bits already exceeds count.")
  (let [ib (u8 b s)]
    (if (!= (ushr ib 5) 4) (return false))
    (let [k (small-arg b s)
          ^:mut x (+ s (head-size (bit-and ib 31)))
          ^:mut p 1]
      (if (or (< k 1) (> k MAX_DIMENSIONS)) (return false))
      (for [^I32 _j 0 k]
        (let [db (u8 b x)
              dai (bit-and db 31)]
          (if (!= (ushr db 5) 0) (return false))
          (if (== dai 27) (return false))
          (let [d (small-arg b x)]
            (if (<= d 0) (return false))
            (if (> d (quot count p)) (return false))
            (set p (* p d))
            (set x (+ x (head-size dai))))))
      (return (== p count)))))

;; ------------------------------------------------------------ any head width (P8.4)
;; The rules of tags 4 and 40 at tag levels 1-3 (RFC 8949 §3.4.4, RFC 8746 §3.1.1,
;; D265), and the Bindle rules (level 0) for content a PF_VALID walk admitted (heads
;; of any width, indefinite lengths): over CHECKED content, read with the canonical
;; module's trusted readers. The functions above stay the deterministic Bindle path.

(defn ^:pub ^I32 vcount [^Bytes b ^Ints o ^I32 x]
  (comment "Elements of the CHECKED array at x (a map's pairs), either length kind.")
  (let [ai (bit-and (u8 b x) 31)
        q (targ b o x)]
    (if (!= ai 31) (return (ia o O_LO)))
    (if (== (ushr (u8 b x) 5) 5) (return (quot (tcount b o q) 2)))
    (return (tcount b o q))))

(defn ^:pub ^I32 tagnum-v [^Bytes b ^Ints o ^I32 x]
  (comment "The number of the CHECKED tag head at x, or -2 above 2^31 - 1.")
  (targ b o x)
  (if (or (!= (ia o O_HI) 0) (< (ia o O_LO) 0)) (return (neg 2)))
  (return (ia o O_LO)))

(defn ^:pub ^I32 mod10-head [^Bytes b ^I32 x]
  (comment "The argument of the CHECKED integer head at x, modulo 10, any width.")
  (let [ai (bit-and (u8 b x) 31)]
    (if (< ai 24) (return (rem ai 10)))
    (return (mod10 b (+ x 1) (+ x (head-size ai))))))

(defn ^:pub ^I32 mod10-str [^Bytes b ^Ints o ^I32 x]
  (comment "The content of the CHECKED byte string at x, as a big-endian unsigned"
           "integer, modulo 10 (its chunks in order, for an indefinite one).")
  (let [ai (bit-and (u8 b x) 31)
        ^:mut q (targ b o x)
        ^:mut r 0]
    (if (!= ai 31) (return (mod10 b q (+ q (ia o O_LO)))))
    (while (!= (u8 b q) 255)
      (set q (targ b o q))
      (let [l (ia o O_LO)]
        (for [^I32 k 0 l]
          (set r (rem (+ (* r 256) (u8 b (+ q k))) 10)))
        (set q (+ q l))))
    (return r)))

(defn ^:pub ^Bool decimal-v [^Bytes b ^Ints o ^I32 p ^I32 lvl]
  (comment "Tag 4 content: the CHECKED two-element array at p. Level >= 1: an integer"
           "exponent (major 0/1) and an integer or bignum mantissa (RFC 8949 §3.4.4)."
           "Level 0 (Bindle): exponent -1024..-1, mantissa non-zero and not divisible"
           "by 10, read at any width.")
  (let [e (targ b o p)
        m (tskip b o e)
        em (ushr (u8 b e) 5)
        mm (ushr (u8 b m) 5)]
    (if (>= lvl 1)
      (do (if (> em 1) (return false))
          (if (<= mm 1) (return true))
          (if (!= mm 6) (return false))
          (let [t (tagnum-v b o m)]
            (return (or (== t 2) (== t 3))))))
    (if (!= em 1) (return false))
    (targ b o e)
    (if (or (!= (ia o O_HI) 0) (or (< (ia o O_LO) 0) (> (ia o O_LO) 1023))) (return false))
    (if (== mm 0)
      (do (targ b o m)
          (if (and (== (ia o O_HI) 0) (== (ia o O_LO) 0)) (return false))
          (return (!= (mod10-head b m) 0))))
    (if (== mm 1) (return (!= (rem (+ (mod10-head b m) 1) 10) 0)))
    (if (!= mm 6) (return false))
    (let [t2 (tagnum-v b o m)
          c (targ b o m)]
      (if (== t2 2) (return (!= (mod10-str b o c) 0)))
      (if (== t2 3) (return (!= (rem (+ (mod10-str b o c) 1) 10) 0)))
      (return false))))

(defn ^:pub ^I32 data-count-v [^Bytes b ^Ints o ^I32 d ^I32 lvl]
  (comment "Elements of CHECKED tag-40 data at d: an array's length; a typed array's"
           "byte length over its element size (level 0: the little-endian set only;"
           "levels >= 1: any RFC 8746 typed array, and a homogeneous array, tag 41,"
           "over an array); -1 for anything else.")
  (let [major (ushr (u8 b d) 5)]
    (if (== major 4) (return (vcount b o d)))
    (if (!= major 6) (return (neg 1)))
    (let [t (tagnum-v b o d)
          c (targ b o d)
          cm (ushr (u8 b c) 5)
          ^:mut size (typed-size t)]
      (if (and (>= lvl 1) (== t 41))
        (do (if (!= cm 4) (return (neg 1)))
            (return (vcount b o c))))
      (if (and (>= lvl 1) (== size 0))
        (do (if (and (>= t 64) (<= t 87))
              (do (if (or (== t 64) (== t 68)) (set size 1))
                  (if (or (== t 65) (or (== t 73) (== t 80))) (set size 2))
                  (if (or (== t 66) (or (== t 74) (== t 81))) (set size 4))
                  (if (or (== t 67) (or (== t 75) (== t 82))) (set size 8))
                  (if (or (== t 83) (== t 87)) (set size 16))))))
      (if (or (== size 0) (!= cm 2)) (return (neg 1)))
      (return (quot (tlength b o c) size)))))

(defn ^:pub ^Bool ndarray-v [^Bytes b ^Ints o ^I32 p ^I32 lvl]
  (comment "Tag 40 content: the CHECKED two-element array at p, [shape, data]. The"
           "shape an array of unsigned integers distinct from zero (RFC 8746 §3.1.1;"
           "level 0 also 1..8 of them, each at most 2^53 - 1) whose product is the"
           "data's element count (data-count-v), checked by division so it never"
           "overflows.")
  (let [sh (targ b o p)
        d (tskip b o sh)
        count (data-count-v b o d lvl)]
    (if (< count 0) (return false))
    (if (!= (ushr (u8 b sh) 5) 4) (return false))
    (let [k (vcount b o sh)
          ^:mut x (targ b o sh)
          ^:mut prod 1]
      (if (and (== lvl 0) (or (< k 1) (> k MAX_DIMENSIONS))) (return false))
      (for [^I32 _j 0 k]
        (if (!= (ushr (u8 b x) 5) 0) (return false))
        (let [nx (targ b o x)
              hi (ia o O_HI)
              lo (ia o O_LO)]
          (if (and (== hi 0) (== lo 0)) (return false))
          (if (or (!= hi 0) (< lo 0)) (return false))
          (if (> lo (quot count prod)) (return false))
          (set prod (* prod lo))
          (set x nx)))
      (return (== prod count)))))
