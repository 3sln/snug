;; The VM's entry points (docs/program.md §13.1): scratch sizing and
;; initialisation, rule lookup, and validation of a whole buffer or of one
;; item's span (architecture §16.3 `validateAt`). The buffer driver of D030:
;; a bounded recursive walk over a contiguous buffer. vm-verify is the
;; compiler engineer's (kin/program, snug.program.verify); a Program must be
;; verified before it is validated against.
(ns snug.vm.api
  (:require [kin.lang :refer [defn let local return set if while for do comment declarefn]]
            [snug.lang :refer [I32 Ext ext-none Bool Bytes BytesW Ints IntsR + - * neg quot rem ushr bit-and bit-or bit-xor < > <= >= == != and or not
                               u8 blen ia iset ilen]]
            [snug.cbor.codes :refer [CODE_TOO_LARGE CODE_NOT_MAP CODE_TRAILING O_TOP O_COSE
                                     O_MAX_BYTES O_MAX_DEPTH O_MAX_ENTRIES O_MAX_ITEMS O_ERR_POS
                                     O_ITEMS O_PROFILE MAX_BIGNUM_BYTES PF_HOST PF_SUB
                                     PF_VALID PF_VREL PF_CANON O_VCTL O_VLEN O_VNEEDW O_VNEEDB
                                     O_S_FIRST O_S_NEV O_S_CBASE O_S_EDEPTH VC_ECS CODE_SCRATCH
                                     EV_HEAD EV_END EV_KEY EV_UNITS EV_WORDS
                                     CODE_NON_SHORTEST CODE_INDEFINITE CODE_KEY_ORDER]]
            [snug.cbor.scan :refer [scan-x]]
            [snug.cbor.vcopy :refer [canon-build vmap vsource ev-find]]
            [snug.cbor.head :refer [fail]]
            [snug.vm.layout :refer [MAGIC FORMAT_V2 HEADER_WORDS H_FORMAT H_HEADER_WORDS
                                    H_PROGRAM_WORDS H_POOL_BYTES H_N_RULES H_N_LEAVES H_LIM_DEPTH
                                    H_LIM_INPUT H_LIM_ENTRIES H_LIM_ITEMS H_LIM_BIGNUM H_LIM_BUDGET
                                    H_S_RULES H_S_CSET_INDEX H_S_CHAIN_INDEX VM_EPOCH VM_MARK_CAP
                                    VM_BUDGET VM_BUDGET_START VM_W_STATE VM_W_REASON VM_W_SUB
                                    VM_W_DEPTH VM_W_XKIND VM_W_XVAL VM_W_OFFSET VM_D VM_FRAMES VM_PATH
                                    VM_REGEX VM_RULE VM_CHAIN VM_EMBED VM_BIGNUM_MAX VM_POS VM_Q1
                                    VM_REGCAP VM_QIDX VM_DLIM VM_GENERIC SCRATCH_MARK R_TYPE R_BUDGET
                                    R_INCONSISTENT R_NONDET VM_VTAB H_FLAGS FL_EMBED FL_ARENA G_FORCED
                                    R_GROUP_LIMIT R_AGROW VM_PBASE]]
            [snug.vm.base :refer [new-epoch q-add q-stamp ts-test cset-rec wit-empty wit-set]]
            [snug.vm.arena :refer [AR_HDR LEASE arena-cap arena-init arena-want]]
            [snug.vm.dead :refer [dead-item]]
            [snug.vm.leaf :refer [cmp-bytes]]
            [snug.vm.eval :refer [eval-item]]))

(declarefn vm-walk)

;; ------------------------------------------------------------ scratch

(defn ^:pub ^I32 chain-of [^IntsR p ^I32 rule]
  (comment "The word offset of rule's closure-chain record.")
  (let [rr (+ (ia p H_S_RULES) (* 5 rule))]
    (return (ia p (+ (ia p H_S_CHAIN_INDEX) (ia p (+ rr 3)))))))

(defn ^:pub ^I32 chain-cset [^IntsR p ^I32 ch ^I32 k]
  (comment "The closure-set record of physical depth k on chain ch, or -1 (empty).")
  (let [n (ia p ch)
        r (ia p (+ ch 1))
        ^:mut ci k]
    (if (>= k n)
      (do (if (< r 0) (return (neg 1)))
          (set ci (+ r (rem (- k r) (- n r))))))
    (return (ia p (+ (ia p H_S_CSET_INDEX) (ia p (+ (+ ch 2) ci)))))))

(defn ^:pub ^I32 chain-regex [^IntsR p ^I32 ch ^I32 dd]
  (comment "max over depths 0..dd of the closure set's regex_words: every depth"
           "beyond the chain repeats a set already visited, so the chain's first"
           "min(n, dd + 1) sets suffice.")
  (let [n (ia p ch)
        ^:mut m 0
        ^:mut top n]
    (if (> top (+ dd 1)) (set top (+ dd 1)))
    (for [^I32 k 0 top]
      (let [cr (chain-cset p ch k)
            rw (ia p (+ cr 2))]
        (if (> rw m) (set m rw))))
    (return m)))

(defn ^:pub ^I32 chain-frames [^IntsR p ^I32 ch ^I32 dd]
  (comment "Sum over depths 0..dd of the closure set's frame_words, in O(n) from the"
           "chain's period (program.md §12.1).")
  (let [n (ia p ch)
        r (ia p (+ ch 1))
        ^:mut top n
        ^:mut t 0]
    (if (> top (+ dd 1)) (set top (+ dd 1)))
    (for [^I32 k 0 top]
      (set t (+ t (ia p (+ (chain-cset p ch k) 1)))))
    (if (and (>= r 0) (> (+ dd 1) n))
      (do (let [left (- (+ dd 1) n)
                per (- n r)
                full (quot left per)
                part (rem left per)
                ^:mut ps 0
                ^:mut qs 0]
            (for [^I32 j 0 per]
              (let [fj (ia p (+ (chain-cset p ch (+ r j)) 1))]
                (set ps (+ ps fj))
                (if (< j part) (set qs (+ qs fj)))))
            (set t (+ (+ t (* full ps)) qs)))))
    (return t)))

(defn ^:pub ^I32 vm-fixed-words [^IntsR p ^I32 rule ^I32 mark-cap]
  (comment "The words before the group arena for this rule with MARK_CAP ="
           "max(mark-cap, N_LEAVES) (§12.1): 48 + 2M + 2(D + 1) + regex area + frames."
           "The rule's verified scratch_words [D] is that total with M = N_LEAVES, so"
           "this is O(1).")
  (let [nl (ia p H_N_LEAVES)
        ^:mut m mark-cap]
    (if (< m nl) (set m nl))
    (return (+ (ia p (+ (+ (ia p H_S_RULES) (* 5 rule)) 4)) (* 2 (- m nl))))))

(defn ^:pub ^I32 arena-lease [^IntsR p]
  (comment "The group arena's default lease (program-2 §9.4): 4,096 words when some"
           "ARRAY leaf is A2 or some MAP leaf is T (FLAGS bit 6), else none -- the arena"
           "then grows on its first push (the forced-tier test mode).")
  (if (!= (bit-and (ia p H_FLAGS) FL_ARENA) 0) (return LEASE))
  (return 0))

(defn ^:pub ^I32 vm-scratch-words [^IntsR p ^I32 rule ^I32 mark-cap]
  (comment "Words S must have for this rule: vm-fixed-words, then the group arena's"
           "8-word header and its default lease (program-2 §9.1, §9.4). A larger S"
           "only gives the arena more room, up to its cap.")
  (return (+ (+ (vm-fixed-words p rule mark-cap) AR_HDR) (arena-lease p))))

(defn ^:pub ^I32 vm-scratch-words-slow [^IntsR p ^I32 rule ^I32 mark-cap]
  (comment "The same total recomputed from the closure chain (the verifier's"
           "formula), for tests.")
  (let [nl (ia p H_N_LEAVES)
        ^:mut m mark-cap
        dd (ia p H_LIM_DEPTH)
        ch (chain-of p rule)]
    (if (< m nl) (set m nl))
    (return (+ (+ (+ (+ (+ SCRATCH_MARK (* 2 m)) (* 2 (+ dd 1))) (chain-regex p ch dd))
                  (chain-frames p ch dd))
               (+ AR_HDR (arena-lease p))))))

(defn ^:pub vm-scratch-init [^Ints s ^I32 mark-cap]
  (comment "On a freshly zeroed S: VM_EPOCH = 1, VM_MARK_CAP = mark-cap.")
  (iset s VM_EPOCH 1)
  (iset s VM_MARK_CAP mark-cap))

(defn ^:pub ^I32 vm-rule-index [^IntsR p ^Bytes pool ^Bytes name]
  (comment "Binary search of RULES (sorted by UTF-8 bytes) for name; -1 if absent.")
  (let [base (ia p H_S_RULES)
        nl (blen name)
        ^:mut lo 0
        ^:mut hi (ia p H_N_RULES)]
    (while (< lo hi)
      (let [mid (ushr (+ lo hi) 1)
            rr (+ base (* 5 mid))
            c (cmp-bytes name 0 nl pool (ia p rr) (ia p (+ rr 1)))]
        (if (== c 0) (return mid))
        (if (< c 0) (set hi mid) (set lo (+ mid 1)))))
    (return (neg 1))))

;; ------------------------------------------------------------ validation

(defn ^:pub ^I32 lim [^IntsR limits ^I32 i ^I32 compiled]
  (comment "The effective limit i: the compiled value, lowered by a given value >= 0.")
  (if (>= i (ilen limits)) (return compiled))
  (let [v (ia limits i)]
    (if (< v 0) (return compiled))
    (if (< v compiled) (return v))
    (return compiled)))

(defn ^:pub ^I32 lim-or [^IntsR limits ^I32 i]
  (comment "Limits word i, or -1 when absent.")
  (if (>= i (ilen limits)) (return (neg 1)))
  (return (ia limits i)))

(defn ^:pub ^I32 opt01 [^IntsR limits ^I32 i]
  (if (>= i (ilen limits)) (return 0))
  (if (== (ia limits i) 1) (return 1))
  (return 0))

(defn ^:pub ^I32 prof [^IntsR limits ^I32 depth0]
  (comment "The profile flags of a run (D120): limits word 9 (a VM extension"
           "beyond program.md §12.3's 8 words), host bits only; absent (fewer than"
           "10 words) or negative is 0, the Bindle profile. A run whose root is not"
           "the document's top (depth0 > 0) adds PF_SUB.")
  (let [^:mut f 0]
    (if (> (ilen limits) 9)
      (if (> (ia limits 9) 0) (set f (bit-and (ia limits 9) PF_HOST))))
    (if (!= depth0 0) (set f (bit-or f PF_SUB)))
    (return f)))

(defn ^:pub ^I32 vm-output [^Ints s ^Ints out ^I32 code ^I32 sub ^I32 offset]
  (comment "Fill out (§13.2) and answer the code.")
  (let [start (ia s VM_BUDGET_START)
        ^:mut used (- start (ia s VM_BUDGET))]
    (if (== code R_BUDGET) (set used start))
    (iset out 0 code)
    (iset out 1 sub)
    (iset out 2 offset)
    (iset out 3 used)
    (iset out 4 (ia s O_ITEMS))
    (iset out 5 0)
    (iset out 6 0)
    (iset out 7 0)
    (return code)))

(defn ^:pub ^I32 vm-witness-output [^Ints s ^Ints out]
  (comment "A schema failure: the witness slot and its path (§9.2, §9.3).")
  (let [depth (ia s VM_W_DEPTH)
        xk (ia s VM_W_XKIND)
        pb (ia s VM_PATH)
        ^:mut n depth
        ^:mut k 0
        cap (ushr (- (ilen out) 8) 1)]
    (let [wr (ia s VM_W_REASON)
          wsub (ia s VM_W_SUB)
          woff (ia s VM_W_OFFSET)]
      (vm-output s out wr wsub woff))
    (if (>= xk 0) (set n (+ n 1)))
    (iset out 5 n)
    (while (and (< k depth) (< k cap))
      (iset out (+ 8 (* 2 k)) (ia s (+ pb (* 2 (+ k 1)))))
      (iset out (+ 9 (* 2 k)) (ia s (+ (+ pb (* 2 (+ k 1))) 1)))
      (set k (+ k 1)))
    (if (and (>= xk 0) (< k cap))
      (do (iset out (+ 8 (* 2 k)) xk)
          (iset out (+ 9 (* 2 k)) (ia s VM_W_XVAL))
          (set k (+ k 1))))
    (iset out 6 k)
    (return (ia s VM_W_REASON))))

(defn ^:pub ^I32 vm-setup [^IntsR p ^I32 rule ^I32 start ^I32 depth0 ^I32 items0
                           ^IntsR limits ^Ints s]
  (comment "Check the Program header, rule and scratch, then fill S for a run on"
           "rule from start (§12.1, §13.1). 0, or -1 Program inconsistent,"
           "-2 scratch too small, -3 rule out of range. Shared by the buffer walk"
           "and the resumable session (snug.vm.session).")
  (if (< (ilen p) HEADER_WORDS) (return (neg 1)))
  (if (or (!= (ia p 0) MAGIC) (or (!= (ia p H_FORMAT) FORMAT_V2) (!= (ia p H_HEADER_WORDS) HEADER_WORDS)))
    (return (neg 1)))
  (if (!= (ia p H_PROGRAM_WORDS) (ilen p)) (return (neg 1)))
  (if (or (< rule 0) (>= rule (ia p H_N_RULES))) (return (neg 3)))
  (if (< (ilen s) SCRATCH_MARK) (return (neg 2)))
  (let [mc (ia s VM_MARK_CAP)
        dd (ia p H_LIM_DEPTH)
        ch (chain-of p rule)]
    (if (< mc (ia p H_N_LEAVES)) (return (neg 2)))
    (if (< (ilen s) (+ (vm-fixed-words p rule mc) AR_HDR)) (return (neg 2)))
    (let [path (+ SCRATCH_MARK (* 2 mc))
          rx (+ path (* 2 (+ dd 1)))
          rxw (chain-regex p ch dd)
          frames (+ rx rxw)
          ^:mut dl (- (lim limits 3 dd) depth0)
          bmax (lim limits 6 (ia p H_LIM_BIGNUM))
          budget (lim limits 7 (ia p H_LIM_BUDGET))]
      (if (< dl 0) (set dl 0))
      (iset s O_TOP (opt01 limits 0))
      (if (== depth0 0) (iset s O_COSE (opt01 limits 1)) (iset s O_COSE 0))
      (comment "P8.4 (D262): a valid-CBOR run walks deterministically first; PF_VREL"
               "keeps what PF_VALID admits without changing bytes")
      (let [pf (prof limits depth0)]
        (if (!= (bit-and pf PF_VALID) 0)
          (iset s O_PROFILE (bit-or (bit-xor pf PF_VALID) PF_VREL))
          (iset s O_PROFILE pf)))
      (iset s O_VCTL 0)
      (iset s VM_VTAB 0)
      (iset s O_MAX_BYTES (lim limits 2 (ia p H_LIM_INPUT)))
      (iset s O_MAX_DEPTH dl)
      (iset s O_MAX_ENTRIES (lim limits 4 (ia p H_LIM_ENTRIES)))
      (iset s O_MAX_ITEMS (lim limits 5 (ia p H_LIM_ITEMS)))
      (iset s O_ERR_POS (neg 1))
      (iset s O_ITEMS items0)
      (iset s VM_BUDGET budget)
      (iset s VM_BUDGET_START budget)
      (iset s VM_W_STATE 0)
      (iset s VM_D dd)
      (iset s VM_FRAMES frames)
      (iset s VM_PATH path)
      (iset s VM_REGEX rx)
      (iset s VM_REGCAP rxw)
      (iset s VM_RULE rule)
      (iset s VM_CHAIN ch)
      (iset s VM_EMBED 0)
      (if (> bmax MAX_BIGNUM_BYTES) (iset s VM_BIGNUM_MAX MAX_BIGNUM_BYTES) (iset s VM_BIGNUM_MAX bmax))
      (iset s VM_POS start)
      (iset s VM_PBASE 0)
      (iset s VM_Q1 0)
      (iset s VM_QIDX (+ SCRATCH_MARK mc))
      (iset s VM_DLIM dl)
      (comment "limits word 8 (a VM extension beyond program.md §12.3's 8 words):"
               "bit 0 forces the generic path (the fast == generic gate);")
      (comment "bit 1 selects the legacy schedule 1; schedule 2 (D045) is the default"
               "(s[VM_GENERIC] bit 1 set = schedule 2). D254: the forced generic path"
               "is charged by the generic walk's own schedule, the table (schedule 1):"
               "schedule 2's free bookkeeping prices the fast paths' CPU, not its.")
      (comment "bit 2 forces every array to tier A2 and every map to T (program-2 §8,"
               "the forced-tier test mode): G_FORCED in s[VM_GENERIC].")
      (if (> (ilen limits) 8)
        (do (let [w8 (ia limits 8)
                  ^:mut g 2]
              (if (!= (bit-and w8 3) 0) (set g (bit-and w8 1)))
              (if (!= (bit-and w8 4) 0) (set g (bit-or g G_FORCED)))
              (iset s VM_GENERIC g)))
        (iset s VM_GENERIC 2))
      (comment "the group arena after the fixed words, its cap lowered by limits word 10")
      (arena-init s (vm-fixed-words p rule mc) (arena-cap p (lim-or limits 10)))
      (return 0))))

(defn ^:pub ^I32 vm-need [^Ints out ^I32 w ^I32 nb ^I32 sw]
  (comment "-5: a host buffer is too small; out[5] the valid scratch's words, out[6]"
           "the canonical buffer's bytes, out[7] the VM scratch's words (0: enough).")
  (iset out 0 0)
  (iset out 5 w)
  (iset out 6 nb)
  (iset out 7 sw)
  (return (neg 5)))

(defn ^:pub ^I32 vm-run [^IntsR p ^Bytes pool ^I32 rule ^Bytes b ^I32 start ^I32 end ^I32 depth0
                         ^I32 items0 ^IntsR limits ^Ints s ^Ints out ^Ext ext]
  (comment "Validate the single item b[start, end) against rule, its depth and item"
           "accounting starting at depth0 / items0. See vm-validate for results.")
  (if (< (ilen out) 8) (return (neg 4)))
  (if (< (ilen p) HEADER_WORDS) (return (neg 1)))
  (if (or (!= (ia p 0) MAGIC) (or (!= (ia p H_FORMAT) FORMAT_V2) (!= (ia p H_HEADER_WORDS) HEADER_WORDS)))
    (return (neg 1)))
  (if (or (!= (ia p H_PROGRAM_WORDS) (ilen p)) (!= (ia p H_POOL_BYTES) (blen pool))) (return (neg 1)))
  (if (or (< rule 0) (>= rule (ia p H_N_RULES))) (return (neg 3)))
  (if (or (< start 0) (or (< end start) (> end (blen b)))) (return (neg 1)))
  (let [su (vm-setup p rule start depth0 items0 limits s)]
    (if (< su 0) (return su)))
  (return (vm-walk p pool rule b start end s out ext)))

(defn ^:pub ^I32 vm-walk [^IntsR p ^Bytes pool ^I32 rule ^Bytes b ^I32 start ^I32 end ^Ints s ^Ints out
                          ^Ext ext]
  (comment "vm-run after its checks and vm-setup: the root item b[start, end).")
  (let [frames (ia s VM_FRAMES)
        n (- end start)]
    (if (> n (ia s O_MAX_BYTES))
      (do (let [c1 (neg (fail s start CODE_TOO_LARGE))]
            (return (vm-output s out c1 0 start)))))
    (if (== (ia s O_TOP) 0)
      (if (or (== n 0) (!= (ushr (u8 b start) 5) 5))
        (do (let [c2 (neg (fail s start CODE_NOT_MAP))]
              (return (vm-output s out c2 0 start))))))
    (let [rr (+ (ia p H_S_RULES) (* 5 rule))
          ts (ia p (+ rr 2))
          cr (cset-rec p s 0)
          w (ia p cr)
          e (new-epoch s)
          nq (q-add p s frames w 0 ts e start)]
      (if (== nq (neg R_BUDGET))
        (do (let [at1 (ia s VM_POS)] (return (vm-output s out R_BUDGET 0 at1)))))
      (if (< nq 0) (return (neg 1)))
      (local ^I32 r)
      (if (> nq 0)
        (set r (eval-item p pool b s start 0 frames 0 nq end 0 ext))
        (set r (dead-item b s start 0 end)))
      (if (== r (neg R_BUDGET))
        (do (let [at2 (ia s VM_POS)] (return (vm-output s out R_BUDGET 0 at2)))))
      (comment "program-2 §9.4: the arena must grow (the host gives S that many words and"
               "runs again, -5), or it is at its cap (group_limit at the item's head)")
      (if (== r (neg R_AGROW)) (return (vm-need out 0 0 (arena-want s))))
      (if (== r (neg R_GROUP_LIMIT))
        (do (let [at6 (ia s VM_POS)] (return (vm-output s out R_GROUP_LIMIT 0 at6)))))
      (if (== r (neg R_INCONSISTENT)) (return (neg 1)))
      (if (< r 0)
        (do (let [at3 (ia s O_ERR_POS)] (return (vm-output s out (neg r) 0 at3)))))
      (if (!= r end)
        (do (let [c3 (neg (fail s r CODE_TRAILING))]
              (return (vm-output s out c3 0 r)))))
      (let [ev (q-stamp s frames w nq start)]
        (if (< ev 0)
          (do (let [at4 (ia s VM_POS)] (return (vm-output s out R_BUDGET 0 at4)))))
        (let [t (ts-test p s ts ev start)]
          (if (< t 0)
            (do (let [at5 (ia s VM_POS)] (return (vm-output s out R_BUDGET 0 at5)))))
          (if (== t 1) (return (vm-output s out 0 0 0)))
          (if (wit-empty s) (wit-set s R_TYPE 0 0 (neg 1) 0 start))
          (return (vm-witness-output s out)))))))

;; ------------------------------------------------------------ valid CBOR (P8.4)

(defn ^:pub ^Bool nondet-code [^I32 code]
  (comment "Codes only an encoding valid CBOR admits can cause on the deterministic"
           "attempt of a valid-CBOR run (D262), or R_NONDET from embedded content.")
  (return (or (or (== code CODE_NON_SHORTEST) (== code CODE_INDEFINITE))
              (or (== code CODE_KEY_ORDER) (== code R_NONDET)))))

(defn ^:pub ^I32 vm-remap [^Bytes b ^Bytes cb ^Ints vs ^I32 start ^Ints out]
  (comment "The offset of a run over a canonical copy mapped back to b (D264); a"
           "refusal the VM found at a planted stop with the planted code is the"
           "stop's own (code and offset, D280) -- the run's code, or the reason's"
           "sub-code when an embedded refusal became a witness.")
  (let [off (ia out 2)
        e (ev-find vs off EV_HEAD)]
    (if (>= e 0)
      (do (let [vc (ia vs (+ e 4))]
            (if (and (> vc 0) (== (ia out 0) vc))
              (do (iset out 0 (ia vs (+ e 2)))
                  (iset out 2 (vsource b cb vs start (ia vs (+ e 3))))
                  (return 0)))
            (if (and (> vc 0) (and (>= (ia out 0) 32) (== (ia out 1) vc)))
              (do (iset out 1 (ia vs (+ e 2)))
                  (iset out 2 (vsource b cb vs start (ia vs (+ e 3))))
                  (return 0))))))
    (iset out 2 (vmap b cb vs start off))
    (return 0)))

(defn ^:pub ^I32 vm-canon [^IntsR p ^Bytes pool ^I32 rule ^Bytes b ^I32 start ^I32 end ^I32 depth0
                           ^I32 items0 ^IntsR limits ^Ints s ^Ints out ^Ext ext ^Ints vs ^BytesW cb]
  (comment "The canonical path (D262, D264, D277, D280): the scanner (vs its options"
           "array and scratch, cb its buffer) checks b[start, end), then its canonical"
           "copy -- for a refused input the copy of the valid prefix, planted and"
           "padded at the stop -- and events are written into cb and vs; the events go"
           "to S past the rule's scratch; the VM walks the copy under PF_CANON (its"
           "fast paths leave every container end, every key that breaks the"
           "ascending order and every stop to the generic walk), charging each marked map's"
           "duplicate-check units at its end and reaching every recorded refusal at"
           "its own check phase, after the charges that precede it on every route."
           "Every offset it reports is mapped back to b. -5 when vs, cb or S is too"
           "small.")
  (if (< (ilen vs) (+ O_S_FIRST 256))
    (return (vm-need out (+ O_S_FIRST 1024) (+ (* 3 (- end start)) 4096) 0)))
  (let [pf (prof limits depth0)
        dd (ia p H_LIM_DEPTH)
        ^:mut dl (- (lim limits 3 dd) depth0)]
    (if (< dl 0) (set dl 0))
    (iset vs O_TOP (opt01 limits 0))
    (if (== depth0 0) (iset vs O_COSE (opt01 limits 1)) (iset vs O_COSE 0))
    (iset vs O_MAX_BYTES (lim limits 2 (ia p H_LIM_INPUT)))
    (iset vs O_MAX_DEPTH dl)
    (iset vs O_S_EDEPTH dl)
    (iset vs O_MAX_ENTRIES (lim limits 4 (ia p H_LIM_ENTRIES)))
    (iset vs O_MAX_ITEMS (lim limits 5 (ia p H_LIM_ITEMS)))
    (iset vs O_PROFILE pf)
    (let [sc (scan-x b vs cb start end 0 items0)
          serr (ia vs O_ERR_POS)
          sitems (ia vs O_ITEMS)]
      (if (== sc CODE_SCRATCH) (return (vm-need out (ia vs O_VNEEDW) (ia vs O_VNEEDB) 0)))
      (let [su (vm-setup p rule start depth0 items0 limits s)]
        (if (< su 0) (return su)))
      (comment "refusals decided before the walk on every route")
      (if (or (== sc CODE_TOO_LARGE) (== sc CODE_NOT_MAP))
        (do (iset s O_ITEMS sitems)
            (return (vm-output s out sc 0 serr))))
      (let [^:mut embeds 1]
        (if (!= (bit-and (ia p H_FLAGS) FL_EMBED) 0) (set embeds 2))
        (let [l (canon-build b vs cb start end embeds sc)]
          (if (< l 0) (return (vm-need out (ia vs O_VNEEDW) (ia vs O_VNEEDB) 0)))
          (let [n (ia vs O_S_NEV)
                base (vm-fixed-words p rule (ia s VM_MARK_CAP))
                ^:mut vt 0]
            (if (> n 0) (set vt (+ 4 (* EV_WORDS n))))
            (let [need (+ (+ (+ base vt) AR_HDR) (arena-lease p))]
              (if (< (ilen s) need) (return (vm-need out 0 0 need))))
            (if (> n 0)
              (do (iset s base n)
                  (iset s (+ base 1) 0)
                  (iset s (+ base 2) 0)
                  (iset s (+ base 3) 0)
                  (for [^I32 i 0 (* EV_WORDS n)]
                    (iset s (+ (+ base 4) i) (ia vs (+ O_S_FIRST i))))
                  (iset s VM_VTAB base)))
            (comment "the group arena after the events")
            (arena-init s (+ base vt) (arena-cap p (lim-or limits 10)))
            (iset s O_PROFILE (bit-or (ia s O_PROFILE) PF_CANON))
            (if (< (ia s O_MAX_BYTES) l) (iset s O_MAX_BYTES l))
            (let [base0 (ia vs O_S_CBASE)
                  r2 (vm-walk p pool rule cb base0 l s out ext)]
              (iset s VM_VTAB 0)
              (if (and (>= r2 0) (!= (ia out 0) 0))
                (vm-remap b cb vs start out))
              (comment "a refused input whose replay ended otherwise (never expected:"
                       "the scanner and the walk agree on every refusal): the scanner's"
                       "verdict stands")
              (if (and (>= r2 0) (and (!= sc 0) (or (== (ia out 0) 0)
                                                    (and (>= (ia out 0) 32) (!= (ia out 0) R_BUDGET)))))
                (do (iset s O_ITEMS sitems)
                    (vm-output s out sc 0 serr)))
              (iset vs O_VLEN l)
              (return r2))))))))

(defn ^:pub ^I32 vm-run-v [^IntsR p ^Bytes pool ^I32 rule ^Bytes b ^I32 start ^I32 end ^I32 depth0
                           ^I32 items0 ^IntsR limits ^Ints s ^Ints out ^Ext ext ^Ints vs ^BytesW cb]
  (comment "vm-run, and the canonical path (vm-canon) when the deterministic attempt of"
           "a valid-CBOR run met an encoding only valid CBOR has, or a key whose"
           "duplicates are not bytewise (VC_ECS) under any profile. vs[O_VLEN] is the"
           "copy's end when the canonical path ran (the copy is cb[vs[O_S_CBASE], it);"
           "the input's copy precedes it), else -1.")
  (if (>= (ilen vs) 16) (iset vs O_VLEN (neg 1)))
  (let [r (vm-run p pool rule b start end depth0 items0 limits s out ext)]
    (if (< r 0) (return r))
    (let [pf (prof limits depth0)
          nd (and (!= (bit-and pf PF_VALID) 0) (nondet-code (ia out 0)))
          ecs (!= (bit-and (ia s O_VCTL) VC_ECS) 0)]
      (if (and (not nd) (not ecs)) (return r))
      (return (vm-canon p pool rule b start end depth0 items0 limits s out ext vs cb)))))

(defn ^:pub ^I32 vm-validate-v [^IntsR p ^Bytes pool ^I32 rule ^Bytes input ^IntsR limits ^Ints s
                                ^Ints out ^Ext ext ^Ints vs ^BytesW cb]
  (comment "vm-validate-x with valid-CBOR support (P8.4): vs and cb are the canonical"
           "path's buffers (any length; -5 asks for more, vm-need).")
  (return (vm-run-v p pool rule input 0 (blen input) 0 0 limits s out ext vs cb)))

(defn ^:pub ^I32 vm-validate-span-v [^IntsR p ^Bytes pool ^I32 rule ^Bytes input ^I32 start ^I32 end
                                     ^I32 depth0 ^I32 items0 ^IntsR limits ^Ints s ^Ints out ^Ext ext
                                     ^Ints vs ^BytesW cb]
  (comment "vm-validate-span-x with valid-CBOR support.")
  (return (vm-run-v p pool rule input start end depth0 items0 limits s out ext vs cb)))

(defn ^:pub ^I32 vm-validate-x [^IntsR p ^Bytes pool ^I32 rule ^Bytes input ^IntsR limits ^Ints s
                                ^Ints out ^Ext ext]
  (comment "Validate input against rule of the verified Program (p, pool), under"
           "limits (8 words, -1 = compiled default; per-call values only lower the"
           "compiled ones; word 8 the generic/schedule bits, word 9 the profile"
           "flags, D120), with scratch s (see vm-scratch-words). Answers the reason"
           "code (0 ok; profile 1..21; schema 32..41; 48 budget), also in out[0],"
           "with out per program.md §13.2; or -1 Program inconsistent, -2 scratch too"
           "small, -3 rule out of range, -4 out shorter than 8 words. Allocates"
           "nothing; calls no host code except x, the extension-control predicate"
           "(D140), for an EXT leaf it queries.")
  (return (vm-run p pool rule input 0 (blen input) 0 0 limits s out ext)))

(defn ^:pub ^I32 vm-validate [^IntsR p ^Bytes pool ^I32 rule ^Bytes input ^IntsR limits ^Ints s
                              ^Ints out]
  (comment "vm-validate-x with no extension controls: an EXT leaf never matches"
           "(hosts refuse to run such a Program without its predicates, D141).")
  (return (vm-validate-x p pool rule input limits s out (ext-none))))

(defn ^:pub ^I32 vm-validate-span-x [^IntsR p ^Bytes pool ^I32 rule ^Bytes input ^I32 start ^I32 end
                                     ^I32 depth0 ^I32 items0 ^IntsR limits ^Ints s ^Ints out ^Ext ext]
  (comment "architecture §16.3: validate the item spanning input[start, end) as its"
           "own document against rule (it must be exactly one item ending at end),"
           "with depth and item accounting continuing from depth0 / items0 (the"
           "enclosing position). Offsets in out are absolute. cose applies only at"
           "depth0 = 0.")
  (return (vm-run p pool rule input start end depth0 items0 limits s out ext)))

(defn ^:pub ^I32 vm-validate-span [^IntsR p ^Bytes pool ^I32 rule ^Bytes input ^I32 start ^I32 end
                                   ^I32 depth0 ^I32 items0 ^IntsR limits ^Ints s ^Ints out]
  (comment "vm-validate-span-x with no extension controls.")
  (return (vm-validate-span-x p pool rule input start end depth0 items0 limits s out (ext-none))))
