;; Map evaluation state (program.md §7, §8.3, §12.2): blocks, the per-pair key
;; search and cursors, the key phase (candidates), the update (pool outcomes,
;; naming records, O(1) pool rejection), satisfaction at the end, and witness
;; rule 4. The walk itself (keys and values as items) is snug.vm.eval's.
;;
;; A block (one per admitted MAP leaf, in query order) is
;;     +0 qindex  +1 alive  +2 cursor  +3 first candidate of the current pair
;;     +4 factor_live[F]  pools: rej live exempt outcome cnt[n_entries]
;;     alts: dead r req_done consumed[ceil(lits/32)]
;; A pool's `outcome` word holds its first candidate during the key phase and
;; its outcome during the update: j >= 0 TAKE j, -1 REJECT, -2 ABSORB, -3 not
;; involved. A candidate is 4 words: block, kind (bit 0: 1 group entry, 0
;; literal; bit 1: value matched), pool or naming record, entry or literal.
(ns snug.vm.map
  (:require [kin.lang :refer [defn let return set if while for do comment]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR + - * neg shl sar ushr bit-and bit-or
                               < > <= >= == != and or not u8 ia iset]]
            [snug.cbor.codes :refer [O_HI]]
            [snug.cbor.head :refer [be16 be32]]
            [snug.vm.layout :refer [H_S_LEAVES H_S_MAP_INDEX H_S_GROUP_INDEX H_S_KEYS H_N_KEYS
                                    MODE_ABSORB INF R_BUDGET R_INCONSISTENT R_MISSING P_KEY P_ANYKEY]]
            [snug.vm.base :refer [charge c16 c64min ts-test q-add wit-set]]
            [snug.vm.leaf :refer [cmp-bytes]]))

;; ------------------------------------------------------------ table layout

(defn ^:pub ^I32 m-pools [^IntsR p ^I32 mt] (return (+ (+ mt 8) (* 4 (ia p mt)))))
(defn ^:pub ^I32 m-alts [^IntsR p ^I32 mt] (return (+ (m-pools p mt) (* 5 (ia p (+ mt 1))))))
(defn ^:pub ^I32 m-lits [^IntsR p ^I32 mt] (return (+ (m-alts p mt) (* 5 (ia p (+ mt 2))))))
(defn ^:pub ^I32 m-keys [^IntsR p ^I32 mt] (return (+ (m-lits p mt) (* 4 (ia p (+ mt 3))))))
(defn ^:pub ^I32 m-names [^IntsR p ^I32 mt] (return (+ (m-keys p mt) (* 4 (ia p (+ mt 4))))))

(defn ^:pub ^I32 group-rec [^IntsR p ^I32 g]
  (return (ia p (+ (ia p H_S_GROUP_INDEX) g))))

(defn ^:pub ^I32 leaf-map [^IntsR p ^I32 lb]
  (comment "The map table (word offset) of the MAP leaf at lb.")
  (return (ia p (+ (ia p H_S_MAP_INDEX) (ia p (+ lb 2))))))

(defn ^:pub ^I32 block-mt [^IntsR p ^IntsR s ^I32 fb ^I32 bo]
  (comment "The map table of the block at bo (its leaf is query entry s[bo]).")
  (let [l (ia s (+ fb (ia s bo)))]
    (return (leaf-map p (+ (ia p H_S_LEAVES) (* 8 l))))))

(defn ^:pub ^Bool alt-live [^IntsR p ^IntsR s ^I32 bo ^I32 pools ^I32 alts ^I32 a]
  (comment "An alternative is live iff dead = 0 and r = its pool's rej (§7.1).")
  (let [arec (+ alts (* 5 a))
        aso (ia p (+ arec 4))
        pso (ia p (+ (+ pools (* 5 (ia p arec))) 4))]
    (return (and (== (ia s (+ bo aso)) 0) (== (ia s (+ (+ bo aso) 1)) (ia s (+ bo pso)))))))

(defn ^Bool absorbing [^I32 emin ^I32 emax]
  (return (and (== emin 0) (== emax INF))))

;; ------------------------------------------------------------ blocks

(defn ^:pub ^I32 map-block-init [^IntsR p ^Ints s ^I32 bo ^I32 qindex ^I32 mt ^I32 at]
  (comment "Initialise a block: charged ceil(state_words/16); alive, factor_live ="
           "the factor's alternatives, each pool's live = its alternatives.")
  (let [sw (ia p (+ mt 6))
        nf (ia p mt)
        np (ia p (+ mt 1))
        pools (m-pools p mt)]
    (if (not (charge s (c16 sw) at)) (return (neg R_BUDGET)))
    (for [^I32 j 0 sw]
      (iset s (+ bo j) 0))
    (iset s bo qindex)
    (iset s (+ bo 1) 1)
    (for [^I32 f 0 nf]
      (let [frec (+ (+ mt 8) (* 4 f))
            pf (ia p (+ frec 2))
            pc (ia p (+ frec 3))
            ^:mut live 0]
        (for [^I32 k 0 pc]
          (set live (+ live (ia p (+ (+ pools (* 5 (+ pf k))) 3)))))
        (iset s (+ (+ bo 4) f) live)))
    (for [^I32 pi 0 np]
      (let [prec (+ pools (* 5 pi))]
        (iset s (+ (+ bo (ia p (+ prec 4))) 1) (ia p (+ prec 3)))))
    (return 0)))

;; ------------------------------------------------------------ the pair's key

(defn ^:pub ^I32 key-span-end [^Bytes b ^I32 start ^I32 end]
  (comment "The end of the key item at start for the key search, or -1 when its head"
           "is not well-formed (the key's own walk then refuses it, and a profile"
           "refusal wins). Text keys: head + payload; integer labels: the head.")
  (let [ib (u8 b start)
        major (ushr ib 5)
        ai (bit-and ib 31)
        ^:mut arg ai
        ^:mut h 1]
    (if (> ai 27) (return (neg 1)))
    (if (>= ai 24)
      (do (let [wd (shl 1 (- ai 24))]
            (if (> wd (- end (+ start 1))) (return (neg 1)))
            (set h (+ wd 1))
            (if (== wd 1) (set arg (u8 b (+ start 1))))
            (if (== wd 2) (set arg (be16 b (+ start 1))))
            (if (== wd 4) (set arg (be32 b (+ start 1))))
            (if (== wd 8)
              (do (if (!= (be32 b (+ start 1)) 0) (return (neg 1)))
                  (set arg (be32 b (+ start 5))))))))
    (if (<= major 1) (return (+ start h)))
    (if (!= major 3) (return (neg 1)))
    (if (< arg 0) (return (neg 1)))
    (if (> arg (- end (+ start h))) (return (neg 1)))
    (return (+ (+ start h) arg))))

(defn ^:pub ^I32 key-search [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 ks ^I32 ke ^I32 lo0 ^I32 at]
  (comment "Binary search of KEYS[lo0, N_KEYS) for the encoded key b[ks, ke): its id,"
           "-1 if absent, -2 if the budget ran out. The next pair's lower bound (one"
           "past the id, or the insertion point) goes in s[O_HI]. A probe is charged"
           "with its comparison: ceil(min(len)/64), at least 1.")
  (let [kb (ia p H_S_KEYS)
        kl (- ke ks)
        ^:mut lo lo0
        ^:mut hi (ia p H_N_KEYS)]
    (if (> lo hi) (set lo hi))
    (while (< lo hi)
      (let [mid (sar (+ lo hi) 1)
            ko (ia p (+ kb (* 2 mid)))
            kn (ia p (+ (+ kb (* 2 mid)) 1))]
        (if (not (charge s (c64min kl kn) at)) (return (neg 2)))
        (let [c (cmp-bytes b ks kl pool ko kn)]
          (if (== c 0) (do (iset s O_HI (+ mid 1)) (return mid)))
          (if (< c 0) (set hi mid) (set lo (+ mid 1))))))
    (iset s O_HI lo)
    (return (neg 1))))

(defn ^:pub ^I32 map-cursor [^IntsR p ^Ints s ^I32 bo ^I32 mt ^I32 kid ^I32 at]
  (comment "Advance the block's cursor over its key index to the first key >= kid;"
           "1 unit per step. 0 or a negated code.")
  (if (< kid 0) (return 0))
  (let [keys (m-keys p mt)
        nk (ia p (+ mt 4))
        ^:mut cur (ia s (+ bo 2))]
    (while (and (< cur nk) (< (ia p (+ keys (* 4 cur))) kid))
      (if (not (charge s 1 at)) (return (neg R_BUDGET)))
      (set cur (+ cur 1)))
    (iset s (+ bo 2) cur)
    (return 0)))

(defn ^:pub ^I32 named-rec [^IntsR p ^IntsR s ^I32 bo ^I32 mt ^I32 kid]
  (comment "The key-index record of kid in this leaf (the cursor's), or -1.")
  (if (< kid 0) (return (neg 1)))
  (let [keys (m-keys p mt)
        cur (ia s (+ bo 2))]
    (if (and (< cur (ia p (+ mt 4))) (== (ia p (+ keys (* 4 cur))) kid)) (return cur))
    (return (neg 1))))

(defn ^:pub ^I32 map-key-query [^IntsR p ^Ints s ^I32 bo ^I32 mt ^I32 cfb ^I32 cw ^I32 cnq ^I32 e ^I32 at]
  (comment "Add the key typesets of every entry of the group of every live residual"
           "pool of this block to the key's query list. The new length or a code.")
  (let [pools (m-pools p mt)
        f0c (ia p (+ mt 11))
        ^:mut n cnq]
    (for [^I32 pi 0 f0c]
      (let [prec (+ pools (* 5 pi))
            pso (ia p (+ prec 4))]
        (if (> (ia s (+ (+ bo pso) 1)) 0)
          (do (let [go (group-rec p (ia p (+ prec 1)))
                    ne (ia p go)]
                (for [^I32 j 0 ne]
                  (set n (q-add p s cfb cw n (ia p (+ (+ go 2) (* 4 j))) e at))
                  (if (< n 0) (return n))))))))
    (return n)))

(defn ^:pub ^I32 map-key-phase [^IntsR p ^Ints s ^I32 bo ^I32 mt ^I32 kid ^I32 ek ^I32 cl
                                ^I32 nc0 ^I32 cap ^I32 at]
  (comment "Candidates of this block (§8.3 step 6): each group entry of a live"
           "residual pool whose key typeset matched (1 unit + its test), then each"
           "naming record of the key whose alternative is live (1 unit each)."
           "Answers the new candidate count or a negated code.")
  (let [pools (m-pools p mt)
        alts (m-alts p mt)
        f0c (ia p (+ mt 11))
        kr (named-rec p s bo mt kid)
        ^:mut nc nc0]
    (iset s (+ bo 3) nc0)
    (for [^I32 pi 0 f0c]
      (let [prec (+ pools (* 5 pi))
            pso (ia p (+ prec 4))]
        (if (> (ia s (+ (+ bo pso) 1)) 0)
          (do (iset s (+ (+ bo pso) 3) nc)
              (let [go (group-rec p (ia p (+ prec 1)))
                    ne (ia p go)]
                (for [^I32 j 0 ne]
                  (if (not (charge s 1 at)) (return (neg R_BUDGET)))
                  (let [t (ts-test p s (ia p (+ (+ go 2) (* 4 j))) ek at)]
                    (if (< t 0) (return t))
                    (if (== t 1)
                      (do (if (>= nc cap) (return (neg R_INCONSISTENT)))
                          (iset s (+ cl (* 4 nc)) bo)
                          (iset s (+ (+ cl (* 4 nc)) 1) 1)
                          (iset s (+ (+ cl (* 4 nc)) 2) pi)
                          (iset s (+ (+ cl (* 4 nc)) 3) j)
                          (set nc (+ nc 1)))))))))))
    (if (>= kr 0)
      (do (let [krec (+ (m-keys p mt) (* 4 kr))
                nf (ia p (+ krec 2))
                ncount (ia p (+ krec 3))
                names (m-names p mt)]
            (for [^I32 r 0 ncount]
              (if (not (charge s 1 at)) (return (neg R_BUDGET)))
              (let [nr (+ nf r)
                    a (ia p (+ names (* 2 nr)))
                    lit (ia p (+ (+ names (* 2 nr)) 1))]
                (if (alt-live p s bo pools alts a)
                  (do (if (>= nc cap) (return (neg R_INCONSISTENT)))
                      (iset s (+ cl (* 4 nc)) bo)
                      (iset s (+ (+ cl (* 4 nc)) 1) 0)
                      (iset s (+ (+ cl (* 4 nc)) 2) nr)
                      (iset s (+ (+ cl (* 4 nc)) 3) lit)
                      (set nc (+ nc 1)))))))))
    (return nc)))

(defn ^:pub ^I32 cand-vts [^IntsR p ^IntsR s ^I32 fb ^I32 cl ^I32 c]
  (comment "The value typeset of candidate c.")
  (let [cb (+ cl (* 4 c))
        bo (ia s cb)
        mt (block-mt p s fb bo)]
    (if (== (bit-and (ia s (+ cb 1)) 1) 1)
      (do (let [prec (+ (m-pools p mt) (* 5 (ia s (+ cb 2))))
                go (group-rec p (ia p (+ prec 1)))]
            (return (ia p (+ (+ (+ go 2) (* 4 (ia s (+ cb 3)))) 1))))))
    (return (ia p (+ (+ (m-lits p mt) (* 4 (ia s (+ cb 3)))) 1)))))

(defn ^:pub ^Bool block-named [^IntsR s ^I32 bo ^I32 cl ^I32 nc]
  (comment "Did this block contribute a literal (naming) candidate for the pair?")
  (let [^:mut c (ia s (+ bo 3))]
    (while (and (< c nc) (== (ia s (+ cl (* 4 c))) bo))
      (if (== (bit-and (ia s (+ (+ cl (* 4 c)) 1)) 1) 0) (return true))
      (set c (+ c 1))))
  (return false))

;; ------------------------------------------------------------ the update

(defn ^:pub ^I32 map-update [^IntsR p ^Ints s ^I32 bo ^I32 mt ^I32 kid ^I32 cl ^I32 nc ^I32 at]
  (comment "§8.3 step 8 for one alive block: pool outcomes, naming records (1 unit"
           "each), each pool (1 unit), liveness. 1 still alive, 0 died, or a code.")
  (let [pools (m-pools p mt)
        alts (m-alts p mt)
        lits (m-lits p mt)
        nf (ia p mt)
        np (ia p (+ mt 1))
        c0 (ia s (+ bo 3))
        kr (named-rec p s bo mt kid)
        ^:mut owner (neg 1)]
    (if (>= kr 0) (set owner (ia p (+ (+ (m-keys p mt) (* 4 kr)) 1))))
    (comment "1. Outcomes (residual pools first: they are pools 0..), exempt = 0.")
    (for [^I32 pi 0 np]
      (let [prec (+ pools (* 5 pi))
            pso (ia p (+ prec 4))
            fct (ia p prec)
            ^:mut oc (neg 1)]
        (iset s (+ (+ bo pso) 2) 0)
        (if (== fct 0)
          (do (if (> (ia s (+ (+ bo pso) 1)) 0)
                (do (let [go (group-rec p (ia p (+ prec 1)))
                          ^:mut ci (ia s (+ (+ bo pso) 3))
                          ^:mut jstar (neg 1)
                          ^:mut j2 (neg 1)]
                      (while (and (< ci nc)
                                  (and (== (ia s (+ cl (* 4 ci))) bo)
                                       (and (== (bit-and (ia s (+ (+ cl (* 4 ci)) 1)) 1) 1)
                                            (== (ia s (+ (+ cl (* 4 ci)) 2)) pi))))
                        (if (!= (bit-and (ia s (+ (+ cl (* 4 ci)) 1)) 2) 0)
                          (do (let [jj (ia s (+ (+ cl (* 4 ci)) 3))]
                                (if (< jstar 0)
                                  (set jstar jj)
                                  (if (< j2 0) (set j2 jj))))))
                        (set ci (+ ci 1)))
                      (if (>= jstar 0)
                        (do (let [erec (+ (+ go 2) (* 4 jstar))
                                  emin (ia p (+ erec 2))
                                  emax (ia p (+ erec 3))]
                              (if (or (absorbing emin emax)
                                      (< (ia s (+ (+ (+ bo pso) 4) jstar)) emax))
                                (set oc jstar)
                                (if (>= j2 0) (set oc j2))))))))))
          (do (set oc (neg 3))
              (if (== owner fct)
                (do (let [frec (+ (+ mt 8) (* 4 fct))
                          pp (ia p (+ frec 1))]
                      (set oc (neg 1))
                      (if (and (== (ia p frec) MODE_ABSORB) (>= pp 0))
                        (if (!= (ia s (+ (+ bo (ia p (+ (+ pools (* 5 pp)) 4))) 3)) (neg 1))
                          (set oc (neg 2)))))))))
        (iset s (+ (+ bo pso) 3) oc)))
    (comment "2. Naming records of the key (1 unit each).")
    (if (>= kr 0)
      (do (let [krec (+ (m-keys p mt) (* 4 kr))
                nfst (ia p (+ krec 2))
                ncount (ia p (+ krec 3))
                names (m-names p mt)
                ^:mut kc c0]
            (for [^I32 r 0 ncount]
              (if (not (charge s 1 at)) (return (neg R_BUDGET)))
              (let [nr (+ nfst r)
                    a (ia p (+ names (* 2 nr)))
                    lit (ia p (+ (+ names (* 2 nr)) 1))]
                (if (alt-live p s bo pools alts a)
                  (do (while (and (< kc nc)
                                  (and (== (ia s (+ cl (* 4 kc))) bo)
                                       (== (bit-and (ia s (+ (+ cl (* 4 kc)) 1)) 1) 1)))
                        (set kc (+ kc 1)))
                      (if (or (>= kc nc) (!= (ia s (+ cl (* 4 kc))) bo)) (return (neg R_INCONSISTENT)))
                      (let [matched (!= (bit-and (ia s (+ (+ cl (* 4 kc)) 1)) 2) 0)
                            arec (+ alts (* 5 a))
                            aso (ia p (+ arec 4))
                            apool (ia p arec)
                            prec2 (+ pools (* 5 apool))
                            pso2 (ia p (+ prec2 4))
                            lrec (+ lits (* 4 lit))]
                        (set kc (+ kc 1))
                        (if matched
                          (do (let [li (- lit (ia p (+ arec 1)))
                                    wd (+ (+ (+ bo aso) 3) (sar li 5))]
                                (iset s wd (bit-or (ia s wd) (shl 1 (bit-and li 31))))
                                (iset s (+ (+ bo aso) 2) (+ (ia s (+ (+ bo aso) 2)) (ia p (+ lrec 2))))
                                (if (== (ia s (+ (+ bo pso2) 3)) (neg 1))
                                  (do (iset s (+ (+ bo aso) 1) (+ (ia s (+ (+ bo aso) 1)) 1))
                                      (iset s (+ (+ bo pso2) 2) (+ (ia s (+ (+ bo pso2) 2)) 1))))))
                          (if (== (ia p (+ lrec 3)) 1)
                            (do (iset s (+ bo aso) 1)
                                (iset s (+ (+ bo pso2) 1) (- (ia s (+ (+ bo pso2) 1)) 1))
                                (let [fa (+ (+ bo 4) (ia p prec2))]
                                  (iset s fa (- (ia s fa) 1))))))))))))))
    (comment "3. Each pool (1 unit): TAKE of a constrained entry counts; REJECT kills"
             "every live alternative that did not consume the pair.")
    (for [^I32 pj 0 np]
      (if (not (charge s 1 at)) (return (neg R_BUDGET)))
      (let [prec3 (+ pools (* 5 pj))
            pso3 (ia p (+ prec3 4))
            fct3 (ia p prec3)
            o3 (ia s (+ (+ bo pso3) 3))
            ^:mut inv (== owner fct3)]
        (if (== fct3 0) (set inv (<= owner 0)))
        (if inv
          (do (if (>= o3 0)
                (do (let [go3 (group-rec p (ia p (+ prec3 1)))
                          erec3 (+ (+ go3 2) (* 4 o3))]
                      (if (not (absorbing (ia p (+ erec3 2)) (ia p (+ erec3 3))))
                        (do (let [ca (+ (+ (+ bo pso3) 4) o3)]
                              (iset s ca (+ (ia s ca) 1))))))))
              (if (== o3 (neg 1))
                (do (let [lv (ia s (+ (+ bo pso3) 1))
                          ex (ia s (+ (+ bo pso3) 2))
                          fa3 (+ (+ bo 4) fct3)]
                      (iset s (+ bo pso3) (+ (ia s (+ bo pso3)) 1))
                      (iset s fa3 (- (ia s fa3) (- lv ex)))
                      (iset s (+ (+ bo pso3) 1) ex))))))))
    (comment "4. Alive iff every factor still has a live alternative.")
    (for [^I32 f 0 nf]
      (if (== (ia s (+ (+ bo 4) f)) 0)
        (do (iset s (+ bo 1) 0)
            (return 0))))
    (return 1)))

;; ------------------------------------------------------------ the end

(defn ^:pub ^Bool pool-counts-ok [^IntsR p ^IntsR s ^I32 bo ^I32 prec]
  (let [g (ia p (+ prec 1))
        pso (ia p (+ prec 4))]
    (if (< g 0) (return true))
    (let [go (group-rec p g)
          ne (ia p go)]
      (for [^I32 j 0 ne]
        (if (< (ia s (+ (+ (+ bo pso) 4) j)) (ia p (+ (+ (+ go 2) (* 4 j)) 2))) (return false))))
    (return true)))

(defn ^:pub ^Bool factor-sat [^IntsR p ^IntsR s ^I32 bo ^I32 mt ^I32 f]
  (comment "Has factor f a live alternative with every required literal consumed,"
           "whose pool has every group entry at or above its minimum?")
  (let [pools (m-pools p mt)
        alts (m-alts p mt)
        frec (+ (+ mt 8) (* 4 f))
        pf (ia p (+ frec 2))
        pc (ia p (+ frec 3))]
    (for [^I32 k 0 pc]
      (let [prec (+ pools (* 5 (+ pf k)))]
        (if (pool-counts-ok p s bo prec)
          (do (let [af (ia p (+ prec 2))
                    ac (ia p (+ prec 3))]
                (for [^I32 ai 0 ac]
                  (let [a (+ af ai)
                        arec (+ alts (* 5 a))
                        aso (ia p (+ arec 4))]
                    (if (alt-live p s bo pools alts a)
                      (if (== (ia s (+ (+ bo aso) 2)) (ia p (+ arec 3))) (return true))))))))))
    (return false)))

(defn ^:pub ^Bool map-satisfied [^IntsR p ^IntsR s ^I32 bo ^I32 mt]
  (if (== (ia s (+ bo 1)) 0) (return false))
  (for [^I32 f 0 (ia p mt)]
    (if (not (factor-sat p s bo mt f)) (return false)))
  (return true))

(defn ^:pub ^I32 map-missing [^IntsR p ^Ints s ^I32 bo ^I32 mt ^I32 d ^I32 pos]
  (comment "Witness rule 4 for this (alive, unsatisfied) block: its first factor"
           "with no satisfied alternative, that factor's lowest-index live"
           "alternative, its first unmet entry -- literal entries in source order,"
           "then constrained group entries in priority order (§17 Q3); 1 unit per"
           "entry examined. 0 or a negated code.")
  (let [pools (m-pools p mt)
        alts (m-alts p mt)
        lits (m-lits p mt)]
    (for [^I32 f 0 (ia p mt)]
      (if (not (factor-sat p s bo mt f))
        (do (let [frec (+ (+ mt 8) (* 4 f))
                  pf (ia p (+ frec 2))
                  pc (ia p (+ frec 3))]
              (for [^I32 k 0 pc]
                (let [prec (+ pools (* 5 (+ pf k)))
                      pso (ia p (+ prec 4))
                      af (ia p (+ prec 2))
                      ac (ia p (+ prec 3))]
                  (for [^I32 ai 0 ac]
                    (let [a (+ af ai)
                          arec (+ alts (* 5 a))
                          aso (ia p (+ arec 4))
                          lf (ia p (+ arec 1))
                          lc (ia p (+ arec 2))]
                      (if (alt-live p s bo pools alts a)
                        (do (for [^I32 li 0 lc]
                              (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                              (let [lrec (+ lits (* 4 (+ lf li)))
                                    word (ia s (+ (+ (+ bo aso) 3) (sar li 5)))]
                                (if (and (== (ia p (+ lrec 2)) 1)
                                         (== (bit-and word (shl 1 (bit-and li 31))) 0))
                                  (do (wit-set s R_MISSING 0 d P_KEY (ia p lrec) pos)
                                      (return 0)))))
                            (let [g (ia p (+ prec 1))]
                              (if (>= g 0)
                                (do (let [go (group-rec p g)
                                          ne (ia p go)]
                                      (for [^I32 j 0 ne]
                                        (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                                        (let [erec (+ (+ go 2) (* 4 j))
                                              emin (ia p (+ erec 2))]
                                          (if (and (not (absorbing emin (ia p (+ erec 3))))
                                                   (< (ia s (+ (+ (+ bo pso) 4) j)) emin))
                                            (do (wit-set s R_MISSING 0 d P_ANYKEY 0 pos)
                                                (return 0)))))))))
                            (wit-set s R_MISSING 0 d (neg 1) 0 pos)
                            (return 0)))))))))))
    (wit-set s R_MISSING 0 d (neg 1) 0 pos)
    (return 0)))
