;; The LIVE walk (program.md §8, §9): one item evaluated against its query list
;; Q' in the frame of its physical depth, fused with the profile checks of
;; kin/scan.kin in the scanner's order (docs/scanner.md). Children get their
;; query lists in the next frame; a child whose query is empty is walked dead
;; (snug.vm.dead), which is also the profile-only continuation after a schema
;; failure (architecture §4.5).
;;
;; Every function answers a position (>= 0) or a negated code (profile code,
;; R_BUDGET, R_INCONSISTENT). A schema failure is not a code: it is the absence
;; of matched answers plus the witness slot.
;;
;; Readings of program.md recorded in DEVLOG (D040-D042): ANY and MAJOR give
;; their children no query (children are walked dead); a container's "live
;; candidate" for witness clearing is an alive block or an admitted scalar
;; leaf (ANY, MAJOR, LIT, ...); leaf failure reasons for containers are
;; `unexpected`/`value` (died at a pair or element) and `missing` (at the end).
(ns snug.vm.eval
  (:require [kin.lang :refer [defn let local return set if while for do comment declarefn break]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR + - * neg shl sar ushr bit-and bit-or bit-xor
                               < > <= >= == != and or not u8 ia iset]]
            [snug.cbor.codes :refer [CODE_TRUNCATED CODE_KEY_TYPE CODE_TEXT CODE_TAG CODE_DEPTH
                                     CODE_TOO_MANY_ITEMS CODE_DECIMAL CODE_NDARRAY CODE_TRAILING
                                     O_COSE O_MAX_DEPTH O_MAX_ITEMS O_ITEMS O_HI O_LO O_CSTART
                                     O_ERR_POS O_PROFILE]]
            [snug.cbor.head :refer [fail read-arg take-len enter-container be16 be32]]
            [snug.cbor.text :refer [utf8-invalid-at]]
            [snug.cbor.keys :refer [compare-spans]]
            [snug.cbor.tags :refer [typed-size]]
            [snug.cbor.scan :refer [scan-float scan-simple key-peek key-label text-nc]]
            [snug.cbor.stdtags :refer [std-allowed]]
            [snug.vm.layout :refer [H_FLAGS H_S_LEAVES FL_EMBED FL_COMB K_TAG K_TAGSET K_EMBED
                                    K_ARRAY K_MAP K_AND K_NOT F_ANSWER F_ADMITTED F_MATCHED F_EVAL
                                    VM_QIDX VM_Q1 VM_BIGNUM_MAX VM_EMBED VM_D VM_DLIM VM_W_STATE
                                    VM_W_REASON VM_W_SUB SCRATCH_MARK R_TYPE R_MISSING R_UNEXPECTED
                                    R_VALUE R_TAG R_EMBEDDED R_BUDGET R_INCONSISTENT P_INDEX P_KEY
                                    P_ANYKEY P_TAG P_EMBED P_EMBEDSEQ CTX_KEY CTX_SIMPLE VM_GENERIC VM_FASTM
                                    INF H_S_TS_INDEX H_S_GROUP_INDEX H_S_INTERVALS K_INT K_TEXT
                                    R_RANGE R_SIZE VM_BUDGET VM_FASTK MODE_ABSORB K_ANY K_MAJOR
                                    VM_FASTP VM_FASTL]]
            [snug.vm.base :refer [charge c64 c64min new-epoch sched2 free-on free-off q-add q-filter q-stamp ts-test q-flag q-set-flag
                                  q-kind q-leaf-base cset-rec next-ck cset-width cset-frame
                                  wit-empty wit-clear wit-set path-put rule1]]
            [snug.vm.dead :refer [dead-item dead-seq key-order dead-int-streak dead-map-pairs dead-array-elems dead-typed dead-bignum dead-pair-body
                                  pair-check decimal-check ndarray-check dead-std-check]]
            [snug.vm.leaf :refer [eval-scalars scalar-kind cmp-u64 eval-leaf cmp-point]]
            [snug.vm.map :refer [leaf-map block-mt map-block-init key-span-end key-search map-cursor
                                 m-pools m-alts m-lits m-keys m-names group-rec named-rec key-probe
                                 cand-vts-mt simple-struct key-phase-struct update-struct
                                 map-key-query map-key-phase cand-vts block-named map-update
                                 map-satisfied map-missing]]
            [snug.vm.array :refer [leaf-array block-ao array-words array-block-init array-candidates
                                   array-advance array-accepts]]))

(declarefn eval-item eval-embed eval-array)

;; ------------------------------------------------------------ item endings

(defn ^:pub ^I32 unit-of [^I32 ctx]
  (comment "The per-leaf unit of eval-scalars: 0 for schedule 2's one-leaf child.")
  (if (!= (bit-and ctx CTX_SIMPLE) 0) (return 0))
  (return 1))

(defn ^:pub ^I32 simple-of [^IntsR p ^IntsR s ^I32 on ^I32 cfb ^I32 cnq]
  (comment "CTX_SIMPLE when schedule 2's simple pair (on = 1) queries its child with"
           "exactly one entry, a scalar answer leaf (D045 iii), else 0.")
  (if (or (!= on 1) (!= cnq 1)) (return 0))
  (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 (ia s cfb)))) 255)) (return CTX_SIMPLE))
  (return 0))

(defn ^:pub ^I32 simple-leaf [^IntsR p ^I32 on ^I32 leaf]
  (comment "CTX_SIMPLE for schedule 2's one-leaf child when the leaf is scalar.")
  (if (or (!= on 1) (< leaf 0)) (return 0))
  (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 leaf))) 255)) (return CTX_SIMPLE))
  (return 0))

(defn ^:pub ^I32 if-s2 [^IntsR s]
  (if (sched2 s) (return 1))
  (return 0))

(defn ^:pub ^I32 q-filter-x [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 cls ^I32 pos ^I32 ctx]
  (comment "q-filter; its |Q'| units free for schedule 2's one-leaf child (D045).")
  (if (!= (bit-and ctx CTX_SIMPLE) 0)
    (do (free-on s)
        (let [r (q-filter p s fb w nq cls pos)]
          (free-off s)
          (return r))))
  (return (q-filter p s fb w nq cls pos)))

(defn ^:pub ^I32 finish-comb [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 pos]
  (comment "Combinators of the item (§8.4): stamp its matched leaves in a fresh"
           "epoch, then one pass in query order evaluates each admitted AND"
           "(both operands) and NOT (target and not the literal), 2 units each."
           "Answers 1 if some answer leaf matched, 0 if none, or a code.")
  (if (!= (bit-and (ia p H_FLAGS) FL_COMB) 0)
    (do (let [e (new-epoch s)
              qi (ia s VM_QIDX)
              fl0 (+ fb w)]
          (for [^I32 i 0 nq]
            (let [l (ia s (+ fb i))]
              (iset s (+ qi l) i)
              (if (!= (bit-and (ia s (+ fl0 i)) F_MATCHED) 0)
                (iset s (+ SCRATCH_MARK l) e))))
          (for [^I32 j 0 nq]
            (let [kind (q-kind p s fb j)
                  f (ia s (+ fl0 j))]
              (if (and (or (== kind K_AND) (== kind K_NOT)) (!= (bit-and f F_ADMITTED) 0))
                (do (if (not (charge s 2 pos)) (return (neg R_BUDGET)))
                    (let [lb (q-leaf-base p s fb j)
                          a (ia p (+ lb 2))
                          c (ia p (+ lb 3))
                          ma (== (ia s (+ SCRATCH_MARK a)) e)
                          mc (== (ia s (+ SCRATCH_MARK c)) e)
                          ra (bit-and (ia s (+ fl0 (ia s (+ qi a)))) (shl 255 8))
                          rc (bit-and (ia s (+ fl0 (ia s (+ qi c)))) (shl 255 8))
                          ok (or (and (== kind K_AND) (and ma mc))
                                 (and (== kind K_NOT) (and ma (not mc))))
                          ^:mut why ra]
                      (if ma
                        (if (== kind K_AND) (set why rc) (set why (shl R_VALUE 8))))
                      (if (== why 0) (set why (shl R_TYPE 8)))
                      (if ok
                        (do (iset s (+ fl0 j) (bit-or f F_MATCHED))
                            (let [lj (ia s (+ fb j))]
                              (iset s (+ SCRATCH_MARK lj) e)))
                        (iset s (+ fl0 j) (bit-or f why)))))))))))
  (for [^I32 k 0 nq]
    (if (== (bit-and (ia s (+ (+ fb w) k)) (+ F_ANSWER F_MATCHED)) (+ F_ANSWER F_MATCHED))
      (return 1)))
  (return 0))

(defn ^:pub ^I32 finish-scalar [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 d ^I32 pos ^I32 ctx]
  (comment "End of an item that is not a container: combinators, then witness rule 1"
           "if no answer matched (never for a map key, §9.2 rule 6).")
  (let [m (finish-comb p s fb w nq pos)]
    (if (< m 0) (return m))
    (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
      (return (rule1 s fb w nq d pos)))
    (return 0)))

(defn ^:pub ^I32 count-pending [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq]
  (comment "Admitted scalar leaves (ANY, MAJOR, LIT, ...) of a container item: live"
           "candidates until its end.")
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (if (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0)
        (if (scalar-kind (q-kind p s fb i)) (set k (+ k 1)))))
    (return k)))

;; ------------------------------------------------------------ byte strings and EMBED

(defn ^:pub ^I32 bstr-tail [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 cs ^I32 ce
                            ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 ctx]
  (comment "A byte string item at pos (content [cs, ce)) at depth d, after its"
           "profile checks: filter, scalar leaves, EMBED sub-validations, end.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        na (q-filter-x p s fb w nq 4 pos ctx)]
    (if (< na 0) (return na))
    (let [r1 (eval-scalars p pool b s fb w nq pos cs ce 4 0 0 (unit-of ctx))]
      (if (< r1 0) (return r1)))
    (if (!= (bit-and (ia p H_FLAGS) FL_EMBED) 0)
      (do (let [^:mut ne 0]
            (for [^I32 i 0 nq]
              (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_EMBED))
                (set ne (+ ne 1))))
            (if (> ne 0)
              (do (let [^I32 r2 (eval-embed p pool b s pos cs ce d fb ck nq)]
                    (if (< r2 0) (return r2))))))))
    (return (finish-scalar p s fb w nq d pos ctx))))

(defn ^:pub ^I32 embed-kill [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 seq]
  (comment "Kill the live EMBED leaves of one kind (seq 1 `.cborseq`, 0 `.cbor`).")
  (for [^I32 i 0 nq]
    (let [f (q-flag s fb w i)]
      (if (and (!= (bit-and f F_EVAL) 0) (== (q-kind p s fb i) K_EMBED))
        (if (== (sar (bit-and (ia p (q-leaf-base p s fb i)) 256) 8) seq)
          (iset s (+ (+ fb w) i) (bit-or (bit-and f (bit-xor F_EVAL (neg 1))) (shl R_EMBEDDED 8)))))))
  (return 0))

(defn ^:pub ^I32 count-matched-scalars [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq]
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (let [f (q-flag s fb w i)]
        (if (== (bit-and f (+ F_ADMITTED F_MATCHED)) (+ F_ADMITTED F_MATCHED))
          (if (scalar-kind (q-kind p s fb i)) (set k (+ k 1))))))
    (return k)))

(defn ^:pub ^I32 embed-live [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq ^I32 seq]
  (comment "How many EMBED leaves of this kind (seq 1: `.cborseq`, 0: `.cbor`) are"
           "still live (F_EVAL).")
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (let [f (q-flag s fb w i)]
        (if (and (!= (bit-and f F_EVAL) 0) (== (q-kind p s fb i) K_EMBED))
          (if (== (sar (bit-and (ia p (q-leaf-base p s fb i)) 256) 8) seq) (set k (+ k 1))))))
    (return k)))

(defn ^:pub ^I32 embed-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 cs ^I32 ce ^I32 d ^I32 fb
                            ^I32 ck ^I32 nq ^I32 seq ^I32 pos]
  (comment "One sub-validation of the content [cs, ce) for the live EMBED leaves of"
           "one kind. `.cbor` (seq 0): one item at physical depth d + 1 queried with"
           "their content typesets, which must end at ce (else inner trailing)."
           "`.cborseq` (seq 1, D040): the sequence is the element list of a VIRTUAL"
           "array item at depth d + 1 queried with their content typesets (the"
           "control type is an array type), its items at depth d + 2. Own item"
           "counter, depth limit min(limit, D - root depth), top-any, no cose,"
           "bounded by ce, the shared budget; an inner profile or limit failure"
           "kills these leaves only. 0, or budget / inconsistent.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        items (ia s O_ITEMS)
        maxd (ia s O_MAX_DEPTH)
        cose (ia s O_COSE)
        errpos (ia s O_ERR_POS)
        dd (ia s VM_D)
        root (+ (+ d 1) seq)
        ^:mut nm (+ (ia s VM_DLIM) root)
        e (new-epoch s)
        ^:mut cnq 0]
    (if (> nm dd) (set nm dd))
    (comment "No frame for the embedded root beyond the compiled depth D: an inner"
             "`cbor/depth` (program.md §17 q6). Its path is the byte string's plus"
             "`cbor` as the witness's extra segment (no path-stack slot past D).")
    (if (> root dd)
      (do (wit-set s CODE_DEPTH 0 d P_EMBED 0 cs)
          (embed-kill p s fb w nq seq)
          (return 0)))
    (path-put s (+ d 1) P_EMBED 0)
    (for [^I32 k 0 nq]
      (let [fk (q-flag s fb w k)
            lbk (q-leaf-base p s fb k)]
        (if (and (and (!= (bit-and fk F_EVAL) 0) (== (q-kind p s fb k) K_EMBED))
                 (== (sar (bit-and (ia p lbk) 256) 8) seq))
          (do (let [ets (ia p (+ lbk 2))]
                (set cnq (q-add p s cfb cw cnq ets e pos)))
              (if (< cnq 0) (return cnq))))))
    (iset s O_ITEMS 0)
    (iset s O_MAX_DEPTH nm)
    (iset s O_COSE 0)
    (iset s VM_EMBED (+ (ia s VM_EMBED) 1))
    (local ^I32 r)
    (if (== seq 1)
      (if (> cnq 0)
        (set r (eval-array p pool b s cs cs (neg 1) (+ d 1) cfb cck cnq ce 0))
        (set r (dead-seq b s cs (+ d 2) ce)))
      (if (> cnq 0)
        (set r (eval-item p pool b s cs (+ d 1) cfb cck cnq ce 0))
        (set r (dead-item b s cs (+ d 1) ce))))
    (if (or (== r (neg R_BUDGET)) (== r (neg R_INCONSISTENT))) (return r))
    (let [ierr (ia s O_ERR_POS)]
      (iset s O_ITEMS items)
      (iset s O_MAX_DEPTH maxd)
      (iset s O_COSE cose)
      (iset s O_ERR_POS errpos)
      (iset s VM_EMBED (- (ia s VM_EMBED) 1))
      (if (< r 0)
        (do (wit-set s (neg r) 0 (+ d 1) (neg 1) 0 ierr)
            (embed-kill p s fb w nq seq)
            (return 0))))
    (let [ev (q-stamp s cfb cw cnq pos)]
      (if (< ev 0) (return ev))
      (for [^I32 k2 0 nq]
        (let [f2 (q-flag s fb w k2)
              lb2 (q-leaf-base p s fb k2)]
          (if (and (and (!= (bit-and f2 F_EVAL) 0) (== (q-kind p s fb k2) K_EMBED))
                   (== (sar (bit-and (ia p lb2) 256) 8) seq))
            (do (let [ets2 (ia p (+ lb2 2))
                      t (ts-test p s ets2 ev pos)]
                  (if (< t 0) (return t))
                  (if (== t 0)
                    (iset s (+ (+ fb w) k2)
                          (bit-or (bit-and f2 (bit-xor F_EVAL (neg 1))) (shl R_EMBEDDED 8))))))))))
    (if (and (== seq 0) (!= r ce))
      (if (> (embed-live p s fb w nq 0) 0)
        (do (wit-set s CODE_TRAILING 0 (+ d 1) (neg 1) 0 r)
            (embed-kill p s fb w nq 0))))
    (return 0)))

(defn ^:pub ^I32 eval-embed [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 cs ^I32 ce
                             ^I32 d ^I32 fb ^I32 ck ^I32 nq]
  (comment "§8.4 EMBED on a byte string item at depth d with content [cs, ce): 1 unit"
           "per admitted EMBED leaf, then a sub-validation for the `.cbor` leaves and"
           "one for the `.cborseq` leaves (D040). Survivors match; with no other"
           "candidate left the slot becomes `embedded` with the innermost"
           "non-embedded reason (§9.2 rule 7). 0, or budget / inconsistent.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)]
    (for [^I32 j 0 nq]
      (let [f (q-flag s fb w j)]
        (if (and (!= (bit-and f F_ADMITTED) 0) (== (q-kind p s fb j) K_EMBED))
          (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
              (q-set-flag s fb w j F_EVAL)))))
    (if (> (embed-live p s fb w nq 0) 0)
      (do (let [r0 (embed-run p pool b s cs ce d fb ck nq 0 pos)]
            (if (< r0 0) (return r0)))
          (if (or (> (embed-live p s fb w nq 0) 0) (> (count-matched-scalars p s fb w nq) 0))
            (wit-clear s))))
    (if (> (embed-live p s fb w nq 1) 0)
      (do (let [r1 (embed-run p pool b s cs ce d fb ck nq 1 pos)]
            (if (< r1 0) (return r1)))
          (if (or (> (embed-live p s fb w nq 1) 0)
                  (or (> (embed-live p s fb w nq 0) 0) (> (count-matched-scalars p s fb w nq) 0)))
            (wit-clear s))))
    (let [^:mut won 0]
      (for [^I32 m 0 nq]
        (let [fm (q-flag s fb w m)]
          (if (and (!= (bit-and fm F_EVAL) 0) (== (q-kind p s fb m) K_EMBED))
            (do (iset s (+ (+ fb w) m) (bit-or fm F_MATCHED))
                (set won (+ won 1))))))
      (if (and (== won 0) (== (count-matched-scalars p s fb w nq) 0))
        (if (wit-empty s)
          (wit-set s R_EMBEDDED 0 d (neg 1) 0 pos)
          (if (!= (ia s VM_W_REASON) R_EMBEDDED)
            (do (iset s VM_W_SUB (ia s VM_W_REASON))
                (iset s VM_W_REASON R_EMBEDDED))))))
    (return 0)))

;; ------------------------------------------------------------ tags

(defn ^:pub ^I32 if-code [^I32 lo]
  (if (== lo 4) (return CODE_DECIMAL))
  (return CODE_NDARRAY))

(defn ^:pub ^I32 count-matched [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq]
  (comment "Admitted, non-combinator entries that matched: the item's live candidates"
           "once everything but its combinators is decided.")
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (let [f (q-flag s fb w i)
            kind (q-kind p s fb i)]
        (if (and (== (bit-and f (+ F_ADMITTED F_MATCHED)) (+ F_ADMITTED F_MATCHED))
                 (and (!= kind K_AND) (!= kind K_NOT)))
          (set k (+ k 1)))))
    (return k)))

(defn ^:pub ^I32 item-cls [^I32 major ^I32 ai ^I32 hi ^I32 lo]
  (comment "The item's class bit (§4.1).")
  (if (< major 6) (return (shl 1 major)))
  (if (== major 6)
    (do (if (and (== hi 0) (or (== lo 2) (== lo 3))) (return 2048))
        (return 64)))
  (if (== ai 25) (return 256))
  (if (== ai 26) (return 512))
  (if (== ai 27) (return 1024))
  (return 128))

(defn ^:pub ^I32 single-scalar [^IntsR p ^I32 ts]
  (comment "The leaf of typeset ts when it is exactly one answer of a scalar kind"
           "with no evaluation list (no combinator), else -1.")
  (let [off (ia p (+ (ia p H_S_TS_INDEX) ts))]
    (if (or (!= (ia p off) 1) (!= (ia p (+ off 1)) 0)) (return (neg 1)))
    (let [l (ia p (+ off 2))]
      (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 l))) 255)) (return l))
      (return (neg 1)))))

(defn ^:pub ^I32 single-leaf [^IntsR p ^I32 ts]
  (comment "The leaf of typeset ts when it is exactly one answer and no evaluation"
           "list (any kind but a combinator), else -1.")
  (let [off (ia p (+ (ia p H_S_TS_INDEX) ts))]
    (if (or (!= (ia p off) 1) (!= (ia p (+ off 1)) 0)) (return (neg 1)))
    (return (ia p (+ off 2)))))

(defn ^:pub ^Bool int1 [^IntsR p ^Bytes pool ^Bytes b ^I32 iv ^I32 cls ^I32 hi ^I32 lo]
  (comment "Is the major-0 (cls 1) or major-1 (cls 2) point hi:lo inside interval iv?")
  (let [bo (+ (ia p H_S_INTERVALS) (* 6 iv))
        ^:mut rg 3]
    (if (== cls 2) (set rg 2))
    (return (and (>= (cmp-point p pool b rg hi lo bo) 0) (<= (cmp-point p pool b rg hi lo (+ bo 3)) 0)))))

(defn ^:pub ^Bool pt-ge [^I32 rg ^I32 ph ^I32 pl ^I32 br ^I32 ba ^I32 bb]
  (comment "point (rg 2 NEG / 3 POS, hi:lo) >= bound (region, a, b)?")
  (if (!= rg br) (return (> rg br)))
  (if (== rg 3) (return (>= (cmp-u64 ph pl ba bb) 0)))
  (return (>= (cmp-u64 ba bb ph pl) 0)))

(defn ^:pub ^Bool pt-le [^I32 rg ^I32 ph ^I32 pl ^I32 br ^I32 ba ^I32 bb]
  (if (!= rg br) (return (< rg br)))
  (if (== rg 3) (return (<= (cmp-u64 ph pl ba bb) 0)))
  (return (<= (cmp-u64 ba bb ph pl) 0)))

(defn ^:pub ^I32 array-streak [^IntsR p ^Bytes b ^Ints s ^I32 q0 ^I32 limit ^I32 end
                               ^I32 leaf ^I32 s2]
  (comment "P3.6 (D044): consecutive SUCCESSFUL elements of a `[* T]` array whose"
           "block already holds its one active position (|A| = 1), T one INT leaf"
           "over one interval or one TEXT leaf without a regexp. Each element is"
           "checked first -- items limit, head (shortest form, bytes present),"
           "UTF-8, the leaf -- and only then charged, in the generic order: 5 at"
           "the array (block 1 + W(|A|+1) 2 + candidate 1 + element 1), visit 1"
           "[+ UTF-8 ceil(len/64)] + filter 1 + leaf 1 [+ probe 1] at the element,"
           "3 at the array (stamp, candidate, test). An element that would fail,"
           "need anything else or exceed the budget stops the streak BEFORE it is"
           "touched. No path write is needed: no witness can be recorded inside"
           "a successful streak. Answers the next position; the element count goes"
           "in s[VM_FASTM].")
  (let [lb (+ (ia p H_S_LEAVES) (* 8 leaf))
        kind (bit-and (ia p lb) 255)
        isint (== kind K_INT)
        mask (ia p (+ lb 1))
        iv (+ (ia p H_S_INTERVALS) (* 6 (ia p (+ lb 2))))
        lr (ia p iv)
        la (ia p (+ iv 1))
        lbb (ia p (+ iv 2))
        hr (ia p (+ iv 3))
        ha (ia p (+ iv 4))
        hb (ia p (+ iv 5))
        tlo (ia p (+ lb 2))
        thi (ia p (+ lb 3))
        maxit (ia s O_MAX_ITEMS)
        ^:mut q q0
        ^:mut k 0
        ^:mut items (ia s O_ITEMS)
        ^:mut left (ia s VM_BUDGET)]
    (while (and (< k limit) (< q end))
      (let [ib (u8 b q)
            major (ushr ib 5)
            ai (bit-and ib 31)
            ^:mut hi 0
            ^:mut lo ai
            ^:mut h 1
            ^:mut cost (- 12 (* 10 s2))]
        (if (>= items maxit) (break))
        (if (> ai 27) (break))
        (if (>= ai 24)
          (do (set h (+ 1 (shl 1 (- ai 24))))
              (if (> h (- end q)) (break))
              (if (== ai 24) (set lo (u8 b (+ q 1))))
              (if (== ai 25) (set lo (be16 b (+ q 1))))
              (if (== ai 26) (set lo (be32 b (+ q 1))))
              (if (== ai 27) (do (set hi (be32 b (+ q 1))) (set lo (be32 b (+ q 5)))))
              (comment "shortest form, else the element is not ours")
              (if (and (== ai 24) (< lo 24)) (break))
              (if (and (== ai 25) (< lo 256)) (break))
              (if (and (== ai 26) (== (ushr lo 16) 0)) (break))
              (if (and (== ai 27) (== hi 0)) (break))))
        (if isint
          (do (if (> major 1) (break))
              (if (== (bit-and mask (shl 1 major)) 0) (break))
              (let [rg (- 3 major)]
                (if (not (and (pt-ge rg hi lo lr la lbb) (pt-le rg hi lo hr ha hb))) (break)))
              (if (< left cost) (break))
              (set left (- left cost))
              (set q (+ q h)))
          (do (comment "TEXT: length, bytes present, size, UTF-8")
              (if (!= major 3) (break))
              (if (or (!= hi 0) (< lo 0)) (break))
              (if (> lo (- end (+ q h))) (break))
              (if (or (< lo tlo) (> lo thi)) (break))
              (comment "schedule 2: visit + UTF-8 only")
              (set cost (+ (- 11 (* 10 s2)) (c64 lo)))
              (if (< left cost) (break))
              (if (>= (utf8-invalid-at b (+ q h) (+ (+ q h) lo) (text-nc s)) 0) (break))
              (set left (- left cost))
              (set q (+ (+ q h) lo))))
        (set items (+ items 1))
        (set k (+ k 1))))
    (iset s VM_BUDGET left)
    (iset s O_ITEMS items)
    (iset s VM_FASTM k)
    (if (> k 0) (wit-clear s))
    (return q)))

(defn ^:pub ^I32 fast-child [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 d ^I32 cfb ^I32 ck
                             ^I32 cw ^I32 leaf ^I32 end ^I32 ctx]
  (comment "P3.6 (D044): eval-item on a query list of exactly ONE answer leaf"
           "`leaf` without building the list: for a scalar kind on a scalar major,"
           "the same profile checks, charges (consecutive charges at one offset"
           "merged, which no output can tell apart) and witness rule 1, with no"
           "frame or mark writes; the matched flag goes in s[VM_FASTM]. Any other"
           "item (container, tag, missing byte) or leaf kind takes the generic"
           "eval-item over the one-entry list written into the frame (its building"
           "was charged by the caller).")
  (let [^:mut major (neg 1)
        lb (+ (ia p H_S_LEAVES) (* 8 leaf))
        kind (bit-and (ia p lb) 255)]
    (if (< pos end) (set major (ushr (u8 b pos) 5)))
    (comment "ANY, or the matching bare major, on an array or map: the generic"
             "item's visit, head, container checks, filter 1, children walked dead"
             "(D043), then 1 for the leaf -- directly.")
    (if (and (or (== major 4) (== major 5))
             (or (== kind K_ANY) (and (== kind K_MAJOR) (== (ia p (+ lb 2)) major))))
      (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
          (let [it0 (+ (ia s O_ITEMS) 1)]
            (iset s O_ITEMS it0)
            (if (> it0 (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
          (let [ai0 (bit-and (u8 b pos) 31)
                ^:mut hi0 0
                ^:mut lo0 ai0
                ^:mut q0 (+ pos 1)]
            (if (>= ai0 24)
              (do (set q0 (read-arg b s pos ai0 end))
                  (if (< q0 0) (return q0))
                  (set hi0 (ia s O_HI))
                  (set lo0 (ia s O_LO))))
            (let [rc (enter-container s pos q0 hi0 lo0 d (- major 4) end)]
              (if (< rc 0) (return rc)))
            (if (not (charge s (unit-of ctx) pos)) (return (neg R_BUDGET)))
            (local ^I32 r0)
            (if (== major 4)
              (set r0 (dead-array-elems b s q0 lo0 d end))
              (set r0 (dead-map-pairs b s q0 lo0 d end)))
            (if (< r0 0) (return r0))
            (if (not (charge s (unit-of ctx) pos)) (return (neg R_BUDGET)))
            (iset s VM_FASTM 1)
            (return r0))))
    (if (or (< major 0) (or (not (scalar-kind kind)) (or (== major 4) (or (== major 5) (== major 6)))))
      (do (iset s cfb leaf)
          (iset s (+ cfb cw) F_ANSWER)
          (let [^I32 rg (eval-item p pool b s pos d cfb ck 1 end ctx)
                fq (ia s (+ cfb cw))]
            (if (< rg 0) (return rg))
            (if (!= (bit-and fq F_MATCHED) 0) (iset s VM_FASTM 1) (iset s VM_FASTM 0))
            (return rg))))
    (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
    (let [it (+ (ia s O_ITEMS) 1)]
      (iset s O_ITEMS it)
      (if (> it (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
    (let [ai (bit-and (u8 b pos) 31)
          ^:mut hi 0
          ^:mut lo ai
          ^:mut q (+ pos 1)
          ^:mut cs (+ pos 1)
          ^:mut stop (+ pos 1)]
      (if (>= ai 24)
        (if (and (== major 7) (and (>= ai 25) (<= ai 27)))
          (do (set stop (scan-float b s pos ai end))
              (if (< stop 0) (return stop)))
          (do (set q (read-arg b s pos ai end))
              (if (< q 0) (return q))
              (set hi (ia s O_HI))
              (set lo (ia s O_LO))
              (set cs q)
              (set stop q))))
      (if (== major 2)
        (do (set stop (take-len s pos q hi lo end))
            (if (< stop 0) (return stop))))
      (if (== major 3)
        (do (set stop (take-len s pos q hi lo end))
            (if (< stop 0) (return stop))
            (if (not (charge s (c64 (- stop q)) pos)) (return (neg R_BUDGET)))
            (let [bad (utf8-invalid-at b q stop (text-nc s))]
              (if (>= bad 0) (return (fail s bad CODE_TEXT))))))
      (if (and (== major 7) (or (< ai 25) (> ai 27)))
        (do (let [r7 (scan-simple s pos ai)]
              (if (< r7 0) (return r7)))))
      (let [cls (item-cls major ai hi lo)
            ^:mut ^I32 r R_TYPE]
        (if (!= (bit-and (ia p (+ lb 1)) cls) 0)
          (if (and (== kind K_INT) (and (<= cls 2) (== (ia p (+ lb 3)) 1)))
            (do (comment "INT over one interval: filter 1 + leaf 1 + its one probe")
                (if (not (charge s (+ 1 (* 2 (unit-of ctx))) pos)) (return (neg R_BUDGET)))
                (if (int1 p pool b (ia p (+ lb 2)) cls hi lo) (set r 0) (set r R_RANGE)))
            (if (and (== kind K_TEXT) (< (ia p (+ lb 4)) 0))
              (do (comment "TEXT without a regexp: filter 1 + leaf 1, a size check")
                  (if (not (charge s (* 2 (unit-of ctx)) pos)) (return (neg R_BUDGET)))
                  (if (and (>= (- stop cs) (ia p (+ lb 2))) (<= (- stop cs) (ia p (+ lb 3))))
                    (set r 0)
                    (set r R_SIZE)))
              (do (if (not (charge s (* 2 (unit-of ctx)) pos)) (return (neg R_BUDGET)))
                  (set r (eval-leaf p pool b s lb kind pos cs stop cls hi lo))
                  (if (< r 0) (return r)))))
          (if (not (charge s (unit-of ctx) pos)) (return (neg R_BUDGET))))
        (if (== r 0)
          (iset s VM_FASTM 1)
          (do (iset s VM_FASTM 0)
              (if (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s))
                (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                    (wit-set s r 0 d (neg 1) 0 pos)))))
        (return stop)))))

(defn ^:pub ^I32 eval-tag [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q ^I32 hi ^I32 lo
                           ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (comment "A tag item (§8.4): the scanner's depth and number checks, the filter,"
           "TAG/TAGSET number tests (1 unit each), the content at depth d + 1 queried"
           "with the content typesets of the leaves whose number matched (bignum and"
           "typed-array content: a schema child, not an item; tag 4/40: the inner"
           "array as an item; a standard-set tag: its content item, D121), the"
           "scanner's tag semantics, then the leaves.")
  (if (>= d (ia s O_MAX_DEPTH)) (return (fail s pos CODE_DEPTH)))
  (if (!= hi 0) (return (fail s pos CODE_TAG)))
  (let [big (or (== lo 2) (== lo 3))
        tsize (typed-size lo)
        std (and (and (not big) (and (!= lo 4) (and (!= lo 40) (== tsize 0))))
                 (std-allowed (ia s O_PROFILE) lo d))
        cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        ^:mut cls 64
        ^:mut cnq 0
        ^:mut cs q]
    (local ^:mut ^I32 stop)
    (if (and (not big) (and (!= lo 4) (and (!= lo 40) (and (== tsize 0) (not std))))) (return (fail s pos CODE_TAG)))
    (if big (set cls 2048))
    (let [na (q-filter-x p s fb w nq cls pos ctx)]
      (if (< na 0) (return na)))
    (let [e (new-epoch s)]
      (for [^I32 i 0 nq]
        (let [f (q-flag s fb w i)
              kind (q-kind p s fb i)]
          (if (and (!= (bit-and f F_ADMITTED) 0) (or (== kind K_TAG) (== kind K_TAGSET)))
            (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                (let [lb (q-leaf-base p s fb i)
                      istag (== kind K_TAG)
                      hit (or (and istag (and (== (ia p (+ lb 2)) 0) (== (ia p (+ lb 3)) lo)))
                              (and (not istag)
                                   (and (<= (cmp-u64 (ia p (+ lb 2)) (ia p (+ lb 3)) 0 lo) 0)
                                        (>= (cmp-u64 (ia p (+ lb 4)) (ia p (+ lb 5)) 0 lo) 0))))
                      ^:mut cts (ia p (+ lb 6))]
                  (if istag (set cts (ia p (+ lb 4))))
                  (if hit
                    (do (q-set-flag s fb w i F_EVAL)
                        (set cnq (q-add p s cfb cw cnq cts e pos))
                        (if (< cnq 0) (return cnq)))
                    (q-set-flag s fb w i (shl R_TAG 8)))))))))
    (if (> cnq 0) (path-put s (+ d 1) P_TAG 0))
    (if (or big (> tsize 0))
      (do (if (not (charge s 1 q)) (return (neg R_BUDGET)))
          (if big
            (set stop (dead-bignum b s pos q (ia s VM_BIGNUM_MAX) end))
            (set stop (dead-typed b s pos q lo tsize end)))
          (if (< stop 0) (return stop))
          (set cs (ia s O_CSTART))
          (if (> cnq 0)
            (do (let [rb (bstr-tail p pool b s q cs stop (+ d 1) cfb cck cnq 0)]
                  (if (< rb 0) (return rb))))))
      (if std
        (do (if (> cnq 0)
              (set stop (eval-item p pool b s q (+ d 1) cfb cck cnq end 0))
              (set stop (dead-item b s q (+ d 1) end)))
            (if (< stop 0) (return stop))
            (set stop (dead-std-check b s pos lo q stop d))
            (if (< stop 0) (return stop)))
        (do (let [pc (pair-check b s pos q (if-code lo) end)]
              (if (< pc 0) (return pc)))
            (if (> cnq 0)
              (set stop (eval-item p pool b s q (+ d 1) cfb cck cnq end 0))
              (set stop (dead-pair-body b s q d end)))
            (if (< stop 0) (return stop))
            (if (== lo 4)
              (set stop (decimal-check b s pos q stop))
              (set stop (ndarray-check b s pos q stop)))
            (if (< stop 0) (return stop)))))
    (let [ec (q-stamp s cfb cw cnq pos)]
      (if (< ec 0) (return ec))
      (for [^I32 j 0 nq]
        (let [fj (q-flag s fb w j)]
          (if (!= (bit-and fj F_EVAL) 0)
            (do (let [lbj (q-leaf-base p s fb j)
                      ^:mut ctj (ia p (+ lbj 4))]
                  (if (== (q-kind p s fb j) K_TAGSET) (set ctj (ia p (+ lbj 6))))
                  (let [t (ts-test p s ctj ec pos)]
                    (if (< t 0) (return t))
                    (if (== t 1)
                      (q-set-flag s fb w j F_MATCHED)
                      (q-set-flag s fb w j (shl R_TYPE 8))))))))))
    (let [r2 (eval-scalars p pool b s fb w nq pos cs stop cls 0 lo (unit-of ctx))]
      (if (< r2 0) (return r2)))
    (if (> (count-matched p s fb w nq) 0) (wit-clear s))
    (let [r3 (finish-scalar p s fb w nq d pos ctx)]
      (if (< r3 0) (return r3)))
    (return stop)))

;; ------------------------------------------------------------ arrays

(defn ^:pub ^I32 if-limit [^I32 n ^I32 el]
  (if (< n 0) (return INF))
  (return (- n el)))

(defn ^:pub ^I32 array-step [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q ^I32 d ^I32 fb
                             ^I32 w ^I32 area ^I32 cfb ^I32 cck ^I32 cw ^I32 fleaf ^I32 el ^I32 pend
                             ^I32 end ^I32 s2 ^I32 cx]
  (comment "P3.6 (D044): one element of a `[* T]` array (one block, one uncounted"
           "self-looping position, T one answer): the generic element step's"
           "charges merged per offset -- block 1 + W(|A|+1) + candidate 1 + T's"
           "element 1 at the array, the child, then stamp 1 + candidate 1 + test 1"
           "-- the block's state and witness updated as array-advance would."
           "Answers the element's end (the block's alive word tells a death).")
  (comment "schedule 2 (D045): the element's bookkeeping is free")
  (if (not (charge s (* (- 1 s2) (+ (ia s (+ area 2)) 4)) pos)) (return (neg R_BUDGET)))
  (path-put s (+ d 1) P_INDEX el)
  (let [^I32 rf (fast-child p pool b s q (+ d 1) cfb cck cw fleaf end cx)]
    (if (< rf 0) (return rf))
    (if (not (charge s (* (- 1 s2) 3) pos)) (return (neg R_BUDGET)))
    (if (== (ia s VM_FASTM) 1)
      (do (if (!= (ia s (+ area 2)) 1)
            (do (iset s (+ area 2) 1)
                (iset s (+ area 3) 1)
                (iset s (+ area 4) 1)))
          (wit-clear s))
      (do (iset s (+ area 1) 0)
          (iset s (+ area 2) 0)
          (iset s (+ area 3) 0)
          (iset s (+ area 4) 0)
          (q-set-flag s fb w (ia s area) (shl R_TYPE 8))
          (if (> pend 0)
            (wit-clear s)
            (if (wit-empty s) (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 q)))))
    (return rf)))

(defn ^:pub ^I32 array-alive [^IntsR p ^IntsR s ^I32 fb ^I32 area ^I32 nb]
  (let [^:mut bo area
        ^:mut k 0]
    (for [^I32 _bi 0 nb]
      (if (!= (ia s (+ bo 1)) 0) (set k (+ k 1)))
      (set bo (+ bo (array-words p (block-ao p s fb bo)))))
    (return k)))

(defn ^:pub ^I32 eval-array [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q0 ^I32 n
                             ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (comment "An array item (§8.1) after its head and container checks: a block per"
           "admitted ARRAY leaf; per element the candidate positions of the live"
           "blocks give the element's query; at the end, acceptance. n < 0: a"
           "VIRTUAL array (a `.cborseq` sequence, D040) whose elements are the"
           "items up to end.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cap (- fw (* 2 w))
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        ^:mut nb 0
        ^:mut used 0
        ^:mut q q0
        ^:mut q1 q0
        ^:mut el 0
        ^:mut ao1 0
        ^:mut fleaf (neg 1)
        ^:mut sleaf (neg 1)
        ^:mut sl (neg 1)
        ^:mut s2 0
        ^:mut cx 0
        ^:mut unacc 0]
    (local ^:mut ^I32 nalive)
    (let [na (q-filter-x p s fb w nq 16 pos ctx)]
      (if (< na 0) (return na)))
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_ARRAY))
        (do (let [words (array-words p (leaf-array p (q-leaf-base p s fb i)))]
              (if (> (+ used words) cap) (return (neg R_INCONSISTENT)))
              (let [ri (array-block-init s (+ area used) i words pos)]
                (if (< ri 0) (return ri)))
              (set used (+ used words))
              (set nb (+ nb 1))))))
    (comment "The first block's automaton, hoisted (one block is the common case).")
    (if (> nb 0) (set ao1 (block-ao p s fb area)))
    (set nalive nb)
    (comment "P3.6 fast step (D044): one block whose automaton is one uncounted"
             "self-looping position (`[* T]`) with a one-answer typeset T.")
    (if (== nb 1)
      (if (and (and (== (ia p ao1) 1) (== (ia p (+ ao1 2)) 0))
               (and (== (ia p (+ ao1 4)) 1) (== (bit-and (ia p (+ ao1 8)) 1) 1)))
        (set sl (single-leaf p (ia p (+ ao1 6))))))
    (comment "Schedule 2 (D045 i, iii): a simple [* T] block's element steps are free"
             "and a one-scalar-leaf element loses its filter and leaf units.")
    (if (and (sched2 s) (>= sl 0))
      (do (set s2 1)
          (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 sl))) 255)) (set cx CTX_SIMPLE))))
    (if (== (bit-and (ia s VM_GENERIC) 1) 0) (set fleaf sl))
    (if (>= fleaf 0)
      (do (let [lbf (+ (ia p H_S_LEAVES) (* 8 fleaf))
                kf (bit-and (ia p lbf) 255)]
            (if (or (and (== kf K_INT) (== (ia p (+ lbf 3)) 1))
                    (and (== kf K_TEXT) (< (ia p (+ lbf 4)) 0)))
              (set sleaf fleaf)))))
    (let [pend (count-pending p s fb w nq)]
      (while (or (and (< n 0) (< q end)) (and (>= n 0) (< el n)))
        (if (== nalive 0)
          (do (comment "dead elements; a run of integers in one streak (D044), never"
                       "element 0 of a two-element array (whose end VM_Q1 records)")
              (if (and (>= el 1) (== (bit-and (ia s VM_GENERIC) 1) 0))
                (do (let [^I32 qd (dead-int-streak b s q (if-limit n el) end)
                          kd (ia s VM_FASTM)]
                      (if (> kd 0)
                        (do (set q qd)
                            (set el (+ el (- kd 1))))
                        (do (set q (dead-item b s q (+ d 1) end))
                            (if (< q 0) (return q))))))
                (do (set q (dead-item b s q (+ d 1) end))
                    (if (< q 0) (return q)))))
          (if (and (>= sleaf 0) (and (>= el 1) (== (ia s (+ area 2)) 1)))
            (do (let [^I32 qs (array-streak p b s q (if-limit n el) end sleaf s2)
                      ks (ia s VM_FASTM)]
                  (if (> ks 0)
                    (do (set q qs)
                        (set el (+ el (- ks 1))))
                    (do (let [^I32 rf2 (array-step p pool b s pos q d fb w area cfb cck cw fleaf el pend end s2 cx)]
                          (if (< rf2 0) (return rf2))
                          (set q rf2)
                          (if (== (ia s (+ area 1)) 0) (set nalive 0)))))))
          (if (>= fleaf 0)
            (do (let [^I32 rf (array-step p pool b s pos q d fb w area cfb cck cw fleaf el pend end s2 cx)]
                  (if (< rf 0) (return rf))
                  (set q rf)
                  (if (== (ia s (+ area 1)) 0) (set nalive 0))))
          (do (let [e (new-epoch s)
                    ^:mut cnq 0
                    ^:mut bo area
                    ^:mut still 0]
                (local ^I32 r)
                (if (== s2 1) (free-on s))
                (for [^I32 bi 0 nb]
                  (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                  (let [^:mut ao ao1]
                    (if (> bi 0) (set ao (block-ao p s fb bo)))
                    (if (!= (ia s (+ bo 1)) 0)
                      (do (set cnq (array-candidates p s bo ao el cfb cw cnq e pos))
                          (if (< cnq 0) (return cnq))))
                    (set bo (+ bo (array-words p ao)))))
                (free-off s)
                (path-put s (+ d 1) P_INDEX el)
                (if (> cnq 0)
                  (set r (eval-item p pool b s q (+ d 1) cfb cck cnq end cx))
                  (set r (dead-item b s q (+ d 1) end)))
                (if (< r 0) (return r))
                (if (== s2 1) (free-on s))
                (let [ev (q-stamp s cfb cw cnq pos)]
                  (if (< ev 0) (return ev))
                  (set bo area)
                  (for [^I32 bj 0 nb]
                    (let [^:mut aoj ao1]
                      (if (> bj 0) (set aoj (block-ao p s fb bo)))
                      (if (!= (ia s (+ bo 1)) 0)
                        (do (let [adv (array-advance p s bo aoj ev pos)]
                              (if (< adv 0) (return adv))
                              (if (== adv 1)
                                (set still (+ still 1))
                                (do (set nalive (- nalive 1))
                                    (if (== adv 2)
                                      (q-set-flag s fb w (ia s bo) (shl R_UNEXPECTED 8))
                                      (q-set-flag s fb w (ia s bo) (shl R_TYPE 8))))))))
                      (set bo (+ bo (array-words p aoj))))))
                (free-off s)
                (if (or (> still 0) (> pend 0))
                  (wit-clear s)
                  (if (wit-empty s) (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 q)))
                (set q r))))))
        (if (== el 0) (set q1 q))
        (set el (+ el 1))))
    (let [^:mut be area]
      (for [^I32 _bk 0 nb]
        (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
        (let [aok (block-ao p s fb be)]
          (if (!= (ia s (+ be 1)) 0)
            (do (if (not (charge s (ia p (+ aok 1)) pos)) (return (neg R_BUDGET)))
                (if (array-accepts p s be aok el)
                  (q-set-flag s fb w (ia s be) F_MATCHED)
                  (do (q-set-flag s fb w (ia s be) (shl R_MISSING 8))
                      (set unacc (+ unacc 1))))))
          (set be (+ be (array-words p aok))))))
    (if (== n 2) (iset s VM_Q1 q1))
    (let [rs (eval-scalars p pool b s fb w nq pos q0 q 16 0 el (unit-of ctx))]
      (if (< rs 0) (return rs)))
    (let [m (finish-comb p s fb w nq pos)]
      (if (< m 0) (return m))
      (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
        (if (> unacc 0)
          (wit-set s R_MISSING 0 d P_INDEX el pos)
          (do (let [r1 (rule1 s fb w nq d pos)]
                (if (< r1 0) (return r1)))))))
    (return q)))

;; ------------------------------------------------------------ maps

(defn ^:pub ^I32 map-fast-mode [^IntsR p ^I32 mt]
  (comment "P3.6 (D044): 1 for a closed struct (one factor, pool and alternative,"
           "the empty group), 2 for a pure table `{* K => V}` (no literal entry,"
           "one absorbing group entry, K and V one leaf each), else 0.")
  (if (or (!= (ia p mt) 1) (or (!= (ia p (+ mt 1)) 1) (!= (ia p (+ mt 2)) 1))) (return 0))
  (let [go (group-rec p (ia p (+ (m-pools p mt) 1)))
        ne (ia p go)]
    (if (== ne 0) (return 1))
    (if (or (!= ne 1) (!= (ia p (+ mt 3)) 0)) (return 0))
    (if (or (!= (ia p (+ go 4)) 0) (!= (ia p (+ go 5)) INF)) (return 0))
    (if (or (< (single-leaf p (ia p (+ go 2))) 0) (< (single-leaf p (ia p (+ go 3))) 0)) (return 0))
    (return 2)))

(defn ^:pub ^Bool map-pair-ok [^IntsR p ^IntsR s ^I32 bo ^I32 mt ^I32 kid ^I32 mode]
  (comment "Can this pair take the fast step? A struct: an unnamed key, or a key"
           "named once whose value typeset is one leaf.")
  (if (== mode 2) (return true))
  (let [kr (named-rec p s bo mt kid)]
    (if (< kr 0) (return true))
    (let [krec (+ (m-keys p mt) (* 4 kr))]
      (if (!= (ia p (+ krec 3)) 1) (return false))
      (let [lit (ia p (+ (+ (m-names p mt) (* 2 (ia p (+ krec 2)))) 1))]
        (return (>= (single-leaf p (ia p (+ (+ (m-lits p mt) (* 4 lit)) 1))) 0))))))

(defn ^:pub ^I32 map-pair-fast [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 start ^I32 km
                                ^I32 ps ^I32 pe ^I32 end ^I32 d ^I32 fb ^I32 w ^I32 bo
                                ^I32 mt ^I32 cfb ^I32 cck ^I32 cw ^I32 kid ^I32 pend ^I32 mode ^I32 ps2]
  (comment "P3.6 (D044): one pair of a single-block map in a fast mode, after the"
           "shared key search and cursor step: the generic pair's charges merged"
           "per offset, its pool/alternative state updates and witness. The key's"
           "end goes in s[VM_FASTK]; answers the value's end.")
  (let [pools (m-pools p mt)
        pso (ia p (+ pools 4))
        arec (m-alts p mt)
        aso (ia p (+ arec 4))
        lits (m-lits p mt)
        ^:mut named false
        ^:mut vm 0
        ^:mut take false]
    (local ^I32 kq)
    (local ^I32 vq)
    (if (== mode 1)
      (set kq (dead-item b s start (+ d 1) end))
      (do (if (not (charge s (- 1 ps2) pos)) (return (neg R_BUDGET)))
          (let [go (group-rec p (ia p (+ pools 1)))
                kl1 (single-leaf p (ia p (+ go 2)))]
            (set kq (fast-child p pool b s start (+ d 1) cfb cck cw kl1 end
                                (bit-or CTX_KEY (simple-leaf p ps2 kl1)))))))
    (if (< kq 0) (return kq))
    (if (<= km 1)
      (if (not (key-label b s start km)) (return (fail s start CODE_KEY_TYPE))))
    (let [ko (key-order b s ps pe start kq)]
      (if (< ko 0) (return ko)))
    (iset s VM_FASTK kq)
    (iset s (+ (+ bo pso) 2) 0)
    (if (== mode 1)
      (do (let [kr (named-rec p s bo mt kid)]
            (if (>= kr 0)
              (do (let [krec (+ (m-keys p mt) (* 4 kr))
                        lit (ia p (+ (+ (m-names p mt) (* 2 (ia p (+ krec 2)))) 1))
                        lrec (+ lits (* 4 lit))]
                    (set named true)
                    (if (not (charge s (* 2 (- 1 ps2)) pos)) (return (neg R_BUDGET)))
                    (path-put s (+ d 1) P_KEY kid)
                    (let [vl1 (single-leaf p (ia p (+ lrec 1)))]
                      (set vq (fast-child p pool b s kq (+ d 1) cfb cck cw vl1 end (simple-leaf p ps2 vl1))))
                    (if (< vq 0) (return vq))
                    (if (not (charge s (* 5 (- 1 ps2)) pos)) (return (neg R_BUDGET)))
                    (if (== (ia s VM_FASTM) 1)
                      (do (let [li (- lit (ia p (+ arec 1)))
                                wd (+ (+ (+ bo aso) 3) (sar li 5))]
                            (iset s wd (bit-or (ia s wd) (shl 1 (bit-and li 31))))
                            (iset s (+ (+ bo aso) 2) (+ (ia s (+ (+ bo aso) 2)) (ia p (+ lrec 2))))
                            (iset s (+ (+ bo aso) 1) (+ (ia s (+ (+ bo aso) 1)) 1))
                            (iset s (+ (+ bo pso) 2) 1)))
                      (if (== (ia p (+ lrec 3)) 1)
                        (do (iset s (+ bo aso) 1)
                            (iset s (+ (+ bo pso) 1) (- (ia s (+ (+ bo pso) 1)) 1))
                            (iset s (+ bo 4) (- (ia s (+ bo 4)) 1)))))))
              (do (path-put s (+ d 1) P_ANYKEY 0)
                  (set vq (dead-item b s kq (+ d 1) end))
                  (if (< vq 0) (return vq))
                  (if (not (charge s (- 1 ps2) pos)) (return (neg R_BUDGET)))))))
      (do (let [kmatch (== (ia s VM_FASTM) 1)
                go2 (group-rec p (ia p (+ pools 1)))]
            (if kmatch
              (do (if (not (charge s (* 4 (- 1 ps2)) pos)) (return (neg R_BUDGET))))
              (do (if (not (charge s (* 3 (- 1 ps2)) pos)) (return (neg R_BUDGET)))))
            (path-put s (+ d 1) P_ANYKEY 0)
            (if kmatch
              (do (let [vl2 (single-leaf p (ia p (+ go2 3)))]
                    (set vq (fast-child p pool b s kq (+ d 1) cfb cck cw vl2 end (simple-leaf p ps2 vl2))))
                  (if (< vq 0) (return vq))
                  (set vm (ia s VM_FASTM))
                  (if (not (charge s (* 4 (- 1 ps2)) pos)) (return (neg R_BUDGET))))
              (do (set vq (dead-item b s kq (+ d 1) end))
                  (if (< vq 0) (return vq))
                  (if (not (charge s (- 1 ps2) pos)) (return (neg R_BUDGET)))))
            (set take (and kmatch (== vm 1))))))
    (comment "the pool's outcome: TAKE of the absorbing entry, or REJECT")
    (if take
      (iset s (+ (+ bo pso) 3) 0)
      (do (let [lv (ia s (+ (+ bo pso) 1))
                ex (ia s (+ (+ bo pso) 2))]
            (iset s (+ (+ bo pso) 3) (neg 1))
            (iset s (+ bo pso) (+ (ia s (+ bo pso)) 1))
            (iset s (+ bo 4) (- (ia s (+ bo 4)) (- lv ex)))
            (iset s (+ (+ bo pso) 1) ex))))
    (if (== (ia s (+ bo 4)) 0) (iset s (+ bo 1) 0))
    (if (!= (ia s (+ bo 1)) 0)
      (wit-clear s)
      (do (if named
            (q-set-flag s fb w (ia s bo) (shl R_VALUE 8))
            (q-set-flag s fb w (ia s bo) (shl R_UNEXPECTED 8)))
          (if (> pend 0)
            (wit-clear s)
            (if (wit-empty s)
              (if named
                (wit-set s R_VALUE 0 (+ d 1) (neg 1) 0 start)
                (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 start))))))
    (return vq)))

(defn ^:pub ^I32 pre-scalar [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 q ^I32 end ^I32 lb ^I32 kind]
  (comment "P3.6 streaks: does the item at q certainly pass the profile and match"
           "leaf lb -- an INT over one interval or a TEXT without a regexp?"
           "Checked without charging: its end, with the units its generic"
           "evaluation charges (visit, UTF-8, filter, leaf, probe) in s[O_LO]; or"
           "-1 when it would not, or it is anything else.")
  (if (>= q end) (return (neg 1)))
  (let [ib (u8 b q)
        major (ushr ib 5)
        ai (bit-and ib 31)
        ^:mut hi 0
        ^:mut lo ai
        ^:mut h 1]
    (if (> ai 27) (return (neg 1)))
    (if (>= ai 24)
      (do (set h (+ 1 (shl 1 (- ai 24))))
          (if (> h (- end q)) (return (neg 1)))
          (if (== ai 24) (set lo (u8 b (+ q 1))))
          (if (== ai 25) (set lo (be16 b (+ q 1))))
          (if (== ai 26) (set lo (be32 b (+ q 1))))
          (if (== ai 27) (do (set hi (be32 b (+ q 1))) (set lo (be32 b (+ q 5)))))
          (if (and (== ai 24) (< lo 24)) (return (neg 1)))
          (if (and (== ai 25) (< lo 256)) (return (neg 1)))
          (if (and (== ai 26) (== (ushr lo 16) 0)) (return (neg 1)))
          (if (and (== ai 27) (== hi 0)) (return (neg 1)))))
    (if (== kind K_INT)
      (do (if (or (> major 1) (!= (ia p (+ lb 3)) 1)) (return (neg 1)))
          (if (== (bit-and (ia p (+ lb 1)) (shl 1 major)) 0) (return (neg 1)))
          (if (not (int1 p pool b (ia p (+ lb 2)) (+ major 1) hi lo)) (return (neg 1)))
          (iset s O_LO 4)
          (return (+ q h))))
    (if (and (== kind K_TEXT) (== major 3))
      (do (if (or (!= hi 0) (< lo 0)) (return (neg 1)))
          (if (> lo (- end (+ q h))) (return (neg 1)))
          (if (or (< lo (ia p (+ lb 2))) (> lo (ia p (+ lb 3)))) (return (neg 1)))
          (if (>= (utf8-invalid-at b (+ q h) (+ (+ q h) lo) (text-nc s)) 0) (return (neg 1)))
          (iset s O_LO (+ 3 (c64 lo)))
          (return (+ (+ q h) lo))))
    (return (neg 1))))

(defn ^:pub ^Bool streak-kind [^IntsR p ^I32 leaf]
  (comment "Leaves pre-scalar decides: INT over one interval, TEXT without a regexp.")
  (if (< leaf 0) (return false))
  (let [lb (+ (ia p H_S_LEAVES) (* 8 leaf))
        kind (bit-and (ia p lb) 255)]
    (return (or (and (== kind K_INT) (== (ia p (+ lb 3)) 1))
                (and (== kind K_TEXT) (< (ia p (+ lb 4)) 0))))))

(defn ^:pub ^I32 map-streak [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q0 ^I32 limit
                             ^I32 end ^I32 d ^I32 bo ^I32 mt ^I32 mode ^I32 cfb ^I32 cck ^I32 cw
                             ^I32 ps0 ^I32 pe0 ^I32 klo0 ^I32 s2]
  (comment "P3.6 (D044): consecutive SUCCESSFUL pairs of a single-block map in a fast"
           "mode (1 struct: a named key whose value is an INT/TEXT leaf; 2 table:"
           "a TEXT key leaf and an `any` or INT/TEXT value leaf). The key (text,"
           "shortest head, UTF-8, ascending order, the key search done without"
           "charging) and, except under `any`, the value are checked first; then"
           "the pair is charged in the generic order with charges merged per"
           "offset, and its state updated. A pair that would not succeed stops the"
           "streak before it is touched. Answers the next position; the pair count"
           "in s[VM_FASTM], the last key in s[VM_FASTP], s[VM_FASTK], the next"
           "key-table bound in s[VM_FASTL].")
  (let [pools (m-pools p mt)
        pso (ia p (+ pools 4))
        arec (m-alts p mt)
        aso (ia p (+ arec 4))
        lits (m-lits p mt)
        keys (m-keys p mt)
        names (m-names p mt)
        nkm (ia p (+ mt 4))
        go (group-rec p (ia p (+ pools 1)))
        maxit (ia s O_MAX_ITEMS)
        ^:mut klb 0
        ^:mut vleaf2 (neg 1)
        ^:mut q q0
        ^:mut k 0
        ^:mut ps ps0
        ^:mut pe pe0
        ^:mut klo klo0]
    (if (== mode 2)
      (do (set klb (+ (ia p H_S_LEAVES) (* 8 (single-leaf p (ia p (+ go 2))))))
          (set vleaf2 (single-leaf p (ia p (+ go 3))))))
    (while (and (< k limit) (< q end))
      (let [start q
            ib (u8 b start)
            ai (bit-and ib 31)
            ^:mut kh 1
            ^:mut kl ai
            ^:mut cur (ia s (+ bo 2))
            ^:mut steps 0
            ^:mut lrec 0
            ^:mut lit 0
            ^:mut vend 0
            ^:mut vunits 0]
        (local ^I32 vlf)
        (comment "the key: text, a valid head, present, UTF-8, ascending")
        (if (!= (ushr ib 5) 3) (break))
        (if (> ai 27) (break))
        (if (>= ai 24)
          (do (set kh (+ 1 (shl 1 (- ai 24))))
              (if (or (> kh 3) (> kh (- end start))) (break))
              (if (== ai 24) (set kl (u8 b (+ start 1))))
              (if (== ai 25) (set kl (be16 b (+ start 1))))
              (if (and (== ai 24) (< kl 24)) (break))
              (if (and (== ai 25) (< kl 256)) (break))))
        (if (> kl (- end (+ start kh))) (break))
        (if (> (+ (ia s O_ITEMS) 2) maxit) (break))
        (if (>= (utf8-invalid-at b (+ start kh) (+ (+ start kh) kl) (text-nc s)) 0) (break))
        (let [kend (+ (+ start kh) kl)]
          (if (>= ps 0) (if (>= (compare-spans b ps pe start kend) 0) (break)))
          (let [kid (key-probe p pool b s start kend klo)
                sk (ia s O_LO)
                nlo (ia s O_HI)]
            (if (== mode 1)
              (do (if (>= kid 0)
                    (while (and (< cur nkm) (< (ia p (+ keys (* 4 cur))) kid))
                      (set cur (+ cur 1))
                      (set steps (+ steps 1))))
                  (if (or (< kid 0) (or (>= cur nkm) (!= (ia p (+ keys (* 4 cur))) kid))) (break))
                  (if (!= (ia p (+ (+ keys (* 4 cur)) 3)) 1) (break))
                  (set lit (ia p (+ (+ names (* 2 (ia p (+ (+ keys (* 4 cur)) 2)))) 1)))
                  (set lrec (+ lits (* 4 lit)))
                  (set vlf (single-leaf p (ia p (+ lrec 1))))
                  (if (not (streak-kind p vlf)) (break)))
              (do (if (or (< kl (ia p (+ klb 2))) (> kl (ia p (+ klb 3)))) (break))
                  (set vlf vleaf2)))
            (comment "the value, unless under `any`")
            (let [vlb (+ (ia p H_S_LEAVES) (* 8 vlf))
                  vkind (bit-and (ia p vlb) 255)
                  vany (== vkind K_ANY)]
              (if (not vany)
                (do (set vend (pre-scalar p pool b s kend end vlb vkind))
                    (if (< vend 0) (break))
                    (set vunits (ia s O_LO))))
              (comment "commit, in the generic order")
              (let [^:mut ko 0
                    ^:mut ka (+ (+ sk 1) steps)
                    ^:mut kb (+ 1 (c64 kl))]
                (if (>= ps 0) (set ko (c64min (- pe ps) (- kend start))))
                (if (== mode 2) (do (set ka (+ ka 1)) (set kb (+ kb 2))))
                (comment "schedule 2 (D045): the pair costs 1 (no steps, no key element),"
                         "a one-leaf key or value no filter and leaf units, nothing else")
                (if (== s2 1)
                  (do (set ka (+ sk 1))
                      (if (== mode 2) (set kb (- kb 2)))))
                (if (not (charge s ka pos)) (return (neg R_BUDGET)))
                (comment "the visit, then the count, then the rest: the item count is"
                         "observable, so no merge crosses it")
                (if (not (charge s 1 start)) (return (neg R_BUDGET)))
                (iset s O_ITEMS (+ (ia s O_ITEMS) 1))
                (if (not (charge s (+ (- kb 1) ko) start)) (return (neg R_BUDGET)))
                (if (not (charge s (* (- 1 s2) (+ 2 (* 2 (- mode 1)))) pos)) (return (neg R_BUDGET)))
                (if vany
                  (do (let [^I32 rv (fast-child p pool b s kend (+ d 1) cfb cck cw vlf end (simple-leaf p s2 vlf))]
                        (if (< rv 0) (return rv))
                        (set vend rv)))
                  (do (if (not (charge s 1 kend)) (return (neg R_BUDGET)))
                      (iset s O_ITEMS (+ (ia s O_ITEMS) 1))
                      (if (not (charge s (- (- vunits 1) (* 2 s2)) kend)) (return (neg R_BUDGET)))))
                (if (not (charge s (* (- 1 s2) (- 6 mode)) pos)) (return (neg R_BUDGET)))
                (if (== mode 1)
                  (do (let [li (- lit (ia p (+ arec 1)))
                            wd (+ (+ (+ bo aso) 3) (sar li 5))]
                        (iset s (+ bo 2) cur)
                        (iset s wd (bit-or (ia s wd) (shl 1 (bit-and li 31))))
                        (iset s (+ (+ bo aso) 2) (+ (ia s (+ (+ bo aso) 2)) (ia p (+ lrec 2))))
                        (iset s (+ (+ bo aso) 1) (+ (ia s (+ (+ bo aso) 1)) 1))
                        (iset s (+ bo pso) (+ (ia s (+ bo pso)) 1)))))
                (set ps start)
                (set pe kend)
                (set klo nlo)
                (set q vend)
                (set k (+ k 1))))))))
    (iset s VM_FASTM k)
    (iset s VM_FASTP ps)
    (iset s VM_FASTK pe)
    (iset s VM_FASTL klo)
    (if (> k 0) (wit-clear s))
    (return q)))

(defn ^:pub ^I32 map-alive [^IntsR p ^IntsR s ^I32 fb ^I32 area ^I32 nb]
  (let [^:mut bo area
        ^:mut k 0]
    (for [^I32 _bi 0 nb]
      (if (!= (ia s (+ bo 1)) 0) (set k (+ k 1)))
      (set bo (+ bo (ia p (+ (block-mt p s fb bo) 6)))))
    (return k)))

(defn ^:pub ^I32 eval-map [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q0 ^I32 n
                           ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (comment "A map item (§8.3) after its head and container checks. Per pair: the"
           "scanner's key checks; the key search, cursors, the key's query (key"
           "typesets of live residual pools), the key, its order; the key phase"
           "(candidates); the value with the candidates' value typesets; the"
           "update. At the end, satisfaction, then witness rules 3/4/1.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cap (- fw (* 2 w))
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        cose (and (== d 0) (!= (ia s O_COSE) 0))
        ^:mut nb 0
        ^:mut used 0
        ^:mut ccap 0
        ^:mut q q0
        ^:mut ps (neg 1)
        ^:mut pe (neg 1)
        ^:mut klo 0
        ^:mut fmode 0
        ^:mut smap 0
        ^:mut smode 0
        ^:mut pk 0
        ^:mut unsat 0]
    (local ^:mut ^I32 nalive)
    (let [na (q-filter-x p s fb w nq 32 pos ctx)]
      (if (< na 0) (return na)))
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_MAP))
        (do (let [mt (leaf-map p (q-leaf-base p s fb i))
                  sw (ia p (+ mt 6))]
              (if (> (+ used sw) cap) (return (neg R_INCONSISTENT)))
              (let [ri (map-block-init p s (+ area used) i mt pos)]
                (if (< ri 0) (return ri)))
              (set used (+ used sw))
              (set ccap (+ ccap (ia p (+ mt 7))))
              (set nb (+ nb 1))))))
    (if (> (+ used (* 4 ccap)) cap) (return (neg R_INCONSISTENT)))
    (set nalive nb)
    (if (== nb 1) (set smap (map-fast-mode p (block-mt p s fb area))))
    (if (== (bit-and (ia s VM_GENERIC) 1) 0) (set fmode smap))
    (if (== fmode 1) (set smode 1))
    (if (== fmode 2)
      (do (let [gom (group-rec p (ia p (+ (m-pools p (block-mt p s fb area)) 1)))
                kfl (single-leaf p (ia p (+ gom 2)))
                vfl (single-leaf p (ia p (+ gom 3)))
                klbm (+ (ia p H_S_LEAVES) (* 8 kfl))]
            (if (and (and (== (bit-and (ia p klbm) 255) K_TEXT) (< (ia p (+ klbm 4)) 0))
                     (or (== (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 vfl))) 255) K_ANY) (streak-kind p vfl)))
              (set smode 2)))))
    (let [cl (+ area used)
          pend (count-pending p s fb w nq)]
      (while (< pk n)
        (if (and (> smode 0) (> nalive 0))
          (do (let [^I32 qm (map-streak p pool b s pos q (- n pk) end d area (block-mt p s fb area) smode
                                        cfb cck cw ps pe klo (if-s2 s))
                    km2 (ia s VM_FASTM)]
                (if (< qm 0) (return qm))
                (if (> km2 0)
                  (do (set q qm)
                      (set ps (ia s VM_FASTP))
                      (set pe (ia s VM_FASTK))
                      (set klo (ia s VM_FASTL))
                      (set pk (+ pk km2)))))))
        (if (< pk n)
        (let [start q]
          (if (>= start end) (return (fail s start CODE_TRUNCATED)))
          (let [km (ushr (u8 b start) 5)]
            (if (!= km 3)
              (if (not (key-peek s km cose)) (return (fail s start CODE_KEY_TYPE))))
            (if (== nalive 0)
              (do (set q (dead-item b s start (+ d 1) end))
                  (if (< q 0) (return q))
                  (if (<= km 1)
                    (if (not (key-label b s start km)) (return (fail s start CODE_KEY_TYPE))))
                  (let [kod (key-order b s ps pe start q)]
                    (if (< kod 0) (return kod)))
                  (set ps start)
                  (set pe q)
                  (set q (dead-item b s q (+ d 1) end))
                  (if (< q 0) (return q)))
              (do (let [ke (key-span-end b start end)
                        ^:mut kid (neg 1)
                        ^:mut cnq 0
                        ^:mut nc 0
                        ^:mut named false
                        ^:mut vnq 0
                        ^:mut ps2 0
                        ^:mut still 0]
                    (local ^I32 kq)
                    (local ^I32 vq)
                    (local ^:mut ^I32 bo)
                    (comment "The key's id in the schema-wide key table.")
                    (if (> ke start)
                      (do (set kid (key-search p pool b s start ke klo pos))
                          (if (== kid (neg 2)) (return (neg R_BUDGET)))
                          (set klo (ia s O_HI))))
                    (comment "Cursors: 1 unit per block, 1 per cursor step (a fast-mode map"
                             "here; otherwise fused with the key query below: charges at"
                             "one offset with no check between may be reordered).")
                    (if (> smap 0)
                      (do (comment "the cursor first, uncharged, to decide schedule 2's simple"
                                   "pair (D045 ii); then block 1 + steps, or the pair's 1 unit,"
                                   "merged at the map's offset")
                          (let [c0 (ia s (+ area 2))
                                mt0 (block-mt p s fb area)]
                            (free-on s)
                            (map-cursor p s area mt0 kid pos)
                            (free-off s)
                            (if (and (sched2 s) (map-pair-ok p s area mt0 kid smap))
                              (do (set ps2 1)
                                  (if (not (charge s 1 pos)) (return (neg R_BUDGET))))
                              (if (not (charge s (+ 1 (- (ia s (+ area 2)) c0)) pos)) (return (neg R_BUDGET)))))))
                    (if (and (> fmode 0) (map-pair-ok p s area (block-mt p s fb area) kid fmode))
                      (do (let [^I32 vf (map-pair-fast p pool b s pos start km ps pe end d fb w area
                                                       (block-mt p s fb area) cfb cck cw kid pend fmode ps2)]
                            (if (< vf 0) (return vf))
                            (set ps start)
                            (set pe (ia s VM_FASTK))
                            (if (== (ia s (+ area 1)) 0) (set nalive 0))
                            (set q vf)))
                      (do
                    (comment "The key, queried with the live residual key typesets.")
                    (if (== ps2 1) (free-on s))
                    (let [e (new-epoch s)]
                      (set bo area)
                      (for [^I32 _bj 0 nb]
                        (let [mtj (block-mt p s fb bo)]
                          (if (== smap 0)
                            (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                                (if (!= (ia s (+ bo 1)) 0)
                                  (do (let [rc2 (map-cursor p s bo mtj kid pos)]
                                        (if (< rc2 0) (return rc2)))))))
                          (if (!= (ia s (+ bo 1)) 0)
                            (do (set cnq (map-key-query p s bo mtj cfb cw cnq e pos))
                                (if (< cnq 0) (return cnq))))
                          (set bo (+ bo (ia p (+ mtj 6)))))))
                    (free-off s)
                    (if (> cnq 0)
                      (set kq (eval-item p pool b s start (+ d 1) cfb cck cnq end
                                         (bit-or CTX_KEY (simple-of p s ps2 cfb cnq))))
                      (set kq (dead-item b s start (+ d 1) end)))
                    (if (< kq 0) (return kq))
                    (if (<= km 1)
                      (if (not (key-label b s start km)) (return (fail s start CODE_KEY_TYPE))))
                    (let [ko (key-order b s ps pe start kq)]
                      (if (< ko 0) (return ko)))
                    (set ps start)
                    (set pe kq)
                    (comment "Key phase: candidates.")
                    (if (== ps2 1) (free-on s))
                    (let [ek (q-stamp s cfb cw cnq pos)]
                      (if (< ek 0) (return ek))
                      (set bo area)
                      (for [^I32 _bk 0 nb]
                        (let [mtk (block-mt p s fb bo)]
                          (if (!= (ia s (+ bo 1)) 0)
                            (do (if (simple-struct p mtk)
                                  (set nc (key-phase-struct p s bo mtk kid cl nc ccap pos))
                                  (set nc (map-key-phase p s bo mtk kid ek cl nc ccap pos)))
                                (if (< nc 0) (return nc))))
                          (set bo (+ bo (ia p (+ mtk 6)))))))
                    (for [^I32 c 0 nc]
                      (if (== (bit-and (ia s (+ (+ cl (* 4 c)) 1)) 1) 0) (set named true)))
                    (if named (path-put s (+ d 1) P_KEY kid) (path-put s (+ d 1) P_ANYKEY 0))
                    (comment "The value, queried with the candidates' value typesets.")
                    (let [e2 (new-epoch s)]
                      (for [^I32 c2 0 nc]
                        (let [vts (cand-vts p s fb cl c2)]
                          (set vnq (q-add p s cfb cw vnq vts e2 pos)))
                        (if (< vnq 0) (return vnq))))
                    (free-off s)
                    (if (> vnq 0)
                      (set vq (eval-item p pool b s kq (+ d 1) cfb cck vnq end (simple-of p s ps2 cfb vnq)))
                      (set vq (dead-item b s kq (+ d 1) end)))
                    (if (< vq 0) (return vq))
                    (if (== ps2 1) (free-on s))
                    (comment "Update: each candidate (1 unit + its value test), then"
                             "each alive block.")
                    (let [ev (q-stamp s cfb cw vnq pos)]
                      (if (< ev 0) (return ev))
                      (set bo area)
                      (for [^I32 _bl 0 nb]
                      (let [mtl (block-mt p s fb bo)]
                        (if (!= (ia s (+ bo 1)) 0)
                          (do (comment "this block's candidates (contiguous), 1 unit + its"
                                       "value test each, then its update")
                              (let [^:mut c3 (ia s (+ bo 3))]
                                (while (and (< c3 nc) (== (ia s (+ cl (* 4 c3))) bo))
                                  (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                                  (let [vts3 (cand-vts-mt p s mtl cl c3)
                                        t (ts-test p s vts3 ev pos)]
                                    (if (< t 0) (return t))
                                    (if (== t 1)
                                      (do (let [kw (+ (+ cl (* 4 c3)) 1)]
                                            (iset s kw (bit-or (ia s kw) 2))))))
                                  (set c3 (+ c3 1))))
                              (let [ss (simple-struct p mtl)]
                                (local ^I32 u)
                                (if ss
                                  (set u (update-struct p s bo mtl kid cl nc pos))
                                  (set u (map-update p s bo mtl kid cl nc pos)))
                                (if (< u 0) (return u))
                                (if (== u 1)
                                  (set still (+ still 1))
                                  (do (set nalive (- nalive 1))
                                      (if (block-named s bo cl nc)
                                        (q-set-flag s fb w (ia s bo) (shl R_VALUE 8))
                                        (q-set-flag s fb w (ia s bo) (shl R_UNEXPECTED 8))))))))
                        (set bo (+ bo (ia p (+ mtl 6)))))))
                    (free-off s)
                    (if (or (> still 0) (> pend 0))
                      (wit-clear s)
                      (if (wit-empty s)
                        (if named
                          (wit-set s R_VALUE 0 (+ d 1) (neg 1) 0 start)
                          (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 start))))
                    (set q vq)))))))))
        (set pk (+ pk 1))))
    (comment "The end: 1 unit per block; alive blocks + 1 per alternative and pool.")
    (let [^:mut be area
          ^:mut best (neg 1)
          ^:mut bestbo 0]
      (for [^I32 _bm 0 nb]
        (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
        (let [mtm (block-mt p s fb be)]
          (if (!= (ia s (+ be 1)) 0)
            (do (if (not (charge s (+ (ia p (+ mtm 2)) (ia p (+ mtm 1))) pos)) (return (neg R_BUDGET)))
                (if (map-satisfied p s be mtm)
                  (q-set-flag s fb w (ia s be) F_MATCHED)
                  (do (q-set-flag s fb w (ia s be) (shl R_MISSING 8))
                      (set unsat (+ unsat 1))
                      (let [lid (ia s (+ fb (ia s be)))]
                        (if (or (< best 0) (< lid best))
                          (do (set best lid) (set bestbo be))))))))
          (set be (+ be (ia p (+ mtm 6))))))
      (let [rs (eval-scalars p pool b s fb w nq pos q0 q 32 0 n (unit-of ctx))]
        (if (< rs 0) (return rs)))
      (let [m (finish-comb p s fb w nq pos)]
        (if (< m 0) (return m))
        (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
          (if (> unsat 0)
            (do (let [mtb (block-mt p s fb bestbo)
                      r4 (map-missing p s bestbo mtb d pos)]
                  (if (< r4 0) (return r4))))
            (do (let [r1 (rule1 s fb w nq d pos)]
                  (if (< r1 0) (return r1))))))))
    (return q)))

;; ------------------------------------------------------------ the item

(defn ^:pub ^I32 eval-item [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 d ^I32 fb ^I32 ck
                            ^I32 nq ^I32 end ^I32 ctx]
  (comment "One LIVE item at pos, physical depth d, query list (nq > 0 entries) in the"
           "frame at fb: visit (1 unit), counted, then its head -- the scanner's"
           "`item`, with the schema evaluated alongside.")
  (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
  (let [it (+ (ia s O_ITEMS) 1)]
    (iset s O_ITEMS it)
    (if (> it (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
  (if (>= pos end) (return (fail s pos CODE_TRUNCATED)))
  (let [ib (u8 b pos)
        major (ushr ib 5)
        ai (bit-and ib 31)
        cr (cset-rec p s ck)
        w (cset-width p cr)
        ^:mut hi 0
        ^:mut lo ai
        ^:mut q (+ pos 1)]
    (local ^:mut ^I32 stop)
    (if (< cr 0) (return (neg R_INCONSISTENT)))
    (if (>= ai 24)
      (do (if (== major 7)
            (if (and (>= ai 25) (<= ai 27))
              (do (set stop (scan-float b s pos ai end))
                  (if (< stop 0) (return stop))
                  (let [nf (q-filter-x p s fb w nq (item-cls 7 ai 0 0) pos ctx)]
                    (if (< nf 0) (return nf)))
                  (let [rf (eval-scalars p pool b s fb w nq pos (+ pos 1) stop (item-cls 7 ai 0 0) 0 0 (unit-of ctx))]
                    (if (< rf 0) (return rf)))
                  (let [ff (finish-scalar p s fb w nq d pos ctx)]
                    (if (< ff 0) (return ff)))
                  (return stop))))
          (set q (read-arg b s pos ai end))
          (if (< q 0) (return q))
          (set hi (ia s O_HI))
          (set lo (ia s O_LO))))
    (if (== major 4)
      (do (let [ra (enter-container s pos q hi lo d 0 end)]
            (if (< ra 0) (return ra)))
          (return (eval-array p pool b s pos q lo d fb ck nq end ctx))))
    (if (== major 5)
      (do (let [rm (enter-container s pos q hi lo d 1 end)]
            (if (< rm 0) (return rm)))
          (return (eval-map p pool b s pos q lo d fb ck nq end ctx))))
    (if (== major 6) (return (eval-tag p pool b s pos q hi lo d fb ck nq end ctx)))
    (set stop q)
    (if (== major 2)
      (do (set stop (take-len s pos q hi lo end))
          (if (< stop 0) (return stop))
          (let [rb (bstr-tail p pool b s pos q stop d fb ck nq ctx)]
            (if (< rb 0) (return rb)))
          (return stop)))
    (if (== major 3)
      (do (set stop (take-len s pos q hi lo end))
          (if (< stop 0) (return stop))
          (if (not (charge s (c64 (- stop q)) pos)) (return (neg R_BUDGET)))
          (let [bad (utf8-invalid-at b q stop (text-nc s))]
            (if (>= bad 0) (return (fail s bad CODE_TEXT))))))
    (if (== major 7)
      (do (let [r7 (scan-simple s pos ai)]
            (if (< r7 0) (return r7)))))
    (let [cls (item-cls major ai hi lo)
          nf2 (q-filter-x p s fb w nq cls pos ctx)]
      (if (< nf2 0) (return nf2))
      (let [r2 (eval-scalars p pool b s fb w nq pos q stop cls hi lo (unit-of ctx))]
        (if (< r2 0) (return r2)))
      (let [f2 (finish-scalar p s fb w nq d pos ctx)]
        (if (< f2 0) (return f2)))
      (return stop))))

