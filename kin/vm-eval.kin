;; The LIVE walk (program.md §8, §9): one item evaluated against its query list
;; Q' in the frame of its physical depth, fused with the profile checks of
;; kin/scan.kin in the scanner's order (docs/scanner.md). Children get their
;; query lists in the next frame; a child whose query is empty is walked dead
;; (snug.vm.dead), which is also the profile-only continuation after a schema
;; failure (architecture §4.5).
;;
;; Every function answers a position (>= 0) or a negated code (profile code,
;; R_BUDGET, R_INCONSISTENT). A schema failure is not a code: it is the absence
;; of matched answers plus the witness slot.
;;
;; Readings of program.md recorded in DEVLOG (D040-D042): ANY and MAJOR give
;; their children no query (children are walked dead); a container's "live
;; candidate" for witness clearing is an alive block or an admitted scalar
;; leaf (ANY, MAJOR, LIT, ...); leaf failure reasons for containers are
;; `unexpected`/`value` (died at a pair or element) and `missing` (at the end).
(ns snug.vm.eval
  (:require [kin.lang :refer [defn let local return set if while for do comment declarefn break defconst]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR Ext + - * neg shl sar ushr bit-and bit-or bit-xor
                               < > <= >= == != and or not u8 ia iset blen ext-call]]
            [snug.cbor.codes :refer [CODE_TRUNCATED CODE_KEY_TYPE CODE_TAG CODE_DEPTH
                                     CODE_NON_SHORTEST CODE_INDEFINITE CODE_KEY_ORDER PF_VREL PF_CANON
                                     CODE_TOO_MANY_ITEMS CODE_DECIMAL CODE_NDARRAY CODE_TRAILING
                                     O_COSE O_MAX_DEPTH O_MAX_ITEMS O_ITEMS O_HI O_LO O_CSTART
                                     O_ERR_POS O_PROFILE]]
            [snug.cbor.head :refer [fail read-arg take-len enter-container be16 be32]]
            [snug.cbor.text :refer [utf8-invalid-at]]
            [snug.cbor.keys :refer [compare-spans]]
            [snug.cbor.tags :refer [typed-size]]
            [snug.cbor.scan :refer [scan-float scan-simple key-peek key-label text-bad]]
            [snug.cbor.stdtags :refer [std-allowed any-tags rule-tag]]
            [snug.vm.layout :refer [H_FLAGS H_S_LEAVES FL_EMBED FL_COMB FL_EXT K_TAG K_TAGSET K_EMBED
                                    K_ARRAY K_MAP K_AND K_NOT K_EXT R_CONTROL R_CONTROL_SIZE F_ANSWER F_ADMITTED F_MATCHED F_EVAL
                                    VM_QIDX VM_Q1 VM_BIGNUM_MAX VM_EMBED VM_D VM_DLIM VM_W_STATE
                                    VM_W_REASON VM_W_SUB SCRATCH_MARK R_TYPE R_MISSING R_UNEXPECTED
                                    R_VALUE R_TAG R_EMBEDDED R_BUDGET R_INCONSISTENT P_INDEX P_KEY
                                    P_ANYKEY P_TAG P_EMBED P_EMBEDSEQ CTX_KEY CTX_SIMPLE VM_GENERIC VM_FASTM
                                    INF H_S_TS_INDEX H_S_INTERVALS K_INT K_TEXT
                                    R_RANGE R_SIZE VM_BUDGET VM_FASTK K_ANY K_MAJOR
                                    VM_FASTP VM_FASTL VM_POS R_NONDET VM_VTAB PEG_HDR P_REP P_ENTRY R_GROUP_LIMIT R_AGROW G_FORCED G_NOSTREAK
                                    P_MEMBER TIER_F]]
            [snug.vm.base :refer [charge c8 c64min new-epoch sched2 free-on free-off q-add q-filter q-stamp ts-test q-flag q-set-flag
                                  q-kind q-leaf-base cset-rec next-ck cset-width cset-frame
                                  wit-empty wit-clear wit-set path-put rule1]]
            [snug.vm.dead :refer [head-fail dead-item dead-seq key-order dead-int-streak dead-map-pairs dead-array-elems dead-typed dead-bignum
                                  pair-check decimal-check ndarray-check dead-std-check vtab-find
                                  pair-walk pair-count replay-end replay-key]]
            [snug.vm.leaf :refer [eval-scalars scalar-kind cmp-u64 eval-leaf cmp-point]]
            [snug.vm.arena :refer [arena-up-top arena-set-up]]
            [snug.vm.array :refer [AB_ALIVE AB_EVK AB_NACT AB_STATUS AB_MODE AB_SP AB_PC AB_IDX AB_HDR AB_DIED
                                   a-run aev leaf-array block-ao apeg array-words array-block-init
                                   array-records array-mark array-candidates array-advance array-end
                                   array-witness]]
            [snug.vm.map :refer [MB_ALIVE MB_NC MB_NJ MB_CUR MB_CF MB_NP MB_HDR MW key-probe MB_E0 MB_E1 MB_E2 leaf-map block-mt mpeg m-named m-namers
                                 m-member map-words map-block-init map-records map-mark map-unordered
                                 map-is-unordered map-key-ecs key-span-end key-search map-cursor
                                 map-key-query map-key-phase cand-vts map-values map-update
                                 map-end-block]]))

(declarefn eval-item eval-embed eval-array)

;; ------------------------------------------------------------ item endings

(defn ^:pub ^I32 unit-of [^I32 ctx]
  (comment "The per-leaf unit of eval-scalars: 0 for schedule 2's one-leaf child.")
  (if (!= (bit-and ctx CTX_SIMPLE) 0) (return 0))
  (return 1))

(defn ^:pub ^I32 simple-of [^IntsR p ^IntsR s ^I32 on ^I32 cfb ^I32 cnq]
  (comment "CTX_SIMPLE when schedule 2's simple pair (on = 1) queries its child with"
           "exactly one entry, a scalar answer leaf (D045 iii), else 0.")
  (if (or (!= on 1) (!= cnq 1)) (return 0))
  (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 (ia s cfb)))) 255)) (return CTX_SIMPLE))
  (return 0))

(defn ^:pub ^I32 simple-leaf [^IntsR p ^I32 on ^I32 leaf]
  (comment "CTX_SIMPLE for schedule 2's one-leaf child when the leaf is scalar.")
  (if (or (!= on 1) (< leaf 0)) (return 0))
  (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 leaf))) 255)) (return CTX_SIMPLE))
  (return 0))

(defn ^:pub ^I32 if-s2 [^IntsR s]
  (if (sched2 s) (return 1))
  (return 0))

(defn ^:pub ^I32 q-filter-x [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 cls ^I32 pos ^I32 ctx]
  (comment "q-filter; its |Q'| units free for schedule 2's one-leaf child (D045).")
  (if (!= (bit-and ctx CTX_SIMPLE) 0)
    (do (free-on s)
        (let [r (q-filter p s fb w nq cls pos)]
          (free-off s)
          (return r))))
  (return (q-filter p s fb w nq cls pos)))

(defconst ^:pub ^I32 EXT_CALL 16)

(defn ^:pub ^I32 ext-eval [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 fb ^I32 w ^I32 l ^I32 pos
                           ^I32 end ^I32 e ^Ext ext]
  (comment "EXT leaf l (D140, D190) on the item [pos, end) of b, once per item, when a"
           "combinator needs it: longer than its maximum (d3) -> R_CONTROL_SIZE for 1"
           "unit, without asking; else 1 + EXT_CALL units, then the host predicate"
           "(id d0, argument pool[d1, d1 + d2)) is asked with the budget that remains"
           "(`room`) and answers a verdict word: u >= 0 matched after u units, -2 - u"
           "refused after u units, -1 more than `room` (budget). u is charged; a"
           "generic control meters its own work (snug.vm.controls), a host predicate"
           "its declared cost, by default one unit per item byte, before it runs."
           "MATCHED (stamped in epoch e) or R_CONTROL. A walk that cannot hold the"
           "item whole never gets here with one that fits (the session asks for it"
           "whole); -inconsistent if so. 0 or a negated code.")
  (let [qi (ia s VM_QIDX)
        j (ia s (+ qi l))
        fl0 (+ fb w)
        f (ia s (+ fl0 j))
        lb (+ (ia p H_S_LEAVES) (* 8 l))
        n (- end pos)]
    (if (!= (bit-and f (bit-or F_MATCHED (shl 255 8))) 0) (return 0))
    (if (== (bit-and f F_ADMITTED) 0) (return 0))
    (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
    (if (> n (ia p (+ lb 5)))
      (do (iset s (+ fl0 j) (bit-or f (shl R_CONTROL_SIZE 8)))
          (return 0)))
    (if (or (< pos 0) (> end (blen b))) (return (neg R_INCONSISTENT)))
    (if (not (charge s EXT_CALL pos)) (return (neg R_BUDGET)))
    (let [room (ia s VM_BUDGET)
          r (ext-call ext (ia p (+ lb 2)) pool (ia p (+ lb 3)) (ia p (+ lb 4)) b pos end room)
          ^:mut u r]
      (if (< r (neg 1)) (set u (- (neg 2) r)))
      (if (or (== r (neg 1)) (> u room))
        (do (iset s VM_POS pos) (return (neg R_BUDGET))))
      (if (not (charge s u pos)) (return (neg R_BUDGET)))
      (if (>= r 0)
        (do (iset s (+ fl0 j) (bit-or f F_MATCHED))
            (iset s (+ SCRATCH_MARK l) e))
        (iset s (+ fl0 j) (bit-or f (shl R_CONTROL 8)))))
    (return 0)))

(defn ^:pub ^I32 leaf-kind-of [^IntsR p ^I32 l]
  (return (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 l))) 255)))

(defn ^:pub ^I32 finish-comb [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 pos ^I32 end ^Ext ext]
  (comment "Combinators of the item (§8.4): stamp its matched leaves in a fresh"
           "epoch, then one pass in query order evaluates each admitted AND"
           "(both operands) and NOT (target and not the literal), 2 units each."
           "An EXT operand (D140) is decided when first needed: an AND's first"
           "operand, and its second only once the first matched; a NOT's target."
           "Answers 1 if some answer leaf matched, 0 if none, or a code.")
  (if (!= (bit-and (ia p H_FLAGS) FL_COMB) 0)
    (do (let [e (new-epoch s)
              qi (ia s VM_QIDX)
              fl0 (+ fb w)]
          (for [^I32 i 0 nq]
            (let [l (ia s (+ fb i))]
              (iset s (+ qi l) i)
              (if (!= (bit-and (ia s (+ fl0 i)) F_MATCHED) 0)
                (iset s (+ SCRATCH_MARK l) e))))
          (for [^I32 j 0 nq]
            (let [kind (q-kind p s fb j)
                  f (ia s (+ fl0 j))]
              (if (and (or (== kind K_AND) (== kind K_NOT)) (!= (bit-and f F_ADMITTED) 0))
                (do (if (not (charge s 2 pos)) (return (neg R_BUDGET)))
                    (if (!= (bit-and (ia p H_FLAGS) FL_EXT) 0)
                      (do (let [lb0 (q-leaf-base p s fb j)
                                a0 (ia p (+ lb0 2))
                                c0 (ia p (+ lb0 3))]
                            (if (== (leaf-kind-of p a0) K_EXT)
                              (do (let [ra0 (ext-eval p pool b s fb w a0 pos end e ext)]
                                    (if (< ra0 0) (return ra0)))))
                            (if (and (== kind K_AND)
                                     (and (== (ia s (+ SCRATCH_MARK a0)) e) (== (leaf-kind-of p c0) K_EXT)))
                              (do (let [rc0 (ext-eval p pool b s fb w c0 pos end e ext)]
                                    (if (< rc0 0) (return rc0))))))))
                    (let [lb (q-leaf-base p s fb j)
                          a (ia p (+ lb 2))
                          c (ia p (+ lb 3))
                          ma (== (ia s (+ SCRATCH_MARK a)) e)
                          mc (== (ia s (+ SCRATCH_MARK c)) e)
                          ra (bit-and (ia s (+ fl0 (ia s (+ qi a)))) (shl 255 8))
                          rc (bit-and (ia s (+ fl0 (ia s (+ qi c)))) (shl 255 8))
                          ok (or (and (== kind K_AND) (and ma mc))
                                 (and (== kind K_NOT) (and ma (not mc))))
                          ^:mut why ra]
                      (if ma
                        (if (== kind K_AND) (set why rc) (set why (shl R_VALUE 8))))
                      (if (== why 0) (set why (shl R_TYPE 8)))
                      (if ok
                        (do (iset s (+ fl0 j) (bit-or f F_MATCHED))
                            (let [lj (ia s (+ fb j))]
                              (iset s (+ SCRATCH_MARK lj) e)))
                        (iset s (+ fl0 j) (bit-or f why)))))))))))
  (for [^I32 k 0 nq]
    (if (== (bit-and (ia s (+ (+ fb w) k)) (+ F_ANSWER F_MATCHED)) (+ F_ANSWER F_MATCHED))
      (return 1)))
  (return 0))

(defn ^:pub ^I32 finish-scalar [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 d ^I32 pos ^I32 end ^I32 ctx ^Ext ext]
  (comment "End of an item that is not a container: combinators, then witness rule 1"
           "if no answer matched (never for a map key, §9.2 rule 6).")
  (let [m (finish-comb p pool b s fb w nq pos end ext)]
    (if (< m 0) (return m))
    (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
      (return (rule1 s fb w nq d pos)))
    (return 0)))

(defn ^:pub ^I32 count-pending [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq]
  (comment "Admitted scalar leaves (ANY, MAJOR, LIT, ...) of a container item: live"
           "candidates until its end.")
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (if (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0)
        (if (scalar-kind (q-kind p s fb i)) (set k (+ k 1)))))
    (return k)))

;; ------------------------------------------------------------ byte strings and EMBED

(defn ^:pub ^I32 bstr-tail [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 cs ^I32 ce
                            ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 ctx ^Ext ext]
  (comment "A byte string item at pos (content [cs, ce)) at depth d, after its"
           "profile checks: filter, scalar leaves, EMBED sub-validations, end.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        na (q-filter-x p s fb w nq 4 pos ctx)]
    (if (< na 0) (return na))
    (let [r1 (eval-scalars p pool b s fb w nq pos cs ce 4 0 0 (unit-of ctx))]
      (if (< r1 0) (return r1)))
    (if (!= (bit-and (ia p H_FLAGS) FL_EMBED) 0)
      (do (let [^:mut ne 0]
            (for [^I32 i 0 nq]
              (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_EMBED))
                (set ne (+ ne 1))))
            (if (> ne 0)
              (do (let [^I32 r2 (eval-embed p pool b s pos cs ce d fb ck nq ext)]
                    (if (< r2 0) (return r2))))))))
    (return (finish-scalar p pool b s fb w nq d pos ce ctx ext))))

(defn ^:pub ^I32 embed-kill [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 nq ^I32 seq]
  (comment "Kill the live EMBED leaves of one kind (seq 1 `.cborseq`, 0 `.cbor`).")
  (for [^I32 i 0 nq]
    (let [f (q-flag s fb w i)]
      (if (and (!= (bit-and f F_EVAL) 0) (== (q-kind p s fb i) K_EMBED))
        (if (== (sar (bit-and (ia p (q-leaf-base p s fb i)) 256) 8) seq)
          (iset s (+ (+ fb w) i) (bit-or (bit-and f (bit-xor F_EVAL (neg 1))) (shl R_EMBEDDED 8)))))))
  (return 0))

(defn ^:pub ^I32 count-matched-scalars [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq]
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (let [f (q-flag s fb w i)]
        (if (== (bit-and f (+ F_ADMITTED F_MATCHED)) (+ F_ADMITTED F_MATCHED))
          (if (scalar-kind (q-kind p s fb i)) (set k (+ k 1))))))
    (return k)))

(defn ^:pub ^I32 embed-live [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq ^I32 seq]
  (comment "How many EMBED leaves of this kind (seq 1: `.cborseq`, 0: `.cbor`) are"
           "still live (F_EVAL).")
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (let [f (q-flag s fb w i)]
        (if (and (!= (bit-and f F_EVAL) 0) (== (q-kind p s fb i) K_EMBED))
          (if (== (sar (bit-and (ia p (q-leaf-base p s fb i)) 256) 8) seq) (set k (+ k 1))))))
    (return k)))

(defn ^:pub ^I32 embed-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 cs ^I32 ce ^I32 d ^I32 fb
                            ^I32 ck ^I32 nq ^I32 seq ^I32 pos ^Ext ext]
  (comment "One sub-validation of the content [cs, ce) for the live EMBED leaves of"
           "one kind. `.cbor` (seq 0): one item at physical depth d + 1 queried with"
           "their content typesets, which must end at ce (else inner trailing)."
           "`.cborseq` (seq 1, D040): the sequence is the element list of a VIRTUAL"
           "array item at depth d + 1 queried with their content typesets (the"
           "control type is an array type), its items at depth d + 2. Own item"
           "counter, depth limit min(limit, D - root depth), top-any, no cose,"
           "bounded by ce, the shared budget; an inner profile or limit failure"
           "kills these leaves only. 0, or budget / inconsistent.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        items (ia s O_ITEMS)
        maxd (ia s O_MAX_DEPTH)
        cose (ia s O_COSE)
        errpos (ia s O_ERR_POS)
        dd (ia s VM_D)
        root (+ (+ d 1) seq)
        aup0 (arena-up-top s)
        ^:mut nm (+ (ia s VM_DLIM) root)
        e (new-epoch s)
        ^:mut cnq 0]
    (if (> nm dd) (set nm dd))
    (comment "No frame for the embedded root beyond the compiled depth D: an inner"
             "`cbor/depth` (program.md §17 q6). Its path is the byte string's plus"
             "`cbor` as the witness's extra segment (no path-stack slot past D).")
    (if (> root dd)
      (do (wit-set s CODE_DEPTH 0 d P_EMBED 0 cs)
          (embed-kill p s fb w nq seq)
          (return 0)))
    (path-put s (+ d 1) P_EMBED 0)
    (for [^I32 k 0 nq]
      (let [fk (q-flag s fb w k)
            lbk (q-leaf-base p s fb k)]
        (if (and (and (!= (bit-and fk F_EVAL) 0) (== (q-kind p s fb k) K_EMBED))
                 (== (sar (bit-and (ia p lbk) 256) 8) seq))
          (do (let [ets (ia p (+ lbk 2))]
                (set cnq (q-add p s cfb cw cnq ets e pos)))
              (if (< cnq 0) (return cnq))))))
    (iset s O_ITEMS 0)
    (iset s O_MAX_DEPTH nm)
    (iset s O_COSE 0)
    (iset s VM_EMBED (+ (ia s VM_EMBED) 1))
    (local ^:mut ^I32 r)
    (comment "P8.4 (D264): over a canonical copy the content's embedded-table entry --"
             "its duplicate checks charged, then its own copy walked, or the refusal its"
             "check recorded")
    (let [ve (vtab-find s cs)
          ^:mut wcs cs
          ^:mut wce ce]
      (if (>= ve 0)
        (do (set wcs (ia s (+ ve 3)))
            (set wce (ia s (+ ve 4)))))
      (if (== seq 1)
        (if (> cnq 0)
          (set r (eval-array p pool b s wcs wcs (neg 1) (+ d 1) cfb cck cnq wce 0 ext))
          (set r (dead-seq b s wcs (+ d 2) wce)))
        (if (> cnq 0)
          (set r (eval-item p pool b s wcs (+ d 1) cfb cck cnq wce 0 ext))
          (set r (dead-item b s wcs (+ d 1) wce))))
      (if (and (== seq 0) (and (>= r 0) (== r wce))) (set r ce)))
    (comment "the arena's upward top back where it was (program-2 §9.4); a resource"
             "outcome of the content is the document's (program-2 §8)")
    (arena-set-up s aup0)
    (if (or (== r (neg R_BUDGET)) (== r (neg R_INCONSISTENT))) (return r))
    (if (or (== r (neg R_GROUP_LIMIT)) (== r (neg R_AGROW))) (return r))
    (comment "the deterministic attempt of a valid-CBOR run (PF_VREL) meeting content only"
             "valid CBOR has: the run takes the canonical path (D262)")
    (if (and (!= (bit-and (ia s O_PROFILE) PF_VREL) 0)
             (or (== r (neg CODE_NON_SHORTEST)) (or (== r (neg CODE_INDEFINITE)) (== r (neg CODE_KEY_ORDER)))))
      (return (neg R_NONDET)))
    (if (== r (neg R_NONDET)) (return r))
    (let [ierr (ia s O_ERR_POS)]
      (iset s O_ITEMS items)
      (iset s O_MAX_DEPTH maxd)
      (iset s O_COSE cose)
      (iset s O_ERR_POS errpos)
      (iset s VM_EMBED (- (ia s VM_EMBED) 1))
      (if (< r 0)
        (do (wit-set s (neg r) 0 (+ d 1) (neg 1) 0 ierr)
            (embed-kill p s fb w nq seq)
            (return 0))))
    (let [ev (q-stamp s cfb cw cnq pos)]
      (if (< ev 0) (return ev))
      (for [^I32 k2 0 nq]
        (let [f2 (q-flag s fb w k2)
              lb2 (q-leaf-base p s fb k2)]
          (if (and (and (!= (bit-and f2 F_EVAL) 0) (== (q-kind p s fb k2) K_EMBED))
                   (== (sar (bit-and (ia p lb2) 256) 8) seq))
            (do (let [ets2 (ia p (+ lb2 2))
                      t (ts-test p s ets2 ev pos)]
                  (if (< t 0) (return t))
                  (if (== t 0)
                    (iset s (+ (+ fb w) k2)
                          (bit-or (bit-and f2 (bit-xor F_EVAL (neg 1))) (shl R_EMBEDDED 8))))))))))
    (if (and (== seq 0) (!= r ce))
      (if (> (embed-live p s fb w nq 0) 0)
        (do (wit-set s CODE_TRAILING 0 (+ d 1) (neg 1) 0 r)
            (embed-kill p s fb w nq 0))))
    (return 0)))

(defn ^:pub ^I32 eval-embed [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 cs ^I32 ce
                             ^I32 d ^I32 fb ^I32 ck ^I32 nq ^Ext ext]
  (comment "§8.4 EMBED on a byte string item at depth d with content [cs, ce): 1 unit"
           "per admitted EMBED leaf, then a sub-validation for the `.cbor` leaves and"
           "one for the `.cborseq` leaves (D040). Survivors match; with no other"
           "candidate left the slot becomes `embedded` with the innermost"
           "non-embedded reason (§9.2 rule 7). 0, or budget / inconsistent.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)]
    (for [^I32 j 0 nq]
      (let [f (q-flag s fb w j)]
        (if (and (!= (bit-and f F_ADMITTED) 0) (== (q-kind p s fb j) K_EMBED))
          (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
              (q-set-flag s fb w j F_EVAL)))))
    (if (> (embed-live p s fb w nq 0) 0)
      (do (let [r0 (embed-run p pool b s cs ce d fb ck nq 0 pos ext)]
            (if (< r0 0) (return r0)))
          (if (or (> (embed-live p s fb w nq 0) 0) (> (count-matched-scalars p s fb w nq) 0))
            (wit-clear s))))
    (if (> (embed-live p s fb w nq 1) 0)
      (do (let [r1 (embed-run p pool b s cs ce d fb ck nq 1 pos ext)]
            (if (< r1 0) (return r1)))
          (if (or (> (embed-live p s fb w nq 1) 0)
                  (or (> (embed-live p s fb w nq 0) 0) (> (count-matched-scalars p s fb w nq) 0)))
            (wit-clear s))))
    (let [^:mut won 0]
      (for [^I32 m 0 nq]
        (let [fm (q-flag s fb w m)]
          (if (and (!= (bit-and fm F_EVAL) 0) (== (q-kind p s fb m) K_EMBED))
            (do (iset s (+ (+ fb w) m) (bit-or fm F_MATCHED))
                (set won (+ won 1))))))
      (if (and (== won 0) (== (count-matched-scalars p s fb w nq) 0))
        (if (wit-empty s)
          (wit-set s R_EMBEDDED 0 d (neg 1) 0 pos)
          (if (!= (ia s VM_W_REASON) R_EMBEDDED)
            (do (iset s VM_W_SUB (ia s VM_W_REASON))
                (iset s VM_W_REASON R_EMBEDDED))))))
    (return 0)))

;; ------------------------------------------------------------ tags

(defn ^:pub ^I32 if-code [^I32 lo]
  (if (== lo 4) (return CODE_DECIMAL))
  (return CODE_NDARRAY))

(defn ^:pub ^I32 count-matched [^IntsR p ^IntsR s ^I32 fb ^I32 w ^I32 nq]
  (comment "Admitted, non-combinator entries that matched: the item's live candidates"
           "once everything but its combinators is decided.")
  (let [^:mut k 0]
    (for [^I32 i 0 nq]
      (let [f (q-flag s fb w i)
            kind (q-kind p s fb i)]
        (if (and (== (bit-and f (+ F_ADMITTED F_MATCHED)) (+ F_ADMITTED F_MATCHED))
                 (and (!= kind K_AND) (!= kind K_NOT)))
          (set k (+ k 1)))))
    (return k)))

(defn ^:pub ^I32 item-cls [^I32 major ^I32 ai ^I32 hi ^I32 lo]
  (comment "The item's class bit (§4.1).")
  (if (< major 6) (return (shl 1 major)))
  (if (== major 6)
    (do (if (and (== hi 0) (or (== lo 2) (== lo 3))) (return 2048))
        (return 64)))
  (if (== ai 25) (return 256))
  (if (== ai 26) (return 512))
  (if (== ai 27) (return 1024))
  (return 128))

(defn ^:pub ^I32 single-scalar [^IntsR p ^I32 ts]
  (comment "The leaf of typeset ts when it is exactly one answer of a scalar kind"
           "with no evaluation list (no combinator), else -1.")
  (let [off (ia p (+ (ia p H_S_TS_INDEX) ts))]
    (if (or (!= (ia p off) 1) (!= (ia p (+ off 1)) 0)) (return (neg 1)))
    (let [l (ia p (+ off 2))]
      (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 l))) 255)) (return l))
      (return (neg 1)))))

(defn ^:pub ^I32 single-leaf [^IntsR p ^I32 ts]
  (comment "The leaf of typeset ts when it is exactly one answer and no evaluation"
           "list (any kind but a combinator), else -1.")
  (let [off (ia p (+ (ia p H_S_TS_INDEX) ts))]
    (if (or (!= (ia p off) 1) (!= (ia p (+ off 1)) 0)) (return (neg 1)))
    (return (ia p (+ off 2)))))

(defn ^:pub ^Bool int1 [^IntsR p ^Bytes pool ^Bytes b ^I32 iv ^I32 cls ^I32 hi ^I32 lo]
  (comment "Is the major-0 (cls 1) or major-1 (cls 2) point hi:lo inside interval iv?")
  (let [bo (+ (ia p H_S_INTERVALS) (* 6 iv))
        ^:mut rg 3]
    (if (== cls 2) (set rg 2))
    (return (and (>= (cmp-point p pool b rg hi lo bo) 0) (<= (cmp-point p pool b rg hi lo (+ bo 3)) 0)))))

(defn ^:pub ^Bool pt-ge [^I32 rg ^I32 ph ^I32 pl ^I32 br ^I32 ba ^I32 bb]
  (comment "point (rg 2 NEG / 3 POS, hi:lo) >= bound (region, a, b)?")
  (if (!= rg br) (return (> rg br)))
  (if (== rg 3) (return (>= (cmp-u64 ph pl ba bb) 0)))
  (return (>= (cmp-u64 ba bb ph pl) 0)))

(defn ^:pub ^Bool pt-le [^I32 rg ^I32 ph ^I32 pl ^I32 br ^I32 ba ^I32 bb]
  (if (!= rg br) (return (< rg br)))
  (if (== rg 3) (return (<= (cmp-u64 ph pl ba bb) 0)))
  (return (<= (cmp-u64 ba bb ph pl) 0)))

(defn ^:pub ^I32 array-streak [^IntsR p ^Bytes b ^Ints s ^I32 q0 ^I32 limit ^I32 end
                               ^I32 leaf ^I32 s2]
  (comment "P3.6 (D044): consecutive SUCCESSFUL elements of a `[* T]` array whose"
           "block already holds its one active position (|A| = 1), T one INT leaf"
           "over one interval or one TEXT leaf without a regexp. Each element is"
           "checked first -- items limit, head (shortest form, bytes present),"
           "UTF-8, the leaf -- and only then charged, in the generic order: 5 at"
           "the array (block 1 + W(|A|+1) 2 + candidate 1 + element 1), visit 1"
           "[+ UTF-8 ceil(len/8)] + filter 1 + leaf 1 [+ probe 1] at the element,"
           "4 at the array (stamp, candidate, test, the machine's one step, P8.5);"
           "schedule 2 leaves the visit [+ UTF-8] [+ probe]. An element that would fail,"
           "need anything else or exceed the budget stops the streak BEFORE it is"
           "touched. No path write is needed: no witness can be recorded inside"
           "a successful streak. Answers the next position; the element count goes"
           "in s[VM_FASTM].")
  (let [lb (+ (ia p H_S_LEAVES) (* 8 leaf))
        kind (bit-and (ia p lb) 255)
        isint (== kind K_INT)
        mask (ia p (+ lb 1))
        iv (+ (ia p H_S_INTERVALS) (* 6 (ia p (+ lb 2))))
        lr (ia p iv)
        la (ia p (+ iv 1))
        lbb (ia p (+ iv 2))
        hr (ia p (+ iv 3))
        ha (ia p (+ iv 4))
        hb (ia p (+ iv 5))
        tlo (ia p (+ lb 2))
        thi (ia p (+ lb 3))
        maxit (ia s O_MAX_ITEMS)
        ^:mut q q0
        ^:mut k 0
        ^:mut items (ia s O_ITEMS)
        ^:mut left (ia s VM_BUDGET)]
    (while (and (< k limit) (< q end))
      (let [ib (u8 b q)
            major (ushr ib 5)
            ai (bit-and ib 31)
            ^:mut hi 0
            ^:mut lo ai
            ^:mut h 1
            ^:mut cost (- 13 (* 11 s2))]
        (if (>= items maxit) (break))
        (if (> ai 27) (break))
        (if (>= ai 24)
          (do (set h (+ 1 (shl 1 (- ai 24))))
              (if (> h (- end q)) (break))
              (if (== ai 24) (set lo (u8 b (+ q 1))))
              (if (== ai 25) (set lo (be16 b (+ q 1))))
              (if (== ai 26) (set lo (be32 b (+ q 1))))
              (if (== ai 27) (do (set hi (be32 b (+ q 1))) (set lo (be32 b (+ q 5)))))
              (comment "shortest form, else the element is not ours")
              (if (and (== ai 24) (< lo 24)) (break))
              (if (and (== ai 25) (< lo 256)) (break))
              (if (and (== ai 26) (== (ushr lo 16) 0)) (break))
              (if (and (== ai 27) (== hi 0)) (break))))
        (if isint
          (do (if (> major 1) (break))
              (if (== (bit-and mask (shl 1 major)) 0) (break))
              (let [rg (- 3 major)]
                (if (not (and (pt-ge rg hi lo lr la lbb) (pt-le rg hi lo hr ha hb))) (break)))
              (if (< left cost) (break))
              (set left (- left cost))
              (set q (+ q h)))
          (do (comment "TEXT: length, bytes present, size, UTF-8")
              (if (!= major 3) (break))
              (if (or (!= hi 0) (< lo 0)) (break))
              (if (> lo (- end (+ q h))) (break))
              (if (or (< lo tlo) (> lo thi)) (break))
              (comment "schedule 2: visit + UTF-8 only")
              (set cost (+ (- 12 (* 11 s2)) (c8 lo)))
              (if (< left cost) (break))
              (if (>= (utf8-invalid-at b (+ q h) (+ (+ q h) lo)) 0) (break))
              (set left (- left cost))
              (set q (+ (+ q h) lo))))
        (set items (+ items 1))
        (set k (+ k 1))))
    (iset s VM_BUDGET left)
    (iset s O_ITEMS items)
    (iset s VM_FASTM k)
    (if (> k 0) (wit-clear s))
    (return q)))

(defn ^:pub ^I32 fast-child [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 d ^I32 cfb ^I32 ck
                             ^I32 cw ^I32 leaf ^I32 end ^I32 ctx ^Ext ext]
  (comment "P3.6 (D044): eval-item on a query list of exactly ONE answer leaf"
           "`leaf` without building the list: for a scalar kind on a scalar major,"
           "the same profile checks, charges (consecutive charges at one offset"
           "merged, which no output can tell apart) and witness rule 1, with no"
           "frame or mark writes; the matched flag goes in s[VM_FASTM]. Any other"
           "item (container, tag, missing byte) or leaf kind takes the generic"
           "eval-item over the one-entry list written into the frame (its building"
           "was charged by the caller).")
  (let [^:mut major (neg 1)
        lb (+ (ia p H_S_LEAVES) (* 8 leaf))
        kind (bit-and (ia p lb) 255)]
    (if (< pos end) (set major (ushr (u8 b pos) 5)))
    (comment "ANY, or the matching bare major, on an array or map: the generic"
             "item's visit, head, container checks, filter 1, children walked dead"
             "(D043), then 1 for the leaf -- directly.")
    (if (and (or (== major 4) (== major 5))
             (or (== kind K_ANY) (and (== kind K_MAJOR) (== (ia p (+ lb 2)) major))))
      (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
          (let [it0 (+ (ia s O_ITEMS) 1)]
            (iset s O_ITEMS it0)
            (if (> it0 (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
          (let [ai0 (bit-and (u8 b pos) 31)
                ^:mut hi0 0
                ^:mut lo0 ai0
                ^:mut q0 (+ pos 1)]
            (if (>= ai0 24)
              (do (set q0 (read-arg b s pos ai0 end))
                  (if (< q0 0) (return (head-fail b s pos ai0 d q0)))
                  (set hi0 (ia s O_HI))
                  (set lo0 (ia s O_LO))))
            (let [rc (enter-container s pos q0 hi0 lo0 d (- major 4) end)]
              (if (< rc 0) (return rc)))
            (if (not (charge s (unit-of ctx) pos)) (return (neg R_BUDGET)))
            (local ^I32 r0)
            (if (== major 4)
              (set r0 (dead-array-elems b s q0 lo0 d end))
              (set r0 (dead-map-pairs b s q0 lo0 d end)))
            (if (< r0 0) (return r0))
            (if (not (charge s (unit-of ctx) pos)) (return (neg R_BUDGET)))
            (iset s VM_FASTM 1)
            (return r0))))
    (if (or (< major 0) (or (not (scalar-kind kind)) (or (== major 4) (or (== major 5) (== major 6)))))
      (do (iset s cfb leaf)
          (iset s (+ cfb cw) F_ANSWER)
          (let [^I32 rg (eval-item p pool b s pos d cfb ck 1 end ctx ext)
                fq (ia s (+ cfb cw))]
            (if (< rg 0) (return rg))
            (if (!= (bit-and fq F_MATCHED) 0) (iset s VM_FASTM 1) (iset s VM_FASTM 0))
            (return rg))))
    (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
    (let [it (+ (ia s O_ITEMS) 1)]
      (iset s O_ITEMS it)
      (if (> it (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
    (let [ai (bit-and (u8 b pos) 31)
          ^:mut hi 0
          ^:mut lo ai
          ^:mut q (+ pos 1)
          ^:mut cs (+ pos 1)
          ^:mut stop (+ pos 1)]
      (if (>= ai 24)
        (if (and (== major 7) (and (>= ai 25) (<= ai 27)))
          (do (set stop (scan-float b s pos ai end))
              (if (< stop 0) (return stop)))
          (do (set q (read-arg b s pos ai end))
              (if (< q 0) (return (head-fail b s pos ai d q)))
              (set hi (ia s O_HI))
              (set lo (ia s O_LO))
              (set cs q)
              (set stop q))))
      (if (== major 2)
        (do (set stop (take-len s pos q hi lo end))
            (if (< stop 0) (return stop))))
      (if (== major 3)
        (do (set stop (take-len s pos q hi lo end))
            (if (< stop 0) (return stop))
            (if (not (charge s (c8 (- stop q)) pos)) (return (neg R_BUDGET)))
            (let [bad (utf8-invalid-at b q stop)]
              (if (>= bad 0)
                (do (let [tbad (text-bad b s bad stop)]
                      (if (< tbad 0) (return tbad))))))))
      (if (and (== major 7) (or (< ai 25) (> ai 27)))
        (do (let [r7 (scan-simple s pos ai)]
              (if (< r7 0) (return r7)))))
      (let [cls (item-cls major ai hi lo)
            ^:mut ^I32 r R_TYPE]
        (if (!= (bit-and (ia p (+ lb 1)) cls) 0)
          (if (and (== kind K_INT) (and (<= cls 2) (== (ia p (+ lb 3)) 1)))
            (do (comment "INT over one interval: filter 1 + leaf 1 + its one probe")
                (if (not (charge s (+ 1 (* 2 (unit-of ctx))) pos)) (return (neg R_BUDGET)))
                (if (int1 p pool b (ia p (+ lb 2)) cls hi lo) (set r 0) (set r R_RANGE)))
            (if (and (== kind K_TEXT) (< (ia p (+ lb 4)) 0))
              (do (comment "TEXT without a regexp: filter 1 + leaf 1, a size check")
                  (if (not (charge s (* 2 (unit-of ctx)) pos)) (return (neg R_BUDGET)))
                  (if (and (>= (- stop cs) (ia p (+ lb 2))) (<= (- stop cs) (ia p (+ lb 3))))
                    (set r 0)
                    (set r R_SIZE)))
              (do (if (not (charge s (* 2 (unit-of ctx)) pos)) (return (neg R_BUDGET)))
                  (set r (eval-leaf p pool b s lb kind pos cs stop cls hi lo))
                  (if (< r 0) (return r)))))
          (if (not (charge s (unit-of ctx) pos)) (return (neg R_BUDGET))))
        (if (== r 0)
          (iset s VM_FASTM 1)
          (do (iset s VM_FASTM 0)
              (if (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s))
                (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                    (wit-set s r 0 d (neg 1) 0 pos)))))
        (return stop)))))

(defn ^:pub ^I32 eval-tag [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q ^I32 hi ^I32 lo
                           ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^Ext ext]
  (comment "A tag item (§8.4): the scanner's depth and number checks, the filter,"
           "TAG/TAGSET number tests (1 unit each), the content at depth d + 1 queried"
           "with the content typesets of the leaves whose number matched (bignum and"
           "typed-array content: a schema child, not an item; tag 4/40: the inner"
           "array as an item; a standard-set tag: its content item, D121), the"
           "scanner's tag semantics, then the leaves.")
  (if (>= d (ia s O_MAX_DEPTH)) (return (fail s pos CODE_DEPTH)))
  (if (and (!= hi 0) (not (any-tags (ia s O_PROFILE)))) (return (fail s pos CODE_TAG)))
  (comment "rt: the rule tag (D180, rule-tag) of the number hi:lo; the TAG/TAGSET"
           "tests read the whole number")
  (let [rt (rule-tag hi lo)
        big (or (== rt 2) (== rt 3))
        tsize (typed-size rt)
        std (and (and (not big) (and (!= rt 4) (and (!= rt 40) (== tsize 0))))
                 (std-allowed (ia s O_PROFILE) rt d))
        cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        ^:mut cls 64
        ^:mut cnq 0
        ^:mut cs q]
    (local ^:mut ^I32 stop)
    (if (and (not big) (and (!= rt 4) (and (!= rt 40) (and (== tsize 0) (not std))))) (return (fail s pos CODE_TAG)))
    (if big (set cls 2048))
    (let [na (q-filter-x p s fb w nq cls pos ctx)]
      (if (< na 0) (return na)))
    (let [e (new-epoch s)]
      (for [^I32 i 0 nq]
        (let [f (q-flag s fb w i)
              kind (q-kind p s fb i)]
          (if (and (!= (bit-and f F_ADMITTED) 0) (or (== kind K_TAG) (== kind K_TAGSET)))
            (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
                (let [lb (q-leaf-base p s fb i)
                      istag (== kind K_TAG)
                      hit (or (and istag (and (== (ia p (+ lb 2)) hi) (== (ia p (+ lb 3)) lo)))
                              (and (not istag)
                                   (and (<= (cmp-u64 (ia p (+ lb 2)) (ia p (+ lb 3)) hi lo) 0)
                                        (>= (cmp-u64 (ia p (+ lb 4)) (ia p (+ lb 5)) hi lo) 0))))
                      ^:mut cts (ia p (+ lb 6))]
                  (if istag (set cts (ia p (+ lb 4))))
                  (if hit
                    (do (q-set-flag s fb w i F_EVAL)
                        (set cnq (q-add p s cfb cw cnq cts e pos))
                        (if (< cnq 0) (return cnq)))
                    (q-set-flag s fb w i (shl R_TAG 8)))))))))
    (if (> cnq 0) (path-put s (+ d 1) P_TAG 0))
    (if (or big (> tsize 0))
      (do (if (not (charge s 1 q)) (return (neg R_BUDGET)))
          (if big
            (set stop (dead-bignum b s pos q (ia s VM_BIGNUM_MAX) end))
            (set stop (dead-typed b s pos q rt tsize end)))
          (if (< stop 0) (return stop))
          (set cs (ia s O_CSTART))
          (if (> cnq 0)
            (do (let [rb (bstr-tail p pool b s q cs stop (+ d 1) cfb cck cnq 0 ext)]
                  (if (< rb 0) (return rb))))))
      (if std
        (do (if (> cnq 0)
              (set stop (eval-item p pool b s q (+ d 1) cfb cck cnq end 0 ext))
              (set stop (dead-item b s q (+ d 1) end)))
            (if (< stop 0) (return stop))
            (set stop (dead-std-check b s pos rt q stop d))
            (if (< stop 0) (return stop)))
        (do (let [pc (pair-check b s pos q (if-code rt) end)]
              (if (< pc 0) (return pc)))
            (if (> cnq 0)
              (set stop (eval-item p pool b s q (+ d 1) cfb cck cnq end 0 ext))
              (set stop (pair-walk b s q d end)))
            (if (< stop 0) (return stop))
            (set stop (pair-count b s pos q (if-code rt) stop))
            (if (< stop 0) (return stop))
            (if (== rt 4)
              (set stop (decimal-check b s pos q stop))
              (set stop (ndarray-check b s pos q stop)))
            (if (< stop 0) (return stop)))))
    (let [ec (q-stamp s cfb cw cnq pos)]
      (if (< ec 0) (return ec))
      (for [^I32 j 0 nq]
        (let [fj (q-flag s fb w j)]
          (if (!= (bit-and fj F_EVAL) 0)
            (do (let [lbj (q-leaf-base p s fb j)
                      ^:mut ctj (ia p (+ lbj 4))]
                  (if (== (q-kind p s fb j) K_TAGSET) (set ctj (ia p (+ lbj 6))))
                  (let [t (ts-test p s ctj ec pos)]
                    (if (< t 0) (return t))
                    (if (== t 1)
                      (q-set-flag s fb w j F_MATCHED)
                      (q-set-flag s fb w j (shl R_TYPE 8))))))))))
    (let [r2 (eval-scalars p pool b s fb w nq pos cs stop cls hi lo (unit-of ctx))]
      (if (< r2 0) (return r2)))
    (if (> (count-matched p s fb w nq) 0) (wit-clear s))
    (let [r3 (finish-scalar p pool b s fb w nq d pos stop ctx ext)]
      (if (< r3 0) (return r3)))
    (return stop)))

(defn ^:pub ^I32 pre-scalar [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 q ^I32 end ^I32 lb ^I32 kind]
  (comment "P3.6 streaks: does the item at q certainly pass the profile and match"
           "leaf lb -- an INT over one interval or a TEXT without a regexp?"
           "Checked without charging: its end, with the units its generic"
           "evaluation charges (visit, UTF-8, filter, leaf, probe) in s[O_LO]; or"
           "-1 when it would not, or it is anything else.")
  (if (>= q end) (return (neg 1)))
  (let [ib (u8 b q)
        major (ushr ib 5)
        ai (bit-and ib 31)
        ^:mut hi 0
        ^:mut lo ai
        ^:mut h 1]
    (if (> ai 27) (return (neg 1)))
    (if (>= ai 24)
      (do (set h (+ 1 (shl 1 (- ai 24))))
          (if (> h (- end q)) (return (neg 1)))
          (if (== ai 24) (set lo (u8 b (+ q 1))))
          (if (== ai 25) (set lo (be16 b (+ q 1))))
          (if (== ai 26) (set lo (be32 b (+ q 1))))
          (if (== ai 27) (do (set hi (be32 b (+ q 1))) (set lo (be32 b (+ q 5)))))
          (if (and (== ai 24) (< lo 24)) (return (neg 1)))
          (if (and (== ai 25) (< lo 256)) (return (neg 1)))
          (if (and (== ai 26) (== (ushr lo 16) 0)) (return (neg 1)))
          (if (and (== ai 27) (== hi 0)) (return (neg 1)))))
    (if (== kind K_INT)
      (do (if (or (> major 1) (!= (ia p (+ lb 3)) 1)) (return (neg 1)))
          (if (== (bit-and (ia p (+ lb 1)) (shl 1 major)) 0) (return (neg 1)))
          (if (not (int1 p pool b (ia p (+ lb 2)) (+ major 1) hi lo)) (return (neg 1)))
          (iset s O_LO 4)
          (return (+ q h))))
    (if (and (== kind K_TEXT) (== major 3))
      (do (if (or (!= hi 0) (< lo 0)) (return (neg 1)))
          (if (> lo (- end (+ q h))) (return (neg 1)))
          (if (or (< lo (ia p (+ lb 2))) (> lo (ia p (+ lb 3)))) (return (neg 1)))
          (if (>= (utf8-invalid-at b (+ q h) (+ (+ q h) lo)) 0) (return (neg 1)))
          (iset s O_LO (+ 3 (c8 lo)))
          (return (+ (+ q h) lo))))
    (return (neg 1))))

(defn ^:pub ^Bool streak-kind [^IntsR p ^I32 leaf]
  (comment "Leaves pre-scalar decides: INT over one interval, TEXT without a regexp.")
  (if (< leaf 0) (return false))
  (let [lb (+ (ia p H_S_LEAVES) (* 8 leaf))
        kind (bit-and (ia p lb) 255)]
    (return (or (and (== kind K_INT) (== (ia p (+ lb 3)) 1))
                (and (== kind K_TEXT) (< (ia p (+ lb 4)) 0))))))

;; ------------------------------------------------------------ arrays

(defn ^:pub ^Bool star-steady [^IntsR s ^I32 area ^I32 el]
  (comment "Is the single `[* T]` block at area in its steady state before element el:"
           "alive, |A| = 1, its machine waiting at ENTRY (node 1) for record el inside"
           "the REP's frame (program-2 §5.3)? Then each matching element is one step.")
  (return (and (and (!= (ia s (+ area AB_ALIVE)) 0) (== (ia s (+ area AB_NACT)) 1))
               (and (and (== (ia s (+ area AB_STATUS)) 0) (== (ia s (+ area AB_MODE)) 3))
                    (and (and (== (ia s (+ area AB_SP)) 1) (== (ia s (+ area AB_PC)) 1))
                         (== (ia s (+ area AB_IDX)) el))))))

(defn ^:pub star-advance [^IntsR p ^Ints s ^I32 fb ^I32 area ^I32 k]
  (comment "k matching elements of a steady `[* T]` block (star-steady), all at once:"
           "the waiting ENTRY moves on k records, the REP frame counts k more"
           "iterations, the active set stays the position.")
  (let [ao (block-ao p s fb area)
        fr (+ (+ area AB_HDR) (* 2 (ia p (+ ao 1))))
        idx (+ (ia s (+ area AB_IDX)) k)
        cnt (+ (ia s (+ fr 2)) k)]
    (iset s (+ area AB_IDX) idx)
    (iset s (+ fr 2) cnt)
    (iset s (+ fr 3) idx)))

(defn ^:pub ^I32 if-limit [^I32 n ^I32 el]
  (if (< n 0) (return INF))
  (return (- n el)))

(defn ^:pub ^I32 arr-open [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 cap ^I32 nq ^I32 pos]
  (comment "An array's blocks (program-2 §5): one per admitted ARRAY leaf, in query"
           "order, then the A2 blocks' record stride. The block count or a code.")
  (let [area (+ fb (* 2 w))
        ^:mut nb 0
        ^:mut used 0]
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_ARRAY))
        (do (let [words (array-words p (leaf-array p (q-leaf-base p s fb i)))]
              (if (> (+ used words) cap) (return (neg R_INCONSISTENT)))
              (let [ri (array-block-init s (+ area used) i words pos)]
                (if (< ri 0) (return ri)))
              (set used (+ used words))
              (set nb (+ nb 1))))))
    (array-records p s fb area nb)
    (return nb)))

(defn ^:pub ^I32 arr-star-leaf [^IntsR p ^IntsR s ^I32 fb ^I32 area ^I32 nb]
  (comment "The one leaf T of a single `[* T]` block (one position, the program"
           "REP(0, INF, ENTRY), T one answer), else -1: schedule 2's free element"
           "bookkeeping (D045 i).")
  (if (!= nb 1) (return (neg 1)))
  (let [ao (block-ao p s fb area)
        po (apeg p ao)]
    (if (or (!= (ia p ao) 1) (!= (ia p (+ po 1)) 2)) (return (neg 1)))
    (let [n0 (+ po PEG_HDR)
          n1 (+ n0 5)]
      (if (or (!= (ia p n0) P_REP) (or (!= (ia p (+ n0 1)) 1) (or (!= (ia p (+ n0 2)) 0) (!= (ia p (+ n0 3)) INF))))
        (return (neg 1)))
      (if (!= (ia p n1) P_ENTRY) (return (neg 1)))
      (return (single-leaf p (ia p (+ (+ ao 4) (ia p (+ ao 1)))))))))

(defn ^:pub ^I32 arr-alive [^IntsR p ^IntsR s ^I32 fb ^I32 area ^I32 nb]
  (let [^:mut bo area
        ^:mut k 0]
    (for [^I32 _bi 0 nb]
      (if (!= (ia s (+ bo AB_ALIVE)) 0) (set k (+ k 1)))
      (set bo (+ bo (array-words p (block-ao p s fb bo)))))
    (return k)))

(defn ^:pub ^I32 arr-query [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 area ^I32 nb ^I32 el ^I32 q ^I32 cfb ^I32 cw
                            ^I32 e ^I32 pos]
  (comment "Element el (head q): 1 unit per block, then each live block's candidates"
           "(array-candidates; a block whose machine already succeeded dies here)."
           "The element's query length, or a code.")
  (let [^:mut cnq 0
        ^:mut bo area]
    (for [^I32 _bi 0 nb]
      (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
      (let [ao (block-ao p s fb bo)]
        (if (!= (ia s (+ bo AB_ALIVE)) 0)
          (do (set cnq (array-candidates p s bo ao el q cfb cw cnq e pos))
              (if (< cnq 0) (return cnq))
              (if (== (ia s (+ bo AB_ALIVE)) 0)
                (do (let [qi (ia s bo)]
                      (q-set-flag s fb w qi (shl R_UNEXPECTED 8)))))))
        (set bo (+ bo (array-words p ao)))))
    (return cnq)))

(defn ^:pub ^I32 arr-after [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 area ^I32 nb ^I32 el ^I32 q ^I32 r
                            ^I32 cfb ^I32 cw ^I32 cnq ^I32 pos]
  (comment "After element el (head q, end r): the matched leaves stamped, then each"
           "live block's tests, record and machine (array-advance). The live blocks"
           "left, or a code.")
  (let [ev (q-stamp s cfb cw cnq pos)
        ^:mut still 0
        ^:mut bo area]
    (if (< ev 0) (return ev))
    (for [^I32 _bj 0 nb]
      (let [ao (block-ao p s fb bo)]
        (if (!= (ia s (+ bo AB_ALIVE)) 0)
          (do (let [adv (array-advance p s bo ao el ev q r pos)]
                (if (< adv 0) (return adv))
                (if (== adv 1)
                  (set still (+ still 1))
                  (do (let [qi (ia s bo)
                            k (bit-and (ia s (+ bo AB_EVK)) 255)
                            ^:mut ^I32 why R_TYPE]
                        (if (>= k 3) (set why R_UNEXPECTED))
                        (q-set-flag s fb w qi (shl why 8))))))))
        (set bo (+ bo (array-words p ao)))))
    (return still)))

(defn ^:pub ^I32 array-step [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q ^I32 d ^I32 fb
                             ^I32 w ^I32 area ^I32 cfb ^I32 cck ^I32 cw ^I32 fleaf ^I32 el ^I32 pend
                             ^I32 end ^I32 s2 ^I32 cx ^Ext ext]
  (comment "P3.6 (D044): one element of a `[* T]` array (one block, one position, T"
           "one answer, tier A0): the generic element's charges merged per offset --"
           "block 1 + W(|A|+1) + candidate 1 + T's element 1 at the array, the child"
           "(fast-child), then stamp 1 + candidate 1 + test 1 -- the record (the"
           "block's active set) and the machine (a-run) as array-advance has them."
           "Schedule 2 (D045) frees the bookkeeping and the machine's steps."
           "Answers the element's end (the block's alive word tells a death).")
  (if (not (charge s (* (- 1 s2) (+ (ia s (+ area AB_NACT)) 4)) pos)) (return (neg R_BUDGET)))
  (path-put s (+ d 1) P_INDEX el)
  (let [^I32 rf (fast-child p pool b s q (+ d 1) cfb cck cw fleaf end cx ext)]
    (if (< rf 0) (return rf))
    (if (not (charge s (* (- 1 s2) 3) pos)) (return (neg R_BUDGET)))
    (let [ao (block-ao p s fb area)
          m (ia s VM_FASTM)]
      (iset s (+ area AB_HDR) m)
      (iset s (+ area AB_NACT) m)
      (if (== s2 1) (free-on s))
      (let [rm (a-run p s area ao el 0 q rf pos)]
        (free-off s)
        (if (< rm 0) (return rm)))
      (let [st (ia s (+ area AB_STATUS))
            ^:mut alive 0]
        (if (or (== st 0) (and (== st 2) (> (ia s (+ area AB_IDX)) el))) (set alive 1))
        (if (and (== alive 0) (== st 2))
          (do (let [e3 (ia s (+ area AB_IDX))
                    ^:mut o3 pos]
                (if (== e3 el) (set o3 q))
                (aev s area 3 e3 o3))))
        (if (== alive 1)
          (wit-clear s)
          (do (iset s (+ area AB_ALIVE) 0)
              (iset s (+ area AB_DIED) el)
              (let [qi (ia s area)
                    k (bit-and (ia s (+ area AB_EVK)) 255)
                    ^:mut ^I32 why R_TYPE]
                (if (>= k 3) (set why R_UNEXPECTED))
                (q-set-flag s fb w qi (shl why 8)))
              (if (> pend 0) (wit-clear s))))))
    (return rf)))

(defn ^:pub ^I32 arr-close [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 fb ^I32 w ^I32 area ^I32 nb ^I32 d
                            ^I32 n ^I32 pos ^I32 q0 ^I32 q ^I32 nq ^I32 ctx ^I32 pend ^Ext ext]
  (comment "The array's end (program-2 §5.1, §8): 1 unit per block, a live block's end"
           "run (array-end); its records popped; the scalar leaves and combinators;"
           "then, with no answer matched, witness rule 5' (array-witness) when an"
           "ARRAY block failed, else rule 1. 0 or a code.")
  (let [mark (array-mark p s fb area nb)
        ^:mut be area
        ^:mut unacc 0]
    (for [^I32 _bk 0 nb]
      (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
      (let [aok (block-ao p s fb be)]
        (if (!= (ia s (+ be AB_ALIVE)) 0)
          (do (let [ra (array-end p s be aok n pos)
                    qi (ia s be)]
                (if (< ra 0) (return ra))
                (if (== ra 1)
                  (q-set-flag s fb w qi F_MATCHED)
                  (q-set-flag s fb w qi (shl R_MISSING 8))))))
        (if (== (ia s (+ be AB_ALIVE)) 0) (set unacc (+ unacc 1)))
        (set be (+ be (array-words p aok)))))
    (if (>= mark 0) (arena-set-up s mark))
    (let [rs (eval-scalars p pool b s fb w nq pos q0 q 16 0 n (unit-of ctx))]
      (if (< rs 0) (return rs)))
    (let [m (finish-comb p pool b s fb w nq pos q ext)]
      (if (< m 0) (return m))
      (if (and (== m 0) (== (bit-and ctx CTX_KEY) 0))
        (if (> unacc 0)
          (array-witness p s fb area nb d n pos pend)
          (if (wit-empty s)
            (do (let [r1 (rule1 s fb w nq d pos)]
                  (if (< r1 0) (return r1))))))))
    (return 0)))

(defn ^:pub ^I32 eval-array [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q0 ^I32 n
                             ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^Ext ext]
  (comment "An array item (program-2 §5) after its head and container checks: a"
           "block per admitted ARRAY leaf; per element the candidate positions of the"
           "live blocks give the element's query, then records and machines; at the"
           "end, the machines told the input ended. n < 0: a VIRTUAL array (a"
           "`.cborseq` sequence, D040) whose elements are the items up to end.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        ^:mut q q0
        ^:mut q1 q0
        ^:mut el 0
        ^:mut s2 0
        ^:mut cx 0
        ^:mut fleaf (neg 1)
        ^:mut sleaf (neg 1)]
    (local ^:mut ^I32 nalive)
    (let [na (q-filter-x p s fb w nq 16 pos ctx)]
      (if (< na 0) (return na)))
    (let [nb (arr-open p s fb w (- fw (* 2 w)) nq pos)]
      (if (< nb 0) (return nb))
      (set nalive nb)
      (comment "Schedule 2 (D045 i, iii): a simple [* T] block's element steps are free"
               "and a one-scalar-leaf element loses its filter and leaf units. The fast"
               "paths (D044) take its elements unless forced off, or tiers forced.")
      (let [sl (arr-star-leaf p s fb area nb)]
        (if (and (sched2 s) (>= sl 0))
          (do (set s2 1)
              (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 sl))) 255)) (set cx CTX_SIMPLE))))
        (if (and (== (bit-and (ia s VM_GENERIC) (bit-or 1 G_FORCED)) 0) (>= sl 0))
          (do (set fleaf sl)
              (if (and (streak-kind p sl) (== (bit-and (ia s VM_GENERIC) G_NOSTREAK) 0)) (set sleaf sl)))))
      (let [pend (count-pending p s fb w nq)]
        (while (or (and (< n 0) (< q end)) (and (>= n 0) (< el n)))
          (if (== nalive 0)
            (do (comment "dead elements; a run of integers in one streak (D044), never"
                         "element 0 of a two-element array (whose end VM_Q1 records)")
                (if (and (>= el 1) (== (bit-and (ia s VM_GENERIC) 1) 0))
                  (do (let [^I32 qd (dead-int-streak b s q (if-limit n el) end)
                            kd (ia s VM_FASTM)]
                        (if (> kd 0)
                          (do (set q qd)
                              (set el (+ el (- kd 1))))
                          (do (set q (dead-item b s q (+ d 1) end))
                              (if (< q 0) (return q))))))
                  (do (set q (dead-item b s q (+ d 1) end))
                      (if (< q 0) (return q)))))
            (if (and (>= sleaf 0) (and (>= el 1) (star-steady s area el)))
              (do (let [^I32 qs (array-streak p b s q (if-limit n el) end sleaf s2)
                        ks (ia s VM_FASTM)]
                    (if (> ks 0)
                      (do (star-advance p s fb area ks)
                          (set q qs)
                          (set el (+ el (- ks 1))))
                      (do (let [^I32 rf2 (array-step p pool b s pos q d fb w area cfb cck cw fleaf el pend end s2 cx ext)]
                            (if (< rf2 0) (return rf2))
                            (set q rf2)
                            (if (== (ia s (+ area AB_ALIVE)) 0) (set nalive 0)))))))
            (if (>= fleaf 0)
              (do (let [^I32 rf (array-step p pool b s pos q d fb w area cfb cck cw fleaf el pend end s2 cx ext)]
                    (if (< rf 0) (return rf))
                    (set q rf)
                    (if (== (ia s (+ area AB_ALIVE)) 0) (set nalive 0))))
            (do (let [e (new-epoch s)]
                  (local ^I32 r)
                  (local ^I32 cnq)
                  (if (== s2 1) (free-on s))
                  (set cnq (arr-query p s fb w area nb el q cfb cw e pos))
                  (free-off s)
                  (if (< cnq 0) (return cnq))
                  (path-put s (+ d 1) P_INDEX el)
                  (if (> cnq 0)
                    (set r (eval-item p pool b s q (+ d 1) cfb cck cnq end cx ext))
                    (set r (dead-item b s q (+ d 1) end)))
                  (if (< r 0) (return r))
                  (if (== s2 1) (free-on s))
                  (let [still (arr-after p s fb w area nb el q r cfb cw cnq pos)]
                    (free-off s)
                    (if (< still 0) (return still))
                    (set nalive still)
                    (if (or (> still 0) (> pend 0)) (wit-clear s)))
                  (set q r))))))
          (if (== el 0) (set q1 q))
          (set el (+ el 1)))
        (if (!= (ia s VM_VTAB) 0)
          (do (let [rea (replay-end s q0)]
                (if (< rea 0) (return rea)))))
        (if (== n 2) (iset s VM_Q1 q1))
        (let [rc (arr-close p pool b s fb w area nb d el pos q0 q nq ctx pend ext)]
          (if (< rc 0) (return rc)))
        (return q)))))

;; ------------------------------------------------------------ maps

(defn ^:pub ^I32 map-fast-mode [^IntsR p ^I32 mt]
  (comment "Schedule 2's simple shapes (D045 ii) under PEG semantics (tier F): 1 a"
           "closed struct (every member literal, the root a sequence of members), 2"
           "a pure table `{* K => V}` (one non-literal member 0..INF, K and V one"
           "leaf each), else 0.")
  (let [po (mpeg p mt)
        nm (ia p (+ mt 1))]
    (if (!= (ia p (+ po 3)) TIER_F) (return 0))
    (if (and (== nm 1) (< (ia p (+ mt 8)) 0))
      (do (let [n0 (+ po PEG_HDR)]
            (if (or (!= (ia p n0) P_MEMBER) (or (!= (ia p (+ n0 2)) 0) (!= (ia p (+ n0 3)) INF))) (return 0))
            (if (or (< (single-leaf p (ia p (+ mt 9))) 0) (< (single-leaf p (ia p (+ mt 10))) 0)) (return 0))
            (return 2))))
    (if (>= (ia p (+ mt 3)) 0) (return 0))
    (return 1)))

(defn ^:pub ^Bool map-pair-ok [^IntsR p ^I32 mt ^I32 nj ^I32 mode]
  (comment "Is the pair simple (D045 ii)? A table's always; a struct's when its key is"
           "unnamed, or named by one member whose value typeset is one leaf.")
  (if (== mode 2) (return true))
  (if (< nj 0) (return true))
  (let [nrec (+ (m-named p mt) (* 3 nj))]
    (if (!= (ia p (+ nrec 2)) 1) (return false))
    (let [m (ia p (+ (m-namers p mt) (ia p (+ nrec 1))))]
      (return (>= (single-leaf p (ia p (+ (m-member mt m) 2))) 0)))))

(defn ^:pub ^I32 map-open [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 cap ^I32 nq ^I32 pos]
  (comment "A map's blocks (program-2 §6): one per admitted MAP leaf, in query order,"
           "then the T blocks' record stride; the frame must also hold the pair's"
           "candidate list (4 words per member of each block). The block count or"
           "a code.")
  (let [area (+ fb (* 2 w))
        ^:mut nb 0
        ^:mut used 0
        ^:mut ccap 0]
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_MAP))
        (do (let [mt (leaf-map p (q-leaf-base p s fb i))
                  words (map-words p mt)]
              (if (> (+ used words) cap) (return (neg R_INCONSISTENT)))
              (let [ri (map-block-init p s (+ area used) i mt words pos)]
                (if (< ri 0) (return ri)))
              (set used (+ used words))
              (set ccap (+ ccap (ia p (+ mt 1))))
              (set nb (+ nb 1))))))
    (if (> (+ used (* 4 ccap)) cap) (return (neg R_INCONSISTENT)))
    (map-records p s fb area nb)
    (return nb)))

(defn ^:pub ^I32 map-cl [^IntsR p ^IntsR s ^I32 fb ^I32 area ^I32 nb]
  (comment "The candidate list's word offset: past the blocks.")
  (let [^:mut bo area]
    (for [^I32 _i 0 nb]
      (set bo (+ bo (map-words p (block-mt p s fb bo)))))
    (return bo)))

(defn ^:pub ^I32 map-ccap [^IntsR p ^IntsR s ^I32 fb ^I32 area ^I32 nb]
  (comment "The candidate list's capacity: a member is a pair's candidate at most once.")
  (let [^:mut bo area
        ^:mut k 0]
    (for [^I32 _i 0 nb]
      (let [mt (block-mt p s fb bo)]
        (set k (+ k (ia p (+ mt 1))))
        (set bo (+ bo (map-words p mt)))))
    (return k)))

(defn ^:pub ^I32 map-smode [^IntsR p ^IntsR s ^I32 fb ^I32 area ^I32 nb]
  (if (!= nb 1) (return 0))
  (return (map-fast-mode p (block-mt p s fb area))))

(defn ^:pub ^I32 map-pre [^IntsR p ^Ints s ^I32 fb ^I32 area ^I32 smap ^I32 kid ^I32 pos]
  (comment "A pair of a single-block map in a simple shape: its cursor first, uncharged,"
           "to decide schedule 2's simple pair (D045 ii); then the pair's 1 unit, or the"
           "block's 1 + the cursor's units. 1 a simple pair, 0 not, or a code.")
  (let [mt (block-mt p s fb area)]
    (free-on s)
    (iset s O_LO 0)
    (let [rc (map-cursor p s area mt kid pos)]
      (free-off s)
      (if (< rc (neg 1)) (return rc)))
    (let [units (ia s O_LO)
          nj (ia s (+ area MB_NJ))]
      (if (and (sched2 s) (map-pair-ok p mt nj smap))
        (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
            (return 1)))
      (if (not (charge s (+ 1 units) pos)) (return (neg R_BUDGET)))
      (return 0))))

(defn ^:pub ^I32 map-keyq [^IntsR p ^Ints s ^I32 fb ^I32 area ^I32 nb ^I32 smap ^I32 kid ^I32 cfb ^I32 cw
                           ^I32 e ^I32 pos]
  (comment "The pair's key query: per block 1 unit and its cursor (unless map-pre did"
           "them), then each live block's key_ts. The query length or a code.")
  (let [^:mut cnq 0
        ^:mut bo area]
    (for [^I32 _bj 0 nb]
      (let [mt (block-mt p s fb bo)]
        (if (== smap 0)
          (do (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
              (if (!= (ia s (+ bo MB_ALIVE)) 0)
                (do (let [rc (map-cursor p s bo mt kid pos)]
                      (if (< rc (neg 1)) (return rc)))))))
        (if (!= (ia s (+ bo MB_ALIVE)) 0)
          (do (set cnq (map-key-query p s mt cfb cw cnq e pos))
              (if (< cnq 0) (return cnq))))
        (set bo (+ bo (map-words p mt)))))
    (return cnq)))

(defn ^:pub ^I32 map-cands [^IntsR p ^Ints s ^I32 fb ^I32 area ^I32 nb ^I32 cfb ^I32 cw ^I32 cnq ^I32 cl
                            ^I32 ccap ^I32 pos]
  (comment "The key's matched leaves stamped, then each live block's candidates. The"
           "pair's candidate count or a code.")
  (let [ek (q-stamp s cfb cw cnq pos)
        ^:mut nc 0
        ^:mut bo area]
    (if (< ek 0) (return ek))
    (for [^I32 _bk 0 nb]
      (let [mt (block-mt p s fb bo)]
        (if (!= (ia s (+ bo MB_ALIVE)) 0)
          (do (set nc (map-key-phase p s bo mt ek cl nc ccap pos))
              (if (< nc 0) (return nc))))
        (set bo (+ bo (map-words p mt)))))
    (return nc)))

(defn ^:pub ^I32 map-named-of [^IntsR s ^I32 cl ^I32 nc]
  (comment "Did some literal member name the pair's key? (its path segment is KEY)")
  (for [^I32 c 0 nc]
    (if (>= (ia s (+ (+ cl (* 4 c)) 3)) 0) (return 1)))
  (return 0))

(defn ^:pub ^I32 map-valq [^IntsR p ^Ints s ^I32 fb ^I32 cl ^I32 nc ^I32 cfb ^I32 cw ^I32 pos]
  (comment "The value's query: the candidates' value typesets. Its length or a code.")
  (let [e2 (new-epoch s)
        ^:mut vnq 0]
    (for [^I32 c2 0 nc]
      (let [vts (cand-vts p s fb cl c2)]
        (set vnq (q-add p s cfb cw vnq vts e2 pos)))
      (if (< vnq 0) (return vnq)))
    (return vnq)))

(defn ^:pub ^I32 map-after [^IntsR p ^Ints s ^I32 fb ^I32 w ^I32 area ^I32 nb ^I32 cl ^I32 cfb ^I32 cw
                            ^I32 vnq ^I32 kid ^I32 kpos ^I32 klen ^I32 pos]
  (comment "After the value: its matched leaves stamped, then per live block its"
           "candidates' value tests and the tier's update (map-update); a block no"
           "candidate of which accepts the pair dies (rule 3'). The live blocks"
           "left, or a code.")
  (let [ev (q-stamp s cfb cw vnq pos)
        ^:mut still 0
        ^:mut bo area]
    (if (< ev 0) (return ev))
    (for [^I32 _bl 0 nb]
      (let [mt (block-mt p s fb bo)]
        (if (!= (ia s (+ bo MB_ALIVE)) 0)
          (do (let [rv (map-values p s bo mt cl ev pos)]
                (if (< rv 0) (return rv)))
              (let [u (map-update p s bo mt cl kid kpos klen pos)]
                (if (< u 0) (return u))
                (if (== u 1)
                  (set still (+ still 1))
                  (do (let [qi (ia s bo)]
                        (if (> (ia s (+ bo MB_NC)) 0)
                          (q-set-flag s fb w qi (shl R_VALUE 8))
                          (q-set-flag s fb w qi (shl R_UNEXPECTED 8)))))))))
        (set bo (+ bo (map-words p mt)))))
    (return still)))

(defn ^:pub ^I32 map-close [^IntsR p ^Bytes pool ^Bytes b ^Bytes kb ^Ints s ^I32 fb ^I32 w ^I32 area ^I32 nb
                            ^I32 d ^I32 n ^I32 pos ^I32 q0 ^I32 q ^I32 nq ^I32 ctx ^Ext ext]
  (comment "The map's end, after its deferred duplicate check (D277): 1 unit per"
           "block, a live block's end run (map-end-block, kb holding its T records'"
           "keys); its records popped; the scalar leaves and combinators; then with"
           "no answer matched the witness of the lowest leaf that failed at the end"
           "(program-2 §8 rule 4'), else rule 1. 0 or a code.")
  (let [mark (map-mark p s fb area nb)
        ^:mut be area
        ^:mut best (neg 1)
        ^:mut bestbo 0]
    (for [^I32 _bm 0 nb]
      (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
      (let [mtm (block-mt p s fb be)]
        (if (!= (ia s (+ be MB_ALIVE)) 0)
          (do (let [rm (map-end-block p s be mtm kb pos)
                    qi (ia s be)]
                (if (< rm 0) (return rm))
                (if (== rm 1)
                  (q-set-flag s fb w qi F_MATCHED)
                  (do (q-set-flag s fb w qi (shl R_MISSING 8))
                      (let [lid (ia s (+ fb qi))]
                        (if (or (< best 0) (< lid best))
                          (do (set best lid) (set bestbo be)))))))))
        (set be (+ be (map-words p mtm)))))
    (if (>= mark 0) (arena-set-up s mark))
    (let [rs (eval-scalars p pool b s fb w nq pos q0 q 32 0 n (unit-of ctx))]
      (if (< rs 0) (return rs)))
    (let [m (finish-comb p pool b s fb w nq pos q ext)]
      (if (< m 0) (return m))
      (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
        (if (>= best 0)
          (do (let [wr (ia s (+ bestbo MB_E0))
                    wk (ia s (+ bestbo MB_E1))
                    wv (ia s (+ bestbo MB_E2))]
                (wit-set s wr 0 d wk wv pos)))
          (do (let [r1 (rule1 s fb w nq d pos)]
                (if (< r1 0) (return r1)))))))
    (return 0)))

(defn ^:pub ^I32 map-streak [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q0 ^I32 limit ^I32 end
                             ^I32 d ^I32 bo ^I32 mt ^I32 mode ^I32 cl ^I32 ps0 ^I32 pe0 ^I32 klo0]
  (comment "P3.6 (D044) under program-2 §6, schedule 2 only: consecutive SUCCESSFUL"
           "pairs of a single-block tier-F map in a simple shape (map-fast-mode: 1 a"
           "closed struct, the key named by one member whose value typeset is one"
           "streak leaf; 2 a pure table, its key and value one streak leaf each). The"
           "key (text, a valid head, UTF-8, ascending) and the value are checked"
           "first, uncharged; a pair that would not succeed (or would want a bound"
           "member with no room) stops the streak before it is touched. A taken pair"
           "is charged exactly as eval-map's pair-by-pair walk charges a simple pair"
           "(D045 ii: the key search's units and the pair's 1 at the map, the key's"
           "visit and UTF-8, the key order, the value's visit and probe; the"
           "cursor, queries, candidates, value tests and F walk free) and leaves the"
           "block as that walk does (cursor, candidate, member count, pair index)."
           "Answers the next position; the pair count in s[VM_FASTM], the last key in"
           "s[VM_FASTP], s[VM_FASTK], the next key-table bound in s[VM_FASTL]; the"
           "last pair's path segment written.")
  (let [named (m-named p mt)
        namers (m-namers p mt)
        nn (ia p (+ mt 2))
        maxit (ia s O_MAX_ITEMS)
        ^:mut kleaf (neg 1)
        ^:mut vleaf2 (neg 1)
        ^:mut q q0
        ^:mut k 0
        ^:mut ps ps0
        ^:mut pe pe0
        ^:mut klo klo0]
    (iset s VM_FASTM 0)
    (if (== mode 2)
      (do (set kleaf (single-leaf p (ia p (+ mt 9))))
          (set vleaf2 (single-leaf p (ia p (+ mt 10))))
          (if (or (not (streak-kind p kleaf)) (not (streak-kind p vleaf2))) (return q0))
          (if (!= (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 kleaf))) 255) K_TEXT) (return q0))))
    (while (and (< k limit) (< q end))
      (let [start q
            ib (u8 b start)
            ai (bit-and ib 31)
            ^:mut kh 1
            ^:mut kl ai
            ^:mut cur (ia s (+ bo MB_CUR))
            ^:mut nj (neg 1)
            ^:mut m 0]
        (local ^I32 vlf)
        (comment "the key: text, a shortest head, present, UTF-8, ascending")
        (if (!= (ushr ib 5) 3) (break))
        (if (> ai 25) (break))
        (if (>= ai 24)
          (do (set kh (+ 1 (shl 1 (- ai 24))))
              (if (> kh (- end start)) (break))
              (if (== ai 24) (set kl (u8 b (+ start 1))))
              (if (== ai 25) (set kl (be16 b (+ start 1))))
              (if (and (== ai 24) (< kl 24)) (break))
              (if (and (== ai 25) (< kl 256)) (break))))
        (if (> kl (- end (+ start kh))) (break))
        (if (> (+ (ia s O_ITEMS) 2) maxit) (break))
        (let [kend (+ (+ start kh) kl)]
          (if (== mode 2)
            (do (if (< (pre-scalar p pool b s start end (+ (ia p H_S_LEAVES) (* 8 kleaf)) K_TEXT) 0) (break)))
            (do (if (>= (utf8-invalid-at b (+ start kh) kend) 0) (break))))
          (if (>= ps 0) (if (>= (compare-spans b ps pe start kend) 0) (break)))
          (let [kid (key-probe p pool b s start kend klo)
                sk (ia s O_LO)
                nlo (ia s O_HI)]
            (if (== mode 1)
              (do (if (< kid 0) (break))
                  (while (and (< cur nn) (< (ia p (+ named (* 3 cur))) kid))
                    (set cur (+ cur 1)))
                  (if (or (>= cur nn) (!= (ia p (+ named (* 3 cur))) kid)) (break))
                  (if (!= (ia p (+ (+ named (* 3 cur)) 2)) 1) (break))
                  (set nj cur)
                  (set m (ia p (+ namers (ia p (+ (+ named (* 3 cur)) 1)))))
                  (set vlf (single-leaf p (ia p (+ (m-member mt m) 2))))
                  (if (not (streak-kind p vlf)) (break)))
              (do (comment "a pure table's cursor: no named keys")
                  (if (and (>= kid 0) (> nn 0)) (break))
                  (set vlf vleaf2)))
            (let [mw (+ (+ bo MB_HDR) (* MW m))
                  vend (pre-scalar p pool b s kend end (+ (ia p H_S_LEAVES) (* 8 vlf))
                                   (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 vlf))) 255))
                  vunits (ia s O_LO)]
              (if (< vend 0) (break))
              (if (>= (ia s mw) (ia s (+ mw 5))) (break))
              (comment "commit: the charges in the walk's order")
              (if (not (charge s (+ sk 1) pos)) (return (neg R_BUDGET)))
              (if (not (charge s 1 start)) (return (neg R_BUDGET)))
              (iset s O_ITEMS (+ (ia s O_ITEMS) 1))
              (if (not (charge s (c8 kl) start)) (return (neg R_BUDGET)))
              (let [ko (key-order b s ps pe start kend)]
                (if (< ko 0) (return ko)))
              (if (not (charge s 1 kend)) (return (neg R_BUDGET)))
              (iset s O_ITEMS (+ (ia s O_ITEMS) 1))
              (if (not (charge s (- vunits 3) kend)) (return (neg R_BUDGET)))
              (comment "the block, as the walk leaves it")
              (iset s (+ bo MB_CUR) cur)
              (iset s (+ bo MB_NJ) nj)
              (iset s (+ bo MB_CF) 0)
              (iset s (+ bo MB_NC) 1)
              (iset s cl bo)
              (iset s (+ cl 1) m)
              (iset s (+ cl 2) 2)
              (if (== mode 1)
                (iset s (+ cl 3) 0)
                (iset s (+ cl 3) (neg 2)))
              (iset s (+ bo MB_NP) (+ (ia s (+ bo MB_NP)) 1))
              (iset s mw (+ (ia s mw) 1))
              (if (== mode 1)
                (path-put s (+ d 1) P_KEY kid)
                (path-put s (+ d 1) P_ANYKEY 0))
              (set ps start)
              (set pe kend)
              (set klo nlo)
              (set q vend)
              (set k (+ k 1)))))))
    (iset s VM_FASTM k)
    (iset s VM_FASTP ps)
    (iset s VM_FASTK pe)
    (iset s VM_FASTL klo)
    (if (> k 0) (wit-clear s))
    (return q)))

(defn ^:pub ^I32 eval-map [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 q0 ^I32 n
                           ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^Ext ext]
  (comment "A map item (program-2 §6) after its head and container checks. Per pair:"
           "the scanner's key checks; the key's id, the blocks' cursors, the key's"
           "query, the key, its order; the candidates; the value with their value"
           "typesets; the tier updates. At the end the blocks' end runs, then the"
           "witness rules 3'/4'/1.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cfb (+ fb fw)
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        cose (and (== d 0) (!= (ia s O_COSE) 0))
        canon (!= (bit-and (ia s O_PROFILE) PF_CANON) 0)
        ^:mut q q0
        ^:mut ps (neg 1)
        ^:mut pe (neg 1)
        ^:mut klo 0
        ^:mut pk 0]
    (local ^:mut ^I32 nalive)
    (let [na (q-filter-x p s fb w nq 32 pos ctx)]
      (if (< na 0) (return na)))
    (let [nb (map-open p s fb w (- fw (* 2 w)) nq pos)]
      (if (< nb 0) (return nb))
      (set nalive nb)
      (let [cl (map-cl p s fb area nb)
            ccap (map-ccap p s fb area nb)
            smap (map-smode p s fb area nb)
            pend (count-pending p s fb w nq)]
        (while (< pk n)
          (comment "a streak of simple pairs first (D044), when the shape and state allow")
          (if (and (and (> smap 0) (and (sched2 s) (== nalive 1)))
                   (and (== (bit-and (ia s VM_GENERIC) (bit-or (bit-or 1 G_FORCED) G_NOSTREAK)) 0)
                        (and (== (ia s VM_VTAB) 0) (not (map-is-unordered s area nb)))))
            (do (let [^I32 qm (map-streak p pool b s pos q (- n pk) end d area (block-mt p s fb area) smap cl ps pe klo)
                      km2 (ia s VM_FASTM)]
                  (if (< qm 0) (return qm))
                  (if (> km2 0)
                    (do (set q qm)
                        (set pk (+ pk km2))
                        (set ps (ia s VM_FASTP))
                        (set pe (ia s VM_FASTK))
                        (set klo (ia s VM_FASTL)))))))
          (if (< pk n)
          (do (let [start q]
            (if (>= start end) (return (fail s start CODE_TRUNCATED)))
            (let [km (ushr (u8 b start) 5)]
              (if (!= km 3)
                (if (not (key-peek s km cose)) (return (fail s start CODE_KEY_TYPE))))
              (if (== nalive 0)
                (do (set q (dead-item b s start (+ d 1) end))
                    (if (< q 0) (return q))
                    (if (<= km 1)
                      (if (not (key-label b s start km)) (return (fail s start CODE_KEY_TYPE))))
                    (let [kod (key-order b s ps pe start q)]
                      (if (< kod 0) (return kod)))
                    (if (!= (ia s VM_VTAB) 0)
                      (do (let [rkd (replay-key s start)]
                            (if (< rkd 0) (return rkd)))))
                    (set ps start)
                    (set pe q)
                    (set q (dead-item b s q (+ d 1) end))
                    (if (< q 0) (return q)))
                (do (let [ke (key-span-end b start end)
                          ^:mut kid (neg 1)
                          ^:mut ps2 0]
                      (local ^I32 still)
                      (local ^I32 kq)
                      (local ^I32 vq)
                      (comment "Over a canonical copy (PF_CANON, P8.4) keys come in wire order:"
                               "from the first that does not ascend, every key search covers"
                               "the whole key table and every block searches its named table"
                               "(program-2 §6.1 step 1; uncharged, as the session does it).")
                      (if (and (> ke start) (and (>= ps 0) canon))
                        (if (>= (compare-spans b ps pe start ke) 0)
                          (map-unordered p s fb area nb)))
                      (if (map-is-unordered s area nb) (set klo 0))
                      (if (> ke start)
                        (do (set kid (key-search p pool b s start ke klo pos))
                            (if (== kid (neg 2)) (return (neg R_BUDGET)))
                            (set klo (ia s O_HI))))
                      (if (> smap 0)
                        (do (let [pr (map-pre p s fb area smap kid pos)]
                              (if (< pr 0) (return pr))
                              (set ps2 pr))))
                      (if (== ps2 1) (free-on s))
                      (let [e (new-epoch s)
                            cnq (map-keyq p s fb area nb smap kid cfb cw e pos)]
                        (free-off s)
                        (if (< cnq 0) (return cnq))
                        (if (> cnq 0)
                          (set kq (eval-item p pool b s start (+ d 1) cfb cck cnq end
                                             (bit-or CTX_KEY (simple-of p s ps2 cfb cnq)) ext))
                          (set kq (dead-item b s start (+ d 1) end)))
                        (if (< kq 0) (return kq))
                        (if (<= km 1)
                          (if (not (key-label b s start km)) (return (fail s start CODE_KEY_TYPE))))
                        (let [ko (key-order b s ps pe start kq)]
                          (if (< ko 0) (return ko)))
                        (if (!= (ia s VM_VTAB) 0)
                          (do (let [rk (replay-key s start)]
                                (if (< rk 0) (return rk)))))
                        (map-key-ecs p s fb area nb b start)
                        (set ps start)
                        (set pe kq)
                        (if (== ps2 1) (free-on s))
                        (let [nc (map-cands p s fb area nb cfb cw cnq cl ccap pos)]
                          (if (< nc 0) (do (free-off s) (return nc)))
                          (if (== (map-named-of s cl nc) 1)
                            (path-put s (+ d 1) P_KEY kid)
                            (path-put s (+ d 1) P_ANYKEY 0))
                          (let [vnq (map-valq p s fb cl nc cfb cw pos)]
                            (free-off s)
                            (if (< vnq 0) (return vnq))
                            (if (> vnq 0)
                              (set vq (eval-item p pool b s kq (+ d 1) cfb cck vnq end (simple-of p s ps2 cfb vnq) ext))
                              (set vq (dead-item b s kq (+ d 1) end)))
                            (if (< vq 0) (return vq))
                            (if (== ps2 1) (free-on s))
                            (set still (map-after p s fb w area nb cl cfb cw vnq kid start (- kq start) pos))
                            (free-off s)
                            (if (< still 0) (return still))
                            (set nalive still)
                            (if (or (> still 0) (> pend 0))
                              (wit-clear s)
                              (if (wit-empty s)
                                (if (> nc 0)
                                  (wit-set s R_VALUE 0 (+ d 1) (neg 1) 0 start)
                                  (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 start))))
                            (set q vq)))))))))
              (set pk (+ pk 1)))))
        (comment "Over a canonical copy: the map's deferred-check units and a recorded"
                 "refusal, before its end (D277, D280).")
        (if (!= (ia s VM_VTAB) 0)
          (do (let [rem (replay-end s q0)]
                (if (< rem 0) (return rem)))))
        (let [rc (map-close p pool b b s fb w area nb d n pos q0 q nq ctx ext)]
          (if (< rc 0) (return rc)))
        (return q)))))

;; ------------------------------------------------------------ the item

(defn ^:pub ^I32 eval-item [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^I32 pos ^I32 d ^I32 fb ^I32 ck
                            ^I32 nq ^I32 end ^I32 ctx ^Ext ext]
  (comment "One LIVE item at pos, physical depth d, query list (nq > 0 entries) in the"
           "frame at fb: visit (1 unit), counted, then its head -- the scanner's"
           "`item`, with the schema evaluated alongside.")
  (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
  (let [it (+ (ia s O_ITEMS) 1)]
    (iset s O_ITEMS it)
    (if (> it (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
  (if (>= pos end) (return (fail s pos CODE_TRUNCATED)))
  (let [ib (u8 b pos)
        major (ushr ib 5)
        ai (bit-and ib 31)
        cr (cset-rec p s ck)
        w (cset-width p cr)
        ^:mut hi 0
        ^:mut lo ai
        ^:mut q (+ pos 1)]
    (local ^:mut ^I32 stop)
    (if (< cr 0) (return (neg R_INCONSISTENT)))
    (if (>= ai 24)
      (do (if (== major 7)
            (if (and (>= ai 25) (<= ai 27))
              (do (set stop (scan-float b s pos ai end))
                  (if (< stop 0) (return stop))
                  (let [nf (q-filter-x p s fb w nq (item-cls 7 ai 0 0) pos ctx)]
                    (if (< nf 0) (return nf)))
                  (let [rf (eval-scalars p pool b s fb w nq pos (+ pos 1) stop (item-cls 7 ai 0 0) 0 0 (unit-of ctx))]
                    (if (< rf 0) (return rf)))
                  (let [ff (finish-scalar p pool b s fb w nq d pos stop ctx ext)]
                    (if (< ff 0) (return ff)))
                  (return stop))))
          (set q (read-arg b s pos ai end))
          (if (< q 0) (return (head-fail b s pos ai d q)))
          (set hi (ia s O_HI))
          (set lo (ia s O_LO))))
    (if (== major 4)
      (do (let [ra (enter-container s pos q hi lo d 0 end)]
            (if (< ra 0) (return ra)))
          (return (eval-array p pool b s pos q lo d fb ck nq end ctx ext))))
    (if (== major 5)
      (do (let [rm (enter-container s pos q hi lo d 1 end)]
            (if (< rm 0) (return rm)))
          (return (eval-map p pool b s pos q lo d fb ck nq end ctx ext))))
    (if (== major 6) (return (eval-tag p pool b s pos q hi lo d fb ck nq end ctx ext)))
    (set stop q)
    (if (== major 2)
      (do (set stop (take-len s pos q hi lo end))
          (if (< stop 0) (return stop))
          (let [rb (bstr-tail p pool b s pos q stop d fb ck nq ctx ext)]
            (if (< rb 0) (return rb)))
          (return stop)))
    (if (== major 3)
      (do (set stop (take-len s pos q hi lo end))
          (if (< stop 0) (return stop))
          (if (not (charge s (c8 (- stop q)) pos)) (return (neg R_BUDGET)))
          (let [bad (utf8-invalid-at b q stop)]
            (if (>= bad 0)
              (do (let [tbad2 (text-bad b s bad stop)]
                    (if (< tbad2 0) (return tbad2))))))))
    (if (== major 7)
      (do (let [r7 (scan-simple s pos ai)]
            (if (< r7 0) (return r7)))))
    (let [cls (item-cls major ai hi lo)
          nf2 (q-filter-x p s fb w nq cls pos ctx)]
      (if (< nf2 0) (return nf2))
      (let [r2 (eval-scalars p pool b s fb w nq pos q stop cls hi lo (unit-of ctx))]
        (if (< r2 0) (return r2)))
      (let [f2 (finish-scalar p pool b s fb w nq d pos stop ctx ext)]
        (if (< f2 0) (return f2)))
      (return stop))))

