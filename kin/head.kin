;; CBOR heads, by integer operations only (D009): a head's argument is up to
;; 64 bits and is carried as two i32 halves (o[O_HI], o[O_LO]) holding the bit
;; pattern; nothing becomes a host number.
;;
;; Every function returns a position (>= 0) or a NEGATED refusal code, and on
;; refusal records the offset it was decided at in o[O_ERR_POS].
(ns snug.cbor.head
  (:require [kin.lang :refer [defn let return set if do for comment declarefn forever]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR + - * neg shl bit-or bit-and
                               ushr < > <= >= == != and or not u8 ia iset]]
            [snug.cbor.codes :refer [CODE_TRUNCATED CODE_NON_SHORTEST
                                     CODE_INDEFINITE CODE_MALFORMED CODE_TRAILING
                                     CODE_TOO_MANY_ITEMS CODE_DEPTH
                                     CODE_TOO_MANY_ENTRIES
                                     O_ERR_POS O_ITEMS O_MAX_ITEMS O_MAX_DEPTH
                                     O_MAX_ENTRIES O_HI O_LO O_CSTART O_VCTL VC_NONDET
                                     O_PROFILE PF_VALID PF_VREL PF_T24V]]))

(declarefn wf-item)

(defn ^:pub ^I32 fail [^Ints o ^I32 at ^I32 code]
  (comment "Record where a refusal was decided; answer the negated code.")
  (iset o O_ERR_POS at)
  (return (neg code)))

(defn ^:pub ^I32 be16 [^Bytes b ^I32 p]
  (comment "The big-endian u16 at p (the caller checked p + 2 <= length).")
  (return (bit-or (shl (u8 b p) 8) (u8 b (+ p 1)))))

(defn ^:pub ^I32 be32 [^Bytes b ^I32 p]
  (comment "The big-endian 32-bit word at p as an i32 bit pattern (caller checked p + 4 <= length).")
  (return (bit-or (bit-or (shl (u8 b p) 24) (shl (u8 b (+ p 1)) 16))
                  (bit-or (shl (u8 b (+ p 2)) 8) (u8 b (+ p 3))))))

(defn ^:pub ^I32 read-arg [^Bytes b ^Ints o ^I32 pos ^I32 ai ^I32 end]
  (comment "The argument of the head at pos, whose additional information ai is"
           "24 or more: into o[O_HI], o[O_LO]; answers the position after the head."
           "28..30 are malformed and 31 indefinite (before anything is read); then"
           "the 1/2/4/8 argument bytes must remain; then the value must need its"
           "width (shortest form). The caller has checked that b[pos] exists."
           "Kept small on purpose: under V8's inlining limit, so it inlines into"
           "the item walk (P1.4).")
  (if (> ai 27)
    (do (if (== ai 31) (return (fail o pos CODE_INDEFINITE)))
        (return (fail o pos CODE_MALFORMED))))
  (let [p (+ pos 1)
        w (shl 1 (- ai 24))]
    (if (> w (- end p)) (return (fail o pos CODE_TRUNCATED)))
    (if (== w 8)
      (do (let [h8 (be32 b p)]
            (if (== h8 0) (return (fail o pos CODE_NON_SHORTEST)))
            (iset o O_HI h8)
            (iset o O_LO (be32 b (+ p 4)))
            (return (+ p 8)))))
    (let [^:mut v (u8 b p)
          ^:mut short false]
      (if (== w 1) (set short (< v 24)))
      (if (== w 2)
        (do (set v (bit-or (shl v 8) (u8 b (+ p 1))))
            (set short (< v 256))))
      (if (== w 4)
        (do (set v (be32 b p))
            (set short (== (ushr v 16) 0))))
      (if short
        (do (comment "f8 below 32 is not well-formed (RFC 8949 §3.3, D342)")
            (if (== (u8 b pos) 248) (return (fail o pos CODE_MALFORMED)))
            (return (fail o pos CODE_NON_SHORTEST))))
      (iset o O_HI 0)
      (iset o O_LO v)
      (return (+ p w)))))

(defn ^:pub ^I32 take-len [^Ints o ^I32 pos ^I32 p ^I32 hi ^I32 lo ^I32 end]
  (comment "The end of a payload of hi:lo bytes starting at p, or truncated --"
           "checked against what remains BEFORE anything else (cbor.mjs `length`).")
  (if (or (!= hi 0) (< lo 0)) (return (fail o pos CODE_TRUNCATED)))
  (if (> lo (- end p)) (return (fail o pos CODE_TRUNCATED)))
  (return (+ p lo)))

(defn ^:pub ^I32 count-item [^Ints o ^I32 pos]
  (comment "One more data item (cbor.mjs `item`: counted BEFORE its head is read).")
  (let [it (+ (ia o O_ITEMS) 1)]
    (iset o O_ITEMS it)
    (if (> it (ia o O_MAX_ITEMS)) (return (fail o pos CODE_TOO_MANY_ITEMS)))
    (return 0)))

(defn ^:pub ^I32 enter-container [^Ints o ^I32 pos ^I32 p ^I32 hi ^I32 lo
                                  ^I32 depth ^I32 pairs ^I32 end]
  (comment "An array (pairs 0) or map (pairs 1) of hi:lo entries whose head ends at"
           "p, at depth: depth bound, then the declared length against what remains"
           "(n bytes per entry, 2n per pair), then the entry bound -- cbor.mjs's order.")
  (if (>= depth (ia o O_MAX_DEPTH)) (return (fail o pos CODE_DEPTH)))
  (if (or (!= hi 0) (< lo 0)) (return (fail o pos CODE_TRUNCATED)))
  (let [left (- end p)]
    (if (== pairs 0)
      (if (> lo left) (return (fail o pos CODE_TRUNCATED)))
      (if (> lo (ushr left 1)) (return (fail o pos CODE_TRUNCATED)))))
  (if (> lo (ia o O_MAX_ENTRIES)) (return (fail o pos CODE_TOO_MANY_ENTRIES)))
  (return 0))

(defn ^:pub ^I32 bytes-content [^Bytes b ^Ints o ^I32 p ^I32 not-bytes ^I32 end]
  (comment "A tag's byte-string content at p (cbor.mjs `bytesContent`): NOT counted"
           "as an item and not a depth level. A non-byte-string is refused with"
           "not-bytes. Answers the content end; its start goes in o[O_CSTART].")
  (if (>= p end) (return (fail o p CODE_TRUNCATED)))
  (let [ib (u8 b p)
        ai (bit-and ib 31)]
    (if (!= (ushr ib 5) 2) (return (fail o p not-bytes)))
    (if (< ai 24)
      (do (let [e1 (take-len o p (+ p 1) 0 ai end)]
            (if (>= e1 0) (iset o O_CSTART (+ p 1)))
            (return e1))))
    (let [q (read-arg b o p ai end)]
      (if (< q 0) (return q))
      (let [e2 (take-len o p q (ia o O_HI) (ia o O_LO) end)]
        (if (>= e2 0) (iset o O_CSTART q))
        (return e2)))))

(defn ^:pub ^I32 head-size [^I32 ai]
  (comment "Bytes in a (valid) head with additional information ai.")
  (if (< ai 24) (return 1))
  (if (== ai 24) (return 2))
  (if (== ai 25) (return 3))
  (if (== ai 26) (return 5))
  (return 9))

(defn ^:pub ^I32 small-arg [^Bytes b ^I32 x]
  (comment "The argument of the ALREADY VALIDATED head at x, known to fit in 31 bits"
           "(a container length or payload length, which never exceeds the input).")
  (let [ai (bit-and (u8 b x) 31)]
    (if (< ai 24) (return ai))
    (if (== ai 24) (return (u8 b (+ x 1))))
    (if (== ai 25) (return (be16 b (+ x 1))))
    (if (== ai 26) (return (be32 b (+ x 1))))
    (return (be32 b (+ x 5)))))

(defn ^:pub ^I32 read-arg-v [^Bytes b ^Ints o ^I32 pos ^I32 ai ^I32 end]
  (comment "read-arg under PF_VALID (P8.4, D260), for the walks that admit valid"
           "CBOR: any width (a longer head than the value needs notes VC_NONDET: the"
           "input is not its canonical form). 28..30 are malformed; 31 is the"
           "caller's (an indefinite length, or a break). read-arg itself stays as it"
           "was, small enough to inline into the deterministic walk.")
  (if (> ai 27)
    (do (if (== ai 31) (return (fail o pos CODE_INDEFINITE)))
        (return (fail o pos CODE_MALFORMED))))
  (let [p (+ pos 1)
        w (shl 1 (- ai 24))]
    (if (> w (- end p)) (return (fail o pos CODE_TRUNCATED)))
    (let [^:mut hi 0
          ^:mut v (u8 b p)
          ^:mut short false]
      (if (== w 1) (set short (< v 24)))
      (if (== w 2)
        (do (set v (bit-or (shl v 8) (u8 b (+ p 1))))
            (set short (< v 256))))
      (if (== w 4)
        (do (set v (be32 b p))
            (set short (== (ushr v 16) 0))))
      (if (== w 8)
        (do (set hi (be32 b p))
            (set v (be32 b (+ p 4)))
            (set short (== hi 0))))
      (if short
        (do (let [c (ia o O_VCTL)]
              (iset o O_VCTL (bit-or c VC_NONDET)))))
      (iset o O_HI hi)
      (iset o O_LO v)
      (return (+ p w)))))

;; ------------------------------------------------------------ well-formed only (D358)
;; Under PF_VALID a tag-24 payload need only be well-formed (RFC 8949 §3.4.5.1):
;; one item, bounded by its byte string's end. The scanner, the VM (buffer walk,
;; live walk and resumable session) and so the identity gates share this walk.
;; It keeps the resource bounds (items, depth, entries) and the scanner's codes
;; and offsets for them; it checks nothing else: no key rule, no duplicate keys,
;; no UTF-8, no tag rule, no float or simple-value rule beyond Appendix F.

(defn ^:pub ^Bool wf-payload [^IntsR o]
  (comment "Is a tag-24 payload walked as well-formed only: a valid-CBOR run"
           "(PF_VALID, or PF_VREL in the VM) without PF_T24V?")
  (let [pf (ia o O_PROFILE)]
    (return (and (!= (bit-and pf (bit-or PF_VALID PF_VREL)) 0) (== (bit-and pf PF_T24V) 0)))))

(defn ^I32 wf-arg [^Bytes b ^Ints o ^I32 pos ^I32 ai ^I32 end]
  (comment "The argument of the head at pos, ai 24..27, at any width, into o[O_HI],"
           "o[O_LO]: the position after the head, or truncated (at pos).")
  (let [p (+ pos 1)
        w (shl 1 (- ai 24))]
    (if (> w (- end p)) (return (fail o pos CODE_TRUNCATED)))
    (let [^:mut hi 0
          ^:mut v (u8 b p)]
      (if (== w 2) (set v (bit-or (shl v 8) (u8 b (+ p 1)))))
      (if (== w 4) (set v (be32 b p)))
      (if (== w 8)
        (do (set hi (be32 b p))
            (set v (be32 b (+ p 4)))))
      (iset o O_HI hi)
      (iset o O_LO v)
      (return (+ p w)))))

(defn ^I32 wf-istr [^Bytes b ^Ints o ^I32 pos ^I32 major ^I32 end]
  (comment "An indefinite-length string: definite chunks of its major type to a"
           "break (malformed otherwise, truncated at the end of input).")
  (let [^:mut q (+ pos 1)]
    (forever
      (if (>= q end) (return (fail o q CODE_TRUNCATED)))
      (let [ib (u8 b q)
            ai (bit-and ib 31)]
        (if (== ib 255) (return (+ q 1)))
        (if (or (!= (ushr ib 5) major) (> ai 27)) (return (fail o q CODE_MALFORMED)))
        (let [^:mut p (+ q 1)
              ^:mut hi 0
              ^:mut lo ai]
          (if (>= ai 24)
            (do (set p (wf-arg b o q ai end))
                (if (< p 0) (return p))
                (set hi (ia o O_HI))
                (set lo (ia o O_LO))))
          (set q (take-len o q p hi lo end))
          (if (< q 0) (return q)))))))

(defn ^I32 wf-icont [^Bytes b ^Ints o ^I32 pos ^I32 pairs ^I32 depth ^I32 end]
  (comment "An indefinite-length array (pairs 0) or map (1): the depth bound, then"
           "entries to a break, too_many_entries (at the head) before the entry that"
           "would pass maxEntries; a break where a map value belongs is that value's"
           "own refusal (malformed).")
  (if (>= depth (ia o O_MAX_DEPTH)) (return (fail o pos CODE_DEPTH)))
  (let [inner (+ depth 1)
        ^:mut q (+ pos 1)
        ^:mut k 0]
    (forever
      (if (>= q end) (return (fail o q CODE_TRUNCATED)))
      (if (== (u8 b q) 255) (return (+ q 1)))
      (if (>= k (ia o O_MAX_ENTRIES)) (return (fail o pos CODE_TOO_MANY_ENTRIES)))
      (set q (wf-item b o q inner end))
      (if (< q 0) (return q))
      (if (!= pairs 0)
        (do (set q (wf-item b o q inner end))
            (if (< q 0) (return q))))
      (set k (+ k 1)))))

(defn ^:pub ^I32 wf-item [^Bytes b ^Ints o ^I32 pos ^I32 depth ^I32 end]
  (comment "One well-formed item at pos, depth `depth`, bounded by end: its end, or a"
           "negated code. Counted first, as the scanner counts.")
  (let [c (count-item o pos)]
    (if (< c 0) (return c)))
  (if (>= pos end) (return (fail o pos CODE_TRUNCATED)))
  (let [ib (u8 b pos)
        major (ushr ib 5)
        ai (bit-and ib 31)
        ^:mut hi 0
        ^:mut lo ai
        ^:mut p (+ pos 1)]
    (if (== ai 31)
      (do (if (or (== major 2) (== major 3)) (return (wf-istr b o pos major end)))
          (if (or (== major 4) (== major 5)) (return (wf-icont b o pos (- major 4) depth end)))
          (return (fail o pos CODE_MALFORMED))))
    (if (> ai 27) (return (fail o pos CODE_MALFORMED)))
    (if (>= ai 24)
      (do (set p (wf-arg b o pos ai end))
          (if (< p 0) (return p))
          (set hi (ia o O_HI))
          (set lo (ia o O_LO))))
    (if (<= major 1) (return p))
    (if (<= major 3) (return (take-len o pos p hi lo end)))
    (if (<= major 5)
      (do (let [pairs (- major 4)
                r (enter-container o pos p hi lo depth pairs end)
                inner (+ depth 1)
                ^:mut n lo
                ^:mut q p]
            (if (< r 0) (return r))
            (if (!= pairs 0) (set n (* 2 lo)))
            (for [^I32 _i 0 n]
              (set q (wf-item b o q inner end))
              (if (< q 0) (return q)))
            (return q))))
    (if (== major 6)
      (do (if (>= depth (ia o O_MAX_DEPTH)) (return (fail o pos CODE_DEPTH)))
          (return (wf-item b o p (+ depth 1) end))))
    (comment "major 7: f8 with a value below 32 is not well-formed (Appendix F)")
    (if (and (== ai 24) (< lo 32)) (return (fail o pos CODE_MALFORMED)))
    (return p)))

(defn ^:pub ^I32 wf-one [^Bytes b ^Ints o ^I32 cs ^I32 depth ^I32 ce]
  (comment "One well-formed item at cs that must end exactly at ce (a tag-24 payload):"
           "ce, or a negated code -- truncated when it runs past ce, trailing after it.")
  (let [r (wf-item b o cs depth ce)]
    (if (< r 0) (return r))
    (if (!= r ce) (return (fail o r CODE_TRAILING)))
    (return r)))
