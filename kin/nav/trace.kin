;; A deterministic trace of every navigation primitive over one checked
;; document, for the cross-host gate (kin/scripts/nav-test): JS and Rust run
;; the same trace and must answer the same words. Not part of the runtime.
;;
;; Every head of a checked document starts an item, so the items in preorder
;; are: from an item, its content start if it is an array, map or tag, else
;; its end. Per item the trace writes: position, end (nav-skip), length
;; (nav-length); per container every child position (nav-child) and the
;; directory (nav-dir); per map, for every key, nav-find and nav-dir-find of
;; that key's own bytes and of two spans that are no key: the key without its
;; last byte (a truncated item) and, when a byte follows, the key with that
;; byte (an item plus a byte); neither equals any complete encoding.
(ns snug.nav.trace
  (:require [kin.lang :refer [defn let return set if while for do comment]]
            [snug.lang :refer [I32 Bytes Ints + - < > >= == != or blen ia iset ilen]]
            [snug.nav.walk :refer [N_MAJOR NAV_SMALL nav-init nav-head nav-skip nav-length
                                   nav-child nav-find nav-dir nav-dir-find]]))

(defn ^I32 put [^Ints out ^I32 at ^I32 v]
  (comment "out[at] = v when it fits; answers at + 1 (the caller checks overflow at the end).")
  (if (< at (ilen out)) (iset out at v))
  (return (+ at 1)))

(defn ^I32 if-lt [^I32 a ^I32 x]
  (comment "1 when a < x, else 0.")
  (if (< a x) (return 1))
  (return 0))

(defn ^:pub ^I32 nav-trace [^Bytes b ^Ints o ^Ints d ^Ints out]
  (comment "The trace of b into out; answers the word count, or NAV_SMALL when out"
           "or d is too short.")
  (nav-init o 2147483647)
  (let [end (blen b)
        ^:mut q 0
        ^:mut w 0]
    (while (< q end)
      (let [e (nav-skip b o q end)
            n (nav-length b o q end)
            c (nav-head b o q end)
            major (ia o N_MAJOR)]
        (set w (put out w q))
        (set w (put out w e))
        (set w (put out w n))
        (if (< e 0) (return (- 0 1000)))
        (if (>= n 0)
          (do (for [^I32 i 0 n]
                (let [ch (nav-child b o q i end)]
                  (set w (put out w ch))))
              (if (!= major 6)
                (do (let [dn (nav-dir b o q d end)]
                      (set w (put out w dn))
                      (if (== dn NAV_SMALL) (return NAV_SMALL))
                      (if (== major 5)
                        (for [^I32 j 0 dn]
                          (let [ks (ia d j)
                                ke (nav-skip b o ks end)
                                f1 (nav-find b o q b ks ke end)
                                f2 (nav-dir-find b o d dn b ks ke end)]
                            (set w (put out w f1))
                            (set w (put out w f2))
                            (let [g1 (nav-find b o q b ks (- ke 1) end)
                                  g2 (nav-dir-find b o d dn b ks (- ke 1) end)
                                  after (if-lt ke end)
                                  g3 (nav-find b o q b ks (+ ke after) end)
                                  g4 (nav-dir-find b o d dn b ks (+ ke after) end)]
                              (set w (put out w g1))
                              (set w (put out w g2))
                              (set w (put out w g3))
                              (set w (put out w g4)))))))))))
        (if (or (< c 0) (> w (ilen out))) (return NAV_SMALL))
        (if (or (== major 4) (or (== major 5) (== major 6)))
          (set q c)
          (set q e))))
    (set w (put out w (ia o 4)))
    (if (> w (ilen out)) (return NAV_SMALL))
    (return w)))
