;; ------------------------------------------------------------ checked access

(defn ^:pub ^I32 oob [^Ints h]
  (comment "An index the compiler computed is outside the arena: a compiler bug."
           "Recorded as ERR_INTERNAL (sticky) and answered as 0.")
  (if (> (ilen h) H_ERR)
    (if (== (ia h H_ERR) 0) (iset h H_ERR ERR_INTERNAL)))
  (return 0))

(defn ^:pub ^I32 hg [^IntsR h ^I32 i]
  (comment "h[i], checked: an out-of-range read answers 0 (a read-only arena cannot"
           "record the fault; every write is checked and recorded, see `hs`).")
  (if (ult i (ilen h)) (return (ia h i)))
  (return 0))

(defn ^:pub hs [^Ints h ^I32 i ^I32 v]
  (comment "h[i] = v, checked.")
  (if (ult i (ilen h))
    (iset h i v)
    (oob h)))

(defn ^:pub ^Bool erred [^IntsR h]
  (return (!= (ia h H_ERR) 0)))

(defn ^:pub ^I32 fail [^Ints h ^I32 code ^I32 pos]
  (comment "Record the first error: its code, the source offset it is about (or"
           "-1) and the rule being compiled. Answers -1.")
  (if (== (ia h H_ERR) 0)
    (do (iset h H_ERR code)
        (iset h H_ERR_POS pos)
        (iset h H_ERR_RULE (ia h H_CUR_RULE))))
  (return (neg 1)))

(defn ^:pub ^Bool charge [^Ints h ^I32 n]
  (comment "Spend n compile-budget units (n >= 0); false (and ERR_LIM_BUDGET) when"
           "the budget is exhausted. Saturating: the budget never goes below -1.")
  (let [b (ia h H_BUDGET)]
    (if (> n b)
      (do (iset h H_BUDGET (neg 1))
          (fail h ERR_LIM_BUDGET (neg 1))
          (return false)))
    (iset h H_BUDGET (- b n))
    (return true)))

;; ------------------------------------------------------------ bump + vectors

(defn ^:pub ^I32 alloc [^Ints h ^I32 n]
  (comment "n words from the bump area (absolute address), or -1 with ERR_ARENA.")
  (let [top (ia h H_TOP)]
    (if (or (< n 0) (> n (- (ilen h) top)))
      (do (if (== (ia h H_ERR) 0) (iset h H_ERR ERR_ARENA))
          (return (neg 1))))
    (iset h H_TOP (+ top n))
    (return top)))

(defn ^:pub ^I32 vbase [^IntsR h ^I32 t]
  (return (hg h (+ H_TAB (* 3 t)))))

(defn ^:pub ^I32 vlen [^IntsR h ^I32 t]
  (return (hg h (+ (+ H_TAB (* 3 t)) 1))))

(defn ^:pub ^I32 vcap [^IntsR h ^I32 t]
  (return (hg h (+ (+ H_TAB (* 3 t)) 2))))

(defn ^:pub vinit [^Ints h ^I32 t]
  (comment "An empty vector with no storage.")
  (let [d (+ H_TAB (* 3 t))]
    (hs h d 0)
    (hs h (+ d 1) 0)
    (hs h (+ d 2) 0)))

(defn ^:pub ^Bool vreserve [^Ints h ^I32 t ^I32 n]
  (comment "Room for n more words in vector t (relocating it if needed).")
  (let [d (+ H_TAB (* 3 t))
        base (hg h d)
        len (hg h (+ d 1))
        cap (hg h (+ d 2))]
    (if (or (< n 0) (> n (- INF len)))
      (do (fail h ERR_INTERNAL (neg 1)) (return false)))
    (if (<= (+ len n) cap) (return true))
    (let [^:mut nc (+ cap cap)]
      (if (< cap 0) (set nc 0))
      (if (> cap (quot INF 2)) (set nc INF))
      (if (< nc (+ len n)) (set nc (+ len n)))
      (if (< nc 16) (set nc 16))
      (let [at (alloc h nc)]
        (if (< at 0) (return false))
        (for [^I32 i 0 len]
          (let [w (hg h (+ base i))]
            (hs h (+ at i) w)))
        (hs h d at)
        (hs h (+ d 2) nc)
        (return true)))))

(defn ^:pub ^I32 vpush [^Ints h ^I32 t ^I32 n]
  (comment "Append a zeroed record of n words; answers its offset, or -1.")
  (if (not (vreserve h t n)) (return (neg 1)))
  (let [d (+ H_TAB (* 3 t))
        base (hg h d)
        len (hg h (+ d 1))]
    (for [^I32 i 0 n]
      (hs h (+ (+ base len) i) 0))
    (hs h (+ d 1) (+ len n))
    (return len)))

(defn ^:pub ^I32 vpush1 [^Ints h ^I32 t ^I32 v]
  (comment "Append one word v; answers its offset, or -1.")
  (if (not (vreserve h t 1)) (return (neg 1)))
  (let [d (+ H_TAB (* 3 t))
        base (hg h d)
        len (hg h (+ d 1))]
    (hs h (+ base len) v)
    (hs h (+ d 1) (+ len 1))
    (return len)))

(defn ^:pub ^I32 vget [^IntsR h ^I32 t ^I32 off]
  (comment "Word off of vector t, checked against its length (0 when outside).")
  (let [d (+ H_TAB (* 3 t))]
    (if (ult off (hg h (+ d 1))) (return (hg h (+ (hg h d) off))))
    (return 0)))

(defn ^:pub vset [^Ints h ^I32 t ^I32 off ^I32 v]
  (let [d (+ H_TAB (* 3 t))
        n (hg h (+ d 1))
        at (+ (hg h d) off)]
    (if (ult off n)
      (hs h at v)
      (oob h))))

(defn ^:pub vadd [^Ints h ^I32 t ^I32 off ^I32 dv]
  (comment "vector t word off += dv.")
  (let [v (vget h t off)]
    (vset h t off (+ v dv))))

(defn ^:pub vtrunc [^Ints h ^I32 t ^I32 n]
  (comment "Shorten vector t to n words (n <= length).")
  (let [d (+ H_TAB (* 3 t))]
    (if (and (>= n 0) (<= n (hg h (+ d 1))))
      (hs h (+ d 1) n)
      (oob h))))

(defn ^:pub ^I32 vpop [^Ints h ^I32 t]
  (comment "Remove and answer the last word of vector t.")
  (let [n (vlen h t)]
    (if (<= n 0) (return (oob h)))
    (let [v (vget h t (- n 1))]
      (vtrunc h t (- n 1))
      (return v))))

(defn ^:pub vfill [^Ints h ^I32 t ^I32 from ^I32 n ^I32 v]
  (comment "Words from..from+n of vector t = v.")
  (for [^I32 i 0 n]
    (vset h t (+ from i) v)))

;; ------------------------------------------------------------ hashing

(defn ^:pub ^I32 mix [^I32 x ^I32 v]
  (comment "One step of a 32-bit FNV-1a-like mix over words; identical on every host.")
  (let [y (mul32 (bit-xor x v) 16777619)]
    (return (bit-xor y (ushr y 13)))))

;; An open-addressing hash table in vector t: words [count, mask] then
;; (mask + 1) slots of [id + 1, hash]; 0 marks an empty slot. Equality is the
;; CALLER's: it probes with `ht-start`/`ht-id`/`ht-next` and inserts at the
;; empty slot it stopped on. Rehashing needs only the stored hashes.

(defn ^:pub ^Bool ht-init [^Ints h ^I32 t ^I32 cap]
  (comment "An empty table of cap slots (a power of two).")
  (vtrunc h t 0)
  (let [at (vpush h t (+ 2 (* 2 cap)))]
    (if (< at 0) (return false))
    (vset h t 1 (- cap 1))
    (return true)))

(defn ^:pub ^I32 ht-start [^IntsR h ^I32 t ^I32 hsh]
  (return (bit-and hsh (vget h t 1))))

(defn ^:pub ^I32 ht-id [^IntsR h ^I32 t ^I32 s]
  (comment "The id stored in slot s, or -1 when the slot is empty.")
  (return (- (vget h t (+ 2 (* 2 s))) 1)))

(defn ^:pub ^I32 ht-next [^IntsR h ^I32 t ^I32 s]
  (return (bit-and (+ s 1) (vget h t 1))))

(defn ^:pub ^Bool ht-put [^Ints h ^I32 t ^I32 s ^I32 id ^I32 hsh]
  (comment "Store id in the EMPTY slot s the caller's probe stopped on; grows the"
           "table (rehashing by stored hash) past half full.")
  (vset h t (+ 2 (* 2 s)) (+ id 1))
  (vset h t (+ 3 (* 2 s)) hsh)
  (let [n (+ (vget h t 0) 1)
        cap (+ (vget h t 1) 1)]
    (vset h t 0 n)
    (if (<= (* n 2) cap) (return true))
    (comment "Rehash: copy the live slots out, re-initialise at twice the size, reinsert.")
    (vtrunc h T_MARK 0)
    (for [^I32 i 0 cap]
      (let [sid (vget h t (+ 2 (* 2 i)))
            sh (vget h t (+ 3 (* 2 i)))]
        (if (!= sid 0)
          (do (vpush1 h T_MARK sid)
              (vpush1 h T_MARK sh)))))
    (if (erred h) (return false))
    (if (not (charge h cap)) (return false))
    (if (not (ht-init h t (* cap 2))) (return false))
    (let [m (vlen h T_MARK)
          mask (vget h t 1)]
      (for [^I32 j 0 (quot m 2)]
        (let [xid (vget h T_MARK (* 2 j))
              xh (vget h T_MARK (+ (* 2 j) 1))
              ^:mut s2 (bit-and xh mask)]
          (while (!= (vget h t (+ 2 (* 2 s2))) 0)
            (set s2 (bit-and (+ s2 1) mask)))
          (vset h t (+ 2 (* 2 s2)) xid)
          (vset h t (+ 3 (* 2 s2)) xh)))
      (vset h t 0 (quot m 2)))
    (return (not (erred h)))))

;; ------------------------------------------------------------ sorting

(defn sift [^Ints h ^I32 t ^I32 off ^I32 start ^I32 n ^I32 stride]
  (comment "Heap sift-down of records (stride words, keyed by their first word)"
           "within vector t from record `start` of the n records at off.")
  (let [^:mut root start]
    (forever
     (let [child (+ (* root 2) 1)]
       (if (>= child n) (return))
       (let [^:mut big child]
         (if (< (+ child 1) n)
           (if (< (vget h t (+ off (* child stride))) (vget h t (+ off (* (+ child 1) stride))))
             (set big (+ child 1))))
         (if (>= (vget h t (+ off (* root stride))) (vget h t (+ off (* big stride))))
           (return))
         (for [^I32 k 0 stride]
           (let [a (vget h t (+ off (+ (* root stride) k)))
                 b (vget h t (+ off (+ (* big stride) k)))]
             (vset h t (+ off (+ (* root stride) k)) b)
             (vset h t (+ off (+ (* big stride) k)) a)))
         (set root big))))))

(defn ^:pub ^Bool sort-records [^Ints h ^I32 t ^I32 off ^I32 n ^I32 stride]
  (comment "Sort n records of `stride` words at offset off of vector t, ascending by"
           "their first word (heapsort: O(n log n), charged).")
  (if (< n 2) (return true))
  (let [^:mut lg 1
        ^:mut x n]
    (while (> x 1) (set lg (+ lg 1)) (set x (sar x 1)))
    (if (not (charge h (* (+ n 1) (* lg stride)))) (return false)))
  (let [^:mut i (- (quot n 2) 1)]
    (while (>= i 0)
      (sift h t off i n stride)
      (set i (- i 1))))
  (let [^:mut e (- n 1)]
    (while (> e 0)
      (for [^I32 k2 0 stride]
        (let [a2 (vget h t (+ off k2))
              b2 (vget h t (+ off (+ (* e stride) k2)))]
          (vset h t (+ off k2) b2)
          (vset h t (+ off (+ (* e stride) k2)) a2)))
      (sift h t off 0 e stride)
      (set e (- e 1))))
  (return (not (erred h))))

(defn ^:pub ^Bool msort-records [^Ints h ^I32 t ^I32 off ^I32 n ^I32 stride]
  (comment "STABLE sort of n records of `stride` words at offset off of vector t by"
           "their first word (bottom-up merge sort through T_MSORT; charged n per"
           "pass, so n log n in all).")
  (if (< n 2) (return true))
  (vtrunc h T_MSORT 0)
  (if (< (vpush h T_MSORT (* n stride)) 0) (return false))
  (let [^:mut width 1]
    (while (< width n)
      (if (not (charge h n)) (return false))
      (let [^:mut lo 0]
        (while (< lo n)
          (let [^:mut mid (+ lo width)
                ^:mut hi (+ lo (* 2 width))]
            (if (> mid n) (set mid n))
            (if (> hi n) (set hi n))
            (let [^:mut i lo
                  ^:mut j mid
                  ^:mut k lo]
              (while (< k hi)
                (let [^:mut take-left (< i mid)]
                  (if (and take-left (< j hi))
                    (if (> (vget h t (+ off (* i stride))) (vget h t (+ off (* j stride))))
                      (set take-left false)))
                  (let [^:mut src j]
                    (if take-left (set src i))
                    (for [^I32 w 0 stride]
                      (let [x (vget h t (+ off (+ (* src stride) w)))]
                        (vset h T_MSORT (+ (* k stride) w) x)))
                    (if take-left (set i (+ i 1)) (set j (+ j 1)))))
                (set k (+ k 1)))))
          (set lo (+ lo (* 2 width)))))
      (for [^I32 c 0 (* n stride)]
        (let [y (vget h T_MSORT c)]
          (vset h t (+ off c) y)))
      (set width (* width 2))))
  (return (not (erred h))))
