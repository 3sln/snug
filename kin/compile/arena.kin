;; The compiler's memory: ONE int arena `h` (an `Ints`) that the host allocates
;; and kin carves. Nothing in the compiler allocates host memory; everything
;; it builds -- tokens, the AST, leaves, typesets, maps, automata, and the
;; Program itself -- lives in growable VECTORS inside `h`.
;;
;; * The first H_DATA words are a header: globals, limits, return registers
;;   and one descriptor (base, len, cap) per vector.
;; * A vector grows by RELOCATION to the top of the bump area (old space is
;;   abandoned). So the compiler holds OFFSETS into a vector, never absolute
;;   addresses, across any push to that vector.
;; * When the bump area is exhausted the compile stops with ERR_ARENA and the
;;   host retries from scratch with a larger arena (up to ARENA_MAX_WORDS).
;;   The outcome never depends on the arena size: every limit and the compile
;;   budget are counted, not measured (D033).
;; * Every arena access is CHECKED (`hg`/`hs`): an index the compiler got
;;   wrong is a sticky ERR_INTERNAL, never a panic or an `undefined`.
;;
;; Errors are sticky too: `fail` records the first error (code, source offset,
;; rule) and answers -1; callers test `(erred h)` after anything that can fail.
(ns snug.compile.arena
  (:require [kin.lang :refer [defn let return set if while for do comment defconst forever]]
            [snug.lang :refer [I32 Bool Ints IntsR + - * neg quot shl sar ushr bit-and bit-or bit-xor mul32
                               < > <= >= == != and or not ult ia iset ilen]]))

;; ------------------------------------------------------------ error codes
;; Stable schema error codes (the host maps them to names: snug.compile.main
;; `error-name`). 1..3 never reach a caller: the host acts on them.
(defconst ^:pub ^I32 ERR_ARENA 1)
(defconst ^:pub ^I32 ERR_NEED_FLOATS 2)
(defconst ^:pub ^I32 ERR_INTERNAL 3)
(defconst ^:pub ^I32 ERR_SYNTAX 10)
(defconst ^:pub ^I32 ERR_LIM_TEXT 12)
(defconst ^:pub ^I32 ERR_LIM_NESTING 13)
(defconst ^:pub ^I32 ERR_LIM_AST 14)
(defconst ^:pub ^I32 ERR_LIM_INST 15)
(defconst ^:pub ^I32 ERR_LIM_ALTS 16)
(defconst ^:pub ^I32 ERR_LIM_APOS 17)
(defconst ^:pub ^I32 ERR_LIM_RPOS 18)
(defconst ^:pub ^I32 ERR_LIM_WIDTH 19)
(defconst ^:pub ^I32 ERR_LIM_POOL 20)
(defconst ^:pub ^I32 ERR_LIM_TOTAL 21)
(defconst ^:pub ^I32 ERR_LIM_BUDGET 22)
(defconst ^:pub ^I32 ERR_LIM_LEAVES 23)
(defconst ^:pub ^I32 ERR_LIM_MEMORY 24)
(defconst ^:pub ^I32 ERR_UNDEFINED 30)
(defconst ^:pub ^I32 ERR_DUPLICATE 31)
