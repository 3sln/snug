;; Lowering (architecture §5.1 steps 3-5): from the AST to internal leaves
;; and typesets, maps and automata.
;;
;; * `lower-type` turns a type expression into a typeset in a generic
;;   ENVIRONMENT (T_ENV: rule, argument typesets), memoised per (rule, env):
;;   generics are monomorphised, and the instantiation limit counts distinct
;;   environments (ERR_LIM_INST), so `g<T> = [g<[T, T]>]` is refused when its
;;   instantiations run out, not after building them.
;; * A rule reached again while it is being lowered, without a container in
;;   between, is nonproductive (ERR_NONPRODUCTIVE, §5.1 step 4).
;; * Containers (maps, arrays, tags, embedded CBOR) become leaves at once and
;;   are filled from a FIFO worklist afterwards, so recursion through a
;;   container is a reference, never a recursive call.
;; * Groups are expanded where they are used, into a PEG builder tree
;;   (snug.compile.peg, architecture §20, format 2.0): a group rule reached
;;   again inside its own expansion is a CALL of it (guarded recursion; left
;;   recursion is refused as ERR_GROUP_RECURSION once the group is complete).
;; * Undefined sockets: `$x` is the empty type choice, `$$x` the empty group
;;   choice -- no alternatives, so nothing matches through it (RFC 8610 §3.9;
;;   D251 corrects the earlier empty-group reading; §4.8).
;;
;; Recursion depth in here is bounded by h[H_DEPTH_MAX] (ERR_LIM_NESTING).
(ns snug.compile.lower
  (:require [kin.lang :refer [defn let return set if while for do comment defconst forever break declarefn]]
            [snug.lang :refer [I32 Bool Ints IntsR + - * neg quot shl sar ushr bit-and bit-or bit-not sub32
                               < > <= >= == != and or not]]
            [snug.compile.arena :refer [hg hs erred fail charge vlen vpush vpush1 vget vset vtrunc
                                        mix ht-init ht-start ht-id ht-next ht-put
                                        INF ERR_INTERNAL ERR_UNDEFINED ERR_KIND ERR_GENERIC
                                        ERR_NONPRODUCTIVE ERR_GROUP_RECURSION ERR_UNWRAP ERR_ENUM
                                        ERR_RANGE ERR_CONTROL_VALUE ERR_UNSUPPORTED_CONTROL
                                        ERR_UNKNOWN_CONTROL ERR_MAP_KEY ERR_SYNTAX ERR_TAG ERR_MAJOR
                                        ERR_PROFILE ERR_LIM_INST ERR_LIM_NESTING
                                        H_R0 H_R1 H_R2 H_R3 H_DEPTH H_DEPTH_MAX H_CUR_RULE H_LIM_INST
                                        H_N_INST H_PROFILE H_WORK_AT H_PMODE
                                        T_ENV T_HENV T_MEMO T_HMEMO T_CON T_HCON T_WORK T_ASTK T_STK
                                        T_LITB T_SRC T_PSTK T_GSTACK T_LSTK T_MAP T_ARR T_TMP2 T_IV
                                        T_EXTARG H_EXT_FLAGS]]
            [snug.compile.lex :refer [tk-kind tk-start tk-end tk-a tk-b tk-c
                                      TK_INT TK_FLOAT TK_TEXT TK_BYTES]]
            [snug.compile.parse :refer [nk ntok nnext na nb nc nd ne npos
                                        N_RULE N_TYPE N_RANGE N_CTL N_VALUE N_NAME N_MAP N_ARRAY
                                        N_UNWRAP N_ENUM N_TAG N_MAJOR N_ANY N_GROUP N_GRPCHOICE
                                        N_MEMBER N_ENT N_SUBGRP N_KEY KEY_BARE KEY_VALUE KEY_TYPE]]
            [snug.compile.rules :refer [rw rset rule-find rule-find-tok rule-kind param-index def-next
                                        nrules RK_TYPE RK_GROUP]]
            [snug.compile.bytes :refer [intern enc-string enc-int-key mag-of bid-byte bid-len head-push]]
            [snug.compile.leaf :refer [lk lflags ld lw lset lsetd leaf-new ts-make ts-of1 ts-push-leaves
                                       ts-n ts-leaf leaf-mask mk-any mk-major mk-simple-range mk-lit mk-text
                                       mk-bytes mk-int-range point-of fkey-hi fkey-lo mk-float-from bound-pred mag-pow u64-cmp
                                       stage stage-d stage-intern mk-and
                                       K_INT K_FLOAT K_LIT K_TAG K_TAGSET K_EMBED K_ARRAY K_MAP
                                       K_SIMPLE K_EXT
                                       R_NEG_INF R_NEG_BIG R_NEG R_POS R_POS_BIG R_POS_INF]]
            [snug.compile.ctl :refer [ctl-size ctl-bits ctl-compare ctl-eq ctl-and ctl-regexp ctl-cbor
                                      ctl-cat ctl-det ctl-plus int-point float-point single-leaf]]
            [snug.compile.peg :refer [peg-init peg-begin peg-finish pb-node pb-list pb-add pb-rep pm-new
                                      pgs-find pgs-push pgs-pop P_FAIL P_ENTRY P_MEMBER P_SEQ P_CHOICE P_CALL]]
            [snug.compile.ext :refer [builtin-ctl ext-lookup ext-max]]))

(declarefn ^I32 ext-arg ^I32 lower-type ^I32 p-ent ^I32 p-group ^I32 enum-group ^I32 enum-node ^I32 if-neg)

;; ------------------------------------------------------------ depth

(defn ^Bool enter [^Ints h ^I32 pos]
  (let [d (+ (hg h H_DEPTH) 1)]
    (hs h H_DEPTH d)
    (if (> d (hg h H_DEPTH_MAX)) (do (fail h ERR_LIM_NESTING pos) (return false)))
    (return true)))

(defn leave [^Ints h]
  (let [d (hg h H_DEPTH)]
    (hs h H_DEPTH (- d 1))))

;; ------------------------------------------------------------ environments

(defn ^:pub ^I32 env-rule [^IntsR h ^I32 e] (return (vget h T_ENV e)))
(defn ^:pub ^I32 env-nargs [^IntsR h ^I32 e] (return (vget h T_ENV (+ e 1))))
(defn ^:pub ^I32 env-parent [^IntsR h ^I32 e] (return (vget h T_ENV (+ e 2))))
(defn ^:pub ^I32 env-arg [^IntsR h ^I32 e ^I32 i] (return (vget h T_ENV (+ e (+ 3 i)))))

(defn ^Bool generic-ancestor [^IntsR h ^I32 env ^I32 rule]
  (comment "Is `rule` instantiated in env or any environment it was instantiated from?")
  (let [^:mut e env
        ^:mut steps 0]
    (while (and (>= e 0) (< steps 100000))
      (if (== (env-rule h e) rule) (return true))
      (set e (env-parent h e))
      (set steps (+ steps 1)))
    (return false)))

(defn ^I32 env-intern [^Ints h ^I32 rule ^I32 from ^I32 parent ^I32 pos]
  (comment "The environment (rule, T_ASTK[from..]), first made from environment"
           "`parent`; a new one counts against the instantiation limit. Records are"
           "rule, nargs, parent, args. T_ASTK is cut back to from.")
  (let [n (- (vlen h T_ASTK) from)
        ^:mut hsh (mix 77 rule)]
    (for [^I32 i 0 n]
      (set hsh (mix hsh (vget h T_ASTK (+ from i)))))
    (let [^:mut s (ht-start h T_HENV hsh)]
      (forever
       (let [id (ht-id h T_HENV s)]
         (if (< id 0) (break))
         (if (and (== (env-rule h id) rule) (== (env-nargs h id) n))
           (do (let [^:mut same true]
                 (for [^I32 j 0 n]
                   (if (!= (env-arg h id j) (vget h T_ASTK (+ from j))) (set same false)))
                 (if same (do (vtrunc h T_ASTK from) (return id))))))
         (set s (ht-next h T_HENV s))))
      (let [cnt (+ (hg h H_N_INST) 1)]
        (hs h H_N_INST cnt)
        (if (> cnt (hg h H_LIM_INST)) (return (fail h ERR_LIM_INST pos))))
      (let [e (vlen h T_ENV)]
        (vpush1 h T_ENV rule)
        (vpush1 h T_ENV n)
        (vpush1 h T_ENV parent)
        (for [^I32 k 0 n]
          (vpush1 h T_ENV (vget h T_ASTK (+ from k))))
        (vtrunc h T_ASTK from)
        (if (erred h) (return (neg 1)))
        (if (not (ht-put h T_HENV s e hsh)) (return (neg 1)))
        (comment "Its memo record: state, typeset.")
        (return e)))))

(defn ^I32 memo-find [^Ints h ^I32 env]
  (comment "The memo record (T_MEMO: env, state, ts) of a generic instance, made on"
           "first use.")
  (let [hsh (mix 91 env)
        ^:mut s (ht-start h T_HMEMO hsh)]
    (forever
     (let [id (ht-id h T_HMEMO s)]
       (if (< id 0) (break))
       (if (== (vget h T_MEMO (* id 3)) env) (return id))
       (set s (ht-next h T_HMEMO s))))
    (let [nid (quot (vlen h T_MEMO) 3)]
      (vpush1 h T_MEMO env)
      (vpush1 h T_MEMO 0)
      (vpush1 h T_MEMO (neg 1))
      (if (not (ht-put h T_HMEMO s nid hsh)) (return (neg 1)))
      (return nid))))

(defn ^I32 con-find [^Ints h ^I32 node ^I32 env]
  (comment "The container memo (T_CON: node, env, ts) for (node, env): its typeset"
           "or -1 when absent (h[H_R0] = the slot to insert at).")
  (let [hsh (mix (mix 13 node) env)
        ^:mut s (ht-start h T_HCON hsh)]
    (forever
     (let [id (ht-id h T_HCON s)]
       (if (< id 0) (do (hs h H_R0 s) (hs h H_R1 hsh) (return (neg 1))))
       (if (and (== (vget h T_CON (* id 3)) node) (== (vget h T_CON (+ (* id 3) 1)) env))
         (return (vget h T_CON (+ (* id 3) 2))))
       (set s (ht-next h T_HCON s))))))

(defn ^I32 con-put [^Ints h ^I32 node ^I32 env ^I32 ts]
  (let [s (hg h H_R0)
        hsh (hg h H_R1)
        id (quot (vlen h T_CON) 3)]
    (vpush1 h T_CON node)
    (vpush1 h T_CON env)
    (vpush1 h T_CON ts)
    (if (not (ht-put h T_HCON s id hsh)) (return (neg 1)))
    (return ts)))

(defn ^I32 container [^Ints h ^I32 kind ^I32 flags ^I32 node ^I32 env]
  (comment "A container leaf to be filled by the worklist; remembers the rule it"
           "belongs to (word 14) for error reports.")
  (let [l (leaf-new h kind flags)]
    (if (< l 0) (return (neg 1)))
    (lset h l 12 node)
    (lset h l 13 env)
    (lset h l 14 (hg h H_CUR_RULE))
    (vpush1 h T_WORK l)
    (return l)))

;; ------------------------------------------------------------ init

(defn ^:pub ^Bool lower-init [^Ints h]
  (vtrunc h T_ENV 0)
  (vtrunc h T_MEMO 0)
  (vtrunc h T_CON 0)
  (vtrunc h T_WORK 0)
  (vtrunc h T_GSTACK 0)
  (hs h H_WORK_AT 0)
  (if (not (ht-init h T_HENV 64)) (return false))
  (if (not (ht-init h T_HMEMO 64)) (return false))
  (if (not (peg-init h)) (return false))
  (return (ht-init h T_HCON 128)))

;; ------------------------------------------------------------ rules

(defn ^I32 lower-rule [^Ints h ^I32 r ^I32 env ^I32 pos]
  (comment "The typeset of type rule r in environment env (-1: not generic):"
           "the union of its definitions, memoised.")
  (let [^:mut memo (neg 1)
        ^:mut state (rw h r 8)]
    (if (>= env 0)
      (do (set memo (memo-find h env))
          (if (< memo 0) (return (neg 1)))
          (set state (vget h T_MEMO (+ (* memo 3) 1)))))
    (if (== state 2)
      (do (if (>= memo 0) (return (vget h T_MEMO (+ (* memo 3) 2))))
          (return (rw h r 9))))
    (if (== state 1) (return (fail h ERR_NONPRODUCTIVE pos)))
    (if (>= memo 0) (vset h T_MEMO (+ (* memo 3) 1) 1) (rset h r 8 1))
    (let [saved (hg h H_CUR_RULE)
          from (vlen h T_STK)]
      (if (== (rw h r 7) 0) (hs h H_CUR_RULE r))
      (let [^:mut d (rw h r 2)]
        (while (>= d 0)
          (let [^I32 ts (lower-type h (nd h d) env)]
            (if (< ts 0) (return (neg 1)))
            (ts-push-leaves h ts))
          (set d (def-next h d))))
      (hs h H_CUR_RULE saved)
      (let [res (ts-make h from)]
        (if (< res 0) (return (neg 1)))
        (if (>= memo 0)
          (do (vset h T_MEMO (+ (* memo 3) 1) 2)
              (vset h T_MEMO (+ (* memo 3) 2) res))
          (do (rset h r 8 2)
              (rset h r 9 res)))
        (return res)))))

(defn ^Bool socket-spelling [^IntsR h ^I32 tok ^I32 dollars]
  (comment "Does the name token start with `$` (dollars 1) or `$$` (2)?")
  (let [s (tk-start h tok)]
    (if (!= (vget h T_SRC s) 36) (return false))
    (if (== dollars 1) (return (!= (vget h T_SRC (+ s 1)) 36)))
    (return (== (vget h T_SRC (+ s 1)) 36))))

(defn ^I32 instance-env [^Ints h ^I32 r ^I32 args ^I32 nargs ^I32 env ^I32 pos]
  (comment "The environment for rule r applied to the generic arguments (a chain"
           "of type1 nodes lowered in env); -2 when r is not generic.")
  (if (!= nargs (rw h r 5)) (return (fail h ERR_GENERIC pos)))
  (if (== nargs 0) (return (neg 2)))
  (let [from (vlen h T_ASTK)
        ^:mut a args]
    (while (>= a 0)
      (let [^I32 ts (lower-type h a env)]
        (if (< ts 0) (return (neg 1)))
        (vpush1 h T_ASTK ts))
      (set a (nnext h a)))
    (comment "bindle and bus: generics may not recurse (architecture §5.3).")
    (if (and (> (hg h H_PROFILE) 0) (generic-ancestor h env r)) (return (fail h ERR_PROFILE pos)))
    (return (env-intern h r from env pos))))

(defn ^I32 lower-name [^Ints h ^I32 node ^I32 env]
  (comment "A type name: a generic parameter of env, or a type rule (with its"
           "arguments), or an undefined type socket (the empty type).")
  (let [tok (ntok h node)
        nargs (nb h node)
        pos (npos h node)]
    (if (and (>= env 0) (== nargs 0))
      (do (let [pi (param-index h (env-rule h env) tok)]
            (if (>= pi 0) (return (env-arg h env pi))))))
    (let [r (rule-find-tok h tok)]
      (if (< r 0)
        (do (if (socket-spelling h tok 1)
              (do (if (> (hg h H_PROFILE) 0) (return (fail h ERR_PROFILE pos)))
                  (return (ts-of1 h (neg 2)))))
            (if (socket-spelling h tok 2) (return (fail h ERR_KIND pos)))
            (return (fail h ERR_UNDEFINED pos))))
      (if (and (!= (rw h r 13) 0) (> (hg h H_PROFILE) 0)) (return (fail h ERR_PROFILE pos)))
      (let [k (rule-kind h r)]
        (if (< k 0) (return (neg 1)))
        (if (== k RK_GROUP) (return (fail h ERR_KIND pos))))
      (let [e (instance-env h r (na h node) nargs env pos)]
        (if (== e (neg 1)) (return (neg 1)))
        (if (== e (neg 2)) (return (lower-rule h r (neg 1) pos)))
        (return (lower-rule h r e pos))))))

;; ------------------------------------------------------------ literals

(defn ^I32 lower-value [^Ints h ^I32 node]
  (let [t (ntok h node)
        k (tk-kind h t)]
    (if (== k TK_INT)
      (do (let [mag (mag-of h T_LITB (tk-b h t) (tk-c h t))]
            (point-of h (tk-a h t) mag)
            (let [r (hg h H_R0) a (hg h H_R1) b (hg h H_R2)
                  l (mk-int-range h r a b r a b)]
              (return (ts-of1 h l))))))
    (if (== k TK_FLOAT)
      (do (let [kh (fkey-hi (tk-a h t))
                kl (fkey-lo (tk-a h t) (tk-b h t))]
            (vtrunc h T_TMP2 0)
            (vpush1 h T_TMP2 kh) (vpush1 h T_TMP2 kl) (vpush1 h T_TMP2 kh) (vpush1 h T_TMP2 kl)
            (let [fl (mk-float-from h 7 T_TMP2 1)]
              (return (ts-of1 h fl))))))
    (let [^:mut major 3]
      (if (== k TK_BYTES) (set major 2))
      (let [enc (enc-string h major T_LITB (tk-b h t) (tk-c h t))
            lit (mk-lit h enc)]
        (return (ts-of1 h lit))))))

(defn ^I32 lower-range [^Ints h ^I32 node ^I32 env]
  (let [^I32 lo (lower-type h (na h node) env)
        ^I32 hi (lower-type h (nb h node) env)
        incl (nc h node)
        pos (npos h node)]
    (if (or (< lo 0) (< hi 0)) (return (neg 1)))
    (if (int-point h lo)
      (do (let [lr (hg h H_R0) la (hg h H_R1) lb (hg h H_R2)]
            (if (not (int-point h hi)) (return (fail h ERR_RANGE pos)))
            (let [^:mut hr (hg h H_R0) ^:mut ha (hg h H_R1) ^:mut hb (hg h H_R2)]
              (if (== incl 0)
                (do (bound-pred h hr ha hb)
                    (set hr (hg h H_R0)) (set ha (hg h H_R1)) (set hb (hg h H_R2))))
              (let [l (mk-int-range h lr la lb hr ha hb)]
                (return (ts-of1 h l)))))))
    (if (float-point h lo)
      (do (let [lkh (hg h H_R0) lkl (hg h H_R1)]
            (if (not (float-point h hi)) (return (fail h ERR_RANGE pos)))
            (comment "D250: an inclusive upper bound is the point's highest key, an"
                     "exclusive one stops below its lowest (for zero: +0, and below -0).")
            (let [^:mut hkh (hg h H_R2) ^:mut hkl (hg h H_R3)]
              (if (== incl 0)
                (do (set hkh (hg h H_R0)) (set hkl (hg h H_R1))
                    (if (== hkl 0) (set hkh (sub32 hkh 1)))
                    (set hkl (sub32 hkl 1))))
              (comment "An empty range (lo > hi, or an exclusive one with nothing in it) is"
                       "the empty type.")
              (if (> (u64-cmp lkh lkl hkh hkl) 0) (return (ts-of1 h (neg 2))))
              (vtrunc h T_TMP2 0)
              (vpush1 h T_TMP2 lkh) (vpush1 h T_TMP2 lkl) (vpush1 h T_TMP2 hkh) (vpush1 h T_TMP2 hkl)
              (let [fl (mk-float-from h 7 T_TMP2 1)]
                (return (ts-of1 h fl)))))))
    (return (fail h ERR_RANGE pos))))

;; ------------------------------------------------------------ controls

(defn ^I32 ranged-ast [^IntsR h ^I32 n]
  (comment "1 if the controller expression is written as a range (through"
           "parentheses), else 0.")
  (let [^:mut x n]
    (while (and (>= x 0) (and (== (nk h x) N_TYPE) (== (nb h x) 1)))
      (set x (na h x)))
    (if (and (>= x 0) (== (nk h x) N_RANGE)) (return 1))
    (return 0)))

(defn ^I32 pack-name [^IntsR h ^I32 s ^I32 len ^I32 from]
  (comment "Bytes from..from+3 of the name at s as one little-endian word (0 past the end).")
  (let [^:mut w 0]
    (for [^I32 i 0 4]
      (if (< (+ from i) len)
        (set w (bit-or w (shl (vget h T_SRC (+ s (+ from i))) (* 8 i))))))
    (return w)))

(defn ^I32 ctl-code [^IntsR h ^I32 tok]
  (comment "The control's code from its name (TK_CTL: a = name start), or 0."
           "Names are matched as two packed words and the length (snug.compile.ext).")
  (let [s (tk-a h tok)
        len (- (tk-end h tok) s)
        w1 (pack-name h s len 0)
        w2 (pack-name h s len 4)]
    (return (builtin-ctl len w1 w2))))

;; ------------------------------------------------------------ extension controls (D140, D141)

(defn ^I32 ext-entries [^IntsR h ^I32 g]
  (comment "The entry count of an array's group when it is one choice of plain"
           "entries (no key, occurrence exactly one), else -1.")
  (if (or (< g 0) (!= (nb h g) 1)) (return (neg 1)))
  (let [gc (na h g)
        ^:mut e (na h gc)
        ^:mut n 0]
    (while (>= e 0)
      (if (!= (nk h e) N_ENT) (return (neg 1)))
      (if (or (!= (na h e) 1) (!= (nb h e) 1)) (return (neg 1)))
      (set n (+ n 1))
      (set e (nnext h e)))
    (return n)))

(defn ^I32 ext-arg-leaf [^Ints h ^I32 l ^I32 pos]
  (comment "Append the CBOR of a literal leaf to T_EXTARG: a LIT's encoding, a"
           "simple value, an integer, or an integer range lo..hi as [lo, hi]. 0 or -1.")
  (let [k (lk h l)]
    (if (== k K_LIT)
      (do (let [bid (ld h l 0)]
            (for [^I32 i 0 (bid-len h bid)]
              (let [c (bid-byte h bid i)] (vpush1 h T_EXTARG c))))
          (return 0)))
    (if (and (== k K_SIMPLE) (== (ld h l 0) (ld h l 1)))
      (do (let [v (ld h l 0)]
            (if (< v 24)
              (vpush1 h T_EXTARG (bit-or 224 v))
              (do (vpush1 h T_EXTARG 248) (vpush1 h T_EXTARG v))))
          (return 0)))
    (if (and (== k K_INT) (== (ld h l 1) 1))
      (do (let [o (* 6 (ld h l 0))
                lr (vget h T_IV o) la (vget h T_IV (+ o 1)) lb (vget h T_IV (+ o 2))
                hr (vget h T_IV (+ o 3)) ha (vget h T_IV (+ o 4)) hb (vget h T_IV (+ o 5))]
            (if (or (or (< lr R_NEG) (> lr R_POS)) (or (< hr R_NEG) (> hr R_POS)))
              (return (fail h ERR_CONTROL_VALUE pos)))
            (if (not (and (== lr hr) (and (== la ha) (== lb hb))))
              (vpush1 h T_EXTARG 130))
            (if (== lr R_POS) (head-push h T_EXTARG 0 la lb) (head-push h T_EXTARG 1 la lb))
            (if (not (and (== lr hr) (and (== la ha) (== lb hb))))
              (if (== hr R_POS) (head-push h T_EXTARG 0 ha hb) (head-push h T_EXTARG 1 ha hb)))
            (return 0))))
    (return (fail h ERR_CONTROL_VALUE pos))))

(defn ^I32 ext-arg [^Ints h ^I32 node ^I32 env]
  (comment "Append the CBOR encoding of an extension control's argument to T_EXTARG:"
           "a literal (text, bytes, an integer, a named simple value such as true),"
           "an integer range (as the array [lo, hi], inclusive), or an array of"
           "those. Anything else is ERR_CONTROL_VALUE. 0 or -1.")
  (let [pos (npos h node)]
    (if (not (enter h pos)) (return (neg 1)))
    (if (== (nk h node) N_TYPE)
      (do (if (!= (nb h node) 1) (return (fail h ERR_CONTROL_VALUE pos)))
          (let [r (ext-arg h (na h node) env)]
            (leave h)
            (return r))))
    (if (== (nk h node) N_ARRAY)
      (do (let [n (ext-entries h (na h node))]
            (if (< n 0) (return (fail h ERR_CONTROL_VALUE pos)))
            (head-push h T_EXTARG 4 0 n)
            (let [^:mut e (na h (na h (na h node)))]
              (while (>= e 0)
                (if (< (ext-arg h (nc h e) env) 0) (return (neg 1)))
                (set e (nnext h e))))
            (leave h)
            (return 0))))
    (let [^I32 ts (lower-type h node env)]
      (if (< ts 0) (return (neg 1)))
      (if (!= (ts-n h ts) 1) (return (fail h ERR_CONTROL_VALUE pos)))
      (let [r2 (ext-arg-leaf h (ts-leaf h ts 0) pos)]
        (leave h)
        (return r2)))))

(defn ^I32 lower-ext [^Ints h ^I32 node ^I32 env ^I32 id ^I32 pos]
  (comment "`target .name argument` for registered control id: one EXT leaf (id,"
           "the argument's encoding, the control's maximum item bytes) and, for each"
           "target leaf, AND(target leaf, EXT) -- the EXT never answers alone (D141).")
  (if (and (== (hg h H_PROFILE) 2) (== (hg h H_EXT_FLAGS) 0)) (return (fail h ERR_PROFILE pos)))
  (let [^I32 target (lower-type h (na h node) env)]
    (if (< target 0) (return (neg 1)))
    (vtrunc h T_EXTARG 0)
    (if (< (ext-arg h (nb h node) env) 0) (return (neg 1)))
    (let [bid (intern h T_EXTARG 0 (vlen h T_EXTARG))]
      (if (< bid 0) (return (neg 1)))
      (stage h K_EXT 0)
      (stage-d h 0 id)
      (stage-d h 1 bid)
      (stage-d h 2 (ext-max h id))
      (let [x (stage-intern h)
            from (vlen h T_STK)]
        (if (< x 0) (return (neg 1)))
        (if (not (charge h (ts-n h target))) (return (neg 1)))
        (for [^I32 i 0 (ts-n h target)]
          (let [a (mk-and h (ts-leaf h target i) x)]
            (if (< a 0) (return (neg 1)))
            (vpush1 h T_STK a)))
        (if (erred h) (return (neg 1)))
        (return (ts-make h from))))))

(defn ^I32 lower-ctl [^Ints h ^I32 node ^I32 env]
  (let [tok (nc h node)
        code (ctl-code h tok)
        pos (npos h node)]
    (if (== code 0)
      (do (let [nt (tk-a h tok)
                id (ext-lookup h nt (- (tk-end h tok) nt))]
            (if (< id 0) (return (fail h ERR_UNKNOWN_CONTROL pos)))
            (return (lower-ext h node env id pos)))))
    (comment ".pcre, .abnf, .abnfb: refused before anything is lowered (D013).")
    (if (>= code 19) (return (fail h ERR_UNSUPPORTED_CONTROL pos)))
    (let [^I32 target (lower-type h (na h node) env)]
      (if (< target 0) (return (neg 1)))
      (if (or (== code 14) (== code 15)) (return target))
      (if (or (== code 12) (== code 13))
        (do (if (and (== code 13) (> (hg h H_PROFILE) 0)) (return (fail h ERR_PROFILE pos)))
            (comment "RFC 8610 §3.8.4: a .cborseq controller is an array type describing"
                     "the sequence (the VM matches it as a virtual array, D040).")
            (if (== code 13)
              (do (let [^I32 cts (lower-type h (nb h node) env)]
                    (if (< cts 0) (return (neg 1)))
                    (for [^I32 i 0 (ts-n h cts)]
                      (if (!= (lk h (ts-leaf h cts i)) K_ARRAY) (return (fail h ERR_CONTROL_VALUE pos)))))))
            (let [cn (nb h node)
                  ^:mut flags 0]
              (if (== code 13) (set flags 1))
              (comment "One EMBED leaf per (control node, env): keyed by the N_CTL node, not"
                       "the controller, whose own container (an array, a map) has that key.")
              (let [^:mut ets (con-find h node env)]
                (if (< ets 0)
                  (do (let [el (container h K_EMBED flags cn env)]
                        (if (< el 0) (return (neg 1)))
                        (let [ts1 (ts-of1 h el)]
                          (con-find h node env)
                          (set ets (con-put h node env ts1))))))
                (return (ctl-cbor h target (ts-leaf h ets 0) pos))))))
      (let [^I32 ctl (lower-type h (nb h node) env)]
        (if (< ctl 0) (return (neg 1)))
        (if (== code 1) (return (ctl-size h target ctl (ranged-ast h (nb h node)) pos)))
        (if (== code 2) (return (ctl-bits h target ctl pos)))
        (if (and (>= code 3) (<= code 6)) (return (ctl-compare h target ctl (- code 3) pos)))
        (if (== code 7) (return (ctl-eq h target ctl 0 pos)))
        (if (== code 8) (return (ctl-eq h target ctl 1 pos)))
        (if (or (== code 9) (== code 10)) (return (ctl-and h target ctl)))
        (if (== code 11)
          (do (if (== (hg h H_PROFILE) 2) (return (fail h ERR_PROFILE pos)))
              (return (ctl-regexp h target ctl pos))))
        (if (== code 16) (return (ctl-cat h target ctl pos)))
        (if (== code 17) (return (ctl-det h target ctl pos)))
        (if (== code 18) (return (ctl-plus h target ctl pos)))
        (return (fail h ERR_INTERNAL pos))))))

;; ------------------------------------------------------------ tags, majors

(defn ^Bool bstr-content [^Ints h ^I32 content ^I32 env]
  (comment "Is the content exactly the unconstrained byte string (`bstr`, `bytes`"
           "of the prelude, or `#2`)? Then tag 2/3 IS a bignum range.")
  (if (or (or (< content 0) (!= (nk h content) N_TYPE)) (!= (nb h content) 1)) (return false))
  (let [c (na h content)]
    (if (== (nk h c) N_MAJOR) (return (and (== (na h c) 2) (== (nb h c) 2))))
    (if (or (!= (nk h c) N_NAME) (!= (nb h c) 0)) (return false))
    (if (and (>= env 0) (>= (param-index h (env-rule h env) (ntok h c)) 0)) (return false))
    (let [r (rule-find-tok h (ntok h c))]
      (if (or (< r 0) (== (rw h r 7) 0)) (return false))
      (comment "prelude `bstr` (4 bytes) or `bytes` (5)")
      (let [s (rw h r 0)
            len (rw h r 1)]
        (if (and (== len 4) (and (== (vget h T_SRC s) 98) (== (vget h T_SRC (+ s 1)) 115)))
          (return true))
        (if (and (== len 5) (and (== (vget h T_SRC s) 98) (== (vget h T_SRC (+ s 4)) 115)))
          (return true))
        (return false)))))

(defn ^I32 lower-tag [^Ints h ^I32 node ^I32 env]
  (let [mode (na h node)
        hi (nb h node)
        lo (nc h node)
        content (ne h node)
        pos (npos h node)]
    (let [memo (con-find h node env)]
      (if (>= memo 0) (return memo))
      (if (== mode 0)
        (do (if (and (== hi 0) (and (or (== lo 2) (== lo 3)) (bstr-content h content env)))
              (do (let [two64 (mag-pow h)
                        lp (mk-int-range h R_POS_BIG two64 9 R_POS_INF 0 0)
                        ln (mk-int-range h R_NEG_INF 0 0 R_NEG_BIG two64 9)
                        ^:mut l lp]
                    (if (== lo 3) (set l ln))
                    (let [ts (ts-of1 h l)]
                      (con-find h node env)
                      (return (con-put h node env ts))))))
            (let [tl (container h K_TAG 0 content env)]
              (if (< tl 0) (return (neg 1)))
              (lsetd h tl 0 hi)
              (lsetd h tl 1 lo)
              (lsetd h tl 2 (neg 1))
              (let [ts2 (ts-of1 h tl)]
                (con-find h node env)
                (return (con-put h node env ts2))))))
      (if (== mode 2)
        (do (if (< content 0)
              (do (let [mj (mk-major h 6)
                        ts3 (ts-of1 h mj)]
                    (con-find h node env)
                    (return (con-put h node env ts3)))))
            (let [sl (container h K_TAGSET 0 content env)]
              (if (< sl 0) (return (neg 1)))
              (lsetd h sl 0 0) (lsetd h sl 1 0) (lsetd h sl 2 (neg 1)) (lsetd h sl 3 (neg 1))
              (lsetd h sl 4 (neg 1))
              (let [ts4 (ts-of1 h sl)]
                (con-find h node env)
                (return (con-put h node env ts4))))))
      (comment "#6.<T>(C): one TAGSET per interval of T within 0..2^64-1.")
      (let [^I32 nts (lower-type h (nd h node) env)]
        (if (< nts 0) (return (neg 1)))
        (let [tl2 (single-leaf h nts)
              from (vlen h T_STK)]
          (if (or (< tl2 0) (!= (lk h tl2) K_INT)) (return (fail h ERR_TAG pos)))
          (for [^I32 i 0 (ld h tl2 1)]
            (let [o (* 6 (+ (ld h tl2 0) i))
                  ^:mut a1 (vget h T_IV (+ o 1))
                  ^:mut a2 (vget h T_IV (+ o 2))
                  ^:mut b1 (vget h T_IV (+ o 4))
                  ^:mut b2 (vget h T_IV (+ o 5))
                  lr (vget h T_IV o)
                  hr (vget h T_IV (+ o 3))]
              (if (and (<= lr R_POS) (>= hr R_POS))
                (do (if (< lr R_POS) (do (set a1 0) (set a2 0)))
                    (if (> hr R_POS) (do (set b1 (neg 1)) (set b2 (neg 1))))
                    (let [sl2 (container h K_TAGSET 0 content env)]
                      (if (< sl2 0) (return (neg 1)))
                      (lsetd h sl2 0 a1) (lsetd h sl2 1 a2) (lsetd h sl2 2 b1) (lsetd h sl2 3 b2)
                      (lsetd h sl2 4 (neg 1))
                      (vpush1 h T_STK sl2))))))
          (let [ts5 (ts-make h from)]
            (con-find h node env)
            (return (con-put h node env ts5))))))))

(defn ^I32 head7 [^Ints h ^I32 a ^I32 b ^I32 mode]
  (comment "RFC 9682 §3.2: the #7 head-numbers a..b (0 <= a <= b <= 255). 0..23 and"
           "32..255 are simple values; 24 stands for ai 24, i.e. every simple value"
           "32..255 (D284 makes f8 00..f8 1f malformed); 25..27 for the floats (D328:"
           "by value); 28..31 for nothing (no such data item). Answers bit 0 for 24 and"
           "bits 1..3 for 25..27. mode 1 pushes the simple ranges onto T_STK, mode 2"
           "only the one below 24 (24 is in, so 32..255 comes whole), mode 0 none.")
  (let [^:mut f 0]
    (for [^I32 w 24 28]
      (if (and (<= a w) (>= b w)) (set f (bit-or f (shl 1 (- w 24))))))
    (if (and (> mode 0) (<= a 23))
      (do (let [^:mut b1 b]
            (if (> b1 23) (set b1 23))
            (let [l1 (mk-simple-range h a b1)] (vpush1 h T_STK l1)))))
    (if (and (== mode 1) (>= b 32))
      (do (let [^:mut a2 a]
            (if (< a2 32) (set a2 32))
            (let [l2 (mk-simple-range h a2 b)] (vpush1 h T_STK l2)))))
    (return f)))

(defn ^I32 head7-end [^Ints h ^I32 f ^I32 from]
  (comment "head7's floats and ai 24 onto T_STK; the typeset of T_STK[from..].")
  (let [lf (mk-float-from h (sar f 1) T_TMP2 0)] (vpush1 h T_STK lf))
  (if (!= (bit-and f 1) 0)
    (do (let [l24 (mk-simple-range h 32 255)] (vpush1 h T_STK l24))))
  (return (ts-make h from)))

(defn ^I32 lower-head7 [^Ints h ^I32 nts ^I32 pos]
  (comment "#7.<T> (RFC 9682 §3.2): T's integers in 0..255 as head-numbers (head7);"
           "the rest of T matches nothing, as #6.<T> keeps only 0..2^64-1.")
  (let [tl (single-leaf h nts)
        from (vlen h T_STK)
        ^:mut f 0]
    (if (or (< tl 0) (!= (lk h tl) K_INT)) (return (fail h ERR_MAJOR pos)))
    (comment "pass 0 learns whether 24 is in; pass 1 pushes the simple ranges")
    (for [^I32 pass 0 2]
      (for [^I32 i 0 (ld h tl 1)]
        (let [o (* 6 (+ (ld h tl 0) i))
              lr (vget h T_IV o) la (vget h T_IV (+ o 1)) lb (vget h T_IV (+ o 2))
              hr (vget h T_IV (+ o 3)) ha (vget h T_IV (+ o 4)) hb (vget h T_IV (+ o 5))
              ^:mut a lb
              ^:mut b hb]
          (comment "clip the interval to 0..255 (b -1: nothing there)")
          (if (< lr R_POS) (set a 0))
          (if (or (> hr R_POS) (or (!= ha 0) (or (< hb 0) (> hb 255)))) (set b 255))
          (if (< hr R_POS) (set b (neg 1)))
          (if (or (> lr R_POS) (and (== lr R_POS) (or (!= la 0) (or (< lb 0) (> lb 255)))))
            (set b (neg 1)))
          (if (<= a b)
            (set f (bit-or f (head7 h a b (* pass (+ 1 (bit-and f 1))))))))))
    (return (head7-end h f from))))

(defn ^I32 lower-major [^Ints h ^I32 node ^I32 env]
  (let [m (na h node)
        mode (nb h node)
        hi (nc h node)
        lo (nd h node)
        pos (npos h node)]
    (if (== mode 2)
      (do (if (== m 0)
            (do (let [l0 (mk-int-range h R_POS 0 0 R_POS (neg 1) (neg 1))] (return (ts-of1 h l0)))))
          (if (== m 1)
            (do (let [l1 (mk-int-range h R_NEG (neg 1) (neg 1) R_NEG 0 0)] (return (ts-of1 h l1)))))
          (if (== m 2) (do (let [l2 (mk-bytes h 0 INF (neg 1))] (return (ts-of1 h l2)))))
          (if (== m 3) (do (let [l3 (mk-text h 0 INF (neg 1))] (return (ts-of1 h l3)))))
          (let [lm (mk-major h m)] (return (ts-of1 h lm)))))
    (if (== mode 1)
      (do (let [^I32 nts (lower-type h (ne h node) env)]
            (if (< nts 0) (return (neg 1)))
            (return (lower-head7 h nts pos)))))
    (if (or (or (!= m 7) (!= hi 0)) (or (< lo 0) (> lo 255))) (return (fail h ERR_MAJOR pos)))
    (let [from (vlen h T_STK)
          f (head7 h lo lo 0)]
      (head7 h lo lo (+ 1 (bit-and f 1)))
      (return (head7-end h f from)))))

;; ------------------------------------------------------------ containers

(defn ^I32 content-ts [^Ints h ^I32 cn ^I32 env]
  (comment "A tag's or embedded document's content: the type at node cn (-1: any).")
  (if (< cn 0)
    (do (let [any (mk-any h)] (return (ts-of1 h any)))))
  (return (lower-type h cn env)))

(defn ^I32 lower-map [^Ints h ^I32 node ^I32 env]
  (comment "One MAP leaf per map type: a top-level `//` is the PEG CHOICE of its"
           "group, prioritised and locking in (D270, R5), not separate leaves.")
  (let [memo (con-find h node env)]
    (if (>= memo 0) (return memo))
    (let [ml (container h K_MAP 0 (na h node) env)]
      (if (< ml 0) (return (neg 1)))
      (lsetd h ml 0 (neg 1))
      (let [ts (ts-of1 h ml)]
        (con-find h node env)
        (return (con-put h node env ts))))))

(defn ^I32 lower-array [^Ints h ^I32 node ^I32 env]
  (let [memo (con-find h node env)]
    (if (>= memo 0) (return memo))
    (let [al (container h K_ARRAY 0 (na h node) env)]
      (if (< al 0) (return (neg 1)))
      (lsetd h al 0 (neg 1))
      (let [ts (ts-of1 h al)]
        (con-find h node env)
        (return (con-put h node env ts))))))

(defn ^I32 lower-unwrap [^Ints h ^I32 node ^I32 env]
  (comment "`~name` as a type: the content of the named tag type(s).")
  (if (> (hg h H_PROFILE) 0) (return (fail h ERR_PROFILE (npos h node))))
  (let [ts (lower-name h node env)
        pos (npos h node)
        from (vlen h T_STK)]
    (if (< ts 0) (return (neg 1)))
    (for [^I32 i 0 (ts-n h ts)]
      (let [l (ts-leaf h ts i)
            k (lk h l)]
        (if (or (== k K_TAG) (== k K_TAGSET))
          (do (let [cts (content-ts h (lw h l 12) (lw h l 13))]
                (if (< cts 0) (return (neg 1)))
                (ts-push-leaves h cts)))
          (if (and (== k K_INT) (!= (lflags h l) 0))
            (do (comment "an unconstrained bignum tag: its content is a byte string")
                (let [bl (mk-bytes h 0 INF (neg 1))] (vpush1 h T_STK bl)))
            (return (fail h ERR_UNWRAP pos))))))
    (return (ts-make h from))))

;; ------------------------------------------------------------ the dispatch

(defn ^:pub ^I32 lower-type [^Ints h ^I32 node ^I32 env]
  (let [pos (npos h node)]
    (if (not (enter h pos)) (return (neg 1)))
    (if (not (charge h 1)) (return (neg 1)))
    (let [k (nk h node)
          ^:mut r (neg 1)]
      (if (== k N_TYPE)
        (do (let [from (vlen h T_STK)
                  ^:mut c (na h node)
                  ^:mut ok true]
              (while (and ok (>= c 0))
                (let [^I32 ts (lower-type h c env)]
                  (if (< ts 0) (set ok false) (ts-push-leaves h ts)))
                (set c (nnext h c)))
              (if ok (set r (ts-make h from)) (vtrunc h T_STK from)))))
      (if (== k N_VALUE) (set r (lower-value h node)))
      (if (== k N_NAME) (set r (lower-name h node env)))
      (if (== k N_RANGE) (set r (lower-range h node env)))
      (if (== k N_CTL) (set r (lower-ctl h node env)))
      (if (== k N_MAP) (set r (lower-map h node env)))
      (if (== k N_ARRAY) (set r (lower-array h node env)))
      (if (== k N_UNWRAP) (set r (lower-unwrap h node env)))
      (if (== k N_ENUM)
        (do (let [from2 (vlen h T_STK)]
              (if (>= (enum-node h node env) 0) (set r (ts-make h from2)) (vtrunc h T_STK from2)))))
      (if (== k N_TAG) (set r (lower-tag h node env)))
      (if (== k N_MAJOR) (set r (lower-major h node env)))
      (if (== k N_ANY) (do (let [al (mk-any h)] (set r (ts-of1 h al)))))
      (leave h)
      (if (erred h) (return (neg 1)))
      (if (< r 0) (return (fail h ERR_INTERNAL pos)))
      (return r))))

;; ------------------------------------------------------------ group references

(defn ^I32 ent-type [^IntsR h ^I32 ent]
  (comment "The type of a keyless entry: an N_ENT's, or the node itself when a group"
           "rule's definition was parsed as a type (`g1 = (g)` is `g1 = g`, a group by"
           "usage).")
  (if (== (nk h ent) N_TYPE) (return ent))
  (return (nc h ent)))

(defn ^I32 ent-lo [^IntsR h ^I32 ent]
  (if (== (nk h ent) N_TYPE) (return 1))
  (return (na h ent)))

(defn ^I32 ent-hi [^IntsR h ^I32 ent]
  (if (== (nk h ent) N_TYPE) (return 1))
  (return (nb h ent)))

(defn ^I32 group-ref [^Ints h ^I32 ty ^I32 env]
  (comment "If the type ty of a keyless entry is a reference to a group -- a group"
           "rule (with arguments), an undefined group socket, or `~name` -- answer: >="
           "0 the rule (environment in h[H_R0], -2 = not generic), -3 for an unwrap"
           "(node in h[H_R0]), -4 for an undefined `$$` socket; -2 when it is a plain"
           "type.")
  (let []
    (if (or (!= (nk h ty) N_TYPE) (!= (nb h ty) 1)) (return (neg 2)))
    (let [c (na h ty)]
      (if (== (nk h c) N_UNWRAP) (do (hs h H_R0 c) (return (neg 3))))
      (if (!= (nk h c) N_NAME) (return (neg 2)))
      (let [tok (ntok h c)]
        (if (and (>= env 0) (and (== (nb h c) 0) (>= (param-index h (env-rule h env) tok) 0)))
          (return (neg 2)))
        (let [r (rule-find-tok h tok)]
          (if (< r 0)
            (do (if (socket-spelling h tok 2)
                  (do (if (> (hg h H_PROFILE) 0) (return (fail h ERR_PROFILE (npos h c))))
                      (return (neg 4))))
                (return (neg 2))))
          (let [k (rule-kind h r)]
            (if (< k 0) (return (neg 1)))
            (if (!= k RK_GROUP) (return (neg 2))))
          (if (and (!= (rw h r 13) 0) (> (hg h H_PROFILE) 0)) (return (fail h ERR_PROFILE (npos h c))))
          (let [e (instance-env h r (na h c) (nb h c) env (npos h c))]
            (if (== e (neg 1)) (return (neg 1)))
            (hs h H_R0 e)
            (return r)))))))

(defn ^I32 gstack-find [^IntsR h ^I32 r ^I32 env]
  (comment "The index of (rule, env) on the group expansion stack, or -1.")
  (let [n (quot (vlen h T_GSTACK) 2)]
    (for [^I32 i 0 n]
      (if (and (== (vget h T_GSTACK (* 2 i)) r) (== (vget h T_GSTACK (+ (* 2 i) 1)) env))
        (return i)))
    (return (neg 1))))

(defn gstack-push [^Ints h ^I32 r ^I32 env]
  (vpush1 h T_GSTACK r)
  (vpush1 h T_GSTACK env))

(defn gstack-pop [^Ints h]
  (let [n (vlen h T_GSTACK)]
    (vtrunc h T_GSTACK (- n 2))))

(defn ^I32 env-of [^IntsR h]
  (comment "h[H_R0] as an environment (-2 means none: -1).")
  (let [e (hg h H_R0)]
    (if (< e 0) (return (neg 1)))
    (return e)))

;; ------------------------------------------------------------ maps

(defn ^I32 key-lit [^Ints h ^I32 ts]
  (comment "If the key typeset is one text literal or one integer value of major 0/1,"
           "answer its encoding bid (a literal key), else -1.")
  (let [l (single-leaf h ts)]
    (if (< l 0) (return (neg 1)))
    (if (and (== (lk h l) K_LIT) (== (sar (bid-byte h (ld h l 0) 0) 5) 3))
      (return (ld h l 0)))
    (if (int-point h ts)
      (do (let [r (hg h H_R0) a (hg h H_R1) b (hg h H_R2)]
            (if (or (== r R_POS) (== r R_NEG))
              (do (vtrunc h T_TMP2 0)
                  (head-push h T_TMP2 (if-neg r) a b)
                  (return (intern h T_TMP2 0 (vlen h T_TMP2))))))))
    (return (neg 1))))

(defn ^I32 if-neg [^I32 r]
  (if (== r R_NEG) (return 1))
  (return 0))

(defn ^I32 p-member [^Ints h ^I32 m ^I32 env]
  (comment "A member (map context): MEMBER(1, 1) over its record; p-ent applies the"
           "occurrence. A text or integer literal key is a key id; any other key (a"
           "typeset, or a byte-string, float or beyond-64-bit value before `:`, D294)"
           "is a key typeset, with or without a cut (R11).")
  (let [key (nc h m)
        kk (na h key)
        pos (npos h m)
        ^:mut kbid (neg 1)
        ^:mut kts (neg 1)
        cut (nb h key)
        ^:mut never false]
    (if (== kk KEY_BARE)
      (do (let [t (ntok h key)
                s (tk-start h t)]
            (set kbid (enc-string h 3 T_SRC s (- (tk-end h t) s))))))
    (if (== kk KEY_VALUE)
      (do (let [t2 (ntok h key)
                tk (tk-kind h t2)]
            (if (== tk TK_TEXT) (set kbid (enc-string h 3 T_LITB (tk-b h t2) (tk-c h t2))))
            (if (== tk TK_INT)
              (do (set kbid (enc-int-key h (tk-a h t2) T_LITB (tk-b h t2) (tk-c h t2)))
                  (if (< kbid 0) (set never true))))
            (if (or (== tk TK_BYTES) (== tk TK_FLOAT)) (set never true))
            (comment "bindle and bus: text and integer keys only")
            (if (and never (> (hg h H_PROFILE) 0)) (return (fail h ERR_PROFILE pos)))
            (comment "D294 (withdraws D125's map_cut refusal): the value is a key typeset"
                     "with the cut, matched by the key's actual representation.")
            (if never
              (do (set kbid (neg 1))
                  (set kts (lower-value h key))
                  (if (< kts 0) (return (neg 1))))))))
    (if (== kk KEY_TYPE)
      (do (if (and (== cut 1) (> (hg h H_PROFILE) 0)) (return (fail h ERR_PROFILE pos)))
          (set kts (lower-type h (nc h key) env))
          (if (< kts 0) (return (neg 1)))
          (set kbid (key-lit h kts))
          (if (>= kbid 0) (set kts (neg 1)))
          (if (and (< kbid 0) (> (hg h H_PROFILE) 0))
            (do (comment "bindle/bus: text and integer keys only")
                (for [^I32 i 0 (ts-n h kts)]
                  (if (!= (bit-and (leaf-mask h (ts-leaf h kts i)) (bit-not 11)) 0)
                    (return (fail h ERR_PROFILE pos))))))))
    (let [^I32 val (lower-type h (nd h m) env)]
      (if (< val 0) (return (neg 1)))
      (let [^:mut mkind 1
            ^:mut mkey kts]
        (if (>= kbid 0) (do (set mkind 0) (set mkey kbid)))
        (let [mr (pm-new h mkind mkey val cut pos)]
          (if (< mr 0) (return (neg 1)))
          (return (pb-node h P_MEMBER mr 1 1 pos)))))))

(defn ^I32 p-grouprule [^Ints h ^I32 r ^I32 env ^I32 pos]
  (comment "A group rule: its definitions as a CHOICE in rule order (App. C), or a"
           "CALL of the expansion of (rule, env) already open -- group recursion"
           "(R16; left recursion is refused once the group is complete).")
  (let [open (pgs-find h r env)]
    (if (>= open 0) (return (pb-node h P_CALL open 0 0 pos)))
    (let [node (pb-list h P_CHOICE pos)]
      (if (< node 0) (return (neg 1)))
      (pgs-push h r env node)
      (let [^:mut d (rw h r 2)]
        (while (>= d 0)
          (let [^I32 s (p-ent h (nd h d) env)]
            (if (< s 0) (return (neg 1)))
            (pb-add h node s))
          (set d (def-next h d))))
      (pgs-pop h)
      (return node))))

(defn ^I32 p-unwrap [^Ints h ^I32 un ^I32 env]
  (comment "`~name` in a group: the groups of the named map / array types as a CHOICE"
           "in the typeset's (creation) order; in an array, a tag's content as an"
           "entry (R17, X14). Unwrapping a container whose group is being expanded"
           "is a CALL of that expansion.")
  (if (> (hg h H_PROFILE) 0) (return (fail h ERR_PROFILE (npos h un))))
  (let [ts (lower-name h un env)
        pos (npos h un)
        mode (hg h H_PMODE)]
    (if (< ts 0) (return (neg 1)))
    (let [alt (pb-list h P_CHOICE pos)]
      (if (< alt 0) (return (neg 1)))
      (for [^I32 i 0 (ts-n h ts)]
        (let [l (ts-leaf h ts i)
              k (lk h l)
              ^:mut child (neg 1)]
          (if (or (== k K_MAP) (== k K_ARRAY))
            (do (let [g (lw h l 12)
                      e (lw h l 13)
                      ukey (- (neg 2) g)
                      open (pgs-find h ukey e)]
                  (if (>= open 0)
                    (set child (pb-node h P_CALL open 0 0 pos))
                    (do (let [frame (pb-list h P_CHOICE pos)]
                          (if (< frame 0) (return (neg 1)))
                          (pgs-push h ukey e frame)
                          (let [^I32 sub (p-group h g e)]
                            (if (< sub 0) (return (neg 1)))
                            (pb-add h frame sub))
                          (pgs-pop h)
                          (set child frame)))))))
          (if (or (== k K_TAG) (== k K_TAGSET))
            (do (if (== mode 1) (return (fail h ERR_MAP_KEY pos)))
                (let [cts (content-ts h (lw h l 12) (lw h l 13))]
                  (if (< cts 0) (return (neg 1)))
                  (set child (pb-node h P_ENTRY cts 0 0 pos)))))
          (if (and (== k K_INT) (!= (lflags h l) 0))
            (do (if (== mode 1) (return (fail h ERR_MAP_KEY pos)))
                (comment "an unconstrained bignum tag: its content is a byte string")
                (let [bl (mk-bytes h 0 INF (neg 1))
                      bts (ts-of1 h bl)]
                  (set child (pb-node h P_ENTRY bts 0 0 pos)))))
          (if (< child 0)
            (do (if (erred h) (return (neg 1)))
                (return (fail h ERR_UNWRAP pos))))
          (pb-add h alt child)))
      (return alt))))

(defn ^I32 p-ent [^Ints h ^I32 ent ^I32 env]
  (comment "One group entry: ENTRY (arrays: member keys are labels) or MEMBER (maps),"
           "a parenthesised group, a group rule, an unwrap, or an unplugged `$$`"
           "socket (FAIL, R14 / D251); the occurrence applied by pb-rep. `n*m` with"
           "m < n is refused (D293).")
  (let [pos (npos h ent)
        k (nk h ent)
        lo (ent-lo h ent)
        ^:mut hi (ent-hi h ent)
        mode (hg h H_PMODE)]
    (if (not (enter h pos)) (return (neg 1)))
    (if (< hi 0) (set hi INF))
    (if (< hi lo) (return (fail h ERR_SYNTAX pos)))
    (let [^:mut child (neg 1)]
      (if (== k N_MEMBER)
        (if (== mode 0)
          (do (let [^I32 vt (lower-type h (nd h ent) env)]
                (if (< vt 0) (return (neg 1)))
                (set child (pb-node h P_ENTRY vt 0 0 pos))))
          (set child (p-member h ent env))))
      (if (== k N_SUBGRP) (set child (p-group h (nc h ent) env)))
      (if (or (== k N_ENT) (== k N_TYPE))
        (do (let [gr (group-ref h (ent-type h ent) env)]
              (if (== gr (neg 1)) (return (neg 1)))
              (if (== gr (neg 2))
                (do (if (== mode 1) (return (fail h ERR_MAP_KEY pos)))
                    (let [^I32 vt2 (lower-type h (ent-type h ent) env)]
                      (if (< vt2 0) (return (neg 1)))
                      (set child (pb-node h P_ENTRY vt2 0 0 pos)))))
              (if (== gr (neg 4)) (set child (pb-node h P_FAIL (neg 1) 0 0 pos)))
              (if (== gr (neg 3)) (set child (p-unwrap h (hg h H_R0) env)))
              (if (>= gr 0) (set child (p-grouprule h gr (env-of h) pos))))))
      (leave h)
      (if (< child 0) (return (neg 1)))
      (return (pb-rep h child lo hi pos)))))

(defn ^I32 p-group [^Ints h ^I32 g ^I32 env]
  (comment "A group: a CHOICE, in source order, of SEQs of its entries.")
  (let [alt (pb-list h P_CHOICE (npos h g))
        ^:mut c (na h g)]
    (if (< alt 0) (return (neg 1)))
    (while (>= c 0)
      (let [sq (pb-list h P_SEQ (npos h c))
            ^:mut e (na h c)]
        (if (< sq 0) (return (neg 1)))
        (while (>= e 0)
          (let [^I32 s (p-ent h e env)]
            (if (< s 0) (return (neg 1)))
            (pb-add h sq s))
          (set e (nnext h e)))
        (pb-add h alt sq))
      (set c (nnext h c)))
    (return alt)))

(defn ^I32 process-group [^Ints h ^I32 l ^I32 mode]
  (comment "Fill an ARRAY (mode 0) or MAP (mode 1) leaf: its group's PEG program and"
           "table (snug.compile.peg).")
  (let [g (lw h l 12)
        env (lw h l 13)]
    (peg-begin h mode)
    (let [^I32 root (p-group h g env)]
      (if (< root 0) (return (neg 1)))
      (let [id (peg-finish h root (npos h g))]
        (if (< id 0) (return (neg 1)))
        (lsetd h l 0 id)
        (return 0)))))

;; ------------------------------------------------------------ enumerations

(defn ^I32 enum-ent [^Ints h ^I32 ent ^I32 env]
  (comment "Push the value types of one entry (recursively through groups).")
  (let [k (nk h ent)
        pos (npos h ent)]
    (if (not (enter h pos)) (return (neg 1)))
    (if (== k N_MEMBER)
      (do (let [^I32 vt (lower-type h (nd h ent) env)]
            (if (< vt 0) (return (neg 1)))
            (ts-push-leaves h vt))))
    (if (== k N_SUBGRP)
      (if (< (enum-group h (nc h ent) env) 0) (return (neg 1))))
    (if (or (== k N_ENT) (== k N_TYPE))
      (do (let [gr (group-ref h (ent-type h ent) env)]
            (if (== gr (neg 1)) (return (neg 1)))
            (if (== gr (neg 2))
              (do (let [^I32 vt2 (lower-type h (ent-type h ent) env)]
                    (if (< vt2 0) (return (neg 1)))
                    (ts-push-leaves h vt2))))
            (if (== gr (neg 3)) (return (fail h ERR_ENUM pos)))
            (if (>= gr 0)
              (do (let [e2 (env-of h)]
                    (if (>= (gstack-find h gr e2) 0) (return (fail h ERR_GROUP_RECURSION pos)))
                    (gstack-push h gr e2)
                    (let [^:mut d (rw h gr 2)]
                      (while (>= d 0)
                        (if (< (enum-ent h (nd h d) e2) 0) (return (neg 1)))
                        (set d (def-next h d))))
                    (gstack-pop h)))))))
    (leave h)
    (return 0)))

(defn ^I32 enum-group [^Ints h ^I32 g ^I32 env]
  (let [^:mut c (na h g)]
    (while (>= c 0)
      (let [^:mut e (na h c)]
        (while (>= e 0)
          (if (< (enum-ent h e env) 0) (return (neg 1)))
          (set e (nnext h e))))
      (set c (nnext h c)))
    (return 0)))

(defn ^I32 enum-node [^Ints h ^I32 node ^I32 env]
  (comment "`&(group)` or `&name<args>`: push every value type of the group.")
  (let [g (na h node)
        pos (npos h node)]
    (if (>= g 0) (return (enum-group h g env)))
    (let [tok (ntok h node)
          r (rule-find-tok h tok)]
      (if (< r 0) (return (fail h ERR_UNDEFINED pos)))
      (let [k (rule-kind h r)]
        (if (< k 0) (return (neg 1)))
        (if (!= k RK_GROUP) (return (fail h ERR_ENUM pos))))
      (let [e (instance-env h r (nb h node) (nc h node) env pos)
            ^:mut e2 e]
        (if (== e (neg 1)) (return (neg 1)))
        (if (== e (neg 2)) (set e2 (neg 1)))
        (if (>= (gstack-find h r e2) 0) (return (fail h ERR_GROUP_RECURSION pos)))
        (gstack-push h r e2)
        (let [^:mut d (rw h r 2)]
          (while (>= d 0)
            (if (< (enum-ent h (nd h d) e2) 0) (return (neg 1)))
            (set d (def-next h d))))
        (gstack-pop h)
        (return 0)))))

;; ------------------------------------------------------------ the worklist

(defn ^:pub ^I32 process-work [^Ints h]
  (comment "Fill every container leaf, in creation order, until none is left.")
  (forever
   (let [at (hg h H_WORK_AT)]
     (if (>= at (vlen h T_WORK)) (return 0))
     (hs h H_WORK_AT (+ at 1))
     (let [l (vget h T_WORK at)
           k (lk h l)
           saved (hg h H_CUR_RULE)]
       (hs h H_CUR_RULE (lw h l 14))
       (if (or (or (== k K_TAG) (== k K_TAGSET)) (== k K_EMBED))
         (do (let [cts (content-ts h (lw h l 12) (lw h l 13))]
               (if (< cts 0) (return (neg 1)))
               (if (== k K_TAG) (lsetd h l 2 cts))
               (if (== k K_TAGSET) (lsetd h l 4 cts))
               (if (== k K_EMBED) (lsetd h l 0 cts)))))
       (if (== k K_ARRAY)
         (if (< (process-group h l 0) 0) (return (neg 1))))
       (if (== k K_MAP)
         (if (< (process-group h l 1) 0) (return (neg 1))))
       (hs h H_CUR_RULE saved)
       (if (erred h) (return (neg 1)))))))

(defn ^:pub ^I32 lower-rules [^Ints h]
  (comment "Lower every schema type rule that is not generic (source order), then"
           "the worklist. Answers 0 or -1.")
  (let [n (nrules h)]
    (for [^I32 r 0 n]
      (if (and (== (rw h r 7) 0) (== (rw h r 5) 0))
        (do (let [k (rule-kind h r)]
              (if (< k 0) (return (neg 1)))
              (if (== k RK_TYPE)
                (do (hs h H_CUR_RULE r)
                    (if (< (lower-rule h r (neg 1) (npos h (rw h r 2))) 0)
                      (return (neg 1)))
                    (if (< (process-work h) 0) (return (neg 1))))))))))
  (hs h H_CUR_RULE (neg 1))
  (return (process-work h)))
