;; Lowering to the Program (architecture §5.1 steps 6-7; docs/program.md,
;; format 1, exactly).
;;
;; 1. NUMBERING (program.md §4, §17 q11): a depth-first preorder walk of the
;;    schema's non-generic type rules in source order numbers each live leaf
;;    when first reached; children are visited in a fixed order (a map: its
;;    alternatives' literal entries in source order, then its pools' group
;;    entries, key before value; an array: its positions; a tag or embedded
;;    document: its content; ANY and bare #4/#5/#6: TS_ANY; AND/NOT: their
;;    operands). The walk is iterative (an explicit stack), so no schema can
;;    exhaust a host stack. Typeset ids follow the order typesets are first
;;    reached (hash-consed by their final content).
;; 2. Final typesets with evaluation lists (operands first, §5); residual
;;    groups (hash-consed, ids by first use); the key table (sorted by
;;    encoding); the pool in program.md §15.1's order (rule names, keys,
;;    literals, bignum magnitudes, .bits masks; identical strings share).
;; 3. CLOSURE (§10): per rule, R_0 = its typeset's evaluation list and
;;    R_k+1 = the evaluation lists of the children of R_k, until a repetition,
;;    an empty set or depth D; frame and regex words per set, scratch words
;;    per rule (§12). The width limit applies to every R_k.
;; 4. Sizes first, then the total-bytes check (refused before the Program is
;;    written), then every section in order.
(ns snug.compile.emit
  (:require [kin.lang :refer [defn let return set if while for do comment defconst forever break declarefn]]
            [snug.lang :refer [I32 Bool Ints IntsR + - * neg quot shl sar ushr bit-and bit-or bit-not ult
                               < > <= >= == != and or not]]
            [snug.compile.arena :refer [hg hs erred fail charge vlen vpush vpush1 vget vset vtrunc vfill
                                        mix ht-init ht-start ht-id ht-next ht-put sort-records msort-records
                                        INF ERR_INTERNAL ERR_LIM_LEAVES ERR_LIM_WIDTH ERR_LIM_POOL ERR_LIM_TOTAL ERR_PROFILE
                                        H_PROFILE H_LIM_DEPTH H_LIM_INPUT H_LIM_ENTRIES H_LIM_ITEMS
                                        H_LIM_BIGNUM H_LIM_VBUDGET H_LIM_TOTAL H_LIM_WIDTH H_LIM_POOL
                                        H_LIM_LEAVES H_TS_ANY H_N_FIN H_OUT_P H_OUT_PN H_OUT_B H_OUT_BN
                                        H_EPOCH H_R0 H_WALK_RULE H_CUR_RULE
                                        T_LEAF T_TS T_TSL T_FIN T_ORD T_CHILD T_PSTK T_FTS T_FTSL T_HFTS
                                        T_GRP T_GRPD T_HGRP T_POOLG T_KEYS T_KEYID T_POOL T_POOLOFF T_RORD
                                        T_LAUX T_RXF T_MAP T_MAPD T_ARR T_ARRD T_IV T_FIV T_LST T_SRC
                                        T_CSET T_CSD T_HCSET T_CHAIN T_CHD T_HCHAIN T_EPOCHS T_CLS T_CLS2
                                        T_RSCR T_OUT T_TMP T_TMP2 T_STK T_FTSI T_RXD vbase T_KEYTRI T_LRULE T_REP T_CLSID T_CSIG T_HSIG
                                        T_NCLS T_CONT]]
            [snug.compile.bytes :refer [intern bid-len bid-byte bid-cmp nbids sort-bids]]
            [snug.compile.leaf :refer [lk lflags ld lw lset lsetd nleaves ts-off ts-n ts-w ts-setw
                                       leaf-mask mk-any ts-of1 nts
                                       K_ANY K_MAJOR K_INT K_FLOAT K_SIMPLE K_LIT K_LITSET K_TEXT
                                       K_BYTES K_UINTX K_TAG K_TAGSET K_EMBED K_ARRAY K_MAP K_AND K_NOT
                                       R_NEG_BIG R_POS_BIG]]
            [snug.compile.regexp :refer [rx-npos rx-w rx-natoms rx-nullable rx-data rx-count]]
            [snug.compile.rules :refer [rw nrules RK_TYPE]]
            [snug.compile.parse :refer [npos]]))

;; ------------------------------------------------------------ liveness

(defn ^:pub mark-dead [^Ints h]
  (comment "A map with no satisfiable alternative is dead; so is an AND with a dead"
           "operand and a NOT with a dead target. Operands are always older leaves,"
           "so one pass in creation order settles it. The flag is leaf word 9.")
  (for [^I32 l 0 (nleaves h)]
    (let [k (lk h l)
          ^:mut dead 0]
      (if (and (== k K_MAP) (== (ld h l 2) 1)) (set dead 1))
      (if (and (== k K_AND) (or (!= (lw h (ld h l 0) 9) 0) (!= (lw h (ld h l 1) 9) 0))) (set dead 1))
      (if (and (== k K_NOT) (!= (lw h (ld h l 0) 9) 0)) (set dead 1))
      (lset h l 9 dead))))

(defn ^Bool dead [^IntsR h ^I32 l] (return (!= (lw h l 9) 0)))

(defn ^:pub ^I32 rep [^IntsR h ^I32 l]
  (comment "The representative of leaf l's equivalence class (itself unless"
           "canonicalise merged it).")
  (if (ult l (vlen h T_REP)) (return (vget h T_REP l)))
  (return l))

;; ------------------------------------------------------------ children

(defn ^:pub ^I32 any-ts [^Ints h]
  (comment "The internal typeset {ANY} (made on first need).")
  (let [t (hg h H_TS_ANY)]
    (if (>= t 0) (return t))
    (let [a (mk-any h)
          ts (ts-of1 h a)]
      (hs h H_TS_ANY ts)
      (return ts))))

(defn push2 [^Ints h ^I32 t ^I32 a ^I32 b]
  (vpush1 h t a)
  (vpush1 h t b))

(defn ^:pub ^I32 children [^Ints h ^I32 l ^I32 dst]
  (comment "Push leaf l's children onto vector dst as (kind, id) pairs: kind 0 an"
           "internal typeset, kind 1 a leaf (AND/NOT operands). Answers the count.")
  (let [k (lk h l)
        start (vlen h dst)]
    (if (or (== k K_ANY) (and (== k K_MAJOR) (and (>= (ld h l 0) 4) (<= (ld h l 0) 6))))
      (do (let [a (any-ts h)] (push2 h dst 0 a))))
    (if (== k K_TAG) (push2 h dst 0 (ld h l 2)))
    (if (== k K_TAGSET) (push2 h dst 0 (ld h l 4)))
    (if (== k K_EMBED) (push2 h dst 0 (ld h l 0)))
    (if (or (== k K_AND) (== k K_NOT))
      (do (push2 h dst 1 (ld h l 0))
          (push2 h dst 1 (ld h l 1))))
    (if (== k K_ARRAY)
      (do (let [blob (vget h T_ARR (ld h l 0))
                npos (vget h T_ARRD blob)
                w (vget h T_ARRD (+ blob 1))
                pb (+ (+ blob 4) (* 2 w))]
            (for [^I32 p 0 npos]
              (push2 h dst 0 (vget h T_ARRD (+ pb (* 2 p))))))))
    (if (== k K_MAP)
      (do (let [mblob (vget h T_MAP (ld h l 0))
                nf (vget h T_MAPD mblob)
                np (vget h T_MAPD (+ mblob 1))
                fb (+ mblob 4)
                mpb (+ fb (* 3 nf))
                ab (+ mpb (* 5 np))]
            (for [^I32 f 0 nf]
              (let [pf (vget h T_MAPD (+ fb (+ (* 3 f) 1)))
                    pc (vget h T_MAPD (+ fb (+ (* 3 f) 2)))]
                (for [^I32 p2 pf (+ pf pc)]
                  (let [prec (+ mpb (* 5 p2))
                        af (vget h T_MAPD (+ prec 3))
                        ac (vget h T_MAPD (+ prec 4))]
                    (for [^I32 a2 af (+ af ac)]
                      (let [arec (+ ab (* 3 a2))
                            lo (+ mblob (vget h T_MAPD (+ arec 1)))
                            ln (vget h T_MAPD (+ arec 2))]
                        (for [^I32 i 0 ln]
                          (push2 h dst 0 (vget h T_MAPD (+ lo (+ (* 4 i) 1)))))))
                    (let [go (vget h T_MAPD (+ prec 1))
                          gn (vget h T_MAPD (+ prec 2))]
                      (if (>= go 0)
                        (for [^I32 g 0 gn]
                          (push2 h dst 0 (vget h T_MAPD (+ (+ mblob go) (* 4 g))))
                          (push2 h dst 0 (vget h T_MAPD (+ (+ mblob go) (+ (* 4 g) 1))))))))))))))
    (return (quot (- (vlen h dst) start) 2))))

;; ------------------------------------------------------------ numbering (pass 1)
;; Frames in T_PSTK, 4 words: child run offset (in T_CHILD), count, cursor, spare.

(defn ^Bool push-frame [^Ints h ^I32 off ^I32 n]
  (vpush1 h T_PSTK off)
  (vpush1 h T_PSTK n)
  (vpush1 h T_PSTK 0)
  (vpush1 h T_PSTK 0)
  (return (not (erred h))))

(defn reach-ts [^Ints h ^I32 ts]
  (comment "First reach of internal typeset ts: record it, then visit its live leaves.")
  (if (!= (ts-w h ts 5) 0) (return))
  (ts-setw h ts 5 1)
  (vpush1 h T_ORD ts)
  (let [off (vlen h T_CHILD)
        o (ts-off h ts)
        n (ts-n h ts)]
    (for [^I32 i 0 n]
      (let [l (vget h T_TSL (+ o i))]
        (push2 h T_CHILD 1 l)))
    (push-frame h off n)))

(defn reach-leaf [^Ints h ^I32 l0]
  (comment "First reach of a live leaf (its class representative, see canonicalise):"
           "number it, then visit its children.")
  (let [l (rep h l0)]
  (if (or (dead h l) (>= (lw h l 11) 0)) (return))
  (let [id (hg h H_N_FIN)]
    (hs h H_N_FIN (+ id 1))
    (lset h l 11 id)
    (vpush1 h T_FIN l)
    (comment "the rule whose walk first reached it, for error reports")
    (vpush1 h T_LRULE (hg h H_WALK_RULE)))
  (let [off (vlen h T_CHILD)
        n (children h l T_CHILD)]
    (push-frame h off n))))

(defn ^:pub ^I32 number-from [^Ints h ^I32 ts]
  (comment "The preorder walk from a rule's typeset.")
  (reach-ts h ts)
  (forever
   (let [nf (vlen h T_PSTK)]
     (if (== nf 0) (return 0))
     (if (erred h) (return (neg 1)))
     (if (not (charge h 1)) (return (neg 1)))
     (let [fr (- nf 4)
           off (vget h T_PSTK fr)
           n (vget h T_PSTK (+ fr 1))
           cur (vget h T_PSTK (+ fr 2))]
       (if (>= cur n)
         (do (vtrunc h T_PSTK fr)
             (vtrunc h T_CHILD off))
         (do (vset h T_PSTK (+ fr 2) (+ cur 1))
             (let [kind (vget h T_CHILD (+ off (* 2 cur)))
                   id (vget h T_CHILD (+ off (+ (* 2 cur) 1)))]
               (if (== kind 0) (reach-ts h id) (reach-leaf h id)))))))))

;; ------------------------------------------------------------ final typesets (pass 2)
;; T_FTS records, 5 words: answers offset (T_FTSL), n_ans, eval offset, n_eval, hash.

(defn ^:pub ^I32 fts-n [^IntsR h] (return (quot (vlen h T_FTS) 5)))
(defn ^:pub ^I32 fts-w [^IntsR h ^I32 t ^I32 w] (return (vget h T_FTS (+ (* t 5) w))))

(defn ^I32 fin [^IntsR h ^I32 l] (return (lw h (rep h l) 11)))
(defn ^I32 fin-internal [^IntsR h ^I32 f] (return (vget h T_FIN f)))

(defn ^I32 next-epoch [^Ints h]
  (let [e (+ (hg h H_EPOCH) 1)]
    (hs h H_EPOCH e)
    (return e)))

(defn ^I32 eval-list [^Ints h ^I32 ans ^I32 n]
  (comment "Append to T_FTSL the evaluation list of the answers T_FTSL[ans, ans+n)"
           "(final ids, ascending): every answer and every operand dependency once,"
           "combinators after their operands, dependencies as ~id. Iterative"
           "post-order with an explicit stack (T_TMP2: leaf, state). Answers the"
           "length. Epoch marks per final leaf in T_EPOCHS (2 words: visited, answer).")
  (let [ev (next-epoch h)
        ea (next-epoch h)
        start (vlen h T_FTSL)]
    (for [^I32 i 0 n]
      (let [f (vget h T_FTSL (+ ans i))]
        (vset h T_EPOCHS (+ (* 2 f) 1) ea)))
    (for [^I32 j 0 n]
      (let [root (vget h T_FTSL (+ ans j))]
        (vtrunc h T_TMP2 0)
        (push2 h T_TMP2 root 0)
        (while (> (vlen h T_TMP2) 0)
          (let [top (- (vlen h T_TMP2) 2)
                f2 (vget h T_TMP2 top)
                st (vget h T_TMP2 (+ top 1))
                l (fin-internal h f2)
                k (lk h l)]
            (if (not (charge h 1)) (return (neg 1)))
            (if (and (== st 0) (== (vget h T_EPOCHS (* 2 f2)) ev))
              (vtrunc h T_TMP2 top)
              (if (and (== st 0) (or (== k K_AND) (== k K_NOT)))
                (do (comment "operands first: second pushed last runs first? push b then a")
                    (vset h T_TMP2 (+ top 1) 1)
                    (push2 h T_TMP2 (fin h (ld h l 1)) 0)
                    (push2 h T_TMP2 (fin h (ld h l 0)) 0))
                (do (vtrunc h T_TMP2 top)
                    (if (!= (vget h T_EPOCHS (* 2 f2)) ev)
                      (do (vset h T_EPOCHS (* 2 f2) ev)
                          (if (== (vget h T_EPOCHS (+ (* 2 f2) 1)) ea)
                            (vpush1 h T_FTSL f2)
                            (vpush1 h T_FTSL (bit-not f2))))))))))))
    (return (- (vlen h T_FTSL) start))))

(defn ^I32 final-ts [^Ints h ^I32 ts]
  (comment "The final typeset of internal typeset ts: its live leaves' final ids,"
           "ascending, hash-consed; with an evaluation list when it holds a"
           "combinator.")
  (let [ans (vlen h T_FTSL)
        o (ts-off h ts)
        n0 (ts-n h ts)
        ^:mut n 0
        ^:mut comb false]
    (for [^I32 i 0 n0]
      (let [l (vget h T_TSL (+ o i))]
        (if (not (dead h l))
          (do (vpush1 h T_FTSL (fin h l))
              (if (or (== (lk h l) K_AND) (== (lk h l) K_NOT)) (set comb true))
              (set n (+ n 1))))))
    (if (not (sort-records h T_FTSL ans n 1)) (return (neg 1)))
    (comment "equivalent leaves (one class representative) count once")
    (let [^:mut w 0]
      (for [^I32 u 0 n]
        (if (or (== u 0) (!= (vget h T_FTSL (+ ans u)) (vget h T_FTSL (+ ans (- u 1)))))
          (do (vset h T_FTSL (+ ans w) (vget h T_FTSL (+ ans u)))
              (set w (+ w 1)))))
      (vtrunc h T_FTSL (+ ans w))
      (set n w))
    (let [^:mut hsh (mix 3 n)]
      (for [^I32 j 0 n]
        (set hsh (mix hsh (vget h T_FTSL (+ ans j)))))
      (let [^:mut s (ht-start h T_HFTS hsh)]
        (forever
         (let [id (ht-id h T_HFTS s)]
           (if (< id 0) (break))
           (if (and (== (fts-w h id 4) hsh) (== (fts-w h id 1) n))
             (do (let [ao (fts-w h id 0)
                       ^:mut same true]
                   (for [^I32 q 0 n]
                     (if (!= (vget h T_FTSL (+ ao q)) (vget h T_FTSL (+ ans q))) (set same false)))
                   (if same
                     (do (vtrunc h T_FTSL ans)
                         (return id))))))
           (set s (ht-next h T_HFTS s))))
        (let [nid (fts-n h)
              ^:mut eo 0
              ^:mut en 0]
          (if comb
            (do (set eo (vlen h T_FTSL))
                (set en (eval-list h ans n))
                (if (< en 0) (return (neg 1)))))
          (vpush1 h T_FTS ans)
          (vpush1 h T_FTS n)
          (vpush1 h T_FTS eo)
          (vpush1 h T_FTS en)
          (vpush1 h T_FTS hsh)
          (if (erred h) (return (neg 1)))
          (if (not (ht-put h T_HFTS s nid hsh)) (return (neg 1)))
          (return nid))))))

(defn ^:pub ^I32 fts-of [^IntsR h ^I32 ts]
  (comment "The final id of an internal typeset (set by pass 2).")
  (return (ts-w h ts 3)))

;; ------------------------------------------------------------ groups

(defn ^I32 group-intern [^Ints h ^I32 blob ^I32 go ^I32 gn]
  (comment "The group id of the entries T_MAPD[blob+go ..] (gn x 4: key ts, value"
           "ts, min, max), with typesets made final. T_GRP: offsets into T_GRPD"
           "records (n_entries, n_constrained, entries x 4).")
  (let [at (vlen h T_GRPD)
        ^:mut nc 0]
    (vpush1 h T_GRPD gn)
    (vpush1 h T_GRPD 0)
    (for [^I32 i 0 gn]
      (let [e (+ (+ blob go) (* 4 i))
            kt (fts-of h (vget h T_MAPD e))
            vt (fts-of h (vget h T_MAPD (+ e 1)))
            mn (vget h T_MAPD (+ e 2))
            mx (vget h T_MAPD (+ e 3))]
        (vpush1 h T_GRPD kt)
        (vpush1 h T_GRPD vt)
        (vpush1 h T_GRPD mn)
        (vpush1 h T_GRPD mx)
        (if (not (and (== mn 0) (== mx INF))) (set nc (+ nc 1)))))
    (vset h T_GRPD (+ at 1) nc)
    (let [len (+ 2 (* 4 gn))
          ^:mut hsh (mix 11 len)]
      (for [^I32 j 0 len]
        (set hsh (mix hsh (vget h T_GRPD (+ at j)))))
      (let [^:mut s (ht-start h T_HGRP hsh)]
        (forever
         (let [id (ht-id h T_HGRP s)]
           (if (< id 0) (break))
           (let [go2 (vget h T_GRP id)]
             (if (== (vget h T_GRPD go2) gn)
               (do (let [^:mut same true]
                     (for [^I32 q 0 len]
                       (if (!= (vget h T_GRPD (+ go2 q)) (vget h T_GRPD (+ at q))) (set same false)))
                     (if same (do (vtrunc h T_GRPD at) (return id)))))))
           (set s (ht-next h T_HGRP s))))
        (let [nid (vlen h T_GRP)]
          (vpush1 h T_GRP at)
          (if (not (ht-put h T_HGRP s nid hsh)) (return (neg 1)))
          (return nid))))))

;; ------------------------------------------------------------ sorting bids

;; ------------------------------------------------------------ pool

(defn ^I32 pool-place [^Ints h ^I32 bid]
  (comment "The pool offset of bid's bytes, placing them on first use.")
  (let [cur (vget h T_POOLOFF bid)]
    (if (>= cur 0) (return cur))
    (let [off (vlen h T_POOL)
          n (bid-len h bid)]
      (for [^I32 i 0 n]
        (vpush1 h T_POOL (bid-byte h bid i)))
      (vset h T_POOLOFF bid off)
      (return off))))

;; ------------------------------------------------------------ the bus profile

(defn ^I32 bus-fail [^Ints h ^I32 f]
  (comment "Refuse under `bus` because of final leaf f: reported in the rule whose walk"
           "first reached it, at the leaf's own source position if it is a container,"
           "else at the rule's name.")
  (let [l (fin-internal h f)
        r (vget h T_LRULE f)
        node (lw h l 12)
        ^:mut pos (neg 1)]
    (hs h H_CUR_RULE r)
    (if (and (>= node 0) (>= (lk h l) K_TAG)) (set pos (npos h node)))
    (if (and (< pos 0) (>= r 0)) (set pos (npos h (rw h r 2))))
    (return (fail h ERR_PROFILE pos))))

(defn ^I32 map-blob-of [^IntsR h ^I32 l] (return (vget h T_MAP (ld h l 0))))

(defn ^I32 if-embed-other [^IntsR h ^I32 l]
  (comment "The operand of AND leaf l that is not its EMBED.")
  (if (== (lk h (ld h l 0)) K_EMBED) (return (ld h l 1)))
  (return (ld h l 0)))

(defn ^I32 child-leaves [^Ints h ^I32 l]
  (comment "Push the FINAL ids of every leaf reachable in one step from leaf l (its"
           "child typesets' answers and its operands) onto T_CHILD; answers the count.")
  (let [start (vlen h T_CHILD)
        tmp (vlen h T_CLS)]
    (children h l T_CLS)
    (let [n (quot (- (vlen h T_CLS) tmp) 2)]
      (for [^I32 i 0 n]
        (let [kind (vget h T_CLS (+ tmp (* 2 i)))
              id (vget h T_CLS (+ tmp (+ (* 2 i) 1)))]
          (if (== kind 1)
            (if (not (dead h id)) (vpush1 h T_CHILD (fin h id)))
            (do (let [ft (fts-of h id)]
                  (for [^I32 j 0 (fts-w h ft 1)]
                    (vpush1 h T_CHILD (vget h T_FTSL (+ (fts-w h ft 0) j))))))))))
    (vtrunc h T_CLS tmp)
    (return (- (vlen h T_CHILD) start))))

(defn ^Bool array-bounded [^Ints h ^I32 a]
  (comment "Does the array automaton accept only bounded lengths? (no counter with an"
           "unbounded maximum and no cycle in the follow graph: Kahn's peeling, T_TMP"
           "as the in-degree table)")
  (let [blob (vget h T_ARR a)
        npos (vget h T_ARRD blob)
        w (vget h T_ARRD (+ blob 1))
        nc (vget h T_ARRD (+ blob 2))
        cb (+ (+ (+ blob 4) (* 2 w)) (* 2 npos))
        fb (+ cb (* 2 nc))]
    (for [^I32 c 0 nc]
      (if (== (vget h T_ARRD (+ cb (+ (* 2 c) 1))) INF) (return false)))
    (comment "peel positions with no incoming edge from a live position")
    (let [^:mut removed 0
          ^:mut progress true]
      (vtrunc h T_EPOCHS 0)
      (for [^I32 _i 0 npos] (vpush1 h T_EPOCHS 0))
      (while progress
        (set progress false)
        (for [^I32 q 0 npos]
          (if (== (vget h T_EPOCHS q) 0)
            (do (let [^:mut incoming false]
                  (for [^I32 p 0 npos]
                    (if (and (== (vget h T_EPOCHS p) 0)
                             (!= (bit-and (sar (vget h T_ARRD (+ fb (+ (* p w) (sar q 5)))) (bit-and q 31)) 1) 0))
                      (set incoming true)))
                  (if (not incoming)
                    (do (vset h T_EPOCHS q 1) (set removed (+ removed 1)) (set progress true))))))))
      (return (== removed npos)))))

(defn ^I32 check-bus [^Ints h]
  (comment "The `bus` profile (architecture §5.3): every string and container"
           "bounded, no recursion. Runs on the numbered leaves.")
  (let [nl (hg h H_N_FIN)]
    (if (not (charge h (* nl 4))) (return (neg 1)))
    (for [^I32 f 0 nl]
      (let [l (fin-internal h f)
            k (lk h l)]
        (if (or (== k K_ANY) (== k K_MAJOR)) (return (bus-fail h f)))
        (if (and (or (== k K_TEXT) (== k K_BYTES)) (== (ld h l 1) INF)) (return (bus-fail h f)))
        (if (and (== k K_ARRAY) (not (array-bounded h (ld h l 0)))) (return (bus-fail h f)))
        (if (== k K_MAP)
          (do (let [blob (map-blob-of h l)
                    nf (vget h T_MAPD blob)
                    np (vget h T_MAPD (+ blob 1))
                    pb (+ (+ blob 4) (* 3 nf))]
                (for [^I32 p 0 np]
                  (let [go (vget h T_MAPD (+ (+ pb (* 5 p)) 1))
                        gn (vget h T_MAPD (+ (+ pb (* 5 p)) 2))]
                    (if (>= go 0)
                      (for [^I32 g 0 gn]
                        (if (== (vget h T_MAPD (+ (+ blob go) (+ (* 4 g) 3))) INF)
                          (return (bus-fail h f))))))))))
        (if (and (== k K_AND) (or (== (lk h (ld h l 0)) K_EMBED) (== (lk h (ld h l 1)) K_EMBED)))
          (do (comment "an embedded document needs a bounded byte string beside it")
              (let [other (if-embed-other h l)]
                (if (or (!= (lk h other) K_BYTES) (== (ld h other 1) INF)) (return (bus-fail h f))))))))
    (comment "an EMBED answering for itself is an unbounded byte string")
    (for [^I32 t 0 (fts-n h)]
      (for [^I32 i 0 (fts-w h t 1)]
        (if (== (lk h (fin-internal h (vget h T_FTSL (+ (fts-w h t 0) i)))) K_EMBED)
          (return (bus-fail h (vget h T_FTSL (+ (fts-w h t 0) i)))))))
    (comment "no recursion: no cycle through children (iterative DFS, colours in"
             "T_EPOCHS word 1: 0 new, 1 on the path, 2 done)")
    (vtrunc h T_EPOCHS 0)
    (if (< (vpush h T_EPOCHS (* 2 nl)) 0) (return (neg 1)))
    (for [^I32 root 0 nl]
      (if (== (vget h T_EPOCHS (+ (* 2 root) 1)) 0)
        (do (vtrunc h T_PSTK 0)
            (vtrunc h T_CHILD 0)
            (vset h T_EPOCHS (+ (* 2 root) 1) 1)
            (let [co (vlen h T_CHILD)
                  cn (child-leaves h (fin-internal h root))]
              (push-frame h co cn)
              (vpush1 h T_PSTK root))
            (while (> (vlen h T_PSTK) 0)
              (if (not (charge h 1)) (return (neg 1)))
              (let [fr (- (vlen h T_PSTK) 5)
                    off (vget h T_PSTK fr)
                    n (vget h T_PSTK (+ fr 1))
                    cur (vget h T_PSTK (+ fr 2))
                    me (vget h T_PSTK (+ fr 4))]
                (if (>= cur n)
                  (do (vset h T_EPOCHS (+ (* 2 me) 1) 2)
                      (vtrunc h T_PSTK fr)
                      (vtrunc h T_CHILD off))
                  (do (vset h T_PSTK (+ fr 2) (+ cur 1))
                      (let [c (vget h T_CHILD (+ off cur))
                            st (vget h T_EPOCHS (+ (* 2 c) 1))]
                        (if (== st 1) (return (bus-fail h c)))
                        (if (== st 0)
                          (do (vset h T_EPOCHS (+ (* 2 c) 1) 1)
                              (let [co2 (vlen h T_CHILD)
                                    cn2 (child-leaves h (fin-internal h c))]
                                (push-frame h co2 cn2)
                                (vpush1 h T_PSTK c))))))))))))
    (return 0)))

;; ------------------------------------------------------------ canonicalisation
;; Architecture §4.2: leaves are hash-consed with cycle-aware
;; canonicalisation. Scalars are interned when made; containers (maps,
;; arrays, tags, embedded documents) and the combinators over them are merged
;; here by partition refinement: start from classes of equal SHAPE (the leaf
;; without its child typesets), then split classes until every member of a
;; class has, slot by slot, children of the same SET of classes. The stable
;; partition is a bisimulation, so a class's members match exactly the same
;; items (recursive types reach the fixed point). Each class keeps its first
;; member (lowest internal id) as representative.

(defn ^Bool is-container [^IntsR h ^I32 l]
  (let [k (lk h l)]
    (return (or (or (or (== k K_TAG) (== k K_TAGSET)) (or (== k K_EMBED) (== k K_ARRAY)))
                (or (== k K_MAP) (or (== k K_AND) (== k K_NOT)))))))

(defn shape-sig [^Ints h ^I32 l]
  (comment "Push the shape of container l (everything but its child typesets) onto"
           "T_CSIG.")
  (let [k (lk h l)]
    (vpush1 h T_CSIG k)
    (vpush1 h T_CSIG (lflags h l))
    (if (== k K_TAG) (do (vpush1 h T_CSIG (ld h l 0)) (vpush1 h T_CSIG (ld h l 1))))
    (if (== k K_TAGSET)
      (for [^I32 i 0 4] (vpush1 h T_CSIG (ld h l i))))
    (if (== k K_ARRAY)
      (do (let [ablob (vget h T_ARR (ld h l 0))
                npos (vget h T_ARRD ablob)
                w (vget h T_ARRD (+ ablob 1))
                nc (vget h T_ARRD (+ ablob 2))
                apb (+ (+ ablob 4) (* 2 w))
                n (+ (+ 4 (* 2 w)) (+ (* 2 npos) (+ (* 2 nc) (* npos w))))]
            (for [^I32 i2 0 n]
              (comment "every word but the positions' typesets")
              (let [at (+ ablob i2)]
                (if (or (< at apb) (or (>= at (+ apb (* 2 npos))) (== (bit-and (- at apb) 1) 1)))
                  (vpush1 h T_CSIG (vget h T_ARRD at))))))))
    (if (== k K_MAP)
      (do (let [blob (vget h T_MAP (ld h l 0))
                nf (vget h T_MAPD blob)
                np (vget h T_MAPD (+ blob 1))
                na (vget h T_MAPD (+ blob 2))
                fb (+ blob 4)
                pb (+ fb (* 3 nf))
                ab (+ pb (* 5 np))]
            (vpush1 h T_CSIG nf) (vpush1 h T_CSIG np) (vpush1 h T_CSIG na)
            (for [^I32 f 0 (* 3 nf)] (vpush1 h T_CSIG (vget h T_MAPD (+ fb f))))
            (for [^I32 p 0 np]
              (let [prec (+ pb (* 5 p))
                    go (vget h T_MAPD (+ prec 1))
                    gn (vget h T_MAPD (+ prec 2))]
                (vpush1 h T_CSIG (vget h T_MAPD prec))
                (vpush1 h T_CSIG gn)
                (vpush1 h T_CSIG (vget h T_MAPD (+ prec 3)))
                (vpush1 h T_CSIG (vget h T_MAPD (+ prec 4)))
                (if (>= go 0)
                  (for [^I32 g 0 gn]
                    (vpush1 h T_CSIG (vget h T_MAPD (+ (+ blob go) (+ (* 4 g) 2))))
                    (vpush1 h T_CSIG (vget h T_MAPD (+ (+ blob go) (+ (* 4 g) 3))))))))
            (for [^I32 a 0 na]
              (let [arec (+ ab (* 3 a))
                    lo (+ blob (vget h T_MAPD (+ arec 1)))
                    ln (vget h T_MAPD (+ arec 2))]
                (vpush1 h T_CSIG (vget h T_MAPD arec))
                (vpush1 h T_CSIG ln)
                (for [^I32 i3 0 ln]
                  (vpush1 h T_CSIG (vget h T_MAPD (+ lo (* 4 i3))))
                  (vpush1 h T_CSIG (vget h T_MAPD (+ lo (+ (* 4 i3) 2))))
                  (vpush1 h T_CSIG (vget h T_MAPD (+ lo (+ (* 4 i3) 3))))))))))))

(defn child-sig [^Ints h ^I32 l]
  (comment "Push, per child slot of l, the sorted set of its leaves' classes onto"
           "T_CSIG (slot marker -1, then the count, then the classes).")
  (let [cstart (vlen h T_CHILD)
        cn (children h l T_CHILD)]
    (for [^I32 j 0 cn]
      (let [kind (vget h T_CHILD (+ cstart (* 2 j)))
            id (vget h T_CHILD (+ cstart (+ (* 2 j) 1)))
            at (vlen h T_CSIG)]
        (vpush1 h T_CSIG (neg 1))
        (vpush1 h T_CSIG 0)
        (if (== kind 1)
          (vpush1 h T_CSIG (vget h T_CLSID id))
          (for [^I32 i 0 (ts-n h id)]
            (let [x (vget h T_TSL (+ (ts-off h id) i))]
              (if (not (dead h x)) (vpush1 h T_CSIG (vget h T_CLSID x))))))
        (let [m (- (vlen h T_CSIG) (+ at 2))]
          (sort-records h T_CSIG (+ at 2) m 1)
          (comment "drop repeated classes (a set)")
          (let [^:mut w (+ at 2)]
            (for [^I32 u (+ at 2) (+ (+ at 2) m)]
              (if (or (== u (+ at 2)) (!= (vget h T_CSIG u) (vget h T_CSIG (- u 1))))
                (do (vset h T_CSIG w (vget h T_CSIG u)) (set w (+ w 1)))))
            (vtrunc h T_CSIG w)
            (vset h T_CSIG (+ at 1) (- w (+ at 2)))))))
    (vtrunc h T_CHILD cstart)))

(defn ^I32 sig-intern [^Ints h ^I32 start]
  (comment "The index of the signature T_CSIG[start..] among this round's (equal"
           "signatures share one; T_HSIG hashes them, T_NCLS holds (offset, length))."
           "A repeated signature is cut from T_CSIG.")
  (let [len (- (vlen h T_CSIG) start)
        ^:mut hsh (mix 23 len)]
    (if (not (charge h (+ 1 len))) (return (neg 1)))
    (for [^I32 i 0 len]
      (set hsh (mix hsh (vget h T_CSIG (+ start i)))))
    (let [^:mut s (ht-start h T_HSIG hsh)]
      (forever
       (let [id (ht-id h T_HSIG s)]
         (if (< id 0) (break))
         (let [o (vget h T_NCLS (* 2 id))
               n (vget h T_NCLS (+ (* 2 id) 1))]
           (if (== n len)
             (do (let [^:mut same true
                       ^:mut q 0]
                   (while (and same (< q len))
                     (if (!= (vget h T_CSIG (+ o q)) (vget h T_CSIG (+ start q))) (set same false))
                     (set q (+ q 1)))
                   (if same (do (vtrunc h T_CSIG start) (return id)))))))
         (set s (ht-next h T_HSIG s))))
      (let [nid (quot (vlen h T_NCLS) 2)]
        (vpush1 h T_NCLS start)
        (vpush1 h T_NCLS len)
        (if (not (ht-put h T_HSIG s nid hsh)) (return (neg 1)))
        (return nid)))))

(defn ^:pub ^I32 canonicalise [^Ints h]
  (comment "Partition refinement over the live containers (see above); fills T_REP.")
  (let [nl (nleaves h)]
    (vtrunc h T_REP 0)
    (vtrunc h T_CLSID 0)
    (vtrunc h T_CONT 0)
    (for [^I32 l 0 nl]
      (vpush1 h T_REP l)
      (vpush1 h T_CLSID l)
      (if (and (not (dead h l)) (is-container h l)) (vpush1 h T_CONT l)))
    (let [nc (vlen h T_CONT)]
      (if (== nc 0) (return 0))
      (comment "round 0: shapes")
      (vtrunc h T_CSIG 0)
      (vtrunc h T_NCLS 0)
      (if (not (ht-init h T_HSIG 64)) (return (neg 1)))
      (vtrunc h T_TMP 0)
      (for [^I32 i 0 nc]
        (let [c (vget h T_CONT i)
              st (vlen h T_CSIG)]
          (shape-sig h c)
          (let [id (sig-intern h st)]
            (if (< id 0) (return (neg 1)))
            (vpush1 h T_TMP id))))
      (let [^:mut classes (quot (vlen h T_NCLS) 2)]
      (for [^I32 i2 0 nc]
        (vset h T_CLSID (vget h T_CONT i2) (+ nl (vget h T_TMP i2))))
      (comment "refine until stable")
      (forever
       (vtrunc h T_CSIG 0)
       (vtrunc h T_NCLS 0)
       (if (not (ht-init h T_HSIG 64)) (return (neg 1)))
       (vtrunc h T_TMP 0)
       (for [^I32 i3 0 nc]
         (let [c3 (vget h T_CONT i3)
               st3 (vlen h T_CSIG)]
           (vpush1 h T_CSIG (vget h T_CLSID c3))
           (child-sig h c3)
           (let [id3 (sig-intern h st3)]
             (if (< id3 0) (return (neg 1)))
             (vpush1 h T_TMP id3))))
       (let [nclasses (quot (vlen h T_NCLS) 2)]
         (for [^I32 i4 0 nc]
           (vset h T_CLSID (vget h T_CONT i4) (+ nl (vget h T_TMP i4))))
         (if (== nclasses classes) (break))
         (set classes nclasses)))
      (comment "representatives: the first member of each class")
      (vtrunc h T_TMP 0)
      (for [^I32 _z 0 classes] (vpush1 h T_TMP (neg 1)))
      (for [^I32 i5 0 nc]
        (let [c5 (vget h T_CONT i5)
              k5 (- (vget h T_CLSID c5) nl)]
          (if (< (vget h T_TMP k5) 0)
            (vset h T_TMP k5 c5)
            (vset h T_REP c5 (vget h T_TMP k5)))))
      (if (erred h) (return (neg 1)))
      (return 0)))))

;; ------------------------------------------------------------ the plan

(defn ^:pub ^I32 plan [^Ints h]
  (comment "Steps 1-2 of the namespace doc. Answers 0 or -1.")
  (mark-dead h)
  (if (< (canonicalise h) 0) (return (neg 1)))
  (hs h H_TS_ANY (neg 1))
  (hs h H_N_FIN 0)
  (vtrunc h T_FIN 0)
  (vtrunc h T_LRULE 0)
  (vtrunc h T_ORD 0)
  (vtrunc h T_CHILD 0)
  (vtrunc h T_PSTK 0)
  (for [^I32 l 0 (nleaves h)]
    (lset h l 11 (neg 1)))
  (for [^I32 t 0 (nts h)]
    (ts-setw h t 5 0)
    (ts-setw h t 3 (neg 1)))
  (comment "The walk, over schema type rules in source order.")
  (let [nr (nrules h)]
    (for [^I32 r 0 nr]
      (if (and (and (== (rw h r 7) 0) (== (rw h r 5) 0)) (== (rw h r 4) RK_TYPE))
        (if (>= (rw h r 9) 0)
          (do (hs h H_WALK_RULE r)
              (if (< (number-from h (rw h r 9)) 0) (return (neg 1))))))))
  (let [nl (hg h H_N_FIN)]
    (if (> nl (hg h H_LIM_LEAVES)) (return (fail h ERR_LIM_LEAVES (neg 1))))
    (vtrunc h T_EPOCHS 0)
    (if (< (vpush h T_EPOCHS (* 2 nl)) 0) (return (neg 1))))
  (comment "Final typesets, in first-reach order.")
  (vtrunc h T_FTS 0)
  (vtrunc h T_FTSL 0)
  (if (not (ht-init h T_HFTS 128)) (return (neg 1)))
  (for [^I32 i 0 (vlen h T_ORD)]
    (let [ts (vget h T_ORD i)
          f (final-ts h ts)]
      (if (< f 0) (return (neg 1)))
      (ts-setw h ts 3 f)))
  (if (== (hg h H_PROFILE) 2)
    (if (< (check-bus h) 0) (return (neg 1))))
  (return 0))

;; ------------------------------------------------------------ sections
;; T_LAUX per final leaf, 4 words: kind-specific (see each case below).

(defn ^I32 laux [^IntsR h ^I32 f ^I32 w] (return (vget h T_LAUX (+ (* f 4) w))))
(defn laux-set [^Ints h ^I32 f ^I32 w ^I32 v] (vset h T_LAUX (+ (* f 4) w) v))

(defn ^I32 map-blob [^IntsR h ^I32 l] (return (vget h T_MAP (ld h l 0))))

(defn ^I32 map-keys-into [^Ints h ^I32 blob ^I32 dst]
  (comment "Push the distinct key ids of the map's literal entries, ascending, onto"
           "dst; answers how many (sort, then drop repeats: n log n).")
  (let [start (vlen h dst)
        nf (vget h T_MAPD blob)
        np (vget h T_MAPD (+ blob 1))
        na (vget h T_MAPD (+ blob 2))
        ab (+ (+ (+ blob 4) (* 3 nf)) (* 5 np))]
    (for [^I32 a 0 na]
      (let [lo (+ blob (vget h T_MAPD (+ (+ ab (* 3 a)) 1)))
            ln (vget h T_MAPD (+ (+ ab (* 3 a)) 2))]
        (for [^I32 i 0 ln]
          (vpush1 h dst (vget h T_KEYID (vget h T_MAPD (+ lo (* 4 i))))))))
    (let [n (- (vlen h dst) start)
          ^:mut w start]
      (if (not (sort-records h dst start n 1)) (return (neg 1)))
      (for [^I32 r start (+ start n)]
        (if (or (== r start) (!= (vget h dst r) (vget h dst (- r 1))))
          (do (vset h dst w (vget h dst r))
              (set w (+ w 1)))))
      (vtrunc h dst w)
      (return (- w start)))))

(defn ^I32 key-triples [^Ints h ^I32 blob]
  (comment "T_KEYTRI: (key id, alternative, literal index) for every literal entry of"
           "the map, sorted stably by key id: grouped by key, alternatives ascending"
           "within a key. Answers the count.")
  (let [nf (vget h T_MAPD blob)
        np (vget h T_MAPD (+ blob 1))
        na (vget h T_MAPD (+ blob 2))
        ab (+ (+ (+ blob 4) (* 3 nf)) (* 5 np))
        ^:mut lidx 0]
    (vtrunc h T_KEYTRI 0)
    (for [^I32 a 0 na]
      (let [lo (+ blob (vget h T_MAPD (+ (+ ab (* 3 a)) 1)))
            ln (vget h T_MAPD (+ (+ ab (* 3 a)) 2))]
        (for [^I32 i 0 ln]
          (vpush1 h T_KEYTRI (vget h T_KEYID (vget h T_MAPD (+ lo (* 4 i)))))
          (vpush1 h T_KEYTRI a)
          (vpush1 h T_KEYTRI (+ lidx i)))
        (set lidx (+ lidx ln))))
    (let [n (quot (vlen h T_KEYTRI) 3)]
      (if (not (msort-records h T_KEYTRI 0 n 3)) (return (neg 1)))
      (return n))))

(defn ^:pub ^I32 assign-sections [^Ints h]
  (comment "Map, array, regexp, interval, float-interval and LITSET ids in leaf"
           "order; residual groups; the key table; the pool.")
  (let [nl (hg h H_N_FIN)
        ^:mut nmaps 0
        ^:mut narrays 0
        ^:mut nrx 0
        ^:mut niv 0
        ^:mut nfiv 0
        ^:mut nlr 0]
    (vtrunc h T_LAUX 0)
    (if (< (vpush h T_LAUX (* 4 nl)) 0) (return (neg 1)))
    (vtrunc h T_GRP 0)
    (vtrunc h T_GRPD 0)
    (vtrunc h T_POOLG 0)
    (if (not (ht-init h T_HGRP 64)) (return (neg 1)))
    (vtrunc h T_RXF 0)
    (let [nrxi (rx-count h)]
      (if (< (vpush h T_RXF nrxi) 0) (return (neg 1)))
      (vfill h T_RXF 0 nrxi (neg 1)))
    (for [^I32 f 0 nl]
      (let [l (fin-internal h f)
            k (lk h l)]
        (if (== k K_MAP)
          (do (let [blob (map-blob h l)
                    np (vget h T_MAPD (+ blob 1))
                    nf (vget h T_MAPD blob)
                    pb (+ (+ blob 4) (* 3 nf))
                    pg (vlen h T_POOLG)]
                (laux-set h f 0 nmaps)
                (laux-set h f 1 pg)
                (set nmaps (+ nmaps 1))
                (for [^I32 p 0 np]
                  (let [prec (+ pb (* 5 p))]
                    (if (== (vget h T_MAPD prec) 0)
                      (do (let [g (group-intern h blob (vget h T_MAPD (+ prec 1)) (vget h T_MAPD (+ prec 2)))]
                            (if (< g 0) (return (neg 1)))
                            (vpush1 h T_POOLG g)))
                      (vpush1 h T_POOLG (neg 1))))))))
        (if (== k K_ARRAY)
          (do (let [ab (vget h T_ARR (ld h l 0))]
                (laux-set h f 0 narrays)
                (laux-set h f 1 (vget h T_ARRD (+ ab 1)))
                (laux-set h f 2 (vget h T_ARRD (+ ab 2)))
                (set narrays (+ narrays 1)))))
        (if (and (== k K_TEXT) (>= (ld h l 2) 0))
          (do (let [rx (ld h l 2)]
                (if (< (vget h T_RXF rx) 0)
                  (do (vset h T_RXF rx nrx) (set nrx (+ nrx 1))))
                (laux-set h f 0 (vget h T_RXF rx))
                (laux-set h f 1 (rx-w h rx)))))
        (if (== k K_INT)
          (do (laux-set h f 0 niv) (laux-set h f 1 (ld h l 1)) (set niv (+ niv (ld h l 1)))))
        (if (and (== k K_UINTX) (> (ld h l 3) 0))
          (do (laux-set h f 0 niv) (laux-set h f 1 (ld h l 3)) (set niv (+ niv (ld h l 3)))))
        (if (and (== k K_FLOAT) (> (ld h l 1) 0))
          (do (laux-set h f 0 nfiv) (laux-set h f 1 (ld h l 1)) (set nfiv (+ nfiv (ld h l 1)))))
        (if (== k K_LITSET)
          (do (laux-set h f 0 nlr) (laux-set h f 1 (ld h l 1)) (set nlr (+ nlr (ld h l 1)))))))
    (comment "Counts for the header, in h words H_R? are too few: keep them in T_CLS2.")
    (vtrunc h T_CLS2 0)
    (vpush1 h T_CLS2 nmaps)
    (vpush1 h T_CLS2 narrays)
    (vpush1 h T_CLS2 nrx)
    (vpush1 h T_CLS2 niv)
    (vpush1 h T_CLS2 nfiv)
    (vpush1 h T_CLS2 nlr)
    (comment "The key table: every literal key of a live map, sorted by encoding.")
    (let [nb (nbids h)]
      (vtrunc h T_KEYID 0)
      (if (< (vpush h T_KEYID nb) 0) (return (neg 1)))
      (vfill h T_KEYID 0 nb (neg 1))
      (vtrunc h T_KEYS 0)
      (for [^I32 f2 0 nl]
        (let [l2 (fin-internal h f2)]
          (if (== (lk h l2) K_MAP)
            (do (let [blob2 (map-blob h l2)
                      nf2 (vget h T_MAPD blob2)
                      np2 (vget h T_MAPD (+ blob2 1))
                      na2 (vget h T_MAPD (+ blob2 2))
                      ab2 (+ (+ (+ blob2 4) (* 3 nf2)) (* 5 np2))]
                  (for [^I32 a 0 na2]
                    (let [lo (+ blob2 (vget h T_MAPD (+ (+ ab2 (* 3 a)) 1)))
                          ln (vget h T_MAPD (+ (+ ab2 (* 3 a)) 2))]
                      (for [^I32 i 0 ln]
                        (let [kb (vget h T_MAPD (+ lo (* 4 i)))]
                          (if (== (vget h T_KEYID kb) (neg 1))
                            (do (vset h T_KEYID kb (neg 2))
                                (vpush1 h T_KEYS kb))))))))))))
      (if (not (sort-bids h T_KEYS (vlen h T_KEYS))) (return (neg 1)))
      (for [^I32 q 0 (vlen h T_KEYS)]
        (vset h T_KEYID (vget h T_KEYS q) q)))
    (return 0)))

(defn ^:pub ^I32 order-rules [^Ints h]
  (comment "RULES: the schema's non-generic type rules, sorted by name bytes. T_RORD"
           "gets their rule ids, T_RSCR their name bids (same order). Names are unique,"
           "so a bid -> rule table (T_KEYTRI, reused) undoes the sort: n log n.")
  (vtrunc h T_RORD 0)
  (vtrunc h T_RSCR 0)
  (let [nr (nrules h)]
    (for [^I32 r 0 nr]
      (if (and (and (== (rw h r 7) 0) (== (rw h r 5) 0)) (== (rw h r 4) RK_TYPE))
        (do (let [b (intern h T_SRC (rw h r 0) (rw h r 1))]
              (if (< b 0) (return (neg 1)))
              (vpush1 h T_RSCR b)))))
    (let [n (vlen h T_RSCR)
          nb (nbids h)]
      (vtrunc h T_KEYTRI 0)
      (if (< (vpush h T_KEYTRI nb) 0) (return (neg 1)))
      (let [^:mut k 0]
        (for [^I32 r2 0 nr]
          (if (and (and (== (rw h r2 7) 0) (== (rw h r2 5) 0)) (== (rw h r2 4) RK_TYPE))
            (do (vset h T_KEYTRI (vget h T_RSCR k) r2)
                (set k (+ k 1))))))
      (if (not (sort-bids h T_RSCR n)) (return (neg 1)))
      (for [^I32 j2 0 n]
        (vpush1 h T_RORD (vget h T_KEYTRI (vget h T_RSCR j2))))
      (return n))))

(defn ^:pub ^I32 build-pool [^Ints h]
  (comment "Pool order (program.md §15.1): rule names, keys, literals, bignum"
           "magnitudes, .bits masks; identical byte strings share.")
  (let [nb (nbids h)
        nl (hg h H_N_FIN)]
    (vtrunc h T_POOL 0)
    (vtrunc h T_POOLOFF 0)
    (if (< (vpush h T_POOLOFF nb) 0) (return (neg 1)))
    (vfill h T_POOLOFF 0 nb (neg 1))
    (for [^I32 i 0 (vlen h T_RSCR)] (pool-place h (vget h T_RSCR i)))
    (for [^I32 j 0 (vlen h T_KEYS)] (pool-place h (vget h T_KEYS j)))
    (for [^I32 f 0 nl]
      (let [l (fin-internal h f)]
        (if (== (lk h l) K_LIT) (pool-place h (ld h l 0)))
        (if (== (lk h l) K_LITSET)
          (for [^I32 m 0 (ld h l 1)] (pool-place h (vget h T_LST (+ (ld h l 0) m)))))))
    (for [^I32 f2 0 nl]
      (let [l2 (fin-internal h f2)
            k (lk h l2)
            ^:mut first (neg 1)
            ^:mut cnt 0]
        (if (== k K_INT) (do (set first (ld h l2 0)) (set cnt (ld h l2 1))))
        (if (== k K_UINTX) (do (set first (ld h l2 2)) (set cnt (ld h l2 3))))
        (for [^I32 v 0 cnt]
          (let [o (* 6 (+ first v))]
            (if (or (== (vget h T_IV o) R_NEG_BIG) (== (vget h T_IV o) R_POS_BIG))
              (pool-place h (vget h T_IV (+ o 1))))
            (if (or (== (vget h T_IV (+ o 3)) R_NEG_BIG) (== (vget h T_IV (+ o 3)) R_POS_BIG))
              (pool-place h (vget h T_IV (+ o 4))))))))
    (for [^I32 f3 0 nl]
      (let [l3 (fin-internal h f3)]
        (if (and (== (lk h l3) K_BYTES) (>= (ld h l3 2) 0)) (pool-place h (ld h l3 2)))))
    (if (> (vlen h T_POOL) (hg h H_LIM_POOL)) (return (fail h ERR_LIM_POOL (neg 1))))
    (comment "§5.1: pool bytes are charged too.")
    (if (not (charge h (vlen h T_POOL))) (return (neg 1)))
    (if (erred h) (return (neg 1)))
    (return 0)))

;; ------------------------------------------------------------ map planning

(defn ^I32 ceil32 [^I32 n] (return (sar (+ n 31) 5)))

(defn ^:pub ^I32 plan-maps [^Ints h]
  (comment "state_words and cand_max (program.md §7.3, §12.2) of every live map:"
           "T_LAUX words 2 and 3 of its leaf.")
  (let [nl (hg h H_N_FIN)]
    (for [^I32 f 0 nl]
      (let [l (fin-internal h f)]
        (if (== (lk h l) K_MAP)
          (do (let [blob (map-blob h l)
                    nf (vget h T_MAPD blob)
                    np (vget h T_MAPD (+ blob 1))
                    na (vget h T_MAPD (+ blob 2))
                    pb (+ (+ blob 4) (* 3 nf))
                    ab (+ pb (* 5 np))
                    ^:mut sw (+ 4 nf)
                    ^:mut groupsum 0
                    ^:mut maxnames 0]
                (for [^I32 p 0 np]
                  (let [gn (vget h T_MAPD (+ (+ pb (* 5 p)) 2))]
                    (set sw (+ sw (+ 4 gn)))
                    (if (== (vget h T_MAPD (+ pb (* 5 p))) 0) (set groupsum (+ groupsum gn)))))
                (for [^I32 a 0 na]
                  (set sw (+ sw (+ 3 (ceil32 (vget h T_MAPD (+ (+ ab (* 3 a)) 2))))))) 
                (comment "the most naming records of one key: the longest run of one key")
                (let [nt (key-triples h blob)
                      ^:mut run 0]
                  (for [^I32 q 0 nt]
                    (if (and (> q 0) (== (vget h T_KEYTRI (* 3 q)) (vget h T_KEYTRI (* 3 (- q 1)))))
                      (set run (+ run 1))
                      (set run 1))
                    (if (> run maxnames) (set maxnames run))))
                (laux-set h f 2 sw)
                (laux-set h f 3 (+ groupsum maxnames)))))))
    (if (erred h) (return (neg 1)))
    (return 0)))

;; ------------------------------------------------------------ closure

(defn ^I32 add-eval-set [^Ints h ^I32 t ^I32 ep]
  (comment "Add every leaf of final typeset t's evaluation list (or answers) to T_CLS"
           "(deduplicated by epoch ep in T_EPOCHS word 0).")
  (let [ne (fts-w h t 3)
        ^:mut off (fts-w h t 0)
        ^:mut n (fts-w h t 1)]
    (if (> ne 0) (do (set off (fts-w h t 2)) (set n ne)))
    (for [^I32 i 0 n]
      (let [x (vget h T_FTSL (+ off i))
            ^:mut f x]
        (if (< x 0) (set f (bit-not x)))
        (if (!= (vget h T_EPOCHS (* 2 f)) ep)
          (do (vset h T_EPOCHS (* 2 f) ep)
              (vpush1 h T_CLS f)))))
    (return 0)))

(defn ^I32 frame-words [^IntsR h ^I32 from ^I32 n]
  (let [^:mut maparea 0
        ^:mut arrarea 0]
    (for [^I32 i 0 n]
      (let [f (vget h T_CLS (+ from i))
            k (lk h (fin-internal h f))]
        (if (== k K_MAP) (set maparea (+ maparea (+ (laux h f 2) (* 4 (laux h f 3))))))
        (if (== k K_ARRAY) (set arrarea (+ arrarea (+ 3 (+ (* 2 (laux h f 1)) (laux h f 2))))))))
    (if (> arrarea maparea) (set maparea arrarea))
    (return (+ (* 2 n) maparea))))

(defn ^I32 regex-words [^IntsR h ^I32 from ^I32 n]
  (let [^:mut w 0]
    (for [^I32 i 0 n]
      (let [f (vget h T_CLS (+ from i))
            l (fin-internal h f)]
        (if (and (== (lk h l) K_TEXT) (>= (ld h l 2) 0))
          (set w (+ w (* 2 (laux h f 1)))))))
    (return w)))

(defn ^I32 cset-intern [^Ints h ^I32 from ^I32 n]
  (comment "The closure set of the (sorted) leaves T_CLS[from, from+n): T_CSET is the"
           "index into T_CSD records (n, frame_words, regex_words, leaves).")
  (let [^:mut hsh (mix 17 n)]
    (for [^I32 i 0 n]
      (set hsh (mix hsh (vget h T_CLS (+ from i)))))
    (let [^:mut s (ht-start h T_HCSET hsh)]
      (forever
       (let [id (ht-id h T_HCSET s)]
         (if (< id 0) (break))
         (let [o (vget h T_CSET id)]
           (if (== (vget h T_CSD o) n)
             (do (let [^:mut same true]
                   (for [^I32 j 0 n]
                     (if (!= (vget h T_CSD (+ o (+ 3 j))) (vget h T_CLS (+ from j))) (set same false)))
                   (if same (return id))))))
         (set s (ht-next h T_HCSET s))))
      (let [nid (vlen h T_CSET)
            at (vlen h T_CSD)
            fw (frame-words h from n)
            rw2 (regex-words h from n)]
        (vpush1 h T_CSET at)
        (vpush1 h T_CSD n)
        (vpush1 h T_CSD fw)
        (vpush1 h T_CSD rw2)
        (for [^I32 q 0 n]
          (vpush1 h T_CSD (vget h T_CLS (+ from q))))
        (if (erred h) (return (neg 1)))
        (if (not (ht-put h T_HCSET s nid hsh)) (return (neg 1)))
        (return nid)))))

(defn ^I32 cset-w [^IntsR h ^I32 c ^I32 w] (return (vget h T_CSD (+ (vget h T_CSET c) w))))

(defn ^I32 chain-intern [^Ints h ^I32 from ^I32 n ^I32 rp]
  (comment "The chain (n, repeat_from, csets T_CLS2[from..]) -- T_CHAIN indexes"
           "T_CHD records.")
  (let [^:mut hsh (mix (mix 19 n) rp)]
    (for [^I32 i 0 n]
      (set hsh (mix hsh (vget h T_CLS2 (+ from i)))))
    (let [^:mut s (ht-start h T_HCHAIN hsh)]
      (forever
       (let [id (ht-id h T_HCHAIN s)]
         (if (< id 0) (break))
         (let [o (vget h T_CHAIN id)]
           (if (and (== (vget h T_CHD o) n) (== (vget h T_CHD (+ o 1)) rp))
             (do (let [^:mut same true]
                   (for [^I32 j 0 n]
                     (if (!= (vget h T_CHD (+ o (+ 2 j))) (vget h T_CLS2 (+ from j))) (set same false)))
                   (if same (return id))))))
         (set s (ht-next h T_HCHAIN s))))
      (let [nid (vlen h T_CHAIN)
            at (vlen h T_CHD)]
        (vpush1 h T_CHAIN at)
        (vpush1 h T_CHD n)
        (vpush1 h T_CHD rp)
        (for [^I32 q 0 n]
          (vpush1 h T_CHD (vget h T_CLS2 (+ from q))))
        (if (erred h) (return (neg 1)))
        (if (not (ht-put h T_HCHAIN s nid hsh)) (return (neg 1)))
        (return nid)))))

(defn ^I32 rem2 [^I32 a ^I32 b]
  (return (- a (* (quot a b) b))))

(defn ^I32 rule-chain [^Ints h ^I32 rts]
  (comment "The closure chain of a rule whose final typeset is rts; its scratch words"
           "(program.md §12.1, with MARK_CAP = N_LEAVES) in h[H_R0].")
  (let [d (hg h H_LIM_DEPTH)
        base (vlen h T_CLS2)
        width (hg h H_LIM_WIDTH)
        nl (hg h H_N_FIN)
        ^:mut repeat (neg 1)]
    (comment "R_0")
    (vtrunc h T_CLS 0)
    (let [ep0 (next-epoch h)]
      (add-eval-set h rts ep0))
    (let [n0 (vlen h T_CLS)]
      (if (> n0 width) (return (fail h ERR_LIM_WIDTH (neg 1))))
      (sort-records h T_CLS 0 n0 1)
      (let [c0 (cset-intern h 0 n0)]
        (if (< c0 0) (return (neg 1)))
        (vpush1 h T_CLS2 c0)))
    (forever
     (let [n (- (vlen h T_CLS2) base)]
       (if (>= n (+ d 1)) (break))
       (let [prev (vget h T_CLS2 (- (vlen h T_CLS2) 1))
             po (vget h T_CSET prev)
             pn (vget h T_CSD po)
             ep (next-epoch h)]
         (vtrunc h T_CLS 0)
         (for [^I32 i 0 pn]
           (let [f (vget h T_CSD (+ po (+ 3 i)))
                 l (fin-internal h f)
                 cstart (vlen h T_CHILD)
                 cn (children h l T_CHILD)]
             (for [^I32 j 0 cn]
               (let [kind (vget h T_CHILD (+ cstart (* 2 j)))
                     id (vget h T_CHILD (+ cstart (+ (* 2 j) 1)))]
                 (if (== kind 0) (add-eval-set h (fts-of h id) ep))))
             (vtrunc h T_CHILD cstart)))
         (let [m (vlen h T_CLS)]
           (if (== m 0) (break))
           (if (> m width) (return (fail h ERR_LIM_WIDTH (neg 1))))
           (if (not (charge h m)) (return (neg 1)))
           (sort-records h T_CLS 0 m 1)
           (let [c (cset-intern h 0 m)
                 ^:mut seen (neg 1)]
             (if (< c 0) (return (neg 1)))
             (for [^I32 q 0 n]
               (if (and (< seen 0) (== (vget h T_CLS2 (+ base q)) c)) (set seen q)))
             (if (>= seen 0) (do (set repeat seen) (break)))
             (vpush1 h T_CLS2 c))))))
    (let [n2 (- (vlen h T_CLS2) base)
          ^:mut sumf 0
          ^:mut maxr 0]
      (comment "Depths 0..D, the chain extended periodically (or by empty sets).")
      (for [^I32 k 0 (+ d 1)]
        (let [^:mut idx k]
          (if (>= k n2)
            (if (< repeat 0)
              (set idx (neg 1))
              (set idx (+ repeat (rem2 (- k repeat) (- n2 repeat))))))
          (if (>= idx 0)
            (do (let [cs (vget h T_CLS2 (+ base idx))]
                  (set sumf (+ sumf (cset-w h cs 1)))
                  (if (> (cset-w h cs 2) maxr) (set maxr (cset-w h cs 2))))))))
      (hs h H_R0 (+ (+ (+ 48 (* 2 nl)) (* 2 (+ d 1))) (+ maxr sumf)))
      (let [ch (chain-intern h base n2 repeat)]
        (vtrunc h T_CLS2 base)
        (return ch)))))


;; ------------------------------------------------------------ writing

(defconst ^:pub ^I32 MAGIC 1735749235)
(defconst ^:pub ^I32 FORMAT_VERSION 1)

(defn out [^Ints h ^I32 v] (vpush1 h T_OUT v))

(defn ^I32 map-size [^Ints h ^I32 l]
  (let [blob (map-blob h l)
        nf (vget h T_MAPD blob)
        np (vget h T_MAPD (+ blob 1))
        na (vget h T_MAPD (+ blob 2))
        nl (vget h T_MAPD (+ blob 3))
        st (vlen h T_TMP2)]
    (let [nk (map-keys-into h blob T_TMP2)]
      (vtrunc h T_TMP2 st)
      (return (+ (+ (+ 8 (* 4 nf)) (+ (* 5 np) (* 5 na))) (+ (* 4 nl) (+ (* 4 nk) (* 2 nl))))))))

(defn ^I32 rx-final-list [^Ints h]
  (comment "T_TMP: internal regexp ids in final order; answers the count.")
  (let [n (rx-count h)
        ^:mut cnt 0]
    (vtrunc h T_TMP 0)
    (for [^I32 i 0 n]
      (if (>= (vget h T_RXF i) 0) (set cnt (+ cnt 1))))
    (if (< (vpush h T_TMP cnt) 0) (return (neg 1)))
    (for [^I32 j 0 n]
      (if (>= (vget h T_RXF j) 0) (vset h T_TMP (vget h T_RXF j) j)))
    (return cnt)))

(defn write-leaf [^Ints h ^I32 f]
  (let [l (fin-internal h f)
        k (lk h l)
        fl (lflags h l)
        ^:mut d0 0 ^:mut d1 0 ^:mut d2 0 ^:mut d3 0 ^:mut d4 0]
    (if (== k K_MAJOR) (set d0 (ld h l 0)))
    (if (== k K_INT) (do (set d0 (laux h f 0)) (set d1 (ld h l 1))))
    (if (and (== k K_FLOAT) (> (ld h l 1) 0)) (do (set d0 (laux h f 0)) (set d1 (ld h l 1))))
    (if (== k K_SIMPLE) (set d0 (ld h l 0)))
    (if (== k K_LIT) (do (set d0 (vget h T_POOLOFF (ld h l 0))) (set d1 (bid-len h (ld h l 0)))))
    (if (== k K_LITSET) (do (set d0 (laux h f 0)) (set d1 (ld h l 1))))
    (if (== k K_TEXT)
      (do (set d0 (ld h l 0)) (set d1 (ld h l 1)) (set d2 (neg 1))
          (if (>= (ld h l 2) 0) (set d2 (laux h f 0)))))
    (if (== k K_BYTES)
      (do (set d0 (ld h l 0)) (set d1 (ld h l 1))
          (if (>= (ld h l 2) 0)
            (do (set d2 (vget h T_POOLOFF (ld h l 2))) (set d3 (bid-len h (ld h l 2)))))))
    (if (== k K_UINTX)
      (do (set d0 (ld h l 0)) (set d1 (ld h l 1))
          (if (> (ld h l 3) 0) (do (set d2 (laux h f 0)) (set d3 (ld h l 3))))))
    (if (== k K_TAG) (do (set d0 (ld h l 0)) (set d1 (ld h l 1)) (set d2 (fts-of h (ld h l 2)))))
    (if (== k K_TAGSET)
      (do (set d0 (ld h l 0)) (set d1 (ld h l 1)) (set d2 (ld h l 2)) (set d3 (ld h l 3))
          (set d4 (fts-of h (ld h l 4)))))
    (if (== k K_EMBED) (set d0 (fts-of h (ld h l 0))))
    (if (or (== k K_ARRAY) (== k K_MAP)) (set d0 (laux h f 0)))
    (if (or (== k K_AND) (== k K_NOT)) (do (set d0 (fin h (ld h l 0))) (set d1 (fin h (ld h l 1)))))
    (out h (bit-or k (shl fl 8)))
    (out h (leaf-mask h l))
    (out h d0) (out h d1) (out h d2) (out h d3) (out h d4) (out h 0)))

(defn write-map [^Ints h ^I32 f]
  (let [l (fin-internal h f)
        blob (map-blob h l)
        nf (vget h T_MAPD blob)
        np (vget h T_MAPD (+ blob 1))
        na (vget h T_MAPD (+ blob 2))
        nl (vget h T_MAPD (+ blob 3))
        fb (+ blob 4)
        pb (+ fb (* 3 nf))
        ab (+ pb (* 5 np))
        pg (laux h f 1)
        ks (vlen h T_TMP2)
        nk (map-keys-into h blob T_TMP2)]
    (out h nf) (out h np) (out h na) (out h nl) (out h nk) (out h nl)
    (out h (laux h f 2)) (out h (laux h f 3))
    (comment "factors")
    (for [^I32 i 0 nf]
      (let [mode (vget h T_MAPD (+ fb (* 3 i)))]
        (out h mode)
        (if (== mode 2) (out h 0) (out h (neg 1)))
        (out h (vget h T_MAPD (+ fb (+ (* 3 i) 1))))
        (out h (vget h T_MAPD (+ fb (+ (* 3 i) 2))))))
    (comment "pools, with state offsets")
    (let [^:mut so (+ 4 nf)]
      (for [^I32 p 0 np]
        (let [prec (+ pb (* 5 p))]
          (out h (vget h T_MAPD prec))
          (out h (vget h T_POOLG (+ pg p)))
          (out h (vget h T_MAPD (+ prec 3)))
          (out h (vget h T_MAPD (+ prec 4)))
          (out h so)
          (set so (+ so (+ 4 (vget h T_MAPD (+ prec 2)))))))
      (comment "alternatives")
      (let [^:mut lf 0]
        (for [^I32 a 0 na]
          (let [arec (+ ab (* 3 a))
                lo (+ blob (vget h T_MAPD (+ arec 1)))
                ln (vget h T_MAPD (+ arec 2))
                ^:mut req 0]
            (for [^I32 i2 0 ln]
              (if (== (vget h T_MAPD (+ lo (+ (* 4 i2) 2))) 1) (set req (+ req 1))))
            (out h (vget h T_MAPD arec))
            (out h lf)
            (out h ln)
            (out h req)
            (out h so)
            (set so (+ so (+ 3 (ceil32 ln))))
            (set lf (+ lf ln))))))
    (comment "literal entries")
    (for [^I32 a2 0 na]
      (let [arec2 (+ ab (* 3 a2))
            lo2 (+ blob (vget h T_MAPD (+ arec2 1)))
            ln2 (vget h T_MAPD (+ arec2 2))]
        (for [^I32 i3 0 ln2]
          (let [e (+ lo2 (* 4 i3))]
            (out h (vget h T_KEYID (vget h T_MAPD e)))
            (out h (fts-of h (vget h T_MAPD (+ e 1))))
            (out h (vget h T_MAPD (+ e 2)))
            (out h (vget h T_MAPD (+ e 3)))))))
    (comment "key index (key, owner, names run) and naming records, from the key"
             "triples: grouped by key, alternatives ascending")
    (let [nt (key-triples h blob)
          ^:mut q 0]
      (while (< q nt)
        (let [kid (vget h T_KEYTRI (* 3 q))
              ^:mut qe q]
          (while (and (< qe nt) (== (vget h T_KEYTRI (* 3 qe)) kid)) (set qe (+ qe 1)))
          (out h kid)
          (out h (vget h T_MAPD (+ pb (* 5 (vget h T_MAPD (+ ab (* 3 (vget h T_KEYTRI (+ (* 3 q) 1)))))))))
          (out h q)
          (out h (- qe q))
          (set q qe)))
      (for [^I32 r 0 nt]
        (out h (vget h T_KEYTRI (+ (* 3 r) 1)))
        (out h (vget h T_KEYTRI (+ (* 3 r) 2)))))
    (vtrunc h T_TMP2 ks)))

(defn write-array [^Ints h ^I32 f]
  (let [l (fin-internal h f)
        blob (vget h T_ARR (ld h l 0))
        npos (vget h T_ARRD blob)
        w (vget h T_ARRD (+ blob 1))
        nc (vget h T_ARRD (+ blob 2))
        n (+ (+ 4 (* 2 w)) (+ (* 2 npos) (+ (* 2 nc) (* npos w))))
        pb (+ (+ blob 4) (* 2 w))]
    (for [^I32 i 0 n]
      (let [x (vget h T_ARRD (+ blob i))
            ^:mut y x]
        (if (and (>= i (- pb blob)) (< i (+ (- pb blob) (* 2 npos))))
          (if (== (rem2 (- i (- pb blob)) 2) 0) (set y (fts-of h x))))
        (out h y)))))

(defn write-regexp [^Ints h ^I32 r]
  (let [w (rx-w h r)
        npos (rx-npos h r)
        na (rx-natoms h r)
        data (rx-data h r)]
    (out h npos) (out h w) (out h na) (out h (rx-nullable h r))
    (for [^I32 i 0 (+ (+ (* 2 w) (* npos w)) (* na (+ 1 w)))]
      (out h (vget h T_RXD (+ data i))))))

(defn write-bound [^Ints h ^I32 o]
  (let [r (vget h T_IV o)]
    (out h r)
    (if (or (== r R_NEG_BIG) (== r R_POS_BIG))
      (do (out h (vget h T_POOLOFF (vget h T_IV (+ o 1))))
          (out h (bid-len h (vget h T_IV (+ o 1)))))
      (do (out h (vget h T_IV (+ o 1)))
          (out h (vget h T_IV (+ o 2)))))))

(defn ^:pub ^I32 emit-program [^Ints h]
  (comment "The whole of step 1-4; the Program in T_OUT, the pool in T_POOL.")
  (if (< (plan h) 0) (return (neg 1)))
  (if (< (assign-sections h) 0) (return (neg 1)))
  (let [nr (order-rules h)]
    (if (< nr 0) (return (neg 1)))
    (if (< (build-pool h) 0) (return (neg 1)))
    (if (< (plan-maps h) 0) (return (neg 1)))
    (comment "closure chains, in rule-table order")
    (vtrunc h T_CSET 0) (vtrunc h T_CSD 0) (vtrunc h T_CHAIN 0) (vtrunc h T_CHD 0)
    (if (not (ht-init h T_HCSET 64)) (return (neg 1)))
    (if (not (ht-init h T_HCHAIN 32)) (return (neg 1)))
    (vtrunc h T_FTSI 0)
    (let [^:mut smax 0]
      (for [^I32 i 0 nr]
        (let [r (vget h T_RORD i)
              rts (fts-of h (rw h r 9))
              ch (rule-chain h rts)
              sw (hg h H_R0)]
          (if (< ch 0) (return (neg 1)))
          (vpush1 h T_FTSI ch)
          (vpush1 h T_FTSI sw)
          (if (> sw smax) (set smax sw))))
      (comment "sizes")
      (let [nl (hg h H_N_FIN)
            nts (fts-n h)
            nkeys (vlen h T_KEYS)
            ngr (vlen h T_GRP)
            nmaps (vget h T_CLS2 0)
            narr (vget h T_CLS2 1)
            nrx (rx-final-list h)
            niv (vget h T_CLS2 3)
            nfiv (vget h T_CLS2 4)
            nlr (vget h T_CLS2 5)
            ncs (vlen h T_CSET)
            nch (vlen h T_CHAIN)
            ^:mut tsdata 0
            ^:mut gdata 0
            ^:mut mdata 0
            ^:mut adata 0
            ^:mut rdata 0
            ^:mut csdata 0
            ^:mut chdata 0]
        (for [^I32 t 0 nts]
          (set tsdata (+ tsdata (+ 2 (+ (fts-w h t 1) (fts-w h t 3))))))
        (for [^I32 g 0 ngr]
          (set gdata (+ gdata (+ 2 (* 4 (vget h T_GRPD (vget h T_GRP g)))))))
        (for [^I32 f 0 nl]
          (let [l (fin-internal h f)
                k (lk h l)]
            (if (== k K_MAP) (set mdata (+ mdata (map-size h l))))
            (if (== k K_ARRAY)
              (do (let [blob (vget h T_ARR (ld h l 0))
                        np (vget h T_ARRD blob)
                        w (vget h T_ARRD (+ blob 1))
                        nc (vget h T_ARRD (+ blob 2))]
                    (set adata (+ adata (+ (+ 4 (* 2 w)) (+ (* 2 np) (+ (* 2 nc) (* np w)))))))))))
        (for [^I32 x 0 nrx]
          (let [r2 (vget h T_TMP x)
                w2 (rx-w h r2)]
            (set rdata (+ rdata (+ (+ 4 (* 2 w2)) (+ (* (rx-npos h r2) w2) (* (rx-natoms h r2) (+ 1 w2))))))))
        (for [^I32 c 0 ncs]
          (set csdata (+ csdata (+ 3 (vget h T_CSD (vget h T_CSET c))))))
        (for [^I32 c2 0 nch]
          (set chdata (+ chdata (+ 2 (vget h T_CHD (vget h T_CHAIN c2))))))
        (let [s0 64
              s1 (+ s0 (* 5 nr))
              s2 (+ s1 (* 8 nl))
              s3 (+ s2 nts)
              s4 (+ s3 tsdata)
              s5 (+ s4 (* 2 nkeys))
              s6 (+ s5 ngr)
              s7 (+ s6 gdata)
              s8 (+ s7 nmaps)
              s9 (+ s8 mdata)
              s10 (+ s9 narr)
              s11 (+ s10 adata)
              s12 (+ s11 nrx)
              s13 (+ s12 rdata)
              s14 (+ s13 (* 6 niv))
              s15 (+ s14 (* 4 nfiv))
              s16 (+ s15 (* 2 nlr))
              s17 (+ s16 ncs)
              s18 (+ s17 csdata)
              s19 (+ s18 nch)
              send (+ s19 chdata)
              pool (vlen h T_POOL)
              total (hg h H_LIM_TOTAL)]
          (comment "Program + pool + scratch, refused before anything is written.")
          (if (or (> smax (quot total 4)) (> send (quot (- (- total pool) (* 4 smax)) 4)))
            (return (fail h ERR_LIM_TOTAL (neg 1))))
          (if (not (charge h send)) (return (neg 1)))
          (vtrunc h T_OUT 0)
          (comment "---- header")
          (let [^:mut flags 0
                ^:mut tsany (neg 1)
                ^:mut gempty (neg 1)]
            (for [^I32 kq 0 nkeys]
              (if (<= (sar (bid-byte h (vget h T_KEYS kq) 0) 5) 1) (set flags (bit-or flags 1))))
            (for [^I32 f2 0 nl]
              (let [l2 (fin-internal h f2)
                    k2 (lk h l2)]
                (if (and (== k2 K_TEXT) (>= (ld h l2 2) 0)) (set flags (bit-or flags 2)))
                (if (== k2 K_EMBED) (set flags (bit-or flags 4)))
                (if (or (== k2 K_AND) (== k2 K_NOT)) (set flags (bit-or flags 8)))
                (if (or (== k2 K_ANY) (and (== k2 K_MAJOR) (and (>= (ld h l2 0) 4) (<= (ld h l2 0) 6))))
                  (set tsany (fts-of h (hg h H_TS_ANY))))))
            (for [^I32 g2 0 ngr]
              (if (and (< gempty 0) (== (vget h T_GRPD (vget h T_GRP g2)) 0)) (set gempty g2)))
            (out h MAGIC) (out h FORMAT_VERSION) (out h 64) (out h send) (out h pool)
            (out h (hg h H_PROFILE)) (out h flags)
            (for [^I32 _z 0 8] (out h 0))
            (out h nr) (out h nl) (out h nts) (out h nkeys) (out h ngr) (out h nmaps) (out h narr)
            (out h nrx) (out h niv) (out h nfiv) (out h nlr) (out h ncs) (out h nch)
            (out h tsany) (out h gempty) (out h 0) (out h 0)
            (out h (hg h H_LIM_DEPTH)) (out h (hg h H_LIM_INPUT)) (out h (hg h H_LIM_ENTRIES))
            (out h (hg h H_LIM_ITEMS)) (out h (hg h H_LIM_BIGNUM)) (out h (hg h H_LIM_VBUDGET))
            (out h total) (out h 0) (out h smax) (out h 0)
            (out h s0) (out h s1) (out h s2) (out h s3) (out h s4) (out h s5) (out h s6) (out h s7)
            (out h s8) (out h s9) (out h s10) (out h s11) (out h s12) (out h s13) (out h s14) (out h s15)
            (out h s16) (out h s17) (out h s18) (out h s19) (out h send) (out h 0))
          (comment "---- rules")
          (for [^I32 i2 0 nr]
            (let [r3 (vget h T_RORD i2)
                  nb (vget h T_RSCR i2)]
              (out h (vget h T_POOLOFF nb))
              (out h (bid-len h nb))
              (out h (fts-of h (rw h r3 9)))
              (out h (vget h T_FTSI (* 2 i2)))
              (out h (vget h T_FTSI (+ (* 2 i2) 1)))))
          (comment "---- leaves")
          (for [^I32 f3 0 nl] (write-leaf h f3))
          (comment "---- typesets")
          (let [^:mut at s3]
            (for [^I32 t2 0 nts]
              (out h at)
              (set at (+ at (+ 2 (+ (fts-w h t2 1) (fts-w h t2 3)))))))
          (for [^I32 t3 0 nts]
            (out h (fts-w h t3 1))
            (out h (fts-w h t3 3))
            (for [^I32 a 0 (fts-w h t3 1)] (out h (vget h T_FTSL (+ (fts-w h t3 0) a))))
            (for [^I32 b 0 (fts-w h t3 3)] (out h (vget h T_FTSL (+ (fts-w h t3 2) b)))))
          (comment "---- keys")
          (for [^I32 kk 0 nkeys]
            (let [kb (vget h T_KEYS kk)]
              (out h (vget h T_POOLOFF kb))
              (out h (bid-len h kb))))
          (comment "---- groups")
          (let [^:mut at2 s6]
            (for [^I32 g3 0 ngr]
              (out h at2)
              (set at2 (+ at2 (+ 2 (* 4 (vget h T_GRPD (vget h T_GRP g3))))))))
          (for [^I32 g4 0 ngr]
            (let [go (vget h T_GRP g4)
                  gn (vget h T_GRPD go)]
              (for [^I32 gi 0 (+ 2 (* 4 gn))] (out h (vget h T_GRPD (+ go gi))))))
          (comment "---- maps")
          (let [^:mut at3 s8]
            (for [^I32 f4 0 nl]
              (let [l4 (fin-internal h f4)]
                (if (== (lk h l4) K_MAP)
                  (do (out h at3) (set at3 (+ at3 (map-size h l4))))))))
          (for [^I32 f5 0 nl]
            (if (== (lk h (fin-internal h f5)) K_MAP) (write-map h f5)))
          (comment "---- arrays")
          (let [^:mut at4 s10]
            (for [^I32 f6 0 nl]
              (let [l6 (fin-internal h f6)]
                (if (== (lk h l6) K_ARRAY)
                  (do (let [blob6 (vget h T_ARR (ld h l6 0))
                            np6 (vget h T_ARRD blob6)
                            w6 (vget h T_ARRD (+ blob6 1))
                            nc6 (vget h T_ARRD (+ blob6 2))]
                        (out h at4)
                        (set at4 (+ at4 (+ (+ 4 (* 2 w6)) (+ (* 2 np6) (+ (* 2 nc6) (* np6 w6))))))))))))
          (for [^I32 f7 0 nl]
            (if (== (lk h (fin-internal h f7)) K_ARRAY) (write-array h f7)))
          (comment "---- regexps")
          (let [^:mut at5 s12]
            (for [^I32 x2 0 nrx]
              (let [r4 (vget h T_TMP x2)
                    w4 (rx-w h r4)]
                (out h at5)
                (set at5 (+ at5 (+ (+ 4 (* 2 w4)) (+ (* (rx-npos h r4) w4) (* (rx-natoms h r4) (+ 1 w4)))))))))
          (for [^I32 x3 0 nrx] (write-regexp h (vget h T_TMP x3)))
          (comment "---- intervals, float intervals, LITSET members")
          (for [^I32 f8 0 nl]
            (let [l8 (fin-internal h f8)
                  k8 (lk h l8)
                  ^:mut first (neg 1)
                  ^:mut cnt8 0]
              (if (== k8 K_INT) (do (set first (ld h l8 0)) (set cnt8 (ld h l8 1))))
              (if (== k8 K_UINTX) (do (set first (ld h l8 2)) (set cnt8 (ld h l8 3))))
              (for [^I32 v 0 cnt8]
                (let [o (* 6 (+ first v))]
                  (write-bound h o)
                  (write-bound h (+ o 3))))))
          (for [^I32 f9 0 nl]
            (let [l9 (fin-internal h f9)]
              (if (and (== (lk h l9) K_FLOAT) (> (ld h l9 1) 0))
                (for [^I32 v2 0 (* 4 (ld h l9 1))]
                  (out h (vget h T_FIV (+ (* 4 (ld h l9 0)) v2)))))))
          (for [^I32 f10 0 nl]
            (let [l10 (fin-internal h f10)]
              (if (== (lk h l10) K_LITSET)
                (for [^I32 m 0 (ld h l10 1)]
                  (let [mb (vget h T_LST (+ (ld h l10 0) m))]
                    (out h (vget h T_POOLOFF mb))
                    (out h (bid-len h mb)))))))
          (comment "---- closure sets and chains")
          (let [^:mut at6 s17]
            (for [^I32 c3 0 ncs]
              (out h at6)
              (set at6 (+ at6 (+ 3 (vget h T_CSD (vget h T_CSET c3)))))))
          (for [^I32 c4 0 ncs]
            (let [co (vget h T_CSET c4)]
              (for [^I32 ci 0 (+ 3 (vget h T_CSD co))] (out h (vget h T_CSD (+ co ci))))))
          (let [^:mut at7 s19]
            (for [^I32 c5 0 nch]
              (out h at7)
              (set at7 (+ at7 (+ 2 (vget h T_CHD (vget h T_CHAIN c5)))))))
          (for [^I32 c6 0 nch]
            (let [cho (vget h T_CHAIN c6)]
              (for [^I32 cj 0 (+ 2 (vget h T_CHD cho))] (out h (vget h T_CHD (+ cho cj))))))
          (if (erred h) (return (neg 1)))
          (if (!= (vlen h T_OUT) send) (return (fail h ERR_INTERNAL (neg 1))))
          (hs h H_OUT_P (vbase h T_OUT))
          (hs h H_OUT_PN send)
          (hs h H_OUT_B (vbase h T_POOL))
          (hs h H_OUT_BN pool)
          (return 0))))))


