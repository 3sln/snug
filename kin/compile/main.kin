;; The compiler's entry point: CDDL text in, a Program (docs/program.md format
;; 1) out, or a schema error. The host owns only the arena and the loop around
;; this call (host/js/src/compile.mjs, host/rust/src/compile.rs):
;;
;;     code = compile-schema(text, opt, fl, unicode, h)
;;     ERR_ARENA        -> retry with a larger arena (up to ARENA_MAX_WORDS)
;;     ERR_NEED_FLOATS  -> convert the requested literal spans (D020/D029), retry
;;     0                -> the Program: h[H_OUT_P ..] words, h[H_OUT_B ..] pool bytes
;;     else             -> schema error: code, line, column, rule name span
;;
;; `opt` (OPT_WORDS words, -1 = default) is every compile option, in the order
;; of program.md §13.3's source key, then the leaf limit, the regexp dialect
;; (D242), the cut mode and the group arena cap (format 2.0, program-2 §1);
;; words from OPT_WORDS on, when present, are the extension-control registry
;; (snug.compile.ext, D141).
;;
;; A compiled schema may carry compile WARNINGS (architecture §20.11, W1-W7):
;; `warning-count` and the `warning-*` accessors, deterministic on every host.
(ns snug.compile.main
  (:require [kin.lang :refer [defn let return set if while for do comment defconst case declarefn]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR Str + - * neg quot bit-and < > <= >= == != and or not
                               u8 blen ia iset ilen]]
            [snug.compile.arena :refer [hg hs erred fail charge vinit vlen vpush1 vget vset vtrunc vbase msort-records
                                        H_CUTS H_LIM_GROUP H_GROUP_GIVEN T_WARN
                                        INF H_TOP H_ERR H_ERR_POS H_ERR_RULE H_BUDGET H_DEPTH H_NSRC
                                        H_CUR_RULE H_ERR_LINE H_ERR_COL H_ERR_RNAME H_ERR_RNAME_LEN
                                        H_LIM_TEXT H_LIM_NEST H_LIM_AST H_LIM_INST H_LIM_ALTS H_LIM_APOS
                                        H_LIM_RPOS H_LIM_WIDTH H_LIM_POOL H_LIM_TOTAL H_LIM_BUDGET
                                        H_LIM_DEPTH H_LIM_INPUT H_LIM_ENTRIES H_LIM_ITEMS H_LIM_BIGNUM
                                        H_LIM_VBUDGET H_LIM_LEAVES H_PROFILE H_FL_GIVEN H_PRELUDE_AT
                                        H_DATA N_TABLES H_DEPTH_MAX H_OUT_P H_OUT_PN H_OUT_B H_OUT_BN
                                        ERR_LIM_TEXT ERR_SYNTAX ERR_NEED_FLOATS ERR_EMPTY ERR_ARENA ERR_INTERNAL H_G1 H_G2
                                        T_UNICODE T_SRC T_FLREQ T_STK6 T_KEYPRE H_EXT_FLAGS H_REGEXP]]
            [snug.compile.prelude :refer [prelude-len prelude-byte]]
            [snug.compile.lex :refer [lex check-utf8 tk-start]]
            [snug.compile.parse :refer [parse-rules]]
            [snug.compile.bytes :refer [bytes-init head-push]]
            [snug.compile.leaf :refer [leaf-init]]
            [snug.compile.regexp :refer [rx-init unicode-init]]
            [snug.compile.rules :refer [build-rules nrules rw def-next]]
            [snug.compile.parse :refer [npos]]
            [snug.compile.lower :refer [lower-init lower-rules]]
            [snug.compile.emit :refer [emit-program]]
            [snug.compile.ext :refer [ext-init n-exts ext-name-len ext-name-byte ext-max]]))

(defconst ^:pub ^I32 OPT_WORDS 22)
(defconst ^:pub ^I32 OPT_REGEXP 19)
;; format 2.0: 0 `reference` (rule A, default), 1 `rfc` (D273)
(defconst ^:pub ^I32 OPT_CUTS 20)
;; format 2.0: the group arena cap in words (D276, D281; -1 = the default)
(defconst ^:pub ^I32 OPT_GROUP_WORDS 21)
(defconst ^:pub ^I32 GROUP_WORDS_DEFAULT 4194304)
(defconst ^:pub ^I32 GROUP_WORDS_MAX 16777216)

(declarefn build-key-preimage ^I32 if-limit warnings-finish)
(defconst ^:pub ^I32 OPT_PROFILE 0)

(defn ^I32 opt-limit [^IntsR opt ^I32 i ^I32 dflt ^I32 hard]
  (comment "Option i: the default when absent (-1 or negative), at most `hard`.")
  (if (>= i (ilen opt)) (return dflt))
  (let [v (ia opt i)]
    (if (< v 0) (return dflt))
    (if (> v hard) (return hard))
    (return v)))

(defn ^:pub setup-limits [^Ints h ^IntsR opt]
  (comment "Effective limits (architecture §7, program.md §17 q18 for leaves).")
  (let [profile (opt-limit opt 0 0 2)
        ^:mut text-default 262144]
    (hs h H_PROFILE profile)
    (hs h H_REGEXP (opt-limit opt OPT_REGEXP 0 1))
    (hs h H_CUTS (opt-limit opt OPT_CUTS 0 1))
    (let [gw (opt-limit opt OPT_GROUP_WORDS (neg 1) GROUP_WORDS_MAX)]
      (hs h H_GROUP_GIVEN gw)
      (if (< gw 0) (hs h H_LIM_GROUP GROUP_WORDS_DEFAULT) (hs h H_LIM_GROUP gw)))
    (if (== profile 2) (set text-default 16384))
    (hs h H_LIM_TEXT (opt-limit opt 1 text-default 1048576))
    (comment "bus: schema text at most 16 KiB whatever the option says (§5.3).")
    (if (and (== profile 2) (> (hg h H_LIM_TEXT) 16384)) (hs h H_LIM_TEXT 16384))
    (hs h H_LIM_NEST (opt-limit opt 2 64 256))
    (hs h H_LIM_AST (opt-limit opt 3 65536 1048576))
    (hs h H_LIM_INST (opt-limit opt 4 1024 16384))
    (comment "format 2.0 (D292): option 5 limits PEG nodes per group (was alternatives)")
    (hs h H_LIM_ALTS (opt-limit opt 5 1024 16384))
    (hs h H_LIM_APOS (opt-limit opt 6 256 4096))
    (hs h H_LIM_RPOS (opt-limit opt 7 256 512))
    (hs h H_LIM_WIDTH (opt-limit opt 8 256 4096))
    (hs h H_LIM_POOL (opt-limit opt 9 1048576 16777216))
    (hs h H_LIM_TOTAL (opt-limit opt 10 8388608 67108864))
    (hs h H_LIM_BUDGET (opt-limit opt 11 10000000 INF))
    (hs h H_LIM_DEPTH (opt-limit opt 12 32 256))
    (hs h H_LIM_INPUT (opt-limit opt 13 1500000 INF))
    (hs h H_LIM_ENTRIES (opt-limit opt 14 65536 16777216))
    (hs h H_LIM_ITEMS (opt-limit opt 15 131072 16777216))
    (comment "program.md §17 q22: only 128 bignum content bytes in revision 2.")
    (hs h H_LIM_BIGNUM 128)
    (hs h H_LIM_VBUDGET (opt-limit opt 17 2250000 INF))
    (hs h H_LIM_LEAVES (opt-limit opt 18 65536 1048576))
    (let [b (hg h H_LIM_BUDGET)]
      (hs h H_BUDGET b))
    (comment "Recursion in the later phases (names, generics, groups) is bounded by"
             "a depth derived from the nesting limit, so no host stack is at risk.")
    (let [nest (hg h H_LIM_NEST)
          ^:mut dm (* 4 nest)]
      (comment "...capped, so the deepest lowering stays far inside any host stack.")
      (if (> dm 512) (set dm 512))
      (hs h H_DEPTH_MAX dm))))

(defn ^:pub ^Bool setup [^Bytes text ^IntsR opt ^IntsR fl ^IntsR unicode ^Ints h]
  (comment "Fresh header and vectors; the source vector: text, -1, prelude, -1.")
  (for [^I32 i 0 H_DATA]
    (iset h i 0))
  (iset h H_TOP H_DATA)
  (iset h H_CUR_RULE (neg 1))
  (iset h H_ERR_RULE (neg 1))
  (iset h H_ERR_POS (neg 1))
  (for [^I32 t 0 N_TABLES]
    (vinit h t))
  (setup-limits h opt)
  (let [n (blen text)]
    (if (> n (hg h H_LIM_TEXT))
      (do (fail h ERR_LIM_TEXT (neg 1)) (return false)))
    (hs h H_NSRC n)
    (for [^I32 j 0 n]
      (let [c (u8 text j)]
        (vpush1 h T_SRC c)))
    (vpush1 h T_SRC (neg 1))
    (hs h H_PRELUDE_AT (+ n 1))
    (let [pn (prelude-len)]
      (for [^I32 k 0 pn]
        (let [pc (prelude-byte k)]
          (vpush1 h T_SRC pc))))
    (vpush1 h T_SRC (neg 1)))
  (comment "Decimal float literal patterns the host converted on a previous round.")
  (if (> (ilen fl) 0)
    (do (let [nf (ia fl 0)]
          (if (and (> nf 0) (<= (+ 1 (* 2 nf)) (ilen fl)))
            (do (hs h H_FL_GIVEN nf)
                (for [^I32 q 0 (* 2 nf)]
                  (let [w (ia fl (+ q 1))]
                    (vpush1 h T_FLREQ w))))))))
  (if (not (unicode-init h unicode)) (return false))
  (comment "D141: the extension-control registry after the OPT_WORDS options")
  (if (not (ext-init h opt)) (return false))
  (return (not (erred h))))

(defn ^:pub ^I32 float-requests [^IntsR h]
  (comment "After ERR_NEED_FLOATS: how many decimal literals need converting.")
  (return (quot (vlen h T_STK6) 2)))

(defn ^:pub ^I32 float-request-start [^IntsR h ^I32 i]
  (return (vget h T_STK6 (* 2 i))))

(defn ^:pub ^I32 float-request-end [^IntsR h ^I32 i]
  (return (vget h T_STK6 (+ (* 2 i) 1))))

(defn ^:pub finish-error [^Ints h]
  (comment "Line (1-based) and column (1-based, in code points) of the error offset"
           "when it is in the schema text; 0, 0 otherwise.")
  (let [pos (hg h H_ERR_POS)
        n (hg h H_NSRC)
        ^:mut line 1
        ^:mut col 1]
    (if (or (< pos 0) (> pos n))
      (do (hs h H_ERR_LINE 0) (hs h H_ERR_COL 0))
      (do (for [^I32 i 0 pos]
            (let [c (vget h T_SRC i)]
              (if (== c 10)
                (do (set line (+ line 1)) (set col 1))
                (if (!= (bit-and c 192) 128) (set col (+ col 1))))))
          (hs h H_ERR_LINE line)
          (hs h H_ERR_COL col)))))

(defn ^I32 bail [^Ints h]
  (comment "A phase failed: report its error (ERR_INTERNAL if it recorded none, so a"
           "silent failure can never pass for success).")
  (if (== (ia h H_ERR) 0) (fail h ERR_INTERNAL (neg 1)))
  (finish-error h)
  (return (ia h H_ERR)))

(defn ^:pub ^I32 compile-schema [^Bytes text ^IntsR opt ^IntsR fl ^IntsR unicode ^Ints h]
  (comment "See the namespace doc. Answers 0 or an error code (also in h[H_ERR]).")
  (if (< (ilen h) (+ H_DATA 1024)) (return ERR_ARENA))
  (if (not (setup text opt fl unicode h))
    (return (bail h)))
  (let [n (hg h H_NSRC)
        bad (check-utf8 h 0 n)]
    (if (>= bad 0)
      (do (fail h ERR_SYNTAX bad) (return (bail h)))))
  (let [ut (lex h 0)]
    (if (erred h) (return (bail h)))
    (if (> (vlen h T_STK6) 0)
      (do (iset h H_ERR ERR_NEED_FLOATS) (return ERR_NEED_FLOATS)))
    (let [pat (hg h H_PRELUDE_AT)
          pt (lex h pat)]
      (if (erred h) (return (bail h)))
      (let [urules (parse-rules h ut)]
        (if (erred h) (return (bail h)))
        (if (< urules 0)
          (do (fail h ERR_EMPTY 0) (return (bail h))))
        (let [prules (parse-rules h pt)]
          (if (erred h) (return (bail h)))
          (if (or (not (bytes-init h)) (or (not (leaf-init h)) (or (not (rx-init h)) (not (lower-init h)))))
            (return (bail h)))
          (if (or (< (build-rules h urules prules) 0) (erred h))
            (return (bail h)))
          (if (or (< (lower-rules h) 0) (erred h))
            (return (bail h)))
          (if (or (< (emit-program h) 0) (erred h))
            (return (bail h)))
          (comment "Belt and braces: a phase that swallowed an error (an arena that"
                   "ran out mid-way) must not pass for a Program.")
          (if (< (hg h H_OUT_PN) 64) (return (bail h)))
          (warnings-finish h)
          (if (erred h) (return (bail h)))
          (build-key-preimage h)
          (if (erred h) (return (bail h)))
          (return 0))))))

(defconst ^:pub ^I32 SNUG_VERSION_LEN 5)

(defn ^:pub ^Str snug-version []
  (comment "The snug version: in the source key (program.md §13.3) and the"
           "serialisation container. One place, so both hosts agree.")
  (return "0.0.0"))

(defn ^I32 version-byte [^I32 i]
  (comment "Byte i of the version text \"0.0.0\" (kept beside snug-version).")
  (if (== (bit-and i 1) 1) (return 46))
  (return 48))

(defn push-uint [^Ints h ^I32 t ^I32 v]
  (head-push h t 0 0 v))

(defn ^:pub build-key-preimage [^Ints h]
  (comment "program.md §13.3's source-key preimage, deterministic CBOR, into T_KEYPRE"
           "(one byte per word): [\"snug/program-key\", 2, version, profile, [17"
           "effective limits, cuts, groupWords or -1], schema text as bytes, ...]"
           "(format 2.0: program-2 §1). The host hashes it (SHA-256) into header"
           "words 7..14.")
  (vtrunc h T_KEYPRE 0)
  (comment "6 elements; 7 with Unicode tables (D110); 8 with registered controls (D141),"
           "the seventh then the tables' words or an empty array.")
  (if (== (hg h H_REGEXP) 0)
    (vpush1 h T_KEYPRE 137)
    (if (> (n-exts h) 0)
    (vpush1 h T_KEYPRE 136)
    (if (> (vlen h T_UNICODE) 0) (vpush1 h T_KEYPRE 135) (vpush1 h T_KEYPRE 134))))
  (head-push h T_KEYPRE 3 0 16)
  (comment "\"snug/program-key\"")
  (vpush1 h T_KEYPRE 115) (vpush1 h T_KEYPRE 110) (vpush1 h T_KEYPRE 117) (vpush1 h T_KEYPRE 103)
  (vpush1 h T_KEYPRE 47) (vpush1 h T_KEYPRE 112) (vpush1 h T_KEYPRE 114) (vpush1 h T_KEYPRE 111)
  (vpush1 h T_KEYPRE 103) (vpush1 h T_KEYPRE 114) (vpush1 h T_KEYPRE 97) (vpush1 h T_KEYPRE 109)
  (vpush1 h T_KEYPRE 45) (vpush1 h T_KEYPRE 107) (vpush1 h T_KEYPRE 101) (vpush1 h T_KEYPRE 121)
  (push-uint h T_KEYPRE 2)
  (head-push h T_KEYPRE 3 0 SNUG_VERSION_LEN)
  (for [^I32 i 0 SNUG_VERSION_LEN]
    (vpush1 h T_KEYPRE (version-byte i)))
  (let [pr (hg h H_PROFILE)] (push-uint h T_KEYPRE pr))
  (head-push h T_KEYPRE 4 0 19)
  (for [^I32 k 0 17]
    (let [v (hg h (if-limit k))]
      (push-uint h T_KEYPRE v)))
  (let [cm (hg h H_CUTS)
        gw (hg h H_GROUP_GIVEN)]
    (push-uint h T_KEYPRE cm)
    (if (< gw 0) (head-push h T_KEYPRE 1 0 0) (push-uint h T_KEYPRE gw)))
  (let [n (hg h H_NSRC)]
    (head-push h T_KEYPRE 2 0 n)
    (for [^I32 j 0 n]
      (let [c (vget h T_SRC j)]
        (vpush1 h T_KEYPRE c))))
  (comment "D110: optional seventh element binds the source key to table contents."
           "The no-table preimage stays byte-identical to D039.")
  (let [un (vlen h T_UNICODE)]
    (if (or (== (hg h H_REGEXP) 0) (or (> un 0) (> (n-exts h) 0)))
      (do (if (not (charge h un)) (return))
          (head-push h T_KEYPRE 4 0 un)
          (for [^I32 j2 0 un]
            (let [uv (vget h T_UNICODE j2)]
              (push-uint h T_KEYPRE uv))))))
  (comment "D141: [flags, [name, max item bytes]...] in registry (name) order, so a"
           "cached Program is never reused under another registry.")
  (let [ne (n-exts h)]
    (if (> ne 0)
      (do (head-push h T_KEYPRE 4 0 2)
          (let [xf (hg h H_EXT_FLAGS)] (push-uint h T_KEYPRE xf))
          (head-push h T_KEYPRE 4 0 ne)
          (for [^I32 k2 0 ne]
            (let [len (ext-name-len h k2)
                  mx (ext-max h k2)]
              (if (not (charge h (+ 2 len))) (return))
              (head-push h T_KEYPRE 4 0 2)
              (head-push h T_KEYPRE 3 0 len)
              (for [^I32 xc 0 len]
                (let [xb (ext-name-byte h k2 xc)] (vpush1 h T_KEYPRE xb)))
              (push-uint h T_KEYPRE mx))))
      (if (== (hg h H_REGEXP) 0) (head-push h T_KEYPRE 4 0 0))))
  (if (== (hg h H_REGEXP) 0) (push-uint h T_KEYPRE 0)))

(defn ^I32 if-limit [^I32 k]
  (comment "The header word of compile option k (source-key order).")
  (case k
    [0] H_LIM_TEXT
    [1] H_LIM_NEST
    [2] H_LIM_AST
    [3] H_LIM_INST
    [4] H_LIM_ALTS
    [5] H_LIM_APOS
    [6] H_LIM_RPOS
    [7] H_LIM_WIDTH
    [8] H_LIM_POOL
    [9] H_LIM_TOTAL
    [10] H_LIM_BUDGET
    [11] H_LIM_DEPTH
    [12] H_LIM_INPUT
    [13] H_LIM_ENTRIES
    [14] H_LIM_ITEMS
    [15] H_LIM_BIGNUM
    :else H_LIM_VBUDGET))

(defn ^:pub ^I32 key-preimage-at [^IntsR h] (return (vbase h T_KEYPRE)))
(defn ^:pub ^I32 key-preimage-len [^IntsR h] (return (vlen h T_KEYPRE)))

(defn ^:pub ^Str error-name [^I32 code]
  (comment "The stable name of a schema error code (the API's SchemaError.code).")
  (case code
    [1] "limit_memory"
    [3] "internal"
    [10] "syntax"
    [12] "limit_schema_bytes"
    [13] "limit_nesting"
    [14] "limit_ast_nodes"
    [15] "limit_instantiations"
    [16] "limit_peg_nodes"
    [17] "limit_array_positions"
    [18] "limit_regexp_positions"
    [19] "limit_width"
    [20] "limit_pool_bytes"
    [21] "limit_total_bytes"
    [22] "limit_compile_budget"
    [23] "limit_leaves"
    [24] "limit_memory"
    [30] "undefined_name"
    [31] "duplicate_rule"
    [32] "type_group_mismatch"
    [33] "generic_arity"
    [34] "nonproductive"
    [35] "group_recursion"
    [36] "unwrap"
    [37] "enum"
    [38] "range"
    [39] "float_literal"
    [40] "control_target"
    [41] "control_value"
    [42] "unsupported_control"
    [43] "unknown_control"
    [44] "regexp"
    [54] "regexp"
    [55] "control_registry"
    [56] "regexp"
    [45] "map_key"
    [49] "tag"
    [50] "major"
    [51] "profile"
    [52] "empty_schema"
    :else "internal"))

(defn ^:pub ^I32 error-line [^IntsR h] (return (hg h H_ERR_LINE)))
(defn ^:pub ^I32 error-offset [^IntsR h]
  (comment "The error's byte offset in the schema text (-1 when not about a place in"
           "it); at an `unknown_control` error, the control's `.` (D141: hosts name it).")
  (let [pos (hg h H_ERR_POS)]
    (if (> pos (hg h H_NSRC)) (return (neg 1)))
    (return pos)))
(defn ^:pub ^I32 error-column [^IntsR h] (return (hg h H_ERR_COL)))

(defn ^:pub ^I32 error-rule-start [^IntsR h]
  (comment "Byte offset in the schema text of the name of the rule the error is in,"
           "or -1 (none, or a prelude rule).")
  (let [r (hg h H_ERR_RULE)]
    (if (or (< r 0) (>= r (nrules h))) (return (neg 1)))
    (if (!= (rw h r 7) 0) (return (neg 1)))
    (return (rw h r 0))))

(defn ^:pub ^I32 error-rule-len [^IntsR h]
  (let [r (hg h H_ERR_RULE)]
    (if (or (< r 0) (>= r (nrules h))) (return 0))
    (return (rw h r 1))))

(defn ^:pub ^I32 out-program-at [^IntsR h] (return (hg h H_OUT_P)))
(defn ^:pub ^I32 out-program-words [^IntsR h] (return (hg h H_OUT_PN)))
(defn ^:pub ^I32 out-pool-at [^IntsR h] (return (hg h H_OUT_B)))
(defn ^:pub ^I32 out-pool-bytes [^IntsR h] (return (hg h H_OUT_BN)))

(defn ^:pub ^I32 budget-used [^IntsR h]
  (comment "Compile budget units the last call spent (for benchmarks and the fuzz gate).")
  (return (- (hg h H_LIM_BUDGET) (hg h H_BUDGET))))

;; ------------------------------------------------------------ warnings (architecture §20.11)
;; T_WARN records (4 words): sort key, code, source offset (-1: none), rule.

(defn ^I32 rule-at [^IntsR h ^I32 pos]
  (comment "The schema rule whose definition holds source offset pos: the definition"
           "(N_RULE, at its name) with the largest offset <= pos; -1 if none.")
  (if (< pos 0) (return (neg 1)))
  (let [^:mut best (neg 1)
        ^:mut at (neg 1)]
    (for [^I32 r 0 (nrules h)]
      (if (== (rw h r 7) 0)
        (do (let [^:mut d (rw h r 2)]
              (while (>= d 0)
                (let [dp (npos h d)]
                  (if (and (<= dp pos) (> dp at)) (do (set at dp) (set best r))))
                (set d (def-next h d)))))))
    (return best)))

(defn ^:pub warnings-finish [^Ints h]
  (comment "Sort the warnings by (offset, code), drop repeats (one AST node lowered in"
           "several generic environments warns once) and name each one's rule.")
  (let [n (quot (vlen h T_WARN) 4)]
    (if (not (charge h (+ 1 (* 4 n)))) (return))
    (for [^I32 i 0 n]
      (let [code (vget h T_WARN (* 4 i))
            pos (vget h T_WARN (+ (* 4 i) 1))]
        (vset h T_WARN (+ (* 4 i) 2) code)
        (vset h T_WARN (+ (* 4 i) 3) pos)
        (vset h T_WARN (* 4 i) (+ (* pos 8) code))
        (vset h T_WARN (+ (* 4 i) 1) code)))
    (if (not (msort-records h T_WARN 0 n 4)) (return))
    (let [^:mut w 0]
      (for [^I32 j 0 n]
        (let [key (vget h T_WARN (* 4 j))]
          (if (or (== j 0) (!= key (vget h T_WARN (* 4 (- w 1)))))
            (do (let [c2 (vget h T_WARN (+ (* 4 j) 1))
                      p2 (vget h T_WARN (+ (* 4 j) 3))
                      r2 (rule-at h p2)]
                  (vset h T_WARN (* 4 w) key)
                  (vset h T_WARN (+ (* 4 w) 1) c2)
                  (vset h T_WARN (+ (* 4 w) 2) p2)
                  (vset h T_WARN (+ (* 4 w) 3) r2))
                (set w (+ w 1))))))
      (vtrunc h T_WARN (* 4 w)))))

(defn ^:pub ^I32 warning-count [^IntsR h] (return (quot (vlen h T_WARN) 4)))
(defn ^:pub ^I32 warning-code [^IntsR h ^I32 i] (return (vget h T_WARN (+ (* 4 i) 1))))
(defn ^:pub ^I32 warning-offset [^IntsR h ^I32 i] (return (vget h T_WARN (+ (* 4 i) 2))))

(defn ^:pub ^I32 warning-line [^IntsR h ^I32 i]
  (comment "1-based line of warning i, 0 when it is about no place (W7).")
  (let [pos (warning-offset h i)
        ^:mut line 1]
    (if (or (< pos 0) (> pos (hg h H_NSRC))) (return 0))
    (for [^I32 k 0 pos]
      (if (== (vget h T_SRC k) 10) (set line (+ line 1))))
    (return line)))

(defn ^:pub ^I32 warning-column [^IntsR h ^I32 i]
  (comment "1-based column (code points) of warning i, 0 when it is about no place.")
  (let [pos (warning-offset h i)
        ^:mut col 1]
    (if (or (< pos 0) (> pos (hg h H_NSRC))) (return 0))
    (for [^I32 k 0 pos]
      (let [c (vget h T_SRC k)]
        (if (== c 10)
          (set col 1)
          (if (!= (bit-and c 192) 128) (set col (+ col 1))))))
    (return col)))

(defn ^:pub ^I32 warning-rule-start [^IntsR h ^I32 i]
  (comment "Offset of the name of warning i's rule, or -1.")
  (let [r (vget h T_WARN (+ (* 4 i) 3))]
    (if (< r 0) (return (neg 1)))
    (return (rw h r 0))))

(defn ^:pub ^I32 warning-rule-len [^IntsR h ^I32 i]
  (let [r (vget h T_WARN (+ (* 4 i) 3))]
    (if (< r 0) (return 0))
    (return (rw h r 1))))

(defn ^:pub ^Str warning-name [^I32 code]
  (comment "The stable code of a warning (the API's warning.code).")
  (case code
    [1] "W1"
    [2] "W2"
    [3] "W3"
    [4] "W4"
    [5] "W5"
    [6] "W6"
    [7] "W7"
    :else "W0"))

(defn ^:pub ^Str warning-message [^I32 code]
  (comment "The fixed text of a warning (architecture §20.11).")
  (case code
    [1] "required member can never match: an earlier unbounded member with an any value takes its keys"
    [2] "optional member is ineffective: an earlier unbounded member with an any value takes its keys"
    [3] "greedy unbounded repetition is followed by a required entry it subsumes, which can never match"
    [4] "repetition with a minimum of 2 or more wraps a body that consumes all it matches"
    [5] "choice alternative follows one that cannot fail and is never tried"
    [6] "order-sensitive member overlaps another member (RFC 8610 section 3.5.3)"
    [7] "worst-case group arena at the compiled limits can exceed the arena cap"
    :else ""))
