;; The RESUMABLE validator session (P6.2; owner direction D027, architecture
;; §17 rev 3; D029/D030; this file's design D047-D049).
;;
;; A session validates one message of a DECLARED length against one rule of a
;; verified Program over WINDOWS of it: each vms-step call is given a window
;; [base, base + len) and runs until the verdict, until it needs bytes the window
;; does not hold (VMS_NEED: vms-need-offset / vms-need-length), or until it has
;; done its work quantum (VMS_YIELD). It never calls the host. Verdicts, codes,
;; offsets, budget used, item counts and paths are those of the buffer walk
;; (snug.vm.api vm-validate) whatever the windows and the quantum (bb vm-test).
;;
;; How (D047). The walk is the buffer walk's, item by item:
;;   * an item whose bytes are all in the window is evaluated by the BUFFER
;;     WALK ITSELF: a scalar directly (eval-item / dead-item, which read only
;;     inside its head and content); a container or tag SPECULATIVELY, with the
;;     walk's bound cut to the window's end -- a result is the real one unless it
;;     is `truncated` with the bound cut short, in which case the few words of
;;     run state it may have changed are rolled back (D049);
;;   * an item that crosses the window's end (or the quantum's bound) gets a
;;     FRAME on an explicit stack in the session array `ss`, whose phases are the
;;     generic path of snug.vm.eval / snug.vm.dead step by step: the same
;;     leaf predicates, map and array state machines, query lists, witness and
;;     charging functions are called in the same order (fast == generic is gated,
;;     so the generic order is the buffer walk's order);
;;   * strings that cross a window are scanned incrementally with carried state
;;     (UTF-8 position, regexp active set and step, `.bits` position); typed
;;     arrays element by element; a few small pieces are asked for whole (D048):
;;     heads, map keys, the first min(length, pool bytes) bytes of a string with
;;     an admitted LIT/LITSET leaf, bignum tags, and the bounded prefixes that the
;;     tag-4/40 checks read (noted in the pair's frame as its elements start);
;;   * each active map's previous key is kept as a window span and copied into
;;     the session's key arena only when the walk suspends, as the resumable
;;     scanner does.
;; Positions in `ss` and in the pending-item block are ABSOLUTE; inside a step
;; they are window-relative (the scratch's position words are rebased at the
;; step's start and end). Messages are shorter than 2^31 bytes.
(ns snug.vm.session
  (:require [kin.lang :refer [defn let local return set if while for do comment forever break defconst]]
            [snug.lang :refer [I32 Bool Bytes Ints IntsR + - * neg quot rem shl sar ushr bit-and bit-or bit-xor
                               < > <= >= == != and or not u8 blen ia iset ilen]]
            [snug.cbor.codes :refer [CODE_TRUNCATED CODE_KEY_TYPE CODE_DUPLICATE_KEY CODE_KEY_ORDER CODE_TEXT
                                     CODE_TAG CODE_DECIMAL CODE_NDARRAY CODE_TYPED_ARRAY CODE_TRAILING
                                     CODE_DEPTH CODE_TOO_LARGE CODE_NOT_MAP CODE_TOO_MANY_ITEMS
                                     O_TOP O_COSE O_MAX_BYTES O_MAX_DEPTH O_ERR_POS O_ITEMS O_MAX_ITEMS
                                     O_HI O_LO O_CSTART]]
            [snug.cbor.head :refer [fail read-arg take-len count-item enter-container bytes-content
                                    head-size small-arg be16 be32]]
            [snug.cbor.text :refer [utf8-window]]
            [snug.cbor.keys :refer [compare-spans]]
            [snug.cbor.tags :refer [typed-size exponent-ok mantissa-ok]]
            [snug.cbor.scan :refer [cose-label-ok]]
            [snug.vm.layout :refer [H_FLAGS H_S_LEAVES H_S_RULES H_LIM_DEPTH H_LIM_INPUT H_N_LEAVES
                                    FL_EMBED K_ANY K_MAJOR K_LIT K_LITSET K_TEXT K_BYTES K_TAG K_TAGSET
                                    K_EMBED K_ARRAY K_MAP F_ADMITTED F_MATCHED F_EVAL
                                    VM_BUDGET VM_POS VM_W_STATE VM_W_REASON VM_W_SUB VM_W_OFFSET VM_D
                                    VM_FRAMES VM_RULE VM_EMBED VM_GENERIC VM_Q1 VM_DLIM VM_REGCAP
                                    VM_BIGNUM_MAX VM_MARK_CAP H_S_REGEX_INDEX
                                    R_TYPE R_MISSING R_UNEXPECTED R_VALUE R_SIZE R_PATTERN R_BITS R_TAG
                                    R_EMBEDDED R_BUDGET R_INCONSISTENT P_INDEX P_KEY P_ANYKEY P_TAG
                                    P_EMBED CTX_KEY CTX_SIMPLE INF]]
            [snug.vm.base :refer [charge c64 c64min new-epoch sched2 free-on free-off q-add q-stamp ts-test
                                  q-flag q-set-flag q-kind q-leaf-base cset-rec next-ck cset-width
                                  cset-frame wit-empty wit-clear wit-set path-put rule1]]
            [snug.vm.leaf :refer [eval-leaf eval-scalars scalar-kind leaf-lit leaf-litset rx-cp rx-accepts
                                  utf8-len bits-ok cmp-u64]]
            [snug.vm.dead :refer [dead-item dead-seq dead-pair-body decimal-check ndarray-check
                                  typed-bad-at]]
            [snug.vm.map :refer [leaf-map block-mt map-block-init key-span-end key-search map-cursor
                                 map-key-query map-key-phase cand-vts cand-vts-mt block-named map-update
                                 map-satisfied map-missing simple-struct key-phase-struct update-struct]]
            [snug.vm.array :refer [leaf-array block-ao array-words array-block-init array-candidates
                                   array-advance array-accepts]]
            [snug.vm.eval :refer [eval-item eval-array unit-of simple-of q-filter-x finish-comb
                                  finish-scalar count-pending item-cls single-leaf embed-kill embed-live
                                  count-matched-scalars count-matched map-fast-mode map-pair-ok]]
            [snug.vm.api :refer [vm-setup vm-scratch-words vm-output vm-witness-output]]))

;; ------------------------------------------------------------ results and layout

(defconst ^:pub ^I32 VMS_NEED -64)
(defconst ^:pub ^I32 VMS_YIELD -65)
(defconst ^I32 GO 0)
(defconst ^I32 FIN 1)
(defconst ^I32 BAD 2)
(defconst ^I32 SPEC_FAIL -1000)

;; the header of `ss`
(defconst ^I32 SS_PH 0)
(defconst ^I32 SS_TOTAL 1)
(defconst ^I32 SS_POS 2)
(defconst ^I32 SS_NEED_OFF 3)
(defconst ^I32 SS_NEED_LEN 4)
(defconst ^I32 SS_QUANTUM 5)
(defconst ^I32 SS_SP 6)
(defconst ^I32 SS_RET 7)
(defconst ^I32 SS_KEEP 8)
(defconst ^I32 SS_ATOP 9)
(defconst ^I32 SS_ARENA 10)
(defconst ^I32 SS_FRAMES 11)
(defconst ^I32 SS_MAXF 12)
(defconst ^I32 SS_SNAP 13)
(defconst ^I32 SS_RTS 14)
(defconst ^I32 SS_RNQ 15)
(defconst ^I32 IT_POS 16)
(defconst ^I32 IT_D 17)
(defconst ^I32 IT_FB 18)
(defconst ^I32 IT_CK 19)
(defconst ^I32 IT_NQ 20)
(defconst ^I32 IT_END 21)
(defconst ^I32 IT_CTX 22)
(defconst ^I32 IT_MODE 23)
(defconst ^I32 IT_NOTE 24)
(defconst ^I32 IT_PAIR 25)
(defconst ^I32 SS_WB0 26)
(defconst ^I32 SS_WBYTES 27)
(defconst ^I32 SS_CODE 28)
(defconst ^I32 SS_STEPS 29)
(defconst ^I32 SS_SNAPW 32)
(defconst ^I32 SS_HDR 48)

(defconst ^I32 PH_START 0)
(defconst ^I32 PH_ITEM 1)
(defconst ^I32 PH_RET 2)
(defconst ^I32 PH_FRAME 3)
(defconst ^I32 PH_DONE 4)

;; frames
(defconst ^I32 FW 40)
(defconst ^I32 FK_ARR 1)
(defconst ^I32 FK_MAP 2)
(defconst ^I32 FK_TAG 3)
(defconst ^I32 FK_STR 4)
(defconst ^I32 FK_DARR 5)
(defconst ^I32 FK_DMAP 6)
(defconst ^I32 FK_DPAIR 7)
(defconst ^I32 FK_DSEQ 8)
(defconst ^I32 FK_DSTR 9)
(defconst ^I32 FK_DTYPED 10)

(defconst ^I32 F_KIND 0)
(defconst ^I32 F_PH 1)
(defconst ^I32 F_POS 2)
(defconst ^I32 F_END 3)
(defconst ^I32 F_D 4)
(defconst ^I32 F_FB 5)
(defconst ^I32 F_CK 6)
(defconst ^I32 F_NQ 7)
(defconst ^I32 F_CTX 8)
(defconst ^I32 F_Q 9)
(defconst ^I32 F_N 10)
(defconst ^I32 F_EL 11)
(defconst ^I32 F_Q0 12)
;; arrays
(defconst ^I32 F_NB 13)
(defconst ^I32 F_S2 14)
(defconst ^I32 F_CX 15)
(defconst ^I32 F_PEND 16)
(defconst ^I32 F_NALIVE 17)
(defconst ^I32 F_UNACC 18)
(defconst ^I32 F_Q1 19)
(defconst ^I32 F_CNQ 20)
(defconst ^I32 F_PAIR 21)
;; maps (F_NB, F_PEND, F_NALIVE as arrays)
(defconst ^I32 F_CL 14)
(defconst ^I32 F_CCAP 15)
(defconst ^I32 F_UNSAT 18)
(defconst ^I32 F_SMAP 19)
(defconst ^I32 F_KLO 20)
(defconst ^I32 F_PS 22)
(defconst ^I32 F_PE 23)
(defconst ^I32 F_PA 24)
(defconst ^I32 F_PIN 25)
(defconst ^I32 F_START 26)
(defconst ^I32 F_KID 27)
(defconst ^I32 F_MCNQ 28)
(defconst ^I32 F_NC 29)
(defconst ^I32 F_NAMED 30)
(defconst ^I32 F_VNQ 31)
(defconst ^I32 F_PS2 32)
(defconst ^I32 F_COSE 33)
;; tags, pairs, typed arrays, strings
(defconst ^I32 F_LO 13)
(defconst ^I32 F_CLS 14)
(defconst ^I32 F_TCNQ 15)
(defconst ^I32 F_CS 16)
(defconst ^I32 F_STOP 17)
(defconst ^I32 F_TSIZE 18)
(defconst ^I32 F_NOTED 19)
(defconst ^I32 F_EXPOK 20)
(defconst ^I32 F_MANT 21)
(defconst ^I32 F_NDBAD 22)
(defconst ^I32 F_NDK 23)
(defconst ^I32 F_COUNT 24)
(defconst ^I32 F_I 25)
(defconst ^I32 F_OWNER 26)
(defconst ^I32 F_MODE 27)
(defconst ^I32 F_DIMS 30)
(defconst ^I32 F_MAJ 13)
(defconst ^I32 F_HI 15)
(defconst ^I32 F_LO2 18)
(defconst ^I32 F_LI 19)
(defconst ^I32 F_LST 20)
(defconst ^I32 F_ACT 21)
(defconst ^I32 F_STEP 22)
(defconst ^I32 F_TAIL 23)
(defconst ^I32 F_EPH 24)
(defconst ^I32 F_ECNQ 26)
(defconst ^I32 F_SITEMS 27)
(defconst ^I32 F_SMAXD 28)
(defconst ^I32 F_SCOSE 29)
(defconst ^I32 F_SERR 30)
(defconst ^I32 F_SEQ 31)

;; frame phases
(defconst ^I32 A_NEXT 0)
(defconst ^I32 A_DEAD 1)
(defconst ^I32 A_LIVE 2)
(defconst ^I32 M_NEXT 0)
(defconst ^I32 M_DVAL 1)
(defconst ^I32 M_LVAL 2)
(defconst ^I32 T_THEAD 0)
(defconst ^I32 T_TSCAN 1)
(defconst ^I32 T_TTAIL 2)
(defconst ^I32 T_TAILRET 3)
(defconst ^I32 T_PAIR 4)
(defconst ^I32 T_PAIRRET 5)
(defconst ^I32 T_FIN 6)
(defconst ^I32 S_UTF8 1)
(defconst ^I32 S_FILTER 2)
(defconst ^I32 S_LEAF 3)
(defconst ^I32 S_EMBED 4)
(defconst ^I32 S_FINISH 5)
(defconst ^I32 DP_CHECK 0)
(defconst ^I32 DP_BODY 1)
(defconst ^I32 DP_ELEM 2)
(defconst ^I32 DP_RET 3)

;; ------------------------------------------------------------ API

(defn ^:pub ^I32 vms-session-words [^IntsR p ^I32 total]
  (comment "Words of the session array for a message of `total` bytes: the header,"
           "a snapshot of N_LEAVES flag words, D + 4 frames, and a key arena of"
           "min(total, compiled input limit) bytes packed four to a word.")
  (let [^:mut ab total]
    (if (> ab (ia p H_LIM_INPUT)) (set ab (ia p H_LIM_INPUT)))
    (if (< ab 0) (set ab 0))
    (return (+ (+ (+ SS_HDR (ia p H_N_LEAVES)) (* (+ (ia p H_LIM_DEPTH) 4) FW)) (+ (ushr ab 2) 2)))))

(defn ^:pub ^I32 vms-init [^IntsR p ^Bytes pool ^I32 rule ^IntsR limits ^Ints s ^Ints ss ^I32 total
                           ^I32 quantum]
  (comment "Start a session on rule over a message of exactly `total` bytes, with"
           "the scratch s (vm-scratch-words, initialised as for vm-validate) and the"
           "session array ss (vms-session-words), both owned by this session until"
           "it ends. quantum > 0 yields after about that many work units per step"
           "(budget units, plus 1 per 64 content bytes scanned incrementally); 0"
           "never yields. 0, or -1 Program inconsistent, -2 scratch or session array"
           "too small, -3 rule out of range.")
  (if (< (ilen p) 64) (return (neg 1)))
  (if (!= (ia p 4) (blen pool)) (return (neg 1)))
  (if (or (< total 0) (< quantum 0)) (return (neg 1)))
  (let [su (vm-setup p rule 0 0 0 limits s)]
    (if (< su 0) (return su)))
  (if (< (ilen ss) (vms-session-words p total)) (return (neg 2)))
  (for [^I32 k 0 SS_HDR] (iset ss k 0))
  (iset ss SS_PH PH_START)
  (iset ss SS_TOTAL total)
  (iset ss SS_QUANTUM quantum)
  (iset ss SS_SNAP SS_HDR)
  (iset ss SS_FRAMES (+ SS_HDR (ia p H_N_LEAVES)))
  (iset ss SS_MAXF (+ (ia p H_LIM_DEPTH) 4))
  (iset ss SS_ARENA (+ (+ SS_HDR (ia p H_N_LEAVES)) (* (+ (ia p H_LIM_DEPTH) 4) FW)))
  (return 0))

(defn ^:pub ^I32 vms-need-offset [^IntsR ss]
  (return (ia ss SS_NEED_OFF)))

(defn ^:pub ^I32 vms-need-length [^IntsR ss]
  (return (ia ss SS_NEED_LEN)))

(defn ^:pub ^I32 vms-position [^IntsR ss]
  (comment "Where the walk stands after VMS_NEED or VMS_YIELD (absolute).")
  (return (ia ss SS_POS)))

(defn ^:pub ^I32 vms-keep [^IntsR ss]
  (comment "After VMS_NEED or VMS_YIELD: no byte before this offset will be asked"
           "for again, so a forward-only source may drop them. It trails the"
           "position while a string's leaves re-read its content or an embedded"
           "item is walked (D048).")
  (return (ia ss SS_KEEP)))

;; ------------------------------------------------------------ frames and control

(defn ^I32 fbase [^IntsR ss ^I32 i]
  (return (+ (ia ss SS_FRAMES) (* i FW))))

(defn ^I32 ftop [^IntsR ss]
  (return (fbase ss (- (ia ss SS_SP) 1))))

(defn ^I32 fpush [^Ints ss ^I32 kind]
  (comment "A new zeroed top frame of this kind; its base, or -1 when the stack is full.")
  (let [sp (ia ss SS_SP)]
    (if (>= sp (ia ss SS_MAXF)) (return (neg 1)))
    (let [f (fbase ss sp)]
      (for [^I32 k 0 FW] (iset ss (+ f k) 0))
      (iset ss (+ f F_KIND) kind)
      (iset ss SS_SP (+ sp 1))
      (return f))))

(defn fpop [^Ints ss]
  (comment "Drop the top frame (a map's arena region with it).")
  (let [f (ftop ss)
        kind (ia ss (+ f F_KIND))]
    (if (and (or (== kind FK_MAP) (== kind FK_DMAP)) (== (ia ss (+ f F_PIN)) 1))
      (iset ss SS_ATOP (ia ss (+ f F_PA))))
    (iset ss SS_SP (- (ia ss SS_SP) 1))))

(defn ^I32 err [^Ints ss ^I32 r]
  (comment "The current item ends with the negated code r (unwound by deliver).")
  (iset ss SS_RET r)
  (iset ss SS_PH PH_RET)
  (return GO))

(defn ^I32 ret [^Ints ss ^I32 base ^I32 r]
  (comment "The current item ends at r (window-relative) or with the negated code r.")
  (if (>= r 0) (iset ss SS_RET (+ r base)) (iset ss SS_RET r))
  (iset ss SS_PH PH_RET)
  (return GO))

(defn ^I32 done [^Ints ss ^I32 base ^I32 r]
  (comment "The top frame's item ends at r: pop it and return r to its parent.")
  (fpop ss)
  (return (ret ss base r)))

(defn ^I32 cont [^Ints ss ^I32 f ^I32 ph]
  (comment "The top frame continues in phase ph.")
  (iset ss (+ f F_PH) ph)
  (iset ss SS_PH PH_FRAME)
  (return GO))

(defn call [^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^I32 mode
            ^I32 note ^I32 pair]
  (comment "Evaluate a child item next (nq 0: dead). mode 1: a `.cborseq` virtual"
           "array, 2: a dead sequence. note >= 0: frame * 4 + kind of a tag-4/40"
           "note to take from its head. pair >= 0: the item is that tag's inner"
           "array.")
  (iset ss IT_POS (+ pos base))
  (iset ss IT_D d)
  (iset ss IT_FB fb)
  (iset ss IT_CK ck)
  (iset ss IT_NQ nq)
  (iset ss IT_END (+ end base))
  (iset ss IT_CTX ctx)
  (iset ss IT_MODE mode)
  (iset ss IT_NOTE note)
  (iset ss IT_PAIR pair)
  (iset ss SS_PH PH_ITEM))

(defn ^I32 need [^Ints ss ^I32 base ^I32 off ^I32 len]
  (comment "Suspend for a window holding [off, off + len) (window-relative here),"
           "clipped to the message.")
  (let [abs (+ off base)
        room (- (ia ss SS_TOTAL) abs)]
    (iset ss SS_NEED_OFF abs)
    (if (< room len) (iset ss SS_NEED_LEN room) (iset ss SS_NEED_LEN len))
    (iset ss SS_POS abs)
    (return VMS_NEED)))

(defn ^I32 yld [^Ints ss ^I32 base ^I32 at]
  (iset ss SS_POS (+ at base))
  (return VMS_YIELD))

(defn ^Bool suspended [^I32 r]
  (return (or (== r VMS_NEED) (== r VMS_YIELD))))

;; ------------------------------------------------------------ the work quantum (D049)

(defn ^I32 work [^IntsR s ^IntsR ss]
  (return (+ (- (ia ss SS_WB0) (ia s VM_BUDGET)) (sar (ia ss SS_WBYTES) 6))))

(defn ^Bool must-yield [^IntsR s ^IntsR ss]
  (let [q (ia ss SS_QUANTUM)]
    (if (<= q 0) (return false))
    (return (>= (work s ss) q))))

(defn ^I32 qbytes [^IntsR s ^IntsR ss]
  (comment "The quantum left, as a bound in bytes for a speculative evaluation (and"
           "in 64-byte units for a content scan); INF without a quantum.")
  (let [q (ia ss SS_QUANTUM)]
    (if (<= q 0) (return INF))
    (let [left (- q (work s ss))]
      (if (< left 1) (return 1))
      (return left))))

(defn ^I32 send-of [^I32 pos ^I32 end ^I32 wend ^I32 qb]
  (let [^:mut e end]
    (if (< wend e) (set e wend))
    (if (< qb (- e pos)) (set e (+ pos qb)))
    (return e)))

(defn ^I32 chunk-end [^I32 i ^I32 stop ^I32 wend ^I32 qb]
  (comment "The end of the next content chunk from i: the content's end, the"
           "window's, or the quantum's (qb * 64 bytes, at least 64).")
  (let [^:mut e stop]
    (if (< wend e) (set e wend))
    (if (< qb (sar (- e i) 6)) (set e (+ i (* qb 64))))
    (return e)))

;; ------------------------------------------------------------ speculation (D049)

(defn snap [^IntsR s ^Ints ss ^I32 fl ^I32 nq]
  (comment "What an in-window evaluation may change before it reports a"
           "window-caused `truncated`: the run state words and the flags of the"
           "item's own query list at fl.")
  (iset ss SS_SNAPW (ia s O_ITEMS))
  (iset ss (+ SS_SNAPW 1) (ia s O_ERR_POS))
  (iset ss (+ SS_SNAPW 2) (ia s O_MAX_DEPTH))
  (iset ss (+ SS_SNAPW 3) (ia s O_COSE))
  (iset ss (+ SS_SNAPW 4) (ia s VM_BUDGET))
  (for [^I32 k 0 7]
    (let [v (ia s (+ VM_W_STATE k))]
      (iset ss (+ (+ SS_SNAPW 5) k) v)))
  (iset ss (+ SS_SNAPW 12) (ia s VM_EMBED))
  (iset ss (+ SS_SNAPW 13) (ia s VM_GENERIC))
  (iset ss (+ SS_SNAPW 14) (ia s VM_Q1))
  (let [sn (ia ss SS_SNAP)]
    (for [^I32 i 0 nq]
      (let [v2 (ia s (+ fl i))]
        (iset ss (+ sn i) v2)))))

(defn unsnap [^Ints s ^IntsR ss ^I32 fl ^I32 nq]
  (iset s O_ITEMS (ia ss SS_SNAPW))
  (iset s O_ERR_POS (ia ss (+ SS_SNAPW 1)))
  (iset s O_MAX_DEPTH (ia ss (+ SS_SNAPW 2)))
  (iset s O_COSE (ia ss (+ SS_SNAPW 3)))
  (iset s VM_BUDGET (ia ss (+ SS_SNAPW 4)))
  (for [^I32 k 0 7]
    (iset s (+ VM_W_STATE k) (ia ss (+ (+ SS_SNAPW 5) k))))
  (iset s VM_EMBED (ia ss (+ SS_SNAPW 12)))
  (iset s VM_GENERIC (ia ss (+ SS_SNAPW 13)))
  (iset s VM_Q1 (ia ss (+ SS_SNAPW 14)))
  (let [sn (ia ss SS_SNAP)]
    (for [^I32 i 0 nq]
      (iset s (+ fl i) (ia ss (+ sn i))))))

(defn ^I32 spec-live [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 pos ^I32 d ^I32 fb ^I32 ck
                      ^I32 nq ^I32 end ^I32 send ^I32 ctx]
  (comment "eval-item with its bound cut to send <= end: the result, or SPEC_FAIL"
           "(state rolled back) when it is `truncated` only because send < end.")
  (let [w (cset-width p (cset-rec p s ck))]
    (snap s ss (+ fb w) nq)
    (let [r (eval-item p pool b s pos d fb ck nq send ctx)]
      (if (and (== r (neg CODE_TRUNCATED)) (< send end))
        (do (unsnap s ss (+ fb w) nq)
            (return SPEC_FAIL)))
      (return r))))

(defn ^I32 spec-dead [^Bytes b ^Ints s ^Ints ss ^I32 pos ^I32 d ^I32 end ^I32 send]
  (snap s ss 0 0)
  (let [r (dead-item b s pos d send)]
    (if (and (== r (neg CODE_TRUNCATED)) (< send end))
      (do (unsnap s ss 0 0)
          (return SPEC_FAIL)))
    (return r)))

;; ------------------------------------------------------------ what must be in the window (D048)

(defn ^I32 head-len [^Bytes b ^I32 pos]
  (let [ai (bit-and (u8 b pos) 31)]
    (if (> ai 27) (return 1))
    (return (head-size ai))))

(defn ^I32 str-end [^Bytes b ^I32 pos ^I32 end]
  (comment "The end of the text or byte string at pos (its head in the window), or"
           "-1 when the walk refuses its head or length reading nothing past the"
           "head.")
  (let [ai (bit-and (u8 b pos) 31)]
    (if (> ai 27) (return (neg 1)))
    (let [h (head-size ai)
          ^:mut len ai]
      (if (> (+ pos h) end) (return (neg 1)))
      (if (== ai 24) (do (set len (u8 b (+ pos 1))) (if (< len 24) (return (neg 1)))))
      (if (== ai 25) (do (set len (be16 b (+ pos 1))) (if (< len 256) (return (neg 1)))))
      (if (== ai 26) (do (set len (be32 b (+ pos 1))) (if (== (ushr len 16) 0) (return (neg 1)))))
      (if (== ai 27) (return (neg 1)))
      (if (< len 0) (return (neg 1)))
      (if (> len (- end (+ pos h))) (return (neg 1)))
      (return (+ (+ pos h) len)))))

(defn ^I32 big-req [^Bytes b ^IntsR s ^I32 pos ^I32 end ^I32 wend]
  (comment "How far from pos a bignum (c2/c3 at pos) must be in the window before"
           "the walk decides it: its byte-string head, then its whole content when"
           "that is 9..bignum-limit bytes, or its first content byte when longer (the"
           "walk then refuses it). Call again once the window holds the answer.")
  (let [x (+ pos 1)]
    (if (>= x end) (return x))
    (if (>= x wend) (return (+ x 1)))
    (let [ib (u8 b x)
          ai (bit-and ib 31)]
      (if (or (!= (ushr ib 5) 2) (> ai 27)) (return (+ x 1)))
      (let [h (head-size ai)
            ^:mut len ai
            ^:mut ok true]
        (if (> (+ x h) end) (return (+ x 1)))
        (if (> (+ x h) wend) (return (+ x h)))
        (if (== ai 24) (do (set len (u8 b (+ x 1))) (if (< len 24) (set ok false))))
        (if (== ai 25) (do (set len (be16 b (+ x 1))) (if (< len 256) (set ok false))))
        (if (== ai 26) (do (set len (be32 b (+ x 1))) (if (== (ushr len 16) 0) (set ok false))))
        (if (== ai 27) (set ok false))
        (if (or (not ok) (< len 0)) (return (+ x h)))
        (let [cs (+ x h)]
          (if (> len (- end cs)) (return cs))
          (if (< len 9) (return cs))
          (if (> len (ia s VM_BIGNUM_MAX)) (return (+ cs 1)))
          (return (+ cs len)))))))

(defn ^I32 key-req [^Bytes b ^I32 start ^I32 end]
  (comment "How far from start a map key must be in the window: a whole text key"
           "(D048), else its head (an integer label, or a head the walk refuses).")
  (if (== (ushr (u8 b start) 5) 3)
    (do (let [e (str-end b start end)]
          (if (>= e 0) (return e)))))
  (let [h (head-len b start)]
    (if (> (+ start h) end) (return (+ start 1)))
    (return (+ start h))))

;; ------------------------------------------------------------ tag 4 / tag 40 notes

(defn ^I32 note-req [^Bytes b ^IntsR s ^I32 kind ^I32 pos ^I32 end ^I32 wend]
  (comment "How far from pos a pair element must be in the window for its note:"
           "0 decimal exponent, 1 mantissa, 2 ndarray shape, 3 ndarray data.")
  (if (>= pos end) (return pos))
  (if (== kind 1)
    (do (let [ib (u8 b pos)]
          (if (or (== ib 194) (== ib 195)) (return (big-req b s pos end wend))))))
  (if (== kind 2)
    (do (if (< (+ pos 73) end) (return (+ pos 73)))
        (return end)))
  (if (== kind 3)
    (do (if (< (+ pos 11) end) (return (+ pos 11)))
        (return end)))
  (return pos))

(defn note-put [^Bytes b ^IntsR s ^Ints ss ^I32 kind ^I32 pos ^I32 end ^I32 wend ^I32 tf]
  (comment "Note what the pair's verdict needs of this element while its bytes are"
           "here (the walk refuses anything malformed before the verdict, so a"
           "malformed element may note anything; no read leaves the window).")
  (if (>= pos end) (return))
  (let [lim0 (if (< end wend) end wend)
        ib (u8 b pos)
        major (ushr ib 5)
        ai (bit-and ib 31)]
    (if (== kind 0)
      (do (if (and (<= ai 27) (<= (+ pos (head-size ai)) lim0))
            (if (exponent-ok b pos) (iset ss (+ tf F_EXPOK) 1) (iset ss (+ tf F_EXPOK) 0))
            (iset ss (+ tf F_EXPOK) 0))
          (return)))
    (if (== kind 1)
      (do (iset ss (+ tf F_MANT) 0)
          (if (<= major 1)
            (if (and (<= ai 27) (<= (+ pos (head-size ai)) lim0))
              (if (mantissa-ok b pos (+ pos (head-size ai))) (iset ss (+ tf F_MANT) 1))))
          (if (or (== ib 194) (== ib 195))
            (do (let [req (big-req b s pos end wend)
                      x (+ pos 1)]
                  (if (and (and (< x lim0) (<= req lim0)) (== (ushr (u8 b x) 5) 2))
                    (if (and (<= (bit-and (u8 b x) 31) 27) (<= (+ x (head-size (bit-and (u8 b x) 31))) req))
                      (if (mantissa-ok b pos req) (iset ss (+ tf F_MANT) 1)))))))
          (return)))
    (if (== kind 2)
      (do (let [^:mut lim lim0
                ^:mut bad 0
                ^:mut k 0
                ^:mut x (+ pos 1)]
            (if (> lim (+ pos 73)) (set lim (+ pos 73)))
            (if (!= major 4) (set bad 1))
            (if (== bad 0)
              (if (< ai 24)
                (set k ai)
                (if (and (== ai 24) (< (+ pos 1) lim))
                  (do (set k (u8 b (+ pos 1))) (set x (+ pos 2)))
                  (set bad 1))))
            (if (or (< k 1) (> k 8)) (set bad 1))
            (let [^:mut j 0]
              (while (and (== bad 0) (< j k))
                (if (>= x lim)
                  (set bad 1)
                  (do (let [db (u8 b x)
                            dai (bit-and db 31)]
                        (if (or (!= (ushr db 5) 0) (> dai 26))
                          (set bad 1)
                          (do (let [hs (head-size dai)]
                                (if (> (+ x hs) lim)
                                  (set bad 1)
                                  (do (let [dv (small-arg b x)]
                                        (if (<= dv 0)
                                          (set bad 1)
                                          (do (iset ss (+ (+ tf F_DIMS) j) dv)
                                              (set x (+ x hs))
                                              (set j (+ j 1))))))))))))))))
            (iset ss (+ tf F_NDBAD) bad)
            (iset ss (+ tf F_NDK) k))
          (return)))
    (comment "kind 3: the data item's element count (data-count, guarded).")
    (let [^:mut lim lim0
          ^:mut count (neg 1)]
      (if (> lim (+ pos 11)) (set lim (+ pos 11)))
      (if (and (== major 4) (<= ai 27))
        (if (<= (+ pos (head-size ai)) lim) (set count (small-arg b pos))))
      (if (and (== ib 216) (< (+ pos 2) lim))
        (do (let [size (typed-size (u8 b (+ pos 1)))
                  ai2 (bit-and (u8 b (+ pos 2)) 31)]
              (if (and (> size 0) (<= ai2 27))
                (if (<= (+ (+ pos 2) (head-size ai2)) lim)
                  (set count (quot (small-arg b (+ pos 2)) size)))))))
      (iset ss (+ tf F_COUNT) count))))

(defn ^I32 pair-verdict [^Ints s ^IntsR ss ^I32 tf ^I32 lo ^I32 tpos]
  (comment "The tag-4/40 semantics from the noted facts (decimal-check,"
           "ndarray-check's shape-ok by division): 0 or the negated refusal at the tag.")
  (if (== lo 4)
    (do (if (== (ia ss (+ tf F_EXPOK)) 0) (return (fail s tpos CODE_DECIMAL)))
        (if (== (ia ss (+ tf F_MANT)) 0) (return (fail s tpos CODE_DECIMAL)))
        (return 0)))
  (let [count (ia ss (+ tf F_COUNT))
        k (ia ss (+ tf F_NDK))
        ^:mut pr 1]
    (if (< count 0) (return (fail s tpos CODE_NDARRAY)))
    (if (!= (ia ss (+ tf F_NDBAD)) 0) (return (fail s tpos CODE_NDARRAY)))
    (for [^I32 j 0 k]
      (let [dv (ia ss (+ (+ tf F_DIMS) j))]
        (if (> dv (quot count pr)) (return (fail s tpos CODE_NDARRAY)))
        (set pr (* pr dv))))
    (if (!= pr count) (return (fail s tpos CODE_NDARRAY)))
    (return 0)))

(defn ^I32 pair-note [^IntsR ss ^I32 pair ^I32 el]
  (comment "The note of element el of the pair whose notes live in frame `pair`.")
  (if (or (< pair 0) (>= el 2)) (return (neg 1)))
  (if (== (ia ss (+ (fbase ss pair) F_LO)) 4) (return (+ (* pair 4) el)))
  (return (+ (* pair 4) (+ 2 el))))

;; ------------------------------------------------------------ the key arena

(defn ^I32 ar-get [^IntsR ss ^I32 x]
  (return (bit-and (ushr (ia ss (+ (ia ss SS_ARENA) (ushr x 2))) (shl (bit-and x 3) 3)) 255)))

(defn ar-put [^Ints ss ^I32 x ^I32 v]
  (let [cell (+ (ia ss SS_ARENA) (ushr x 2))
        sh (shl (bit-and x 3) 3)
        old (ia ss cell)]
    (iset ss cell (bit-or (bit-and old (bit-xor (shl 255 sh) (neg 1))) (shl v sh)))))

(defn keys-save [^Bytes b ^Ints ss ^I32 base]
  (comment "Before the window may go: each active map's previous key still held only"
           "as a window span is copied into the arena, in frame order.")
  (let [sp (ia ss SS_SP)]
    (for [^I32 i 0 sp]
      (let [f (fbase ss i)
            kind (ia ss (+ f F_KIND))]
        (if (and (or (== kind FK_MAP) (== kind FK_DMAP))
                 (and (>= (ia ss (+ f F_PS)) 0) (== (ia ss (+ f F_PIN)) 0)))
          (do (let [ps (- (ia ss (+ f F_PS)) base)
                    len (- (ia ss (+ f F_PE)) (ia ss (+ f F_PS)))
                    top (ia ss SS_ATOP)]
                (for [^I32 j 0 len]
                  (let [v (u8 b (+ ps j))]
                    (ar-put ss (+ top j) v)))
                (iset ss (+ f F_PA) top)
                (iset ss (+ f F_PIN) 1)
                (iset ss SS_ATOP (+ top len)))))))))

(defn ^I32 key-order-s [^Bytes b ^Ints s ^IntsR ss ^I32 f ^I32 base ^I32 start ^I32 kq]
  (comment "key-order against the map's previous key, wherever it is: charged"
           "ceil(min(len)/64), at least 1; 0, or the negated refusal.")
  (let [ps (ia ss (+ f F_PS))]
    (if (< ps 0) (return 0))
    (let [pe (ia ss (+ f F_PE))
          plen (- pe ps)
          klen (- kq start)]
      (if (not (charge s (c64min plen klen) start)) (return (neg R_BUDGET)))
      (local ^:mut ^I32 order)
      (if (== (ia ss (+ f F_PIN)) 0)
        (set order (compare-spans b (- ps base) (- pe base) start kq))
        (do (let [pa (ia ss (+ f F_PA))
                  ^:mut m plen
                  ^:mut j 0]
              (set order (- plen klen))
              (if (< klen m) (set m klen))
              (while (< j m)
                (let [x (ar-get ss (+ pa j))
                      y (u8 b (+ start j))]
                  (if (!= x y) (do (set order (- x y)) (break))))
                (set j (+ j 1))))))
      (if (== order 0) (return (fail s start CODE_DUPLICATE_KEY)))
      (if (> order 0) (return (fail s start CODE_KEY_ORDER)))
      (return 0))))

(defn set-prev [^Ints ss ^I32 f ^I32 ps ^I32 pe]
  (comment "The map's previous key becomes [ps, pe) (absolute, in the window).")
  (if (== (ia ss (+ f F_PIN)) 1) (iset ss SS_ATOP (ia ss (+ f F_PA))))
  (iset ss (+ f F_PIN) 0)
  (iset ss (+ f F_PS) ps)
  (iset ss (+ f F_PE) pe))

;; ------------------------------------------------------------ content scans

(defn ^I32 utf8-steps [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (comment "Text content [F_I, F_STOP) validated a chunk at a time (the scanner's"
           "utf8-window; a sequence is never split): 0 when done, a suspension, or"
           "the negated refusal.")
  (let [stop (- (ia ss (+ f F_STOP)) base)]
    (forever
      (let [i (- (ia ss (+ f F_I)) base)]
        (if (>= i stop) (return 0))
        (if (or (< i 0) (>= i wend)) (return (need ss base i 1)))
        (if (must-yield s ss) (return (yld ss base i)))
        (let [e (chunk-end i stop wend (qbytes s ss))
              t (utf8-window b i e stop)]
          (if (< t 0) (return (fail s (- (neg 1) t) CODE_TEXT)))
          (iset ss SS_WBYTES (+ (ia ss SS_WBYTES) (- t i)))
          (iset ss (+ f F_I) (+ t base))
          (if (and (< t e) (== e wend)) (return (need ss base t (utf8-len (u8 b t))))))))))

(defn ^I32 typed-head [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f ^I32 p ^I32 end ^I32 pos]
  (comment "dead-typed up to its scan: the byte-string head at p, the element-size"
           "check, the NaN scan's charge (tags 84-86). 0 (F_CS, F_STOP, F_I set),"
           "a suspension, or the negated refusal.")
  (if (< p end)
    (do (if (or (< p 0) (>= p wend)) (return (need ss base p 1)))
        (let [h (head-len b p)]
          (if (and (<= (+ p h) end) (> (+ p h) wend)) (return (need ss base p h))))))
  (let [stop (bytes-content b s p CODE_TYPED_ARRAY end)]
    (if (< stop 0) (return stop))
    (let [cs (ia s O_CSTART)
          size (ia ss (+ f F_TSIZE))]
      (if (!= (rem (- stop cs) size) 0) (return (fail s pos CODE_TYPED_ARRAY)))
      (iset ss (+ f F_CS) (+ cs base))
      (iset ss (+ f F_STOP) (+ stop base))
      (if (>= (ia ss (+ f F_LO)) 84)
        (do (if (not (charge s (c64 (- stop cs)) pos)) (return (neg R_BUDGET)))
            (iset ss (+ f F_I) (+ cs base)))
        (iset ss (+ f F_I) (+ stop base)))
      (return 0))))

(defn ^I32 typed-steps [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (comment "The NaN scan of a float typed array, whole elements a chunk at a time.")
  (let [stop (- (ia ss (+ f F_STOP)) base)
        size (ia ss (+ f F_TSIZE))
        tag (ia ss (+ f F_LO))]
    (forever
      (let [i (- (ia ss (+ f F_I)) base)]
        (if (>= i stop) (return 0))
        (if (or (< i 0) (> (+ i size) wend)) (return (need ss base i size)))
        (if (must-yield s ss) (return (yld ss base i)))
        (let [e0 (chunk-end i stop wend (qbytes s ss))
              e (- e0 (rem (- e0 i) size))
              bad (typed-bad-at b i e tag)]
          (if (>= bad 0) (return (fail s bad CODE_TYPED_ARRAY)))
          (iset ss SS_WBYTES (+ (ia ss SS_WBYTES) (- e i)))
          (iset ss (+ f F_I) (+ e base)))))))

(defn ^I32 rx-steps [^IntsR p ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f ^I32 rx ^I32 cs
                     ^I32 stop ^I32 at]
  (comment "rx-match a code point at a time (rx-cp) with its state in the frame and"
           "the regex area: 1 matched, 0 not, a suspension, or a negated code.")
  (if (== (ia ss (+ f F_LST)) 1)
    (do (let [ro (ia p (+ (ia p H_S_REGEX_INDEX) rx))
              w (ia p (+ ro 1))]
          (if (> (* 2 w) (ia s VM_REGCAP)) (return (neg R_INCONSISTENT)))
          (if (== cs stop) (return (ia p (+ ro 3))))
          (iset ss (+ f F_I) (+ cs base))
          (iset ss (+ f F_ACT) 0)
          (iset ss (+ f F_STEP) 0)
          (iset ss (+ f F_LST) 2))))
  (forever
    (let [i (- (ia ss (+ f F_I)) base)]
      (if (>= i stop) (return (rx-accepts p s rx)))
      (if (or (< i 0) (>= i wend)) (return (need ss base i 1)))
      (let [l (utf8-len (u8 b i))]
        (if (> (+ i l) wend) (return (need ss base i l)))
        (if (must-yield s ss) (return (yld ss base i)))
        (let [act (rx-cp p s b rx i (ia ss (+ f F_STEP)) (ia ss (+ f F_ACT)) at)]
          (if (< act 0) (return act))
          (if (== act 0) (return 0))
          (iset ss (+ f F_ACT) act)
          (iset ss (+ f F_STEP) 1)
          (iset ss (+ f F_I) (+ (+ i l) base)))))))

(defn ^I32 bits-steps [^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f ^I32 moff
                       ^I32 mlen ^I32 cs ^I32 stop]
  (comment "`.bits` over the content a chunk at a time: 1 ok, 0 refused, a suspension.")
  (forever
    (let [i (- (ia ss (+ f F_I)) base)]
      (if (>= i stop) (return 1))
      (if (or (< i 0) (>= i wend)) (return (need ss base i 1)))
      (if (must-yield s ss) (return (yld ss base i)))
      (let [e (chunk-end i stop wend (qbytes s ss))]
        (if (not (bits-ok pool b moff mlen cs i e)) (return 0))
        (iset ss SS_WBYTES (+ (ia ss SS_WBYTES) (- e i)))
        (iset ss (+ f F_I) (+ e base))))))

;; ------------------------------------------------------------ one leaf of a crossing string

(defn ^I32 leaf-step [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f
                      ^I32 lb ^I32 kind ^I32 pos ^I32 cs ^I32 stop ^I32 cls ^I32 hi ^I32 lo]
  (comment "eval-leaf for a string whose content may not be in the window, after its"
           "unit was charged: 0 matched, a reason, a suspension, or a negated code.")
  (if (or (== kind K_ANY) (== kind K_MAJOR)) (return 0))
  (if (or (== kind K_LIT) (== kind K_LITSET))
    (do (let [^:mut n (- stop pos)]
          (if (> n (blen pool)) (set n (blen pool)))
          (if (or (< pos 0) (> (+ pos n) wend)) (return (need ss base pos n)))
          (if (== kind K_LIT) (return (leaf-lit p pool b s lb pos stop)))
          (return (leaf-litset p pool b s lb pos stop)))))
  (if (== kind K_TEXT)
    (do (let [len (- stop cs)
              rx (ia p (+ lb 4))]
          (if (or (< len (ia p (+ lb 2))) (> len (ia p (+ lb 3)))) (return R_SIZE))
          (if (< rx 0) (return 0))
          (let [r (rx-steps p b s ss base wend f rx cs stop pos)]
            (if (or (suspended r) (< r 0)) (return r))
            (if (== r 1) (return 0))
            (return R_PATTERN)))))
  (if (== kind K_BYTES)
    (do (let [len (- stop cs)
              moff (ia p (+ lb 4))
              mlen (ia p (+ lb 5))]
          (if (or (< len (ia p (+ lb 2))) (> len (ia p (+ lb 3)))) (return R_SIZE))
          (if (== mlen 0) (return 0))
          (if (== (ia ss (+ f F_LST)) 1)
            (do (if (not (charge s (c64 len) pos)) (return (neg R_BUDGET)))
                (iset ss (+ f F_LST) 2)
                (iset ss (+ f F_I) (+ cs base))))
          (let [r2 (bits-steps pool b s ss base wend f moff mlen cs stop)]
            (if (suspended r2) (return r2))
            (if (== r2 1) (return 0))
            (return R_BITS)))))
  (if (or (< pos 0) (>= pos wend)) (return (need ss base pos 1)))
  (let [h (head-len b pos)]
    (if (> (+ pos h) wend) (return (need ss base pos h)))
    (return (eval-leaf p pool b s lb kind pos cs stop cls hi lo))))

(defn ^I32 str-leaves [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (comment "eval-scalars over a crossing string, leaf by leaf (F_LI, F_LST)."
           "0 when done, a suspension, or a negated code.")
  (let [pos (- (ia ss (+ f F_POS)) base)
        cs (- (ia ss (+ f F_CS)) base)
        stop (- (ia ss (+ f F_STOP)) base)
        cls (ia ss (+ f F_CLS))
        fb (ia ss (+ f F_FB))
        nq (ia ss (+ f F_NQ))
        ctx (ia ss (+ f F_CTX))
        w (cset-width p (cset-rec p s (ia ss (+ f F_CK))))
        fl0 (+ fb w)
        lv (ia p H_S_LEAVES)
        ^:mut hi 0
        ^:mut lo 0]
    (if (== (ia ss (+ f F_MAJ)) 3)
      (do (set hi (ia ss (+ f F_HI)))
          (set lo (ia ss (+ f F_LO2)))))
    (forever
      (let [li (ia ss (+ f F_LI))]
        (if (>= li nq) (return 0))
        (let [fl (ia s (+ fl0 li))
              lb (+ lv (* 8 (ia s (+ fb li))))
              kind (bit-and (ia p lb) 255)]
          (if (and (!= (bit-and fl F_ADMITTED) 0) (scalar-kind kind))
            (do (if (== (ia ss (+ f F_LST)) 0)
                  (do (if (not (charge s (unit-of ctx) pos)) (return (neg R_BUDGET)))
                      (iset ss (+ f F_LST) 1)))
                (let [r (leaf-step p pool b s ss base wend f lb kind pos cs stop cls hi lo)]
                  (if (or (suspended r) (< r 0)) (return r))
                  (if (== r 0)
                    (iset s (+ fl0 li) (bit-or fl F_MATCHED))
                    (iset s (+ fl0 li) (bit-or fl (shl r 8))))
                  (iset ss (+ f F_LST) 0))))
          (iset ss (+ f F_LI) (+ li 1)))))))

;; ------------------------------------------------------------ strings (FK_STR, FK_DSTR)

(defn ^I32 prologue [^Bytes b ^Ints s ^I32 pos ^I32 end]
  (comment "An item's visit (1 unit), count and head, as eval-item and dead-item do"
           "them (pos < end, head in the window): the position after the head"
           "(argument in s[O_HI], s[O_LO]) or a negated code.")
  (if (not (charge s 1 pos)) (return (neg R_BUDGET)))
  (let [it (+ (ia s O_ITEMS) 1)]
    (iset s O_ITEMS it)
    (if (> it (ia s O_MAX_ITEMS)) (return (fail s pos CODE_TOO_MANY_ITEMS))))
  (let [ai (bit-and (u8 b pos) 31)]
    (if (>= ai 24) (return (read-arg b s pos ai end)))
    (iset s O_HI 0)
    (iset s O_LO ai)
    (return (+ pos 1))))

(defn ^I32 frame-item [^Ints ss ^I32 f ^I32 base ^I32 pos ^I32 end ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 ctx]
  (iset ss (+ f F_POS) (+ pos base))
  (iset ss (+ f F_END) (+ end base))
  (iset ss (+ f F_D) d)
  (iset ss (+ f F_FB) fb)
  (iset ss (+ f F_CK) ck)
  (iset ss (+ f F_NQ) nq)
  (iset ss (+ f F_CTX) ctx)
  (return f))

(defn ^I32 open-str [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end
                     ^I32 ctx]
  (comment "A live text or byte string whose content crosses the window: eval-item's"
           "head, length and (text) UTF-8 charge, then phases.")
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [hi (ia s O_HI)
          lo (ia s O_LO)
          stop (take-len s pos q hi lo end)
          major (ushr (u8 b pos) 5)
          ai (bit-and (u8 b pos) 31)]
      (if (< stop 0) (return (err ss stop)))
      (let [f (fpush ss FK_STR)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (frame-item ss f base pos end d fb ck nq ctx)
        (iset ss (+ f F_MAJ) major)
        (iset ss (+ f F_CS) (+ q base))
        (iset ss (+ f F_STOP) (+ stop base))
        (iset ss (+ f F_HI) hi)
        (iset ss (+ f F_LO2) lo)
        (iset ss (+ f F_I) (+ q base))
        (if (== major 3)
          (do (iset ss (+ f F_CLS) (item-cls 3 ai hi lo))
              (if (not (charge s (c64 (- stop q)) pos)) (return (err ss (neg R_BUDGET))))
              (return (cont ss f S_UTF8))))
        (iset ss (+ f F_CLS) 4)
        (return (cont ss f S_FILTER))))))

(defn ^I32 embed-start [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 seq]
  (comment "embed-run's start for the live EMBED leaves of one kind: the depth"
           "check, the content query, the saved counters, then the sub-walk of the"
           "content [cs, stop) as a child (`.cborseq`: a virtual array, D040).")
  (let [pos (- (ia ss (+ f F_POS)) base)
        cs (- (ia ss (+ f F_CS)) base)
        stop (- (ia ss (+ f F_STOP)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        ck (ia ss (+ f F_CK))
        nq (ia ss (+ f F_NQ))
        cr (cset-rec p s ck)
        w (cset-width p cr)
        cfb (+ fb (cset-frame p cr))
        cck (next-ck p s ck)
        cw (cset-width p (cset-rec p s cck))
        dd (ia s VM_D)
        root (+ (+ d 1) seq)
        ^:mut nm (+ (ia s VM_DLIM) root)
        ^:mut cnq 0]
    (iset ss (+ f F_SITEMS) (ia s O_ITEMS))
    (iset ss (+ f F_SMAXD) (ia s O_MAX_DEPTH))
    (iset ss (+ f F_SCOSE) (ia s O_COSE))
    (iset ss (+ f F_SERR) (+ (ia s O_ERR_POS) base))
    (let [e (new-epoch s)]
      (if (> nm dd) (set nm dd))
      (if (> root dd)
        (do (wit-set s CODE_DEPTH 0 d P_EMBED 0 cs)
            (embed-kill p s fb w nq seq)
            (iset ss (+ f F_EPH) (+ 20 seq))
            (return GO)))
      (path-put s (+ d 1) P_EMBED 0)
      (for [^I32 k 0 nq]
        (let [fk (q-flag s fb w k)
              lbk (q-leaf-base p s fb k)]
          (if (and (and (!= (bit-and fk F_EVAL) 0) (== (q-kind p s fb k) K_EMBED))
                   (== (sar (bit-and (ia p lbk) 256) 8) seq))
            (do (let [ets (ia p (+ lbk 2))]
                  (set cnq (q-add p s cfb cw cnq ets e pos)))
                (if (< cnq 0) (return (err ss cnq))))))))
    (iset s O_ITEMS 0)
    (iset s O_MAX_DEPTH nm)
    (iset s O_COSE 0)
    (iset s VM_EMBED (+ (ia s VM_EMBED) 1))
    (iset ss (+ f F_ECNQ) cnq)
    (iset ss (+ f F_SEQ) seq)
    (iset ss (+ f F_EPH) (+ 10 seq))
    (if (== seq 1)
      (if (> cnq 0)
        (call ss base cs (+ d 1) cfb cck cnq stop 0 1 (neg 1) (neg 1))
        (call ss base cs (+ d 2) 0 0 0 stop 0 2 (neg 1) (neg 1)))
      (if (> cnq 0)
        (call ss base cs (+ d 1) cfb cck cnq stop 0 0 (neg 1) (neg 1))
        (call ss base cs (+ d 1) 0 0 0 stop 0 0 (neg 1) (neg 1))))
    (return GO)))

(defn ^I32 embed-ret [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 r]
  (comment "embed-run's end: counters restored; an inner refusal becomes the"
           "witness and kills these leaves; else the content typesets are tested and"
           "`.cbor` content must end at the byte string's end.")
  (let [seq (ia ss (+ f F_SEQ))
        pos (- (ia ss (+ f F_POS)) base)
        stop (- (ia ss (+ f F_STOP)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        ck (ia ss (+ f F_CK))
        nq (ia ss (+ f F_NQ))
        cr (cset-rec p s ck)
        w (cset-width p cr)
        cfb (+ fb (cset-frame p cr))
        cw (cset-width p (cset-rec p s (next-ck p s ck)))
        cnq (ia ss (+ f F_ECNQ))
        ierr (ia s O_ERR_POS)]
    (iset s O_ITEMS (ia ss (+ f F_SITEMS)))
    (iset s O_MAX_DEPTH (ia ss (+ f F_SMAXD)))
    (iset s O_COSE (ia ss (+ f F_SCOSE)))
    (iset s O_ERR_POS (- (ia ss (+ f F_SERR)) base))
    (iset s VM_EMBED (- (ia s VM_EMBED) 1))
    (iset ss (+ f F_EPH) (+ 20 seq))
    (iset ss SS_PH PH_FRAME)
    (if (< r 0)
      (do (wit-set s (neg r) 0 (+ d 1) (neg 1) 0 ierr)
          (embed-kill p s fb w nq seq)
          (return GO)))
    (let [rr (- r base)
          ev (q-stamp s cfb cw cnq pos)]
      (if (< ev 0) (return (err ss ev)))
      (for [^I32 k2 0 nq]
        (let [f2 (q-flag s fb w k2)
              lb2 (q-leaf-base p s fb k2)]
          (if (and (and (!= (bit-and f2 F_EVAL) 0) (== (q-kind p s fb k2) K_EMBED))
                   (== (sar (bit-and (ia p lb2) 256) 8) seq))
            (do (let [t (ts-test p s (ia p (+ lb2 2)) ev pos)]
                  (if (< t 0) (return (err ss t)))
                  (if (== t 0)
                    (iset s (+ (+ fb w) k2)
                          (bit-or (bit-and f2 (bit-xor F_EVAL (neg 1))) (shl R_EMBEDDED 8)))))))))
      (if (and (== seq 0) (!= rr stop))
        (if (> (embed-live p s fb w nq 0) 0)
          (do (wit-set s CODE_TRAILING 0 (+ d 1) (neg 1) 0 rr)
              (embed-kill p s fb w nq 0))))
      (return GO))))

(defn ^I32 str-embed [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 f]
  (comment "eval-embed's phases (F_EPH): 0 charge and mark, 1/2 the `.cbor` and"
           "`.cborseq` runs, 20/21 their witness clearing, 3 the verdict.")
  (let [eph (ia ss (+ f F_EPH))
        pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        nq (ia ss (+ f F_NQ))
        w (cset-width p (cset-rec p s (ia ss (+ f F_CK))))]
    (if (== eph 0)
      (do (for [^I32 j 0 nq]
            (let [fj (q-flag s fb w j)]
              (if (and (!= (bit-and fj F_ADMITTED) 0) (== (q-kind p s fb j) K_EMBED))
                (do (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                    (q-set-flag s fb w j F_EVAL)))))
          (iset ss (+ f F_EPH) 1)
          (return GO)))
    (if (== eph 1)
      (do (if (> (embed-live p s fb w nq 0) 0) (return (embed-start p s ss base f 0)))
          (iset ss (+ f F_EPH) 2)
          (return GO)))
    (if (== eph 2)
      (do (if (> (embed-live p s fb w nq 1) 0) (return (embed-start p s ss base f 1)))
          (iset ss (+ f F_EPH) 3)
          (return GO)))
    (if (== eph 20)
      (do (if (or (> (embed-live p s fb w nq 0) 0) (> (count-matched-scalars p s fb w nq) 0))
            (wit-clear s))
          (iset ss (+ f F_EPH) 2)
          (return GO)))
    (if (== eph 21)
      (do (if (or (> (embed-live p s fb w nq 1) 0)
                  (or (> (embed-live p s fb w nq 0) 0) (> (count-matched-scalars p s fb w nq) 0)))
            (wit-clear s))
          (iset ss (+ f F_EPH) 3)
          (return GO)))
    (let [^:mut won 0]
      (for [^I32 m 0 nq]
        (let [fm (q-flag s fb w m)]
          (if (and (!= (bit-and fm F_EVAL) 0) (== (q-kind p s fb m) K_EMBED))
            (do (iset s (+ (+ fb w) m) (bit-or fm F_MATCHED))
                (set won (+ won 1))))))
      (if (and (== won 0) (== (count-matched-scalars p s fb w nq) 0))
        (if (wit-empty s)
          (wit-set s R_EMBEDDED 0 d (neg 1) 0 pos)
          (if (!= (ia s VM_W_REASON) R_EMBEDDED)
            (do (iset s VM_W_SUB (ia s VM_W_REASON))
                (iset s VM_W_REASON R_EMBEDDED)))))
      (return (cont ss f S_FINISH)))))

(defn ^I32 str-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (let [ph (ia ss (+ f F_PH))
        pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        nq (ia ss (+ f F_NQ))
        ctx (ia ss (+ f F_CTX))
        w (cset-width p (cset-rec p s (ia ss (+ f F_CK))))]
    (if (== ph S_UTF8)
      (do (let [r (utf8-steps b s ss base wend f)]
            (if (suspended r) (return r))
            (if (< r 0) (return (err ss r)))
            (return (cont ss f S_FILTER)))))
    (if (== ph S_FILTER)
      (do (let [na (q-filter-x p s fb w nq (ia ss (+ f F_CLS)) pos ctx)]
            (if (< na 0) (return (err ss na)))
            (iset ss (+ f F_LI) 0)
            (iset ss (+ f F_LST) 0)
            (return (cont ss f S_LEAF)))))
    (if (== ph S_LEAF)
      (do (let [r2 (str-leaves p pool b s ss base wend f)]
            (if (suspended r2) (return r2))
            (if (< r2 0) (return (err ss r2)))
            (let [^:mut ne 0]
              (if (and (== (ia ss (+ f F_MAJ)) 2) (!= (bit-and (ia p H_FLAGS) FL_EMBED) 0))
                (for [^I32 i 0 nq]
                  (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_EMBED))
                    (set ne (+ ne 1)))))
              (if (> ne 0)
                (do (iset ss (+ f F_EPH) 0)
                    (return (cont ss f S_EMBED))))
              (return (cont ss f S_FINISH))))))
    (if (== ph S_EMBED) (return (str-embed p s ss base f)))
    (let [r3 (finish-scalar p s fb w nq d pos ctx)]
      (if (< r3 0) (return (err ss r3)))
      (return (done ss base (- (ia ss (+ f F_STOP)) base))))))

(defn ^I32 open-dstr [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 end]
  (comment "A dead text whose content crosses the window: dead-text in phases.")
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [stop (take-len s pos q (ia s O_HI) (ia s O_LO) end)]
      (if (< stop 0) (return (err ss stop)))
      (if (not (charge s (c64 (- stop q)) pos)) (return (err ss (neg R_BUDGET))))
      (let [f (fpush ss FK_DSTR)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (frame-item ss f base pos end d 0 0 0 0)
        (iset ss (+ f F_STOP) (+ stop base))
        (iset ss (+ f F_I) (+ q base))
        (return (cont ss f 0))))))

(defn ^I32 dstr-run [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (let [r (utf8-steps b s ss base wend f)]
    (if (suspended r) (return r))
    (if (< r 0) (return (err ss r)))
    (return (done ss base (- (ia ss (+ f F_STOP)) base)))))

;; ------------------------------------------------------------ arrays (FK_ARR, FK_DARR)

(defn ^I32 arr-start [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 q0 ^I32 n ^I32 d ^I32 fb
                      ^I32 ck ^I32 nq ^I32 end ^I32 ctx ^I32 pair]
  (comment "eval-array's start (generic path): filter, blocks, the schedule-2 shape,"
           "then the frame. n < 0: a `.cborseq` virtual array (D040).")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cap (- fw (* 2 w))
        ^:mut nb 0
        ^:mut used 0
        ^:mut sl (neg 1)
        ^:mut s2 0
        ^:mut cx 0]
    (let [na (q-filter-x p s fb w nq 16 pos ctx)]
      (if (< na 0) (return (err ss na))))
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_ARRAY))
        (do (let [words (array-words p (leaf-array p (q-leaf-base p s fb i)))]
              (if (> (+ used words) cap) (return (err ss (neg R_INCONSISTENT))))
              (let [ri (array-block-init s (+ area used) i words pos)]
                (if (< ri 0) (return (err ss ri))))
              (set used (+ used words))
              (set nb (+ nb 1))))))
    (if (== nb 1)
      (do (let [ao1 (block-ao p s fb area)]
            (if (and (and (== (ia p ao1) 1) (== (ia p (+ ao1 2)) 0))
                     (and (== (ia p (+ ao1 4)) 1) (== (bit-and (ia p (+ ao1 8)) 1) 1)))
              (set sl (single-leaf p (ia p (+ ao1 6))))))))
    (if (and (sched2 s) (>= sl 0))
      (do (set s2 1)
          (if (scalar-kind (bit-and (ia p (+ (ia p H_S_LEAVES) (* 8 sl))) 255)) (set cx CTX_SIMPLE))))
    (let [pend (count-pending p s fb w nq)
          f (fpush ss FK_ARR)]
      (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
      (frame-item ss f base pos end d fb ck nq ctx)
      (iset ss (+ f F_Q) (+ q0 base))
      (iset ss (+ f F_Q0) (+ q0 base))
      (iset ss (+ f F_Q1) (+ q0 base))
      (iset ss (+ f F_N) n)
      (iset ss (+ f F_NB) nb)
      (iset ss (+ f F_S2) s2)
      (iset ss (+ f F_CX) cx)
      (iset ss (+ f F_PEND) pend)
      (iset ss (+ f F_NALIVE) nb)
      (iset ss (+ f F_PAIR) pair)
      (if (>= pair 0)
        (do (let [of (fbase ss pair)]
              (iset ss (+ of F_NOTED) 1))))
      (return (cont ss f A_NEXT)))))

(defn ^I32 open-arr [^IntsR p ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 fb ^I32 ck
                     ^I32 nq ^I32 end ^I32 ctx ^I32 pair]
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [lo (ia s O_LO)
          ra (enter-container s pos q (ia s O_HI) lo d 0 end)]
      (if (< ra 0) (return (err ss ra)))
      (return (arr-start p s ss base pos q lo d fb ck nq end ctx pair)))))

(defn ^I32 arr-end [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 f]
  (let [pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        nq (ia ss (+ f F_NQ))
        ctx (ia ss (+ f F_CTX))
        q (- (ia ss (+ f F_Q)) base)
        q0 (- (ia ss (+ f F_Q0)) base)
        n (ia ss (+ f F_N))
        el (ia ss (+ f F_EL))
        nb (ia ss (+ f F_NB))
        w (cset-width p (cset-rec p s (ia ss (+ f F_CK))))
        area (+ fb (* 2 w))
        ^:mut unacc 0
        ^:mut be area]
    (for [^I32 _bk 0 nb]
      (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
      (let [aok (block-ao p s fb be)]
        (if (!= (ia s (+ be 1)) 0)
          (do (if (not (charge s (ia p (+ aok 1)) pos)) (return (err ss (neg R_BUDGET))))
              (if (array-accepts p s be aok el)
                (q-set-flag s fb w (ia s be) F_MATCHED)
                (do (q-set-flag s fb w (ia s be) (shl R_MISSING 8))
                    (set unacc (+ unacc 1))))))
        (set be (+ be (array-words p aok)))))
    (if (== n 2) (iset s VM_Q1 (- (ia ss (+ f F_Q1)) base)))
    (let [rs (eval-scalars p pool b s fb w nq pos q0 q 16 0 el (unit-of ctx))]
      (if (< rs 0) (return (err ss rs))))
    (let [m (finish-comb p s fb w nq pos)]
      (if (< m 0) (return (err ss m)))
      (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
        (if (> unacc 0)
          (wit-set s R_MISSING 0 d P_INDEX el pos)
          (do (let [r1 (rule1 s fb w nq d pos)]
                (if (< r1 0) (return (err ss r1))))))))
    (return (done ss base q))))

(defn ^I32 arr-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 f]
  (comment "The next element: its query from the live blocks (charged), then the"
           "element as a child item.")
  (let [pos (- (ia ss (+ f F_POS)) base)
        end (- (ia ss (+ f F_END)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        ck (ia ss (+ f F_CK))
        q (- (ia ss (+ f F_Q)) base)
        n (ia ss (+ f F_N))
        el (ia ss (+ f F_EL))
        nb (ia ss (+ f F_NB))
        s2 (ia ss (+ f F_S2))
        cx (ia ss (+ f F_CX))
        note (pair-note ss (ia ss (+ f F_PAIR)) el)]
    (if (not (or (and (< n 0) (< q end)) (and (>= n 0) (< el n))))
      (return (arr-end p pool b s ss base f)))
    (if (== (ia ss (+ f F_NALIVE)) 0)
      (do (iset ss (+ f F_PH) A_DEAD)
          (call ss base q (+ d 1) 0 0 0 end 0 0 note (neg 1))
          (return GO)))
    (let [cr (cset-rec p s ck)
          w (cset-width p cr)
          area (+ fb (* 2 w))
          cfb (+ fb (cset-frame p cr))
          cck (next-ck p s ck)
          cw (cset-width p (cset-rec p s cck))
          e (new-epoch s)
          ao1 (block-ao p s fb area)
          ^:mut cnq 0
          ^:mut bo area]
      (if (== s2 1) (free-on s))
      (for [^I32 bi 0 nb]
        (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
        (let [^:mut ao ao1]
          (if (> bi 0) (set ao (block-ao p s fb bo)))
          (if (!= (ia s (+ bo 1)) 0)
            (do (set cnq (array-candidates p s bo ao el cfb cw cnq e pos))
                (if (< cnq 0) (return (err ss cnq)))))
          (set bo (+ bo (array-words p ao)))))
      (free-off s)
      (path-put s (+ d 1) P_INDEX el)
      (iset ss (+ f F_CNQ) cnq)
      (iset ss (+ f F_PH) A_LIVE)
      (if (> cnq 0)
        (call ss base q (+ d 1) cfb cck cnq end cx 0 note (neg 1))
        (call ss base q (+ d 1) 0 0 0 end 0 0 note (neg 1)))
      (return GO))))

(defn ^I32 arr-ret [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 r]
  (comment "The element ended at r (absolute): stamp and advance the live blocks"
           "(after a live element), witness, next.")
  (let [el (ia ss (+ f F_EL))]
    (if (== (ia ss (+ f F_PH)) A_LIVE)
      (do (let [pos (- (ia ss (+ f F_POS)) base)
                d (ia ss (+ f F_D))
                fb (ia ss (+ f F_FB))
                ck (ia ss (+ f F_CK))
                q (- (ia ss (+ f F_Q)) base)
                nb (ia ss (+ f F_NB))
                cnq (ia ss (+ f F_CNQ))
                cr (cset-rec p s ck)
                w (cset-width p cr)
                area (+ fb (* 2 w))
                cw (cset-width p (cset-rec p s (next-ck p s ck)))
                ao1 (block-ao p s fb area)
                ^:mut nalive (ia ss (+ f F_NALIVE))
                ^:mut still 0
                ^:mut bo area]
            (if (== (ia ss (+ f F_S2)) 1) (free-on s))
            (let [ev (q-stamp s (+ fb (cset-frame p cr)) cw cnq pos)]
              (if (< ev 0) (return (err ss ev)))
              (for [^I32 bj 0 nb]
                (let [^:mut aoj ao1]
                  (if (> bj 0) (set aoj (block-ao p s fb bo)))
                  (if (!= (ia s (+ bo 1)) 0)
                    (do (let [adv (array-advance p s bo aoj ev pos)]
                          (if (< adv 0) (return (err ss adv)))
                          (if (== adv 1)
                            (set still (+ still 1))
                            (do (set nalive (- nalive 1))
                                (if (== adv 2)
                                  (q-set-flag s fb w (ia s bo) (shl R_UNEXPECTED 8))
                                  (q-set-flag s fb w (ia s bo) (shl R_TYPE 8))))))))
                  (set bo (+ bo (array-words p aoj))))))
            (free-off s)
            (if (or (> still 0) (> (ia ss (+ f F_PEND)) 0))
              (wit-clear s)
              (if (wit-empty s) (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 q)))
            (iset ss (+ f F_NALIVE) nalive))))
    (iset ss (+ f F_Q) r)
    (if (== el 0) (iset ss (+ f F_Q1) r))
    (iset ss (+ f F_EL) (+ el 1))
    (return (cont ss f A_NEXT))))

(defn ^I32 open-darr [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 end]
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [lo (ia s O_LO)
          ra (enter-container s pos q (ia s O_HI) lo d 0 end)]
      (if (< ra 0) (return (err ss ra)))
      (let [f (fpush ss FK_DARR)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (frame-item ss f base pos end d 0 0 0 0)
        (iset ss (+ f F_Q) (+ q base))
        (iset ss (+ f F_N) lo)
        (return (cont ss f 0))))))

(defn ^I32 darr-run [^Ints ss ^I32 base ^I32 f]
  (let [el (ia ss (+ f F_EL))]
    (if (>= el (ia ss (+ f F_N))) (return (done ss base (- (ia ss (+ f F_Q)) base))))
    (iset ss (+ f F_PH) 1)
    (call ss base (- (ia ss (+ f F_Q)) base) (+ (ia ss (+ f F_D)) 1) 0 0 0 (- (ia ss (+ f F_END)) base)
          0 0 (neg 1) (neg 1))
    (return GO)))

;; ------------------------------------------------------------ maps (FK_MAP, FK_DMAP)

(defn ^I32 map-start [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 q0 ^I32 n ^I32 d ^I32 fb
                      ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (comment "eval-map's start (generic path): filter, blocks, then the frame.")
  (let [cr (cset-rec p s ck)
        w (cset-width p cr)
        fw (cset-frame p cr)
        area (+ fb (* 2 w))
        cap (- fw (* 2 w))
        ^:mut nb 0
        ^:mut used 0
        ^:mut ccap 0
        ^:mut smap 0
        ^:mut cose 0]
    (if (and (== d 0) (!= (ia s O_COSE) 0)) (set cose 1))
    (let [na (q-filter-x p s fb w nq 32 pos ctx)]
      (if (< na 0) (return (err ss na))))
    (for [^I32 i 0 nq]
      (if (and (!= (bit-and (q-flag s fb w i) F_ADMITTED) 0) (== (q-kind p s fb i) K_MAP))
        (do (let [mt (leaf-map p (q-leaf-base p s fb i))
                  sw (ia p (+ mt 6))]
              (if (> (+ used sw) cap) (return (err ss (neg R_INCONSISTENT))))
              (let [ri (map-block-init p s (+ area used) i mt pos)]
                (if (< ri 0) (return (err ss ri))))
              (set used (+ used sw))
              (set ccap (+ ccap (ia p (+ mt 7))))
              (set nb (+ nb 1))))))
    (if (> (+ used (* 4 ccap)) cap) (return (err ss (neg R_INCONSISTENT))))
    (if (== nb 1) (set smap (map-fast-mode p (block-mt p s fb area))))
    (let [pend (count-pending p s fb w nq)
          f (fpush ss FK_MAP)]
      (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
      (frame-item ss f base pos end d fb ck nq ctx)
      (iset ss (+ f F_Q) (+ q0 base))
      (iset ss (+ f F_Q0) (+ q0 base))
      (iset ss (+ f F_N) n)
      (iset ss (+ f F_NB) nb)
      (iset ss (+ f F_CL) (+ area used))
      (iset ss (+ f F_CCAP) ccap)
      (iset ss (+ f F_PEND) pend)
      (iset ss (+ f F_NALIVE) nb)
      (iset ss (+ f F_SMAP) smap)
      (iset ss (+ f F_PS) (neg 1))
      (iset ss (+ f F_PE) (neg 1))
      (iset ss (+ f F_COSE) cose)
      (return (cont ss f M_NEXT)))))

(defn ^I32 open-map [^IntsR p ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 fb ^I32 ck
                     ^I32 nq ^I32 end ^I32 ctx]
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [lo (ia s O_LO)
          rm (enter-container s pos q (ia s O_HI) lo d 1 end)]
      (if (< rm 0) (return (err ss rm)))
      (return (map-start p s ss base pos q lo d fb ck nq end ctx)))))

(defn ^I32 pair-key [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (comment "A pair starts: its key's first byte and major type, then the whole key"
           "in the window (D048). The key's start (window-relative), or a"
           "suspension, or VMS_NEED-free refusal as -(1000 + code).")
  (let [start (- (ia ss (+ f F_Q)) base)
        end (- (ia ss (+ f F_END)) base)]
    (if (>= start end) (return (- (neg 1000) CODE_TRUNCATED)))
    (if (or (< start 0) (>= start wend)) (return (need ss base start 1)))
    (let [km (ushr (u8 b start) 5)]
      (if (!= km 3)
        (if (not (and (== (ia ss (+ f F_COSE)) 1) (<= km 1))) (return (- (neg 1000) CODE_KEY_TYPE))))
      (let [h (head-len b start)]
        (if (and (<= (+ start h) end) (> (+ start h) wend)) (return (need ss base start h))))
      (let [req (key-req b start end)]
        (if (> req wend) (return (need ss base start (- req start)))))
      (if (must-yield s ss) (return (yld ss base start)))
      (return start))))

(defn ^I32 map-end [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 f]
  (let [pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        nq (ia ss (+ f F_NQ))
        ctx (ia ss (+ f F_CTX))
        q (- (ia ss (+ f F_Q)) base)
        q0 (- (ia ss (+ f F_Q0)) base)
        n (ia ss (+ f F_N))
        nb (ia ss (+ f F_NB))
        w (cset-width p (cset-rec p s (ia ss (+ f F_CK))))
        area (+ fb (* 2 w))
        ^:mut be area
        ^:mut best (neg 1)
        ^:mut bestbo 0
        ^:mut unsat 0]
    (for [^I32 _bm 0 nb]
      (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
      (let [mtm (block-mt p s fb be)]
        (if (!= (ia s (+ be 1)) 0)
          (do (if (not (charge s (+ (ia p (+ mtm 2)) (ia p (+ mtm 1))) pos)) (return (err ss (neg R_BUDGET))))
              (if (map-satisfied p s be mtm)
                (q-set-flag s fb w (ia s be) F_MATCHED)
                (do (q-set-flag s fb w (ia s be) (shl R_MISSING 8))
                    (set unsat (+ unsat 1))
                    (let [lid (ia s (+ fb (ia s be)))]
                      (if (or (< best 0) (< lid best))
                        (do (set best lid) (set bestbo be))))))))
        (set be (+ be (ia p (+ mtm 6))))))
    (let [rs (eval-scalars p pool b s fb w nq pos q0 q 32 0 n (unit-of ctx))]
      (if (< rs 0) (return (err ss rs))))
    (let [m (finish-comb p s fb w nq pos)]
      (if (< m 0) (return (err ss m)))
      (if (and (== m 0) (and (== (bit-and ctx CTX_KEY) 0) (wit-empty s)))
        (if (> unsat 0)
          (do (let [r4 (map-missing p s bestbo (block-mt p s fb bestbo) d pos)]
                (if (< r4 0) (return (err ss r4)))))
          (do (let [r1 (rule1 s fb w nq d pos)]
                (if (< r1 0) (return (err ss r1))))))))
    (return (done ss base q))))

(defn ^I32 map-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (comment "The next pair: the key (whole in the window) evaluated here with the"
           "generic path's key search, cursors, key query, order check, key phase"
           "and value query; then the value as a child item.")
  (if (>= (ia ss (+ f F_EL)) (ia ss (+ f F_N))) (return (map-end p pool b s ss base f)))
  (let [kr (pair-key b s ss base wend f)]
    (if (suspended kr) (return kr))
    (if (<= kr (neg 1000)) (return (err ss (fail s (- (ia ss (+ f F_Q)) base) (- (neg 1000) kr)))))
    (let [start kr
          pos (- (ia ss (+ f F_POS)) base)
          end (- (ia ss (+ f F_END)) base)
          d (ia ss (+ f F_D))
          fb (ia ss (+ f F_FB))
          ck (ia ss (+ f F_CK))
          nb (ia ss (+ f F_NB))
          cl (ia ss (+ f F_CL))
          ccap (ia ss (+ f F_CCAP))
          smap (ia ss (+ f F_SMAP))
          km (ushr (u8 b start) 5)
          cr (cset-rec p s ck)
          w (cset-width p cr)
          area (+ fb (* 2 w))
          cfb (+ fb (cset-frame p cr))
          cck (next-ck p s ck)
          cw (cset-width p (cset-rec p s cck))]
      (if (== (ia ss (+ f F_NALIVE)) 0)
        (do (let [kq (dead-item b s start (+ d 1) end)]
              (if (< kq 0) (return (err ss kq)))
              (if (<= km 1)
                (if (not (cose-label-ok b start km)) (return (err ss (fail s start CODE_KEY_TYPE)))))
              (let [ko (key-order-s b s ss f base start kq)]
                (if (< ko 0) (return (err ss ko))))
              (set-prev ss f (+ start base) (+ kq base))
              (iset ss (+ f F_PH) M_DVAL)
              (call ss base kq (+ d 1) 0 0 0 end 0 0 (neg 1) (neg 1))
              (return GO))))
      (let [ke (key-span-end b start end)
            ^:mut kid (neg 1)
            ^:mut klo (ia ss (+ f F_KLO))
            ^:mut ps2 0
            ^:mut cnq 0
            ^:mut nc 0
            ^:mut named 0
            ^:mut vnq 0]
        (if (> ke start)
          (do (set kid (key-search p pool b s start ke klo pos))
              (if (== kid (neg 2)) (return (err ss (neg R_BUDGET))))
              (set klo (ia s O_HI))))
        (if (> smap 0)
          (do (let [c0 (ia s (+ area 2))
                    mt0 (block-mt p s fb area)]
                (free-on s)
                (map-cursor p s area mt0 kid pos)
                (free-off s)
                (if (and (sched2 s) (map-pair-ok p s area mt0 kid smap))
                  (do (set ps2 1)
                      (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET)))))
                  (if (not (charge s (+ 1 (- (ia s (+ area 2)) c0)) pos)) (return (err ss (neg R_BUDGET))))))))
        (if (== ps2 1) (free-on s))
        (let [e (new-epoch s)
              ^:mut bo area]
          (for [^I32 _bj 0 nb]
            (let [mtj (block-mt p s fb bo)]
              (if (== smap 0)
                (do (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                    (if (!= (ia s (+ bo 1)) 0)
                      (do (let [rc2 (map-cursor p s bo mtj kid pos)]
                            (if (< rc2 0) (return (err ss rc2))))))))
              (if (!= (ia s (+ bo 1)) 0)
                (do (set cnq (map-key-query p s bo mtj cfb cw cnq e pos))
                    (if (< cnq 0) (return (err ss cnq)))))
              (set bo (+ bo (ia p (+ mtj 6)))))))
        (free-off s)
        (local ^I32 kq)
        (if (> cnq 0)
          (set kq (eval-item p pool b s start (+ d 1) cfb cck cnq end (bit-or CTX_KEY (simple-of p s ps2 cfb cnq))))
          (set kq (dead-item b s start (+ d 1) end)))
        (if (< kq 0) (return (err ss kq)))
        (if (<= km 1)
          (if (not (cose-label-ok b start km)) (return (err ss (fail s start CODE_KEY_TYPE)))))
        (let [ko2 (key-order-s b s ss f base start kq)]
          (if (< ko2 0) (return (err ss ko2))))
        (set-prev ss f (+ start base) (+ kq base))
        (if (== ps2 1) (free-on s))
        (let [ek (q-stamp s cfb cw cnq pos)
              ^:mut bo2 area]
          (if (< ek 0) (return (err ss ek)))
          (for [^I32 _bk 0 nb]
            (let [mtk (block-mt p s fb bo2)]
              (if (!= (ia s (+ bo2 1)) 0)
                (do (if (simple-struct p mtk)
                      (set nc (key-phase-struct p s bo2 mtk kid cl nc ccap pos))
                      (set nc (map-key-phase p s bo2 mtk kid ek cl nc ccap pos)))
                    (if (< nc 0) (return (err ss nc)))))
              (set bo2 (+ bo2 (ia p (+ mtk 6)))))))
        (for [^I32 c 0 nc]
          (if (== (bit-and (ia s (+ (+ cl (* 4 c)) 1)) 1) 0) (set named 1)))
        (if (== named 1) (path-put s (+ d 1) P_KEY kid) (path-put s (+ d 1) P_ANYKEY 0))
        (let [e2 (new-epoch s)]
          (for [^I32 c2 0 nc]
            (let [vts (cand-vts p s fb cl c2)]
              (set vnq (q-add p s cfb cw vnq vts e2 pos)))
            (if (< vnq 0) (return (err ss vnq)))))
        (free-off s)
        (iset ss (+ f F_KLO) klo)
        (iset ss (+ f F_START) (+ start base))
        (iset ss (+ f F_KID) kid)
        (iset ss (+ f F_MCNQ) cnq)
        (iset ss (+ f F_NC) nc)
        (iset ss (+ f F_NAMED) named)
        (iset ss (+ f F_VNQ) vnq)
        (iset ss (+ f F_PS2) ps2)
        (iset ss (+ f F_PH) M_LVAL)
        (if (> vnq 0)
          (call ss base kq (+ d 1) cfb cck vnq end (simple-of p s ps2 cfb vnq) 0 (neg 1) (neg 1))
          (call ss base kq (+ d 1) 0 0 0 end 0 0 (neg 1) (neg 1)))
        (return GO)))))

(defn ^I32 map-ret [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 r]
  (comment "The value ended at r (absolute): after a live value, each candidate's"
           "value test and each block's update, then the witness; next pair.")
  (if (== (ia ss (+ f F_PH)) M_LVAL)
    (do (let [pos (- (ia ss (+ f F_POS)) base)
              d (ia ss (+ f F_D))
              fb (ia ss (+ f F_FB))
              ck (ia ss (+ f F_CK))
              nb (ia ss (+ f F_NB))
              cl (ia ss (+ f F_CL))
              kid (ia ss (+ f F_KID))
              nc (ia ss (+ f F_NC))
              vnq (ia ss (+ f F_VNQ))
              start (- (ia ss (+ f F_START)) base)
              cr (cset-rec p s ck)
              w (cset-width p cr)
              area (+ fb (* 2 w))
              cfb (+ fb (cset-frame p cr))
              cw (cset-width p (cset-rec p s (next-ck p s ck)))
              ^:mut nalive (ia ss (+ f F_NALIVE))
              ^:mut still 0
              ^:mut bo area]
          (if (== (ia ss (+ f F_PS2)) 1) (free-on s))
          (let [ev (q-stamp s cfb cw vnq pos)]
            (if (< ev 0) (return (err ss ev)))
            (for [^I32 _bl 0 nb]
              (let [mtl (block-mt p s fb bo)]
                (if (!= (ia s (+ bo 1)) 0)
                  (do (let [^:mut c3 (ia s (+ bo 3))]
                        (while (and (< c3 nc) (== (ia s (+ cl (* 4 c3))) bo))
                          (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                          (let [vts3 (cand-vts-mt p s mtl cl c3)
                                t (ts-test p s vts3 ev pos)]
                            (if (< t 0) (return (err ss t)))
                            (if (== t 1)
                              (do (let [kw (+ (+ cl (* 4 c3)) 1)]
                                    (iset s kw (bit-or (ia s kw) 2))))))
                          (set c3 (+ c3 1))))
                      (local ^I32 u)
                      (if (simple-struct p mtl)
                        (set u (update-struct p s bo mtl kid cl nc pos))
                        (set u (map-update p s bo mtl kid cl nc pos)))
                      (if (< u 0) (return (err ss u)))
                      (if (== u 1)
                        (set still (+ still 1))
                        (do (set nalive (- nalive 1))
                            (if (block-named s bo cl nc)
                              (q-set-flag s fb w (ia s bo) (shl R_VALUE 8))
                              (q-set-flag s fb w (ia s bo) (shl R_UNEXPECTED 8)))))))
                (set bo (+ bo (ia p (+ mtl 6)))))))
          (free-off s)
          (if (or (> still 0) (> (ia ss (+ f F_PEND)) 0))
            (wit-clear s)
            (if (wit-empty s)
              (if (== (ia ss (+ f F_NAMED)) 1)
                (wit-set s R_VALUE 0 (+ d 1) (neg 1) 0 start)
                (wit-set s R_UNEXPECTED 0 (+ d 1) (neg 1) 0 start))))
          (iset ss (+ f F_NALIVE) nalive))))
  (iset ss (+ f F_Q) r)
  (iset ss (+ f F_EL) (+ (ia ss (+ f F_EL)) 1))
  (return (cont ss f M_NEXT)))

(defn ^I32 open-dmap [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 end]
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [lo (ia s O_LO)
          rm (enter-container s pos q (ia s O_HI) lo d 1 end)]
      (if (< rm 0) (return (err ss rm)))
      (let [f (fpush ss FK_DMAP)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (frame-item ss f base pos end d 0 0 0 0)
        (iset ss (+ f F_Q) (+ q base))
        (iset ss (+ f F_N) lo)
        (iset ss (+ f F_PS) (neg 1))
        (iset ss (+ f F_PE) (neg 1))
        (if (and (== d 0) (!= (ia s O_COSE) 0)) (iset ss (+ f F_COSE) 1))
        (return (cont ss f 0))))))

(defn ^I32 dmap-run [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (comment "dead-map-pairs, a pair at a time.")
  (if (>= (ia ss (+ f F_EL)) (ia ss (+ f F_N))) (return (done ss base (- (ia ss (+ f F_Q)) base))))
  (let [kr (pair-key b s ss base wend f)]
    (if (suspended kr) (return kr))
    (if (<= kr (neg 1000)) (return (err ss (fail s (- (ia ss (+ f F_Q)) base) (- (neg 1000) kr)))))
    (let [start kr
          end (- (ia ss (+ f F_END)) base)
          d (ia ss (+ f F_D))
          km (ushr (u8 b start) 5)
          kq (dead-item b s start (+ d 1) end)]
      (if (< kq 0) (return (err ss kq)))
      (if (<= km 1)
        (if (not (cose-label-ok b start km)) (return (err ss (fail s start CODE_KEY_TYPE)))))
      (let [ko (key-order-s b s ss f base start kq)]
        (if (< ko 0) (return (err ss ko))))
      (set-prev ss f (+ start base) (+ kq base))
      (iset ss (+ f F_PH) 1)
      (call ss base kq (+ d 1) 0 0 0 end 0 0 (neg 1) (neg 1))
      (return GO))))

;; ------------------------------------------------------------ tags (FK_TAG, FK_DPAIR, FK_DTYPED)

(defn ^I32 notes-init [^Ints ss ^I32 f]
  (iset ss (+ f F_EXPOK) 0)
  (iset ss (+ f F_MANT) 0)
  (iset ss (+ f F_NDBAD) 1)
  (iset ss (+ f F_NDK) 0)
  (iset ss (+ f F_COUNT) (neg 1))
  (return f))

(defn ^I32 open-tag [^IntsR p ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 fb ^I32 ck
                     ^I32 nq ^I32 end ^I32 ctx]
  (comment "eval-tag for a typed array or tag 4/40 crossing the window: depth and"
           "number checks, the filter, TAG/TAGSET number tests and the content"
           "query; then phases.")
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [hi (ia s O_HI)
          lo (ia s O_LO)]
      (if (>= d (ia s O_MAX_DEPTH)) (return (err ss (fail s pos CODE_DEPTH))))
      (if (!= hi 0) (return (err ss (fail s pos CODE_TAG))))
      (let [tsize (typed-size lo)
            cr (cset-rec p s ck)
            w (cset-width p cr)
            cfb (+ fb (cset-frame p cr))
            cck (next-ck p s ck)
            cw (cset-width p (cset-rec p s cck))
            ^:mut cnq 0]
        (if (and (!= lo 4) (and (!= lo 40) (== tsize 0))) (return (err ss (fail s pos CODE_TAG))))
        (let [na (q-filter-x p s fb w nq 64 pos ctx)]
          (if (< na 0) (return (err ss na))))
        (let [e (new-epoch s)]
          (for [^I32 i 0 nq]
            (let [fl (q-flag s fb w i)
                  kind (q-kind p s fb i)]
              (if (and (!= (bit-and fl F_ADMITTED) 0) (or (== kind K_TAG) (== kind K_TAGSET)))
                (do (if (not (charge s 1 pos)) (return (err ss (neg R_BUDGET))))
                    (let [lb (q-leaf-base p s fb i)
                          istag (== kind K_TAG)
                          hit (or (and istag (and (== (ia p (+ lb 2)) 0) (== (ia p (+ lb 3)) lo)))
                                  (and (not istag)
                                       (and (<= (cmp-u64 (ia p (+ lb 2)) (ia p (+ lb 3)) 0 lo) 0)
                                            (>= (cmp-u64 (ia p (+ lb 4)) (ia p (+ lb 5)) 0 lo) 0))))
                          ^:mut cts (ia p (+ lb 6))]
                      (if istag (set cts (ia p (+ lb 4))))
                      (if hit
                        (do (q-set-flag s fb w i F_EVAL)
                            (set cnq (q-add p s cfb cw cnq cts e pos))
                            (if (< cnq 0) (return (err ss cnq))))
                        (q-set-flag s fb w i (shl R_TAG 8)))))))))
        (if (> cnq 0) (path-put s (+ d 1) P_TAG 0))
        (let [f (fpush ss FK_TAG)]
          (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
          (frame-item ss f base pos end d fb ck nq ctx)
          (notes-init ss f)
          (iset ss (+ f F_Q) (+ q base))
          (iset ss (+ f F_LO) lo)
          (iset ss (+ f F_CLS) 64)
          (iset ss (+ f F_TCNQ) cnq)
          (iset ss (+ f F_CS) (+ q base))
          (iset ss (+ f F_TSIZE) tsize)
          (if (> tsize 0)
            (do (if (not (charge s 1 q)) (return (err ss (neg R_BUDGET))))
                (return (cont ss f T_THEAD))))
          (return (cont ss f T_PAIR)))))))

(defn ^I32 push-tail [^IntsR p ^Ints s ^Ints ss ^I32 base ^I32 tf]
  (comment "bstr-tail over a typed array's content (a schema child at depth d + 1,"
           "not an item) as a string frame in tail mode.")
  (let [d (ia ss (+ tf F_D))
        fb (ia ss (+ tf F_FB))
        ck (ia ss (+ tf F_CK))
        cr (cset-rec p s ck)
        f (fpush ss FK_STR)]
    (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
    (frame-item ss f base (- (ia ss (+ tf F_Q)) base) (- (ia ss (+ tf F_END)) base) (+ d 1)
                (+ fb (cset-frame p cr)) (next-ck p s ck) (ia ss (+ tf F_TCNQ)) 0)
    (iset ss (+ f F_MAJ) 2)
    (iset ss (+ f F_TAIL) 1)
    (iset ss (+ f F_CLS) 4)
    (iset ss (+ f F_CS) (ia ss (+ tf F_CS)))
    (iset ss (+ f F_STOP) (ia ss (+ tf F_STOP)))
    (return (cont ss f S_FILTER))))

(defn ^I32 tag-fin [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 f]
  (comment "eval-tag's end: the content typesets of the number-matched leaves, the"
           "scalar leaves, the witness, then the tag ends.")
  (let [pos (- (ia ss (+ f F_POS)) base)
        d (ia ss (+ f F_D))
        fb (ia ss (+ f F_FB))
        ck (ia ss (+ f F_CK))
        nq (ia ss (+ f F_NQ))
        ctx (ia ss (+ f F_CTX))
        lo (ia ss (+ f F_LO))
        cs (- (ia ss (+ f F_CS)) base)
        stop (- (ia ss (+ f F_STOP)) base)
        cr (cset-rec p s ck)
        w (cset-width p cr)
        cfb (+ fb (cset-frame p cr))
        cw (cset-width p (cset-rec p s (next-ck p s ck)))
        ec (q-stamp s cfb cw (ia ss (+ f F_TCNQ)) pos)]
    (if (< ec 0) (return (err ss ec)))
    (for [^I32 j 0 nq]
      (let [fj (q-flag s fb w j)]
        (if (!= (bit-and fj F_EVAL) 0)
          (do (let [lbj (q-leaf-base p s fb j)
                    ^:mut ctj (ia p (+ lbj 4))]
                (if (== (q-kind p s fb j) K_TAGSET) (set ctj (ia p (+ lbj 6))))
                (let [t (ts-test p s ctj ec pos)]
                  (if (< t 0) (return (err ss t)))
                  (if (== t 1)
                    (q-set-flag s fb w j F_MATCHED)
                    (q-set-flag s fb w j (shl R_TYPE 8)))))))))
    (let [r2 (eval-scalars p pool b s fb w nq pos cs stop 64 0 lo (unit-of ctx))]
      (if (< r2 0) (return (err ss r2))))
    (if (> (count-matched p s fb w nq) 0) (wit-clear s))
    (let [r3 (finish-scalar p s fb w nq d pos ctx)]
      (if (< r3 0) (return (err ss r3))))
    (return (done ss base stop))))

(defn ^I32 open-dpair [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 end]
  (comment "dead-tag for tag 4/40 crossing the window: the depth and number checks;"
           "then the pair check and dead-pair-body in phases, its elements noted.")
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [hi (ia s O_HI)
          lo (ia s O_LO)]
      (if (>= d (ia s O_MAX_DEPTH)) (return (err ss (fail s pos CODE_DEPTH))))
      (if (!= hi 0) (return (err ss (fail s pos CODE_TAG))))
      (let [f (fpush ss FK_DPAIR)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (frame-item ss f base pos end d 0 0 0 0)
        (notes-init ss f)
        (iset ss (+ f F_Q) (+ q base))
        (iset ss (+ f F_LO) lo)
        (iset ss (+ f F_MODE) 0)
        (iset ss (+ f F_OWNER) (- (ia ss SS_SP) 1))
        (return (cont ss f DP_CHECK))))))

(defn ^I32 dpair-run [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (let [ph (ia ss (+ f F_PH))
        pos (- (ia ss (+ f F_POS)) base)
        end (- (ia ss (+ f F_END)) base)
        d (ia ss (+ f F_D))
        lo (ia ss (+ f F_LO))
        q (- (ia ss (+ f F_Q)) base)]
    (if (== ph DP_CHECK)
      (do (if (>= q end) (return (err ss (fail s q CODE_TRUNCATED))))
          (if (or (< q 0) (>= q wend)) (return (need ss base q 1)))
          (if (!= (u8 b q) 130)
            (if (== lo 4) (return (err ss (fail s pos CODE_DECIMAL))) (return (err ss (fail s pos CODE_NDARRAY)))))
          (return (cont ss f DP_BODY))))
    (if (== ph DP_BODY)
      (do (if (not (charge s 1 q)) (return (err ss (neg R_BUDGET))))
          (let [c (count-item s q)]
            (if (< c 0) (return (err ss c))))
          (let [r (enter-container s q (+ q 1) 0 2 (+ d 1) 0 end)]
            (if (< r 0) (return (err ss r))))
          (iset ss (+ f F_Q) (+ (+ q 1) base))
          (iset ss (+ f F_EL) 0)
          (return (cont ss f DP_ELEM))))
    (let [el (ia ss (+ f F_EL))]
      (if (< el 2)
        (do (iset ss (+ f F_PH) DP_RET)
            (call ss base q (+ d 2) 0 0 0 end 0 0 (pair-note ss (ia ss (+ f F_OWNER)) el) (neg 1))
            (return GO)))
      (if (== (ia ss (+ f F_MODE)) 0)
        (do (let [v (pair-verdict s ss f lo pos)]
              (if (< v 0) (return (err ss v))))))
      (return (done ss base q)))))

(defn ^I32 open-dtyped [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 end]
  (let [q (prologue b s pos end)]
    (if (< q 0) (return (err ss q)))
    (let [hi (ia s O_HI)
          lo (ia s O_LO)]
      (if (>= d (ia s O_MAX_DEPTH)) (return (err ss (fail s pos CODE_DEPTH))))
      (if (!= hi 0) (return (err ss (fail s pos CODE_TAG))))
      (let [f (fpush ss FK_DTYPED)]
        (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
        (frame-item ss f base pos end d 0 0 0 0)
        (iset ss (+ f F_Q) (+ q base))
        (iset ss (+ f F_LO) lo)
        (iset ss (+ f F_TSIZE) (typed-size lo))
        (return (cont ss f 0))))))

(defn ^I32 dtyped-run [^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (let [pos (- (ia ss (+ f F_POS)) base)
        end (- (ia ss (+ f F_END)) base)]
    (if (== (ia ss (+ f F_PH)) 0)
      (do (let [r (typed-head b s ss base wend f (- (ia ss (+ f F_Q)) base) end pos)]
            (if (suspended r) (return r))
            (if (< r 0) (return (err ss r)))
            (iset ss (+ f F_PH) 1))))
    (let [r2 (typed-steps b s ss base wend f)]
      (if (suspended r2) (return r2))
      (if (< r2 0) (return (err ss r2)))
      (return (done ss base (- (ia ss (+ f F_STOP)) base))))))

(defn ^I32 tag-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 f]
  (let [ph (ia ss (+ f F_PH))
        pos (- (ia ss (+ f F_POS)) base)
        end (- (ia ss (+ f F_END)) base)
        d (ia ss (+ f F_D))
        lo (ia ss (+ f F_LO))
        q (- (ia ss (+ f F_Q)) base)]
    (if (== ph T_THEAD)
      (do (let [r (typed-head b s ss base wend f q end pos)]
            (if (suspended r) (return r))
            (if (< r 0) (return (err ss r)))
            (return (cont ss f T_TSCAN)))))
    (if (== ph T_TSCAN)
      (do (let [r2 (typed-steps b s ss base wend f)]
            (if (suspended r2) (return r2))
            (if (< r2 0) (return (err ss r2)))
            (return (cont ss f T_TTAIL)))))
    (if (== ph T_TTAIL)
      (do (if (> (ia ss (+ f F_TCNQ)) 0)
            (do (iset ss (+ f F_PH) T_TAILRET)
                (return (push-tail p s ss base f))))
          (return (cont ss f T_FIN))))
    (if (== ph T_PAIR)
      (do (if (>= q end) (return (err ss (fail s q CODE_TRUNCATED))))
          (if (or (< q 0) (>= q wend)) (return (need ss base q 1)))
          (if (!= (u8 b q) 130)
            (if (== lo 4) (return (err ss (fail s pos CODE_DECIMAL))) (return (err ss (fail s pos CODE_NDARRAY)))))
          (let [fb (ia ss (+ f F_FB))
                ck (ia ss (+ f F_CK))
                cr (cset-rec p s ck)
                me (- (ia ss SS_SP) 1)
                cnq (ia ss (+ f F_TCNQ))]
            (iset ss (+ f F_PH) T_PAIRRET)
            (if (> cnq 0)
              (do (call ss base q (+ d 1) (+ fb (cset-frame p cr)) (next-ck p s ck) cnq end 0 0 (neg 1) me)
                  (return GO)))
            (comment "the dead pair body: speculatively in the window, else in frames")
            (let [send (send-of q end wend (qbytes s ss))]
              (snap s ss 0 0)
              (let [r3 (dead-pair-body b s q d send)]
                (if (and (== r3 (neg CODE_TRUNCATED)) (< send end))
                  (do (unsnap s ss 0 0)
                      (let [g (fpush ss FK_DPAIR)]
                        (if (< g 0) (return (err ss (neg R_INCONSISTENT))))
                        (frame-item ss g base pos end d 0 0 0 0)
                        (iset ss (+ g F_Q) (+ q base))
                        (iset ss (+ g F_LO) lo)
                        (iset ss (+ g F_MODE) 1)
                        (iset ss (+ g F_OWNER) me)
                        (iset ss (+ f F_NOTED) 1)
                        (return (cont ss g DP_BODY)))))
                (return (ret ss base r3)))))))
    (return (tag-fin p pool b s ss base f))))

(defn ^I32 tag-ret [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 f ^I32 r]
  (let [ph (ia ss (+ f F_PH))]
    (if (== ph T_TAILRET) (return (cont ss f T_FIN)))
    (let [pos (- (ia ss (+ f F_POS)) base)
          q (- (ia ss (+ f F_Q)) base)
          lo (ia ss (+ f F_LO))
          stop (- r base)]
      (local ^I32 v)
      (if (== (ia ss (+ f F_NOTED)) 1)
        (set v (pair-verdict s ss f lo pos))
        (if (== lo 4)
          (set v (decimal-check b s pos q stop))
          (set v (ndarray-check b s pos q stop))))
      (if (< v 0) (return (err ss v)))
      (iset ss (+ f F_STOP) r)
      (return (tag-fin p pool b s ss base f)))))

;; ------------------------------------------------------------ dead sequences (FK_DSEQ)

(defn ^I32 dseq-run [^Ints ss ^I32 base ^I32 f]
  (let [q (- (ia ss (+ f F_Q)) base)
        end (- (ia ss (+ f F_END)) base)]
    (if (>= q end) (return (done ss base q)))
    (iset ss (+ f F_PH) 1)
    (call ss base q (ia ss (+ f F_D)) 0 0 0 end 0 0 (neg 1) (neg 1))
    (return GO)))

;; ------------------------------------------------------------ an item begins

(defn ^I32 direct [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 pos ^I32 d ^I32 fb
                   ^I32 ck ^I32 nq ^I32 end ^I32 ctx]
  (comment "The buffer walk on an item whose reads all lie in the window.")
  (if (> nq 0) (return (ret ss base (eval-item p pool b s pos d fb ck nq end ctx))))
  (return (ret ss base (dead-item b s pos d end))))

(defn ^I32 begin-seq [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend ^I32 pos
                      ^I32 d ^I32 fb ^I32 ck ^I32 nq ^I32 end]
  (comment "A `.cborseq` content walk: the buffer walk when the whole content is in"
           "the window (its bound decides where the sequence ends, so it is never"
           "cut short), else frames.")
  (if (must-yield s ss) (return (yld ss base pos)))
  (let [whole (and (>= pos 0) (and (<= end wend) (<= (- end pos) (qbytes s ss))))]
    (if (> nq 0)
      (do (if whole (return (ret ss base (eval-array p pool b s pos pos (neg 1) d fb ck nq end 0))))
          (return (arr-start p s ss base pos pos (neg 1) d fb ck nq end 0 (neg 1)))))
    (if whole (return (ret ss base (dead-seq b s pos d end))))
    (let [f (fpush ss FK_DSEQ)]
      (if (< f 0) (return (err ss (neg R_INCONSISTENT))))
      (frame-item ss f base pos end d 0 0 0 0)
      (iset ss (+ f F_Q) (+ pos base))
      (return (cont ss f 0)))))

(defn ^I32 item-begin [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend]
  (comment "The pending item: its head (and note bytes) in the window before any"
           "side effect, a yield point, then the buffer walk directly (scalars),"
           "speculatively (containers, tags), or a frame.")
  (let [pos (- (ia ss IT_POS) base)
        end (- (ia ss IT_END) base)
        d (ia ss IT_D)
        fb (ia ss IT_FB)
        ck (ia ss IT_CK)
        nq (ia ss IT_NQ)
        ctx (ia ss IT_CTX)
        mode (ia ss IT_MODE)
        note (ia ss IT_NOTE)]
    (if (== mode 1) (return (begin-seq p pool b s ss base wend pos d fb ck nq end)))
    (if (== mode 2) (return (begin-seq p pool b s ss base wend pos d 0 0 0 end)))
    (if (< pos end)
      (do (if (or (< pos 0) (>= pos wend)) (return (need ss base pos 1)))
          (let [h (head-len b pos)]
            (if (and (<= (+ pos h) end) (> (+ pos h) wend)) (return (need ss base pos h))))
          (if (>= note 0)
            (do (let [kind (bit-and note 3)
                      req (note-req b s kind pos end wend)]
                  (if (> req wend) (return (need ss base pos (- req pos))))
                  (note-put b s ss kind pos end wend (fbase ss (ushr note 2))))))))
    (if (must-yield s ss) (return (yld ss base pos)))
    (if (>= pos end) (return (direct p pool b s ss base pos d fb ck nq end ctx)))
    (let [ib (u8 b pos)
          major (ushr ib 5)
          live (> nq 0)
          qb (qbytes s ss)]
      (if (or (<= major 1) (== major 7)) (return (direct p pool b s ss base pos d fb ck nq end ctx)))
      (if (<= major 3)
        (do (let [se (str-end b pos end)]
              (if (or (< se 0) (and (<= se wend) (<= (sar (- se pos) 6) qb)))
                (return (direct p pool b s ss base pos d fb ck nq end ctx)))
              (if live (return (open-str b s ss base pos d fb ck nq end ctx)))
              (if (== major 2) (return (direct p pool b s ss base pos d fb ck nq end ctx)))
              (return (open-dstr b s ss base pos d end)))))
      (if (or (== ib 194) (== ib 195))
        (do (let [req (big-req b s pos end wend)]
              (if (> req wend) (return (need ss base pos (- req pos))))
              (return (direct p pool b s ss base pos d fb ck nq end ctx)))))
      (let [send (send-of pos end wend qb)
            ^:mut r 0]
        (if live
          (set r (spec-live p pool b s ss pos d fb ck nq end send ctx))
          (set r (spec-dead b s ss pos d end send)))
        (if (!= r SPEC_FAIL) (return (ret ss base r)))
        (comment "The item crosses the window's end (or the quantum's bound): frames.")
        (if (== major 4)
          (do (if live (return (open-arr p b s ss base pos d fb ck nq end ctx (ia ss IT_PAIR))))
              (return (open-darr b s ss base pos d end))))
        (if (== major 5)
          (do (if live (return (open-map p b s ss base pos d fb ck nq end ctx)))
              (return (open-dmap b s ss base pos d end))))
        (let [ai (bit-and ib 31)
              ^:mut tag ai]
          (if (== ai 24) (set tag (u8 b (+ pos 1))))
          (if (== ai 25) (set tag (be16 b (+ pos 1))))
          (if (>= ai 26) (set tag (neg 1)))
          (if (or (== tag 4) (== tag 40))
            (do (if live (return (open-tag p b s ss base pos d fb ck nq end ctx)))
                (return (open-dpair b s ss base pos d end))))
          (if (and (>= tag 0) (> (typed-size tag) 0))
            (do (if live (return (open-tag p b s ss base pos d fb ck nq end ctx)))
                (return (open-dtyped b s ss base pos d end))))
          (return (direct p pool b s ss base pos d fb ck nq end ctx)))))))

;; ------------------------------------------------------------ returns, frames, the document

(defn ^I32 fin [^Ints s ^Ints ss ^Ints out ^I32 code ^I32 sub ^I32 offset]
  (vm-output s out code sub offset)
  (iset ss SS_CODE code)
  (iset ss SS_PH PH_DONE)
  (return FIN))

(defn ^I32 root-end [^IntsR p ^Ints s ^Ints ss ^Ints out ^I32 base ^I32 r]
  (comment "vm-run's end: the root's result, trailing bytes, the rule's typeset.")
  (if (== r (neg R_INCONSISTENT)) (return BAD))
  (if (== r (neg R_BUDGET)) (return (fin s ss out R_BUDGET 0 (+ (ia s VM_POS) base))))
  (if (< r 0) (return (fin s ss out (neg r) 0 (+ (ia s O_ERR_POS) base))))
  (if (!= r (ia ss SS_TOTAL))
    (do (fail s (- r base) CODE_TRAILING)
        (return (fin s ss out CODE_TRAILING 0 r))))
  (let [frames (ia s VM_FRAMES)
        nq (ia ss SS_RNQ)
        ts (ia ss SS_RTS)
        w (cset-width p (cset-rec p s 0))
        start (neg base)
        ev (q-stamp s frames w nq start)]
    (if (< ev 0) (return (fin s ss out R_BUDGET 0 (+ (ia s VM_POS) base))))
    (let [t (ts-test p s ts ev start)]
      (if (< t 0) (return (fin s ss out R_BUDGET 0 (+ (ia s VM_POS) base))))
      (if (== t 1) (return (fin s ss out 0 0 0)))
      (if (wit-empty s) (wit-set s R_TYPE 0 0 (neg 1) 0 start))
      (iset s VM_W_OFFSET (+ (ia s VM_W_OFFSET) base))
      (let [c (vm-witness-output s out)]
        (iset ss SS_CODE c)
        (iset ss SS_PH PH_DONE)
        (return FIN)))))

(defn ^I32 deliver [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^Ints out ^I32 base]
  (comment "Hand the finished item's result to its parent frame; a refusal unwinds"
           "frames up to an embedded walk's (which keeps it as its witness) or the"
           "document; budget and inconsistency end the walk.")
  (let [r (ia ss SS_RET)
        sp (ia ss SS_SP)]
    (if (or (== sp 0) (or (== r (neg R_BUDGET)) (== r (neg R_INCONSISTENT))))
      (return (root-end p s ss out base r)))
    (let [f (ftop ss)
          kind (ia ss (+ f F_KIND))
          ph (ia ss (+ f F_PH))]
      (if (and (== kind FK_STR) (and (== ph S_EMBED) (or (== (ia ss (+ f F_EPH)) 10) (== (ia ss (+ f F_EPH)) 11))))
        (return (embed-ret p s ss base f r)))
      (if (< r 0)
        (do (fpop ss)
            (return GO)))
      (if (== kind FK_ARR) (return (arr-ret p s ss base f r)))
      (if (== kind FK_MAP) (return (map-ret p s ss base f r)))
      (if (== kind FK_TAG) (return (tag-ret p pool b s ss base f r)))
      (if (or (== kind FK_DARR) (or (== kind FK_DSEQ) (== kind FK_DMAP)))
        (do (iset ss (+ f F_Q) r)
            (if (!= kind FK_DSEQ) (iset ss (+ f F_EL) (+ (ia ss (+ f F_EL)) 1)))
            (return (cont ss f 0))))
      (if (== kind FK_DPAIR)
        (do (iset ss (+ f F_Q) r)
            (iset ss (+ f F_EL) (+ (ia ss (+ f F_EL)) 1))
            (return (cont ss f DP_ELEM))))
      (return BAD))))

(defn ^I32 frame-run [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^I32 base ^I32 wend]
  (let [f (ftop ss)
        kind (ia ss (+ f F_KIND))]
    (if (== kind FK_ARR) (return (arr-run p pool b s ss base f)))
    (if (== kind FK_MAP) (return (map-run p pool b s ss base wend f)))
    (if (== kind FK_STR) (return (str-run p pool b s ss base wend f)))
    (if (== kind FK_TAG) (return (tag-run p pool b s ss base wend f)))
    (if (== kind FK_DARR) (return (darr-run ss base f)))
    (if (== kind FK_DMAP) (return (dmap-run b s ss base wend f)))
    (if (== kind FK_DPAIR) (return (dpair-run b s ss base wend f)))
    (if (== kind FK_DSEQ) (return (dseq-run ss base f)))
    (if (== kind FK_DSTR) (return (dstr-run b s ss base wend f)))
    (if (== kind FK_DTYPED) (return (dtyped-run b s ss base wend f)))
    (return BAD)))

(defn ^I32 doc-start [^IntsR p ^Bytes b ^Ints s ^Ints ss ^Ints out ^I32 base ^I32 wend]
  (comment "vm-run's start: the size bound, the top-level map peek, the rule's"
           "query, then the root item.")
  (let [total (ia ss SS_TOTAL)]
    (if (> total (ia s O_MAX_BYTES))
      (do (fail s (neg base) CODE_TOO_LARGE)
          (return (fin s ss out CODE_TOO_LARGE 0 0))))
    (if (== (ia s O_TOP) 0)
      (do (if (== total 0)
            (do (fail s (neg base) CODE_NOT_MAP)
                (return (fin s ss out CODE_NOT_MAP 0 0))))
          (if (or (!= base 0) (== wend 0)) (return (need ss base (neg base) 1)))
          (if (!= (ushr (u8 b 0) 5) 5)
            (do (fail s 0 CODE_NOT_MAP)
                (return (fin s ss out CODE_NOT_MAP 0 0))))))
    (let [rr (+ (ia p H_S_RULES) (* 5 (ia s VM_RULE)))
          ts (ia p (+ rr 2))
          frames (ia s VM_FRAMES)
          w (cset-width p (cset-rec p s 0))
          e (new-epoch s)
          nq (q-add p s frames w 0 ts e (neg base))]
      (if (== nq (neg R_BUDGET)) (return (fin s ss out R_BUDGET 0 (+ (ia s VM_POS) base))))
      (if (< nq 0) (return BAD))
      (iset ss SS_RTS ts)
      (iset ss SS_RNQ nq)
      (call ss base (neg base) 0 frames 0 nq (- total base) 0 0 (neg 1) (neg 1))
      (return GO))))

(defn set-keep [^Ints ss]
  (let [^:mut k (ia ss SS_POS)
        sp (ia ss SS_SP)]
    (for [^I32 i 0 sp]
      (let [f (fbase ss i)]
        (if (and (== (ia ss (+ f F_KIND)) FK_STR) (>= (ia ss (+ f F_PH)) S_FILTER))
          (if (< (ia ss (+ f F_POS)) k) (set k (ia ss (+ f F_POS)))))))
    (iset ss SS_KEEP k)))

(defn ^:pub ^I32 vms-step [^IntsR p ^Bytes pool ^Bytes b ^Ints s ^Ints ss ^Ints out ^I32 base-hi
                           ^I32 base-lo]
  (comment "Run the session over the window b, whose first byte is message offset"
           "base-hi:base-lo, until the verdict (the code >= 0, with out filled as by"
           "vm-validate; later calls answer it again), VMS_NEED (call again with a"
           "window holding [vms-need-offset, + vms-need-length)) or VMS_YIELD (the"
           "quantum is done: call again, e.g. with the same window). -1 Program"
           "inconsistent, -4 out shorter than 8 words, -5 a window outside the"
           "message.")
  (if (== (ia ss SS_PH) PH_DONE) (return (ia ss SS_CODE)))
  (if (< (ilen out) 8) (return (neg 4)))
  (if (or (!= base-hi 0) (< base-lo 0)) (return (neg 5)))
  (let [base base-lo
        wend (blen b)]
    (if (> wend (- (ia ss SS_TOTAL) base)) (return (neg 5)))
    (iset ss SS_STEPS (+ (ia ss SS_STEPS) 1))
    (iset s VM_W_OFFSET (- (ia s VM_W_OFFSET) base))
    (iset s VM_POS (- (ia s VM_POS) base))
    (iset s O_ERR_POS (- (ia s O_ERR_POS) base))
    (iset ss SS_WB0 (ia s VM_BUDGET))
    (iset ss SS_WBYTES 0)
    (forever
      (let [ph (ia ss SS_PH)
            ^:mut a GO]
        (if (== ph PH_ITEM)
          (set a (item-begin p pool b s ss base wend))
          (if (== ph PH_RET)
            (set a (deliver p pool b s ss out base))
            (if (== ph PH_FRAME)
              (set a (frame-run p pool b s ss base wend))
              (set a (doc-start p b s ss out base wend)))))
        (if (suspended a)
          (do (keys-save b ss base)
              (set-keep ss)
              (iset s VM_W_OFFSET (+ (ia s VM_W_OFFSET) base))
              (iset s VM_POS (+ (ia s VM_POS) base))
              (iset s O_ERR_POS (+ (ia s O_ERR_POS) base))
              (return a)))
        (if (== a FIN) (return (ia ss SS_CODE)))
        (if (== a BAD)
          (do (iset ss SS_CODE (neg 1))
              (iset ss SS_PH PH_DONE)
              (return (neg 1))))))))

(defn ^:pub ^I32 vms-steps [^IntsR ss]
  (comment "Steps taken so far (for tests and benchmarks).")
  (return (ia ss SS_STEPS)))
