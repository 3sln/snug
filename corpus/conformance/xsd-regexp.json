        "a",
        "aaa"
      ],
      "node": "a{2}"
    },
    {
      "name": "bounded quantifier",
      "pattern": "a{2,4}",
      "accept": [
        "aa",
        "aaa",
        "aaaa"
      ],
      "reject": [
