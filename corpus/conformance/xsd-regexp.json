        "ab",
        "ccabd"
      ],
      "reject": [
        "",
        "ac",
        "abdd"
      ],
      "node": "(ab|c)+d?"
    },
    {
      "name": "empty branches and zero repetitions",
      "pattern": "(a|){0,2}",
      "accept": [
