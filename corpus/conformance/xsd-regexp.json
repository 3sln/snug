{
  "reference": "XSD 1.0 Part 2 second edition Appendix F (corrected class grammar), XML 1.0 fifth edition productions [4]/[4a]; fixed hand-derived verdicts. Node v patterns are explicit translations ONLY where semantics coincide. Ruby cddl is not XSD-exact (anchors/dot/escapes) and supplies no expectations.",
  "cases": [
    {
      "name": "whole-string and literal assertions",
      "pattern": "^x$",
      "accept": [
        "^x$"
      ],
      "reject": [
        "x",
        "x$",
        "^x",
        "^x$\n"
      ],
      "node": "\\^x\\$"
    },
    {
      "name": "dot excludes LF and CR",
      "pattern": ".",
      "accept": [
        "a",
        "😀",
        "",
        " ",
        "\u0000"
      ],
      "reject": [
        "",
        "\n",
        "\r",
        "ab"
      ],
      "node": "[^\\n\\r]"
    },
    {
      "name": "single character escapes",
      "pattern": "\\n\\r\\t\\.\\-\\[\\]\\^\\\\\\|\\?\\*\\+\\(\\)\\{\\}",
      "accept": [
        "\n\r\t.-[]^\\|?*+(){}"
      ],
      "reject": [
        "",
        "nrt.-[]^\\|?*+(){}"
      ]
    },
    {
      "name": "group alternation optional unbounded",
      "pattern": "(ab|c)+d?",
