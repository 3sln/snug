ient]\n]\n\nCOSE_Encrypt0_Tagged = #6.16(COSE_Encrypt0)\n\nCOSE_Encrypt0 = [\n    Headers,\n    ciphertext : bstr / nil,\n]\n\nEnc_structure = [\n    context : \"Encrypt\" / \"Encrypt0\" / \"Enc_Recipient\" /\n        \"Mac_Recipient\" / \"Rec_Recipient\",\n    protected : empty_or_serialized_map,\n    external_aad : bstr\n]\n\nCOSE_Mac_Tagged = #6.97(COSE_Mac)\n\nCOSE_Mac = [\n   Headers,\n   payload : bstr / nil,\n   tag : bstr,\n   recipients : [+COSE_recipient]\n]\n\nCOSE_Mac0_Tagged = #6.17(COSE_Mac0)\n\nCOSE_Mac0 = [\n   Headers,\n   payload : bstr / nil,\n   tag : bstr,\n]\n\nMAC_structure = [\n     context : \"MAC\" / \"MAC0\",\n     protected : empty_or_serialized_map,\n     external_aad : bstr,\n     payload : bstr\n]\n\nCOSE_Key = {\n    1 => tstr / int,          ; kty\n    ? 2 => bstr,              ; kid\n    ? 3 => tstr / int,        ; alg\n    ? 4 => [+ (tstr / int) ], ; key_ops\n    ? 5 => bstr,              ; Base IV\n    * label => values\n}\n\nCOSE_KeySet = [+COSE_Key]\n",
