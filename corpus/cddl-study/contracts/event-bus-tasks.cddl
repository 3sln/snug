; tasks bus manifest payload (docs/spec/extensions/events.md §2) as CDDL, plus a CBOR record envelope using .cbor.
payload = { task: tstr .size (0..128), ? title: tstr .size (0..200), ? assignee: tstr .size (0..320) }
record = { type: "created" / "completed" / "reassigned", data: bstr .cbor payload }
