;; snug's gate map (SPEC §9, P9.15): every gate, how it runs, its watchdog caps,
;; and the named gate SETS. Engineers run the sets locally; hosted CI
;; (.github/workflows/ci.yml, P9.20) runs the same sets with `bb gates`:
;; `land` on pull requests and pushes to main, `release` (as its :partitions
;; shards, below) on version tags and on a manual run.
;;
;;     bb gates release          the release gate set (policy §4 step 2), in order
;;     bb gates land             what an engineer runs before landing
;;     bb identity               = bb gates identity (SPEC §7's cross-host identity)
;;     bb gates vm-test drift    named gates, in the order given
;;     bb gates --list | --check
;;
;; kin/scripts/gates runs each gate under kin/scripts/watchdog.mjs with the gate's
;; :watchdog name (default: the gate's own). A gate is ok only if it exits 0 AND
;; prints no `SKIP` line: a SKIP is recorded as NOT RUN and fails the set
;; (policy §2, §4). A :blocked gate is never run and also fails any set that
;; holds it, naming what it waits for.
;;
;; :caps [wall cpu] in seconds. For a gate kin/scripts/watchdog.mjs DEFAULTS
;; knows, the caps here must EQUAL those defaults (`bb gates --check`, run
;; before every set, refuses a mismatch); the watchdog applies them, so the
;; SNUG_GATE_* overrides still work. For any other gate the runner passes these
;; caps on the gate's command line (--gate-wall= / --gate-cpu=).
;;
;; :mode says what a gate covers when it has more than one way to run.
;;
;; Setup: size, watchdog-test, valid-test's cbor2 arm and runtime need
;; bench/compare/node_modules (AGENTS.md "Worktrees"); wasm-sdk-test and
;; wasm-size need the pinned nightly and wasm-opt from bench/compare
;; (kin/scripts/wasm-build); wasm-package-test needs those plus workerd and
;; Chrome (as runtime); runtime needs Chrome and workerd
;; (tools/runtime/README.md); node-oldest needs the engines Node via nvm and msrv
;; the rust-version toolchain via rustup (P9.18).
;;
;; :partitions splits a set into shard sets that CI's release job runs one after
;; another, a step each (D368; they were parallel jobs, D356): the release set's
;; wall caps sum to about 23 hours, and a hosted job stops at 6. `bb gates --check`
;; refuses a partition whose shards do not hold exactly the set's gates, each
;; once, and one whose shard's wall caps sum past 330 minutes (so a shard can
;; still run as a job of its own); it also checks ci.yml's release, land, compat
;; and linux jobs against this map (kin/scripts/gates, ci-matrix-problems).
{:gates
 {check            {:cmd ["bb" "check"] :caps [900 1800]
                    :doc "generate, run JS and Rust, require identical output"}
  drift            {:cmd ["bb" "drift"] :caps [900 1800]
                    :doc "committed gen/ is what the kin sources produce"}
  scan-test        {:cmd ["bb" "scan-test"] :caps [2400 4800] :mode "default seeds and scale"}
  rscan-test       {:cmd ["bb" "rscan-test"] :caps [2400 4800]}
  vm-test          {:cmd ["bb" "vm-test"] :caps [3600 7200]}
  vmsession-test   {:cmd ["bb" "vmsession-test"] :caps [7200 14400]}
  sequence-test    {:cmd ["bb" "sequence-test"] :caps [7200 14400]}
  valid-test       {:cmd ["bb" "valid-test"] :caps [2400 4800]
                    :doc "SKIPs its cbor2 arm without bench/compare/node_modules: NOT RUN"}
  compile-test     {:cmd ["bb" "compile-test"] :caps [2400 4800]
                    :doc "compile2-test (format 2.0, JS == Rust Programs, SOURCE_KEY) then regexp-test"}
  compile2-test    {:cmd ["bb" "compile2-test"] :caps [2400 4800]
                    :doc "the first half of compile-test, alone"}
  compile-fuzz     {:cmd ["bb" "compile-fuzz"] :caps [2400 4800]}
  nav-test         {:cmd ["bb" "nav-test"] :caps [1800 3600]}
  write-test       {:cmd ["bb" "write-test"] :caps [1800 3600]}
  unicode-test     {:cmd ["bb" "unicode-test"] :caps [1800 3600]}
  abnf-test        {:cmd ["bb" "abnf-test"] :caps [2400 4800]
                    :doc ".abnf/.abnfb (D334): kin vs the independent ABNF oracle, budget and memory cap, JS == Rust"}
  rust-api-test    {:cmd ["bb" "rust-api-test"] :caps [1200 2400]
                    :mode "default: the async differential on a seeded slice (routine runs)"}
  rust-api-test-full {:cmd ["bb" "rust-api-test" "full"] :watchdog "rust-api-test-full" :caps [3600 7200]
                      :mode "full: the async differential at full scale (the release set)"}
  wasm-sdk-test    {:cmd ["bb" "wasm-sdk-test"] :caps [5400 10800]
                    :doc "SKIPs without the pinned nightly: NOT RUN. In the release set: O3 ships the SDK (D338, D345)."}
  size             {:cmd ["bb" "size"] :caps [900 1800]}
  docs-test        {:cmd ["bb" "docs-test"] :caps [120 240]
                    :doc "the shipped text: no stale release state, internal process references or broken links (D366)"}
  types-test       {:cmd ["bb" "types-test"] :caps [600 1200]
                    :doc "the published declarations under the pinned TypeScript (bench/compare)"}
  wasm-size        {:cmd ["bb" "wasm-size"] :caps [3600 7200]
                    :doc "the wasm SDK modules' bytes and gzip caps (D341); SKIPs without the pinned nightly or wasm-opt: NOT RUN"}
  wasm-package-test {:cmd ["bb" "wasm-package-test"] :caps [3600 7200]
                    :doc "@3sln/snug-wasm (D345): release modules, staged package, npm pack, consumer install, every loader, Workers recipe in workerd, Chrome; SKIPs without the pinned nightly, workerd or Chrome: NOT RUN"}
  watchdog-test    {:cmd ["bb" "watchdog-test"] :caps [300 600]}
  npm-test         {:cmd ["npm" "test"] :dir "host/js" :caps [1800 3600]
                    :doc "host/js's node --test suite, including the version-site test (P9.15)"}
  rfc-corpus       {:cmd ["node" "corpus/tools/run-rfc-corpus.mjs" "--gate"] :caps [2400 4800]
                    :doc "no unexplained or stale RFC corpus checks"}
  proptest         {:cmd ["bb" "proptest" "--minutes=2" "--props=1,2,3,4,5" "--tree=working"] :caps [10800 43200]
                    :mode "the 2-minute P1-P5 campaign (policy §4's minimum) on the working tree, as every gate of a set (D370), its uncommitted paths logged; findings under .cache/proptest/"}
  crate-diff       {:cmd ["bb" "crate-diff"] :caps [3600 7200]
                    :doc "differential vs the cddl crate; needs its native build (P9.8 re-runs it)"}
  regexp-diff      {:cmd ["bb" "regexp-diff"] :caps [300 600]
                    :doc ".regexp (XSD) vs xsd-regexp.json, the Ruby gem and the cddl crate; needs both oracles (corpus/tools/ORACLES.md)"}
  runtime          {:cmd ["node" "tools/runtime/run.mjs"] :caps [2400 4800]
                    :doc "the staged package in Node, headless Chrome and workerd (P7.7)"}
  versions         {:cmd ["bb" "versions"] :caps [60 120]
                    :doc "every version site holds version.edn's placeholder: stamped versions are never checked in (D343)"}
  stamp-test       {:cmd ["bb" "stamp-test"] :caps [1800 3600]
                    :doc "bb stamp on scratch copies: coherent sites, idempotent, byte-identical trees, npm tarballs and .crate files (D343)"}
  node-oldest      {:cmd ["bb" "node-oldest"] :caps [3600 7200]
                    :doc "npm test, then wasm-package-test (D345), on the newest installed Node of engines.node's major (nvm); SKIPs without it: NOT RUN (P9.18)"}
  msrv             {:cmd ["bb" "msrv"] :caps [2400 4800]
                    :doc "cargo build, test and doctests of the assembled crate on rust-version (rustup); SKIPs without it: NOT RUN (P9.18)"}}

 ;; bb.edn tasks that are not gates
 :not-gates [gen emit bench-scan gates identity wasm-release stamp dist dist-test]

 :sets
 {;; docs/release-policy.md §4 step 2, in that order. A SKIP or a :blocked gate fails it.
  :release  [versions check drift stamp-test
             scan-test rscan-test vm-test vmsession-test sequence-test valid-test
             compile-test compile-fuzz
             nav-test write-test unicode-test abnf-test
             rust-api-test rust-api-test-full
             wasm-sdk-test wasm-package-test
             size types-test docs-test wasm-size watchdog-test
             npm-test rfc-corpus proptest
             node-oldest msrv runtime]
  ;; SPEC §7: the same Program bytes, verdict, reason, path and budget point on
  ;; every host. Each of these compares JS with Rust (and the oracle) on its layer.
  :identity [check scan-test compile-test vm-test vmsession-test sequence-test
             nav-test write-test unicode-test abnf-test rust-api-test]
  ;; the routine set before landing a change that touches kin or a host
  :land     [versions check drift size types-test docs-test npm-test rust-api-test wasm-sdk-test vm-test compile-test]
  ;; the release set's CI shards (:partitions). Tools: every shard needs Node
  ;; and Rust 1.92.0; core also the pinned wasm nightly (scan-test's wasm arm)
  ;; and bench/compare (its cbor2 differential, types-test's TypeScript); vm also the nightly (vm-test's
  ;; wasm arm); rust also Rust 1.87 and bench/compare; wasm also the nightly,
  ;; bench/compare, Node 20, workerd and Chrome; long also bench/compare
  ;; (valid-test's cbor2 arm).
  :release-core [versions check drift stamp-test scan-test rscan-test
                 compile-test compile-fuzz nav-test write-test types-test docs-test]
  :release-vm   [vm-test vmsession-test sequence-test]
  :release-rust [unicode-test abnf-test rust-api-test rust-api-test-full msrv
                 size watchdog-test npm-test rfc-corpus]
  :release-wasm [wasm-sdk-test wasm-package-test wasm-size node-oldest runtime]
  :release-long [valid-test proptest]}

 :partitions
 {:release [release-core release-vm release-rust release-wasm release-long]}

 ;; D368: the cells hosted CI's compat (macOS) and linux jobs each run, one after another
 ;; in one job: npm-test on these Node majors, rust-api-test on these Rust toolchains
 ;; (rust-version: host/rust/Cargo.toml's). `bb gates --check` reads ci.yml against it.
 :ci-compat {:node ["20" "22" "24"] :rust ["rust-version" "stable"]}

 ;; D370 (P9.13 gates N2): the environment variables gate code reads, by what they may do to
 ;; a gate's coverage. A gate run by `bb gates` (or ci/run-gate.sh) never sees a :clear knob:
 ;; the runner removes it from the gate's environment and prints which it removed, so a gate
 ;; that reports ok ran at full coverage. A gate's own command may still set one for its
 ;; children (rust-api-test sets SNUG_ASYNC_FULL, node-oldest SNUG_NODE_OLDEST, the sh gates
 ;; SNUG_RS_ONLY). A :floor knob relaxes a check only where a toolchain floor lacks a tool:
 ;; the runner passes it to the named gates only on that floor (:node, the engines.node major
 ;; of host/js/package.json; :rust, the rust-version of host/rust/Cargo.toml) and removes it
 ;; everywhere else. `bb gates --check` refuses a workflow that sets a :clear knob, or a
 ;; :floor knob on a step that is not one of its floor's cells. :keep knobs choose a tool,
 ;; a cap or a diagnostic output, not how much a gate runs; they pass through. `bb gates
 ;; --check` also refuses a SNUG_/SEQ_/VMTEST_/RUBY_/CDDL_/RFC_/PEG_ variable that gate code
 ;; reads and this map does not classify (kin/scripts/gates, knob-problems).
 :knobs
 {:clear [SEQ_SLOW SEQ_DRY SEQ_HOSTONLY          ; sequence-test: diagnostics that exit early; no JS arm
          SNUG_GEN                               ; the *-crate scripts: Rust from another gen/ tree
          SNUG_RS_ONLY                           ; rust-crate, wasm-build: a crate of fewer modules
          SNUG_WASM_TOOLCHAIN                    ; wasm-build, wasm-release: not the pinned nightly
          SNUG_SCAN_WASM SNUG_VM_WASM            ; scan-test, vm-test: a module not built from this tree
          SNUG_PARITY_MUTATIONS SNUG_PARITY_SEED SNUG_PARITY_SCHEMAS SNUG_PARITY_SEQ_MATCH ; wasm-sdk-test: parity scale, sequence filter
          SNUG_ASYNC_CASES SNUG_ASYNC_FULL       ; rust-api-test: the async differential's scale
          SNUG_PROPTEST_SELFTEST                 ; proptest: 0 skips its self-test
          SNUG_WASM_RELEASE                      ; wasm-package-test: release modules from elsewhere
          SNUG_STAMPED_VERSION]                  ; npm-test's version test: another tree's stamped version
  :floor {SNUG_NODE_OLDEST {:gates [npm-test] :on :node
                            :doc "host/js/test/oracle.mjs: leave out comparisons with a test-only oracle the engines Node lacks"}
          SNUG_CLIPPY_OPTIONAL {:gates [rust-api-test] :on :rust
                                :doc "host/rust/tests/run: no Clippy on the rust-version toolchain (D344)"}}
  :keep [SNUG_GATE_WALL SNUG_GATE_CPU SNUG_GATE_*  ; the watchdog's caps: a cap fails a gate, never passes one
         SNUG_WATCHDOG                             ; set by the watchdog for the gate it runs
         SNUG_TYPESCRIPT SNUG_ESBUILD SNUG_CHROME SNUG_WORKERD SNUG_WRANGLER SNUG_NODE_OLDEST_NODE ; tool locators (CI sets some)
         RUBY_CDDL RUBY_CDDL_GEM_HOME RFC_RUBY RFC_GEM_HOME PEG_RUBY CDDL_NATIVE ; oracle locators (corpus/tools/ORACLES.md)
         SNUG_LINT SNUG_SHOW SNUG_FULL SNUG_DUMP SNUG_LOUD VMTEST_LOG]}} ; diagnostics: extra output only
